#!/usr/bin/env bash
# Blocks pushing directly to main/master. This repo's private on GitHub Free,
# which has no branch protection or rulesets for private repos (confirmed via
# `gh api .../branches/main/protection` -> 403 "Upgrade to GitHub Pro"), so
# there is no server-side way to require PRs. This is the local substitute:
# real friction, but not a guarantee — --no-verify, or a clone that never ran
# `git config core.hooksPath .githooks`, bypasses it. See CLAUDE.md.
#
# Protocol: git feeds one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
set -eu

# main and master are always protected; additionally protect the repo's real
# default branch, resolved from the remote's HEAD at push time, so this stays
# correct if the default is ever renamed. Kept in lockstep with the emitted
# copy in templates/repo/pre-push.
protected_refs="refs/heads/main refs/heads/master"
default_branch="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
default_branch="${default_branch#origin/}"
if [ -n "$default_branch" ]; then
  protected_refs="refs/heads/$default_branch $protected_refs"
fi

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  for ref in $protected_refs; do
    if [[ "$remote_ref" == "$ref" ]]; then
      echo "pre-push: direct push to '$remote_ref' is blocked — open a PR instead." >&2
      exit 1
    fi
  done
done

exit 0
