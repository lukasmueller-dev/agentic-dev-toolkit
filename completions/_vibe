#compdef vibe
#
# _vibe — zsh completion for bin/vibe. install.sh links it to
# ~/.local/share/zsh/site-functions/_vibe; that directory must be in $fpath
# before compinit runs.

# _vibe_tasks — branch names of the current repo, local and on origin.
_vibe_tasks() {
  local -a tasks
  tasks=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin 2>/dev/null |
    sed -e 's#^origin/##' -e '/^HEAD$/d' -e '/^origin$/d' -e '/^worktree-/d' -e '/^main$/d' -e '/^master$/d' |
    sort -u)"})
  compadd -a tasks
}

# _vibe_agents — --<agent> for each <agent>/vibe-status.sh in the toolkit.
_vibe_agents() {
  local root="${commands[vibe]:A:h:h}" f
  local -a agents
  for f in "$root"/*/vibe-status.sh(N); do
    agents+=("--${f:h:t}")
  done
  compadd -a agents
}

# _vibe_ext — the next word of each extension command after the typed words: `vibe ext lines command`, and each
# `vibe ...` line of `vibe ext lines help` up to its first <arg>, [option] or two spaces.
_vibe_ext() {
  (( ${+commands[vibe]} )) || return 0
  local n=$(( CURRENT - 2 )) l
  local -a w out
  for l in ${(f)"$( { vibe ext lines command; vibe ext lines help | sed -n 's/^ *vibe //p' | sed -e 's/  .*//' -e 's/ [<[].*//'; } 2>/dev/null)"}; do
    w=(${=l})
    if (( $#w > n )) && [[ "${w[1,n]}" == "${words[2,CURRENT-1]}" ]]; then out+=("$w[n+1]"); fi
  done
  out=(${(u)out})
  compadd -a out
}

_vibe() {
  if (( CURRENT == 2 )); then
    local -a verbs
    verbs=(
      'start:start a task in its own worktree'
      'sync:sync worktrees with the default branch'
      'status:show agent servers on this machine'
      'ext:list extensions and their describe lines'
      'update-toolkit:pull, install and run doctor'
      'help:show usage'
    )
    _describe -t commands verb verbs
    _vibe_ext
    return
  fi
  case "$words[2]" in
    start)
      if [[ "$words[CURRENT-1]" == -C ]]; then
        _files -/
      elif [[ "$words[CURRENT]" == -* ]]; then
        compadd -- -C
      else
        _vibe_tasks
      fi
      ;;
    sync) compadd -- --all --wip ;;
    status) _vibe_agents ;;
    ext) (( CURRENT == 3 )) && compadd -- list lines ;;
    *) _vibe_ext ;;
  esac
}

_vibe "$@"
