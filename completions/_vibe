#compdef vibe
#
# zsh completion for vibe.
#
# Installed by install.sh to ~/.zsh/completions/_vibe. That directory has to be
# on $fpath *before* compinit runs, so add this to ~/.zshrc above any
# `compinit` line:
#
#   fpath=(~/.zsh/completions $fpath)
#   autoload -Uz compinit && compinit
#
# The filename must stay `_vibe` — zsh finds completers by name.

_vibe_tasks() {
  # Task directories under <worktree root>/<repo>/. Computed directly rather
  # than by calling vibe, so completion works inside a worktree too.
  local root repo common cfg
  cfg="${VIBE_CONFIG_FILE:-$HOME/.config/vibe/config}"
  root="${VIBE_WORKTREE_ROOT:-}"
  if [[ -z "$root" && -r "$cfg" ]]; then
    # optional 'export ' prefix: bin/vibe sources the config and vibe doctor
    # accepts it, so a parser that ignores it completes the wrong worktree root
    root="${$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?VIBE_WORKTREE_ROOT[[:space:]]*=[[:space:]]*//p' "$cfg" | tail -1)//[\"\']/}"
  fi
  root="${root:-$HOME/git/worktrees}"

  common="$(git rev-parse --git-common-dir 2>/dev/null)" || return 0
  [[ "$common" == /* ]] || common="$PWD/$common"
  repo="${${common:h}:t}"

  [[ -d "$root/$repo" ]] || return 0
  local -a tasks
  tasks=("$root/$repo"/*(/N:t))
  (($#tasks)) && _describe -t tasks 'task' tasks
}

_vibe() {
  local -a commands
  commands=(
    'start:Create branch + worktree for a task and open the agent'
    'attach:Arrive at a task — fast-forward when safe, then attach'
    'status:Show worktrees, tmux sessions and open PRs'
    'done:Remove a task worktree (branch is kept)'
    'doctor:Check tools, paths, config and upstream state'
    'help:Show usage'
  )

  _arguments -C \
    '1:command:->cmd' \
    '*::arg:->args'

  case "$state" in
    cmd)
      _describe -t commands 'vibe command' commands
      ;;
    args)
      case "${words[1]}" in
        attach)
          _arguments \
            '--rebase[rebase onto upstream when diverged]' \
            '*:task:_vibe_tasks'
          ;;
        done)
          _arguments \
            '(-f --force)'{-f,--force}'[remove even if dirty or unpushed]' \
            '--discard-handoff[skip the HANDOFF.md content guard]' \
            '--rm-branch[also delete the local branch once the work has landed]' \
            '*:task:_vibe_tasks'
          ;;
        status)
          _arguments \
            '--all[scan every repo under the worktree root]'
          ;;
        start)
          _arguments \
            '--no-attach[start the tmux session and return instead of attaching (needs tmux)]' \
            '1:new task name:'
          ;;
        help)
          _arguments '1:command:(start attach done status doctor)'
          ;;
      esac
      ;;
  esac
}

_vibe "$@"
