#compdef vibe
#
# zsh completion for vibe.
#
# Installed by install.sh to ~/.zsh/completions/_vibe. That directory has to be
# on $fpath *before* compinit runs, so add this to ~/.zshrc above any
# `compinit` line:
#
#   fpath=(~/.zsh/completions $fpath)
#   autoload -Uz compinit && compinit
#
# The filename must stay `_vibe` — zsh finds completers by name.

_vibe_tasks() {
  # Task directories under <worktree root>/<repo>/. Computed directly rather
  # than by calling `vibe list`, so completion works inside a worktree too.
  local root repo common cfg
  cfg="${VIBE_CONFIG_FILE:-$HOME/.config/vibe/config}"
  root="${VIBE_WORKTREE_ROOT:-}"
  if [[ -z "$root" && -r "$cfg" ]]; then
    root="${$(sed -n 's/^[[:space:]]*VIBE_WORKTREE_ROOT[[:space:]]*=[[:space:]]*//p' "$cfg" | tail -1)//[\"\']/}"
  fi
  root="${root:-$HOME/git/worktrees}"

  common="$(git rev-parse --git-common-dir 2>/dev/null)" || return 0
  [[ "$common" == /* ]] || common="$PWD/$common"
  repo="${${common:h}:t}"

  [[ -d "$root/$repo" ]] || return 0
  local -a tasks
  tasks=("$root/$repo"/*(/N:t))
  (($#tasks)) && _describe -t tasks 'task' tasks
}

_vibe() {
  local -a commands
  commands=(
    'start:Create branch + worktree for a task and open the agent'
    'loop:Create branch + worktree and run the agent unattended'
    'attach:Arrive at a task — fast-forward when safe, then attach'
    'park:Refresh HANDOFF.md via the agent, then sync'
    'rc:Enable Remote Control on a running task (server only)'
    'status:Show environment, worktrees, tmux sessions and open PRs'
    'list:List task worktrees for this repo'
    'done:Remove a task worktree (branch is kept)'
    'sync:Commit handoff files and the rest, then push'
    'resume:Fast-forward pull only'
    'where:Print the detected environment and why'
    'doctor:Check tools, paths, config and upstream state'
    'help:Show usage'
  )

  _arguments -C \
    '1:command:->cmd' \
    '*::arg:->args'

  case "$state" in
    cmd)
      _describe -t commands 'vibe command' commands
      ;;
    args)
      case "${words[1]}" in
        attach | park | rc | sync)
          _vibe_tasks
          ;;
        done)
          _arguments \
            '(-f --force)'{-f,--force}'[remove even if dirty or unpushed]' \
            '--stop[stop a running loop first, then remove]' \
            '--discard-handoff[skip the HANDOFF.md content guard]' \
            '--keep-brief[leave LOOP.md on the branch instead of requiring its deletion]' \
            '*:task:_vibe_tasks'
          ;;
        loop)
          _arguments \
            '--until[shell command that ends the loop when it exits 0]:command:' \
            '--max[stop after this many iterations]:count:' \
            '--for[stop once this much wall-clock time has passed, e.g. 90m]:duration:' \
            '--prompt[custom brief instead of the LOOP.md template]:file:_files' \
            '--push[push each iteration, guarding against divergence]' \
            '--pr[open the PR when the loop ends, draft unless it passed (implies --push)]' \
            '--no-attach[start the tmux session and return instead of attaching (server)]' \
            '--sandbox[confine the agent with the configured sandbox args (see docs)]' \
            '--dangerously-allow-all[skip the agent permission prompts (see docs)]' \
            '*:task:_vibe_tasks'
          ;;
        resume)
          _arguments \
            '--rebase[rebase onto upstream when diverged]' \
            '*:task:_vibe_tasks'
          ;;
        status)
          _arguments '--all[scan every repo under the worktree root]'
          ;;
        start)
          _message 'new task name'
          ;;
        help)
          _arguments '1:command:(start loop attach park done rc status list sync resume where doctor)'
          ;;
      esac
      ;;
  esac
}

_vibe "$@"
