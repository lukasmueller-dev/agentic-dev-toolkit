// Server (VPS over SSH) — add to VS Code *Remote* Settings (JSON):
//   Cmd+Shift+P → "Preferences: Open Remote Settings (JSON)"
//   (the one showing "[SSH: <your-host>]")
// This lives in ~/.vscode-server/data/Machine/settings.json and covers ALL
// repos on the VPS. Makes every new terminal open with `vibe status`.
{
  "terminal.integrated.profiles.linux": {
    "vibe": { "path": "bash", "args": ["-lic", "vibe status; exec bash"] }
  },
  "terminal.integrated.defaultProfile.linux": "vibe"
}
