#!/usr/bin/env bash
# kapso steer "<text>": a note that every agent session started later reads.
set -euo pipefail
# A rented place execs over ssh with no image ENV: kapso needs its PATH.
export PATH=/home/node/venv/bin:/opt/kapso/bin:$PATH
exec kapso inbox note "${KAPSO_WS_ROOT:-/ws}/data/campaign" "${1:?steer needs the text}"
