#!/usr/bin/env bash
# stop: ask run to end the supervisor; wait for the result; /ws/data stays.
set -euo pipefail

pidfile="${TMPDIR:-/tmp}/ar-supervisor.pid"
stopflag="${TMPDIR:-/tmp}/ar-stop"
pid="$(cat "$pidfile" 2>/dev/null)" || exit 0
kill -0 "$pid" 2>/dev/null || exit 0
touch "$stopflag"
# run removes the pid file after it wrote the result.
for _ in $(seq 1 "${AR_STOP_WAIT:-120}"); do
  if [ ! -e "$pidfile" ]; then exit 0; fi
  sleep 1
done
echo "stop: run has not written the result yet" >&2
exit 1
