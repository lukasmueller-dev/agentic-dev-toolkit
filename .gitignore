# install.sh backups (created when a real file was already in place)
*.bak.*

# bin/plug staging dir; removed on exit, left only by a kill mid-sync
.plug-stage.*

# OS / editor cruft
.DS_Store
*.swp
.vscode/

# secrets — forward guard; none tracked today, keep it that way
.env
.env.*
*.pem
*.key
*credentials*

# Vendored upstream files are committed whatever the patterns above say (plug hashes them).
!vendor/**
