#!/usr/bin/env bash
#
# research — the research and workspace extension of vibe (docs/vibe-extensions.md): `vibe ws`, tool jobs
# and place runs (docs/workspaces.md). It sources no toolkit file and calls no vibe function: it reaches
# the queue through $VIBE_BIN commands and job files.
# shellcheck disable=SC2317  # the closing exit makes shellcheck read every function as unreachable
set -euo pipefail

script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

if [[ -z "${VIBE_BIN:-}" || -z "${VIBE_STATE:-}" ]]; then
  echo "research: runs under vibe — VIBE_BIN and VIBE_STATE are unset" >&2
  exit 2
fi
ROOT="$(cd "$(script_dir)/../.." && pwd)" # the checkout: workspaces/, docs/workspaces/, the tool-run prompt
QROOT="$VIBE_STATE"
QDIR="$QROOT/queue"
GPUQ="$(dirname "$VIBE_BIN")/gpu-queue"

die() {
  echo "vibe: $*" >&2
  exit 1
}
warn() { echo "vibe: warning: $*" >&2; }
jget() { awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1" 2>/dev/null || true; }
jstate() { head -n 1 "$1/$2" 2>/dev/null || true; }
slug() { echo "$1" | tr '[:upper:] /' '[:lower:]--' | sed 's/[^a-z0-9._-]//g'; }
esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }
at_time() { LC_ALL=C date -d "@$1" "+${2:-%F %H:%M}" 2>/dev/null || LC_ALL=C date -r "$1" "+${2:-%F %H:%M}"; }
agent_git() { git -c core.hooksPath=/dev/null "$@"; }

# epoch_of 'YYYY-MM-DD HH:MM:SS' — the epoch seconds of a local time, GNU or BSD date; empty when malformed.
epoch_of() {
  [[ -n "$1" ]] || return 0
  date -d "$1" +%s 2>/dev/null || date -j -f '%Y-%m-%d %H:%M:%S' "$1" +%s 2>/dev/null || true
}

# deadline_gate JOB WHAT — dies past JOB's deadline= (`YYYY-MM-DD HH:MM` local time; at VIBE_AT, else now): WHAT, finish the task.
deadline_gate() {
  local v dl=""
  v="$(jget "$1/job" deadline)"
  [[ -n "$v" ]] || return 0
  if [[ "$v" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]]; then dl="$(epoch_of "$v:00")"; fi
  [[ -n "$dl" ]] || die "$1/job: deadline=$v — YYYY-MM-DD HH:MM"
  if ((${VIBE_AT:-$(date +%s)} >= dl)); then die "past this job's deadline ($v): $2, finish the task"; fi
}

# tool_inst JOB — the workspace instance of a tool= job: <tool>-<job id>.
tool_inst() { echo "$(jget "$1/job" tool)-${1##*/}"; }

# tool_conf JOB KEY — KEY from the workspace.conf of the job's tool; empty when absent.
tool_conf() { jget "$WS_ROOT/$(jget "$1/job" tool)/workspace.conf" "$2"; }

# tool_place JOB — place= of a tool= job, else the first of its tool's places.
tool_place() {
  local p
  p="$(jget "$1/job" place)"
  [[ -n "$p" ]] || p="$(tool_conf "$1" places)"
  echo "${p%%,*}"
}

# tool_hours JOB — hours= of a tool= job, else of its tool's workspace.conf.
tool_hours() {
  local h
  h="$(jget "$1/job" hours)"
  echo "${h:-$(tool_conf "$1" hours)}"
}

# tool_gpu JOB — true for a tool= job whose run is to come or runs, on turing with gpu=yes: under the GPU lock.
tool_gpu() {
  [[ -n "$(jget "$1/job" tool)" && ! -f "$1/tool-exit" && "$(tool_conf "$1" gpu)" == yes && "$(tool_place "$1")" == turing ]]
}

# tool_check JOB — why a tool= job cannot run (docs/workspaces.md, Queue job); empty when it can.
tool_check() {
  local n f p h m
  n="$(jget "$1/job" tool)" p="$(tool_place "$1")" h="$(tool_hours "$1")"
  f="$WS_ROOT/$n/workspace.conf"
  if ! m="$( (ws_dir "$n" >/dev/null && ws_secrets "$n" "$f") 2>&1)"; then
    echo "${m#vibe: }"
  elif [[ "$(tool_conf "$1" kind)" != run ]]; then
    echo "$n is kind=service — vibe ws start $n"
  elif [[ ",$(tool_conf "$1" places)," != *",$p,"* ]]; then
    echo "$n has no place '$p' — places=$(tool_conf "$1" places)"
  elif [[ ! -x "$WS_ROOT/_places/$p" ]]; then
    echo "no place script '$p' in $WS_ROOT/_places — place= names another"
  elif ! [[ "$h" =~ ^[1-9][0-9]*$ ]]; then
    echo "hours=$h: a whole number above 0, in the job or $f"
  elif ! [[ "$(tool_inst "$1")" =~ $WS_INST_RE ]]; then
    echo "instance '$(tool_inst "$1")': letters, digits, . _ - only — the repo folder or the branch breaks it"
  fi
}

# tool_run JOB — the run of a tool= job in its instance: in/ (a clone of the worktree, the job's
# in/brief.md and in/args), then `vibe ws run`, under the GPU lock for gpu=yes on turing.
# A stop TERMs the run, then the stop script and down. Writes JOB/tool.log, out/ (plain files and dirs only:
# a link would read host files, a FIFO blocks a read), then tool-exit. The instance is the job's alone:
# once down, its state dir goes.
tool_run() {
  local d="$1" inst st h f pid rc=0
  inst="$(tool_inst "$d")" h="$(tool_hours "$d")"
  st="$WS_STATES/$inst"
  local -a runcmd=("$VIBE_BIN" ws run "$inst")
  : >"$d/tool.log"
  mkdir -p "$st"
  # A job process that died left its instance up: down first; up brings its data/ back.
  if [[ -s "$st/id" ]]; then WS_HOURS="$h" ws_down "$inst" >>"$d/tool.log" 2>&1 || true; fi
  tool_place "$d" >"$st/place"
  rm -rf "$st/in" "$st/out" "$d/out"
  mkdir -p "$st/in"
  for f in brief.md args; do
    if [[ -f "$d/in/$f" ]]; then cp "$d/in/$f" "$st/in/$f"; fi
  done
  if ! agent_git clone -q --single-branch "$(jstate "$d" worktree)" "$st/in/repo" >>"$d/tool.log" 2>&1; then
    rm -rf "$st"
    return 0
  fi
  if tool_gpu "$d"; then
    runcmd=("$GPUQ" lock -- "${runcmd[@]}")
  fi
  # Its own process group: a stop TERMs a lock waiter, `vibe ws run` and the place's exec at once.
  set -m
  WS_HOURS="$h" "${runcmd[@]}" </dev/null >>"$d/tool.log" 2>&1 &
  pid=$!
  set +m
  while kill -0 "$pid" 2>/dev/null; do
    if [[ -e "$d/stop" ]]; then
      kill -TERM -- "-$pid" 2>/dev/null || true
      break
    fi
    sleep "${VIBE_WS_POLL:-10}"
  done
  wait "$pid" || rc=$?
  if [[ -e "$d/stop" && -s "$st/id" ]]; then WS_HOURS="$h" ws_down "$inst" >>"$d/tool.log" 2>&1 || true; fi
  copy_out "$st" "$d" "$d/tool.log"
  # Last: a job process that dies before it runs the tool again.
  echo "$rc" >"$d/tool-exit"
  rm -f "$d/slot"
  if [[ ! -s "$st/id" ]]; then rm -rf "$st"; fi
}

# copy_out ST JOB LOG — ST/out to JOB/out with no link or special file: a rented machine can plant one.
copy_out() {
  if [[ -d "$1/out" ]]; then
    rm -rf "$2/out"
    cp -R "$1/out" "$2/out" >>"$3" 2>&1 || true
    find "$2/out" ! -type f ! -type d -delete 2>/dev/null || rm -rf "$2/out"
  fi
}

# tool_unsafe WT — the first path FETCH_HEAD adds, changes or deletes against WT's HEAD in agent or git
# config (.claude/, CLAUDE.md, .mcp.json, .vibe-jobs/, .github/ …); `?` when the diff fails.
# The closing session and the review run in WT on the host and load that config.
tool_unsafe() {
  local f
  f="$(agent_git -c core.quotePath=false -C "$1" diff --no-renames --name-only HEAD FETCH_HEAD)" || {
    echo "?"
    return 0
  }
  printf '%s\n' "$f" | grep -Ei -m 1 '(^"?|/)(\.claude|\.mcp\.json|claude(\.local)?\.md|agents\.md|gemini\.md|\.vibe-jobs|\.gitattributes|\.gitmodules|\.githooks|\.github)(/|"?$)' || true
}

# tool_job JOB — a tool= job up to its closing session: the run once (tool_run), a result=branch
# fast-forwarded onto the job's branch, JOB/close.md (prompt.md, tool-run.md at its end).
# False with an `end failed <note>` line: a stop, no out/result, a failed: out/result, a done branch result with no bundle, a bad or unsafe
# branch, no fast-forward, no close.md.
# Runs as a tested condition: each failure is handled, not left to errexit.
# A requeue after a crash redoes what is not done: tool-exit marks the run, close.md the check and the merge too.
tool_job() {
  local d="$1" wt b x e
  wt="$(jstate "$d" worktree)"
  if [[ ! -f "$d/close.md" ]]; then
    if [[ ! -f "$d/tool-exit" ]]; then tool_run "$d"; fi
    if [[ -e "$d/stop" ]]; then
      echo "end failed stopped"
      return 1
    fi
    if [[ ! -s "$d/out/result" ]]; then
      x="$(tail -n 1 "$d/tool.log" 2>/dev/null | cut -c 1-160)"
      e="$(jstate "$d" tool-exit)"
      echo "end failed no out/result, tool exit ${e:-none} — tool.log: $x"
      return 1
    fi
    # A failed run has nothing to check: its line is the job's result, no closing session.
    if [[ "$(jstate "$d/out" result)" == failed:* ]]; then
      echo "end failed $(jstate "$d/out" result | cut -c 1-160)"
      return 1
    fi
    b="$(jstate "$d/out" branch)"
    # tool-run.md tells the closing session that the branch holds the tool's commits.
    if [[ "$(tool_conf "$d" result)" == branch && ! -f "$d/out/repo.bundle" && "$(jstate "$d/out" result)" == done:* ]]; then
      echo "end failed out/result is done: but there is no out/repo.bundle — tool.log"
      return 1
    fi
    if [[ "$(tool_conf "$d" result)" == branch && -f "$d/out/repo.bundle" ]]; then
      if ! { git check-ref-format --allow-onelevel "$b" && agent_git -C "$wt" fetch -q "$d/out/repo.bundle" -- "$b"; } >>"$d/tool.log" 2>&1; then
        echo "end failed out/repo.bundle: no branch '$b' — tool.log"
        return 1
      fi
      x="$(tool_unsafe "$wt")"
      if [[ -n "$x" ]]; then
        echo "end failed out/repo.bundle changes $x: agent and git config stay out of a tool's commits"
        return 1
      fi
      if ! agent_git -C "$wt" merge -q --ff-only FETCH_HEAD >>"$d/tool.log" 2>&1; then
        echo "end failed out/repo.bundle: '$b' does not fast-forward $(jget "$d/job" branch) — tool.log"
        return 1
      fi
    fi
  fi
  # `if ! { … } >f` misses a failed redirect (bash keeps its status unnegated): `||` catches it.
  {
    cat "$d/prompt.md" && echo && cat "$ROOT/skills/fill-queue/references/tool-run.md"
  } >"$d/close.md" || {
    echo "end failed close.md not written — runner.log"
    return 1
  }
}

# place_queue JOB PLACE CMD... — vibe queue gpu --place: JOB/run/ gets place, commit (the worktree's HEAD) and cmd
# (CMD as a bash script); after the session the runner takes it (place_take), its next pass starts it (place_pass). One error line when the folder cannot run there.
# The secrets: ~/.config/vibe/workspaces/research-<repo folder>.env, one file per repo.
place_queue() {
  local d="$1" p="$2" wt f=.claude/research c t r
  shift 2
  wt="$(jstate "$d" worktree)"
  c="$wt/$f/workspace.conf"
  [[ -d "$wt/$f" ]] || die "no $f/ in $wt: --place $p runs the repo's research folder — docs/vibe-queue.md#research-jobs"
  t="$(ws_check "$wt/$f")"
  [[ "$t" == ok ]] || die "$f/workspace.conf: $t"
  [[ "$(jget "$c" kind) $(jget "$c" result)" == "run folder" ]] || die "$f/workspace.conf needs kind=run and result=folder"
  [[ ",$(jget "$c" places)," == *",$p,"* ]] || die "$f/workspace.conf has no place '$p' — places=$(jget "$c" places)"
  [[ -n "$(jget "$c" hours)" ]] || die "$f/workspace.conf needs hours=: the limit of a run"
  [[ -n "$(jget "$c" image)" && -n "$(jget "$c" commit)" ]] || die "$f/workspace.conf needs image= and commit=: $p rents that image"
  r="$(jget "$d/job" repo)"
  ws_secrets "research-$(basename "$r")" "$c"
  [[ -x "$WS_ROOT/_places/$p" ]] || die "no place script '$p' in $WS_ROOT/_places"
  [[ -f "$wt/$f/run" && -x "$wt/$f/run" ]] || die "$f/run is missing or not executable: the place runs it"
  [[ -z "$(agent_git -C "$wt" status --porcelain -- "$f")" ]] || die "commit $f/ first: the run takes the worktree's HEAD"
  # Tracked files only: the sandbox puts untracked placeholder files in the worktree root.
  [[ -z "$(agent_git -C "$wt" status --porcelain -uno)" ]] || die "commit your changes first: the run takes the worktree's HEAD"
  [[ ! -e "$d/run" ]] || die "this job queued its run already ($d/run): one run per session"
  t="$(mktemp -d "$d/.run.XXXXXX")"
  echo "$p" >"$t/place"
  agent_git -C "$wt" rev-parse HEAD >"$t/commit"
  printf '#!/usr/bin/env bash\n%s\n' "$(printf '%q ' "$@")" >"$t/cmd"
  mv "$t" "$d/run"
  echo "asked for a run at $p — now write result 'queued: <what runs>' and exit; the runner starts it"
}

# fresh FILE — stdin to FILE as a new file, never through a link: an agent can write every job dir. rm drops a link
# planted before; noclobber refuses one planted after the rm.
fresh() {
  rm -f "$1" && (
    set -C
    cat >"$1"
  )
}

# place_pass JOB — the runner pass for JOB/run/: start place_run once. A run whose process died before
# run/exit (a reboot) ends as infra; its instance goes down at its limit (vibe ws tick).
place_pass() {
  local d="$1" p
  if [[ ! -f "$d/job" || ! -f "$d/run/place" || -e "$d/run/exit" ]]; then return 0; fi
  p="$(jstate "$d/run" pid)"
  if [[ -z "$p" ]]; then
    # Once: a run/pid that cannot be written starts no second run in the next pass.
    if grep -qxF "$d" "$WS_STATES/started" 2>/dev/null; then return 0; fi
    mkdir -p "$WS_STATES" && echo "$d" >>"$WS_STATES/started" || return 1
    place_run "$d" </dev/null >>"$d/runner.log" 2>&1 &
    echo "$!" | fresh "$d/run/pid"
  elif ! run_alive "$d" && [[ ! -e "$d/run/exit" ]]; then
    echo "the run process died (a reboot?) — vibe ws status research-${d##*/}" | fresh "$d/infra" || true
    # No run/exit, no follow-up: else each pass queues one.
    echo infra | fresh "$d/run/exit" || return 1
    (GPUQ_EXIT=infra GPUQ_LOG="$d/run/log" "$VIBE_BIN" queue follow "$d") >>"$d/runner.log" 2>&1 || true
  fi
}

# run_alive JOB — JOB/run/pid is a live fork of this extension's pass event: a pid that a reboot gave to another command is no run.
run_alive() {
  local p
  p="$(jstate "$1/run" pid)"
  [[ "$p" =~ ^[1-9][0-9]*$ && "$(ps -o command= -p "$p" 2>/dev/null || true)" == *"/${0##*/} event pass"* ]]
}

# place_run JOB — JOB's run in instance research-<id>: in/repo holds run/commit alone (depth 1: no other branch
# leaves turing), in/cmd the command, in/repo/.claude/research/ the folder. The usd gate (place_gate), up, exec run
# until the stop bound before the limit or a stop --now (JOB/drain: now), then exec stop, pull, down. All output to the
# runner's log in the instance state, run/log at the end (fresh: no write through a link); /ws/out to JOB/out/.
# A failed fetch, price or up writes JOB/infra; a refused start ends as usd, a stop --now before up as stopped.
# After up, run/started and run/limit mirror the instance's.
# Then cost, run/exit and the follow-up.
place_run() {
  local d="$1" inst="research-${1##*/}" st lim secs stop="${VIBE_WS_STOP_SECS:-300}" rc=0 t0="" p c t pid f cut=0
  p="$(jstate "$d/run" place)" c="$(jstate "$d/run" commit)"
  # The agent can write its job dir: a commit git reads as an option, a host place, or a link to a host file runs
  # or reads outside the sandbox. The error names no value: through a link, it can be a secret's first line.
  if [[ -L "$d/run" || -L "$d/run/place" || -L "$d/run/commit" || -L "$d/run/cmd" || ! -f "$d/run/cmd" ||
    ! "$p" =~ ^(runpod|vast)$ || ! "$c" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
    p="" rc=infra
  fi
  st="$WS_STATES/$inst"
  mkdir -p "$st/in"
  echo "$p" >"$st/place"
  echo "$st/in/repo/.claude/research" >"$st/dir"
  echo "research-$(basename "$(jget "$d/job" repo)")" >"$st/name"
  if [[ "$rc" == infra ]]; then
    echo "vibe: run/place must be runpod or vast, run/commit a commit id, run/cmd a file, and none a link" >>"$st/log"
  elif ! {
    cp "$d/run/cmd" "$st/in/cmd" && chmod +x "$st/in/cmd" &&
      agent_git init -q "$st/in/repo" &&
      agent_git -C "$st/in/repo" fetch -q --depth 1 -- "$(jstate "$d" worktree)" "$c" &&
      agent_git -C "$st/in/repo" checkout -q --detach FETCH_HEAD
  } >>"$st/log" 2>&1; then
    rc=infra
  fi
  if [[ "$rc" == 0 && "$(jstate "$d" drain)" == now ]]; then
    echo "vibe: stopped before up (vibe queue stop --research --now)" >>"$st/log"
    rc=stopped
  fi
  if [[ "$rc" == 0 ]]; then place_gate "$d" "$inst" >>"$st/log" 2>&1 || rc=$?; fi
  case "$rc" in 1) rc=usd ;; 2) rc=infra ;; esac
  if [[ "$rc" == 0 ]]; then
    t0="$(date +%s)"
    ws_place "$inst" up >>"$st/log" 2>&1 || rc=infra
    # shortcut: no code reads this mirror yet (kept for an ended run's box time; PR research-card-status); the instance dir goes with the box.
    for f in started limit; do
      if [[ "$rc" == 0 && -f "$st/$f" ]]; then fresh "$d/run/$f" <"$st/$f" || true; fi
    done
  fi
  if [[ "$rc" == infra ]]; then
    tail -n 1 "$st/log" | fresh "$d/infra" || true
  elif [[ "$rc" == 0 ]]; then
    lim="$(jstate "$st" limit)" secs=""
    # The stop script runs before the limit: its RESULT line lands in the run's log, not in a tick's log.
    if [[ "$lim" =~ ^[0-9]+$ ]]; then secs=$((lim - $(date +%s) - stop)); fi
    if [[ -n "$secs" ]] && ((secs < 1)); then secs=1; fi
    # Its own process group: a stop --now TERMs the place's exec, and the run ends as at its limit (124).
    # timeout(1) leads a group of its own: its TERM handler passes the TERM on to that group.
    set -m
    WS_SECS="$secs" ws_place "$inst" exec run </dev/null >>"$st/log" 2>&1 &
    pid=$!
    set +m
    while kill -0 "$pid" 2>/dev/null; do
      if [[ "$(jstate "$d" drain)" == now ]]; then
        pkill -TERM -P "$pid" 2>/dev/null || true
        kill -TERM -- "-$pid" 2>/dev/null || true
        cut=1
        break
      fi
      sleep "${VIBE_WS_POLL:-10}"
    done
    wait "$pid" || rc=$?
    # A run that ended 0 as the stop came in keeps its result.
    if ((cut && rc != 0)); then rc=124; fi
    # From here this process stops, pulls and downs the instance: vibe ws tick leaves it alone (owner).
    echo "$d" >"$st/owner"
    if ((rc == 124)); then WS_SECS="$stop" ws_place "$inst" exec stop >>"$st/log" 2>&1 || true; fi
    # Bounded as a tick's call: vibe ws tick skips the instance while this process lives, then takes it down at its limit.
    t="${VIBE_WS_TICK_SECS:-600}"
    WS_SECS="$t" ws_place "$inst" pull >>"$st/log" 2>&1 || true
    WS_SECS="$t" ws_place "$inst" down >>"$st/log" 2>&1 || echo "vibe: down of $inst failed — vibe ws status $inst" >>"$st/log"
  fi
  copy_out "$st" "$d" "$st/log"
  fresh "$d/run/log" <"$st/log" || true
  if [[ ! -s "$st/id" ]]; then
    # The instance is gone: cost is price × the time from up to now. A live one keeps hours × price (down at its limit).
    if [[ -n "$t0" ]]; then
      awk -v p="$(jstate "$st" price)" -v s=$(($(date +%s) - t0)) 'BEGIN { printf "%.2f\n", p * s / 3600 }' | fresh "$d/cost" || true
    fi
    rm -rf "$st"
  fi
  echo "$rc" | fresh "$d/run/exit" || true
  GPUQ_EXIT="$rc" GPUQ_LOG="$d/run/log" "$VIBE_BIN" queue follow "$d"
}

# place_gate JOB INST — run/price: the USD per hour of INST's place (its exit 3: 0). With usd= in JOB/job, a start
# is refused when spent (the cost of each live or archived job of JOB's repo= and research=) + hours × price is above usd.
# A start writes cost = hours × price: a run counts at its full hours while it runs. Exit 1: refused, 2: no price or no lock.
place_gate() {
  local d="$1" h p u r g s=0 j rc=0 l="$QROOT/usd" m=""
  h="$(jget "$WS_STATES/$2/in/repo/.claude/research/workspace.conf" hours)"
  p="$(WS_SECS=60 ws_place "$2" price)" || rc=$?
  if ((rc == 3)); then
    p=0
  elif ((rc)) || [[ ! "$p" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "vibe: no price from $(jstate "$WS_STATES/$2" place) (exit $rc)${p:+: $p}"
    return 2
  fi
  echo "$p" >"$WS_STATES/$2/price"
  echo "$p" | fresh "$d/run/price" || true
  # One gate at a time: a run that starts in the same pass sees this one's cost.
  mkdir_lock "$l" || return 2
  u="$(jget "$d/job" usd)" r="$(jget "$d/job" research)" g="$(jget "$d/job" repo)"
  if [[ -n "$r" ]]; then
    s="$({
      for j in "$QDIR"/*/; do
        if [[ "${j%/}" != "$d" && -s "${j}cost" && "$(jget "${j}job" research)" == "$r" && "$(jget "${j}job" repo)" == "$g" ]]; then
          head -n 1 "${j}cost"
        fi
      done
      archived_costs "$r" "$g"
    } | awk '{ s += $1 } END { printf "%.2f", s }')"
  fi
  # awk compares a number with a word as text: a usd that is no number must refuse here.
  if [[ -n "$u" && ! "$u" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    m="usd=$u is no number"
  elif [[ -n "$u" ]] && ! awk -v s="$s" -v h="$h" -v p="$p" -v u="$u" 'BEGIN { exit !(s + h * p <= u) }'; then
    m="spent $s + $h h × $p USD/h is above usd=$u"
  fi
  if [[ -n "$m" ]]; then
    rmdir "$l.lock" 2>/dev/null || true
    echo "usd gate: $m: no start"
    return 1
  fi
  # No cost file, no start: the gate of the next run sums it.
  awk -v h="$h" -v p="$p" 'BEGIN { printf "%.2f\n", h * p }' | fresh "$d/cost" || m="no cost file in ${d##*/}"
  rmdir "$l.lock" 2>/dev/null || true
  if [[ -n "$m" ]]; then
    echo "vibe: $m: no start"
    return 2
  fi
}

# archived_costs RESEARCH REPO — the cost of each archived job of RESEARCH and REPO (empty: any repo), a line each.
# One awk for all: a subshell per archived job took 2.5 s at 1800 jobs, on each page render.
archived_costs() {
  # A missing or empty cost file reads no line: awk prints nothing for it.
  printf '%s\n' "$QROOT"/archive/*/*/cost | awk -v r="$1" -v g="$2" '{
    jf = $0; sub(/cost$/, "job", jf); rs = ""; rp = ""; a = 0; b = 0
    while ((getline l < jf) > 0) {
      if (!a && index(l, "research=") == 1) { rs = substr(l, 10); a = 1 }
      if (!b && index(l, "repo=") == 1) { rp = substr(l, 6); b = 1 }
    }
    close(jf)
    if (rs == r && (g == "" || rp == g) && (getline c < $0) > 0) print c
    close($0)
  }'
}

# tool_up JOB — true while a tool= job runs its tool: running, no tool-exit yet.
tool_up() { [[ -n "$(jget "$1/job" tool)" && "$(jstate "$1" status)" == running && ! -f "$1/tool-exit" ]]; }

# tool_steers JOB — true when the job's tool has a steer script without the contract's bare `exit 3`.
# shortcut: reads the script, never runs it; upgrade when a steer script answers 3 only at run time.
tool_steers() {
  local f
  f="$WS_ROOT/$(jget "$1/job" tool)/steer"
  [[ -x "$f" ]] && ! grep -qx 'exit 3' "$f"
}

# ws_recipe NAME — the Recipe link of a workspace tool: its doc on GitHub; empty without a doc or a GitHub origin.
ws_recipe() {
  if [[ -n "${GH:-}" && -f "$ROOT/docs/workspaces/$1.md" ]]; then printf '<a class="rcp" href="%s/blob/HEAD/docs/workspaces/%s.md" target="_blank" rel="noopener">Recipe ↗</a>' "$(esc "$GH")" "$(esc "$1")"; fi
}

# ws_page HOLDER — line 1: `1` while a tool runs (the tab's dot), else empty; then the Workspaces tab: a card per kind=service
# tool: lamp and state, label, role, where it runs, Open UI ↗ and Stop, or Start (a place and hours form for 2+ places);
# then a card per run tool: lamp and state (Idle, or its live job), label, role, where it runs. HOLDER: gpu_holder,
# named on turing for a gpu=yes tool. Routes ws-start, ws-stop.
ws_page() {
  local d n f l s st lamp line b e p u t x lim now dot="" rows="" runs="" opts hold="${1:-}" tj j run meta
  now="$(date +%s)"
  tj="$(grep -H '^tool=' "$QDIR"/*/job 2>/dev/null || true)"
  for d in "$WS_ROOT"/*/; do
    n="${d%/}" n="${n##*/}"
    if [[ ! -d "$d" || "$n" == _* || "$(slug "$n")" != "$n" || "$(ws_check "$WS_ROOT/$n")" != ok ]]; then continue; fi
    f="$WS_ROOT/$n/workspace.conf" l="$(jget "$f" label)" l="${l:-$n}" e="$(esc "$n")"
    p="$(jget "$f" places)" t="$(jget "$f" hours)"
    meta="Runs on: ${p//,/, }$(if [[ "$(jget "$f" gpu)" == yes ]]; then echo " · GPU"; fi)${t:+ · $t h}"
    if [[ "$(jget "$f" kind)" != service ]]; then
      run=""
      while IFS= read -r j; do
        case "$(jstate "$j" status)" in "" | queued | running | gpu) run="$j" ;; esac
      done < <(printf '%s\n' "$tj" | awk -F'/job:tool=' -v n="$n" '$2 == n { k = $1; sub(/.*\//, "", k); print k "\t" $1 }' | sort | cut -f 2-)
      lamp=off line="Idle"
      if [[ -n "$run" ]]; then
        case "$(jstate "$run" status)" in running) line=Running ;; gpu) line="On the GPU" ;; *) line=Queued ;; esac
        lamp=ok dot=1 line="$line · $(esc "$(short_id "$run" "$(jget "$run/job" repo)")")"
      fi
      runs+="<div class=\"wrow\" id=\"ws-$e\"><div class=\"t\"><span class=\"why\"><i class=\"lamp l-$lamp\"></i>$line</span><b>$(esc "$l")</b><span class=\"role\">$(esc "$(jget "$f" role)")</span><span class=\"meta\">$(esc "$meta")</span></div>$(ws_recipe "$n")</div>"
      continue
    fi
    st="$WS_STATES/$n" s="$(ws_state "$st")" p="$(jstate "$st" place)" b="" u=""
    line="Starts on $(esc "$p")" lamp=warn
    if [[ "$s" != down ]]; then dot=1; fi
    case "$s" in
      down)
        lamp=off line="Off"
        t="$(ws_line "$st" | cut -f 4)"
        if [[ -d "$st" && -n "$t" ]]; then line+=" · <span class=\"bad\">$(esc "$t")</span>"; fi
        p="$(jget "$f" places)"
        if [[ "$p" == *,* ]]; then
          opts=""
          while IFS= read -r t; do
            if [[ "$t" == turing && -n "$hold" && "$(jget "$f" gpu)" == yes ]]; then
              x="waits: $hold holds the GPU"
              if [[ "$hold" == busy ]]; then x="waits for the GPU"; fi
              opts+="<option value=\"turing\">turing — $(esc "$x")</option>"
            else
              opts+="<option>$(esc "$t")</option>"
            fi
          done < <(tr , '\n' <<<"$p")
          # No hours= in the conf: the field may stay empty (data-opt), and the start has no limit, as from the CLI.
          t="$(jget "$f" hours)" x=" data-opt placeholder=\"no limit\""
          if [[ -n "$t" ]]; then x=" value=\"$(esc "$t")\""; fi
          b="<div class=\"jacts\" data-name=\"$e\"><span class=\"ask\"><label>Place<select name=\"place\">$opts</select></label><label>Hours<input name=\"hours\" type=\"number\" min=\"1\"$x></label><button data-act=\"ws-start\">Start</button></span></div>"
        else
          b="<span class=\"jacts p\" data-name=\"$e\"><button data-act=\"ws-start\">Start</button></span>"
        fi
        ;;
      up | "past limit")
        t="$(jstate "$st" started)" lim="$(jstate "$st" limit)" u="$(jstate "$st" url)"
        if [[ "$s" == "past limit" ]]; then
          lamp=bad line="Past its limit on $(esc "$p"): the next tick stops it"
        else
          lamp=ok line="Up on $(esc "$p")"
          if [[ "$t" =~ ^[0-9]+$ ]]; then line+=" · $(printf '%d:%02d' $(((now - t) / 3600)) $(((now - t) % 3600 / 60)))"; fi
          if [[ "$lim" =~ ^[0-9]+$ ]]; then
            t="$(span_text $((lim > now ? lim - now : 0))) left"
            if ((lim - now < 1800)); then t="<span class=\"warn\">$t</span>"; fi
            line+=" · $t"
          else
            line+=" · no limit"
          fi
        fi
        case "$u" in http://* | https://*) b="<a class=\"btn ui\" href=\"$(esc "$u")\" target=\"_blank\" rel=\"noopener\">Open UI ↗</a>" ;; esac
        b+="<span class=\"jacts p\" data-name=\"$e\"><button data-act=\"ws-stop\" data-confirm>Stop</button></span>"
        ;;
      "waits for the GPU" | starts)
        if [[ "$s" != starts ]]; then line="Waits for the GPU on $(esc "$p")"; fi
        if [[ "$s" != starts ]] || ws_stop_cuts "$st"; then b="<span class=\"jacts p\" data-name=\"$e\"><button data-act=\"ws-stop\" data-confirm>Stop</button></span>"; fi
        ;;
    esac
    rows+="<div class=\"wrow\" id=\"ws-$e\"><div class=\"t\"><span class=\"why\"><i class=\"lamp l-$lamp\"></i>$line</span><b>$(esc "$l")</b><span class=\"role\">$(esc "$(jget "$f" role)")</span><span class=\"meta\">$(esc "$meta")</span></div>$b$(ws_recipe "$n")</div>"
  done
  echo "$dot"
  printf '<section class="sec" aria-label="Services"><h2>Services <span>you start and stop them</span></h2><div class="cards">%s</div></section>\n' "${rows:-<p class=\"none\">No service under workspaces/.</p>}"
  if [[ -n "$runs" ]]; then printf '<section class="sec" aria-label="Tools that run as a job"><h2>Tools that run as a job <span>a session queues one</span></h2><div class="cards">%s</div></section>\n' "$runs"; fi
}

# gh_url — the https URL of this checkout's GitHub origin; empty for any other remote.
gh_url() {
  local u re='^https://github\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'
  u="$(git -C "$ROOT" remote get-url origin 2>/dev/null)" || return 0
  u="${u%.git}"
  case "$u" in
    git@github.com:*) u="https://github.com/${u#git@github.com:}" ;;
    ssh://git@github.com/*) u="https://github.com/${u#ssh://git@github.com/}" ;;
  esac
  if [[ "$u" =~ $re ]]; then echo "$u"; fi
}

# mkdir_lock NAME — take the NAME.lock directory; fails with a message after 3 min. Free it with rmdir NAME.lock.
mkdir_lock() {
  local tries=0
  # shortcut: a lock over 1 min old is a killed holder's; the waiter that gets NAME.reap removes it. A reaper killed
  # inside that step leaves NAME.reap and blocks the removal; a waiter fails after 3 min. flock is not on macOS.
  until mkdir "$1.lock" 2>/dev/null; do
    tries=$((tries + 1))
    if ((tries > 1800)); then
      echo "vibe: no lock on $1 after 3 min — remove $1.lock and $1.reap if no job runs, or check the directory is writable" >&2
      return 1
    fi
    if [[ -n "$(find "$1.lock" -prune -mmin +1 2>/dev/null)" ]] && mkdir "$1.reap" 2>/dev/null; then
      if [[ -n "$(find "$1.lock" -prune -mmin +1 2>/dev/null)" ]]; then rmdir "$1.lock" 2>/dev/null || true; fi
      rmdir "$1.reap" 2>/dev/null || true
    fi
    sleep 0.1
  done
}

# short_id JOB REPO — the job's id without <time>-<repo>-.
short_id() {
  local id="${1##*/}" re='^[0-9]{8}-[0-9]{6}-'
  if [[ "$id" =~ $re ]]; then
    id="${id#"${BASH_REMATCH[0]}"}"
    id="${id#"${2##*/}"-}"
  fi
  echo "$id"
}

# span_text SECONDS — `45s`, `12m`, `3h05m`.
span_text() {
  if (($1 < 60)); then
    echo "$1s"
  elif (($1 < 3600)); then
    echo "$(($1 / 60))m"
  else
    printf '%dh%02dm\n' $(($1 / 3600)) $(($1 % 3600 / 60))
  fi
}

# --- ws: outside research tools, one folder each under workspaces/ (docs/workspaces.md) ---

WS_ROOT="${VIBE_WORKSPACES:-$ROOT/workspaces}"
WS_STATES="$QROOT/workspaces"
WS_INST_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$' # docker's container-name rule

# ws_check DIR — "ok", or the first reason DIR/workspace.conf breaks the contract.
ws_check() {
  [[ -f "$1/workspace.conf" && -r "$1/workspace.conf" ]] || {
    echo "no readable workspace.conf"
    return 0
  }
  awk '
    function bad(m) { print m; done = 1; exit }
    function each(v, sep, re, what,  a, n, j) {
      n = split(v, a, sep)
      for (j = 1; j <= n; j++) if (a[j] !~ re) bad(what " " a[j])
    }
    /^[ \t]*(#|$)/ { next }
    {
      i = index($0, "=")
      if (i < 2) bad("not key=value: " $0)
      k = substr($0, 1, i - 1)
      v = substr($0, i + 1)
      if (k in seen) bad("twice: " k)
      seen[k] = v
      if (k == "kind") { if (v != "service" && v != "run") bad("kind=" v ": service or run") }
      else if (k == "runs") { if (v != "container" && v != "host") bad("runs=" v ": container or host") }
      else if (k == "gpu") { if (v != "yes" && v != "no") bad("gpu=" v ": yes or no") }
      else if (k == "places") each(v, ",", "^(turing|runpod|vast)$", "unknown place")
      else if (k == "hours") { if (v !~ /^[1-9][0-9]*$/) bad("hours=" v ": a whole number above 0") }
      else if (k == "commit") { if (length(v) != 40 || v ~ /[^0-9a-f]/) bad("commit=" v ": 40 hex") }
      else if (k == "secrets") each(v, " ", "^[A-Z_][A-Z0-9_]*$", "bad env name")
      else if (k == "ports") each(v, ",", "^[0-9]+$", "bad port")
      else if (k == "result") { if (v != "branch" && v != "folder") bad("result=" v ": branch or folder") }
      else if (k != "label" && k != "role" && k != "image") bad("unknown key " k)
    }
    END {
      if (done) exit
      if (seen["kind"] == "") bad("no kind")
      if (seen["places"] == "") bad("no places")
      if (seen["kind"] == "service" && "result" in seen) bad("result on a service")
      if (seen["kind"] == "run" && seen["result"] == "") bad("kind=run needs result")
      print "ok"
    }' "$1/workspace.conf"
}

# vibe ws list — one line per workspace (a directory not named _*): name, kind, gpu, places,
# label: role; a bad conf prints why, exit 1.
cmd_ws_list() {
  local d n c f l g bad=0
  (($# == 0)) || die "usage: vibe ws list"
  [[ -d "$WS_ROOT" ]] || die "no folder $WS_ROOT"
  for d in "$WS_ROOT"/*/; do
    n="${d%/}" n="${n##*/}"
    if [[ ! -d "$d" || "$n" == _* ]]; then continue; fi
    c="$(ws_check "$WS_ROOT/$n")"
    [[ "$(slug "$n")" == "$n" ]] || c="bad name: lower case, digits, . _ -"
    if [[ "$c" != ok ]]; then
      printf '%-16s bad conf: %s\n' "$n" "$c"
      bad=1
      continue
    fi
    f="$WS_ROOT/$n/workspace.conf"
    l="$(jget "$f" label)" g="$(jget "$f" gpu)"
    printf '%-16s %-7s gpu=%-3s %-18s %s\n' "$n" "$(jget "$f" kind)" "${g:-no}" "$(jget "$f" places)" "${l:+$l: }$(jget "$f" role)"
  done
  return "$bad"
}

# ws_holder INSTANCE-DIR — the pid of its live `gpu-queue lock` holder; fails when none.
# After a reboot the pid can name another process: its command must end in `ws hold <instance>`.
ws_holder() {
  local p
  p="$(jstate "$1" holder)"
  [[ "$p" =~ ^[1-9][0-9]*$ && "$(ps -o command= -p "$p" 2>/dev/null || true)" == *" ws hold ${1##*/}" ]] && echo "$p"
}

# ws_gpu INSTANCE-DIR — true when its place is turing and its tool has gpu=yes: it runs under the GPU lock.
ws_gpu() {
  local n
  n="$(ws_name "${1##*/}")" || return 1
  [[ "$(jstate "$1" place)" == turing && "$(jget "$WS_ROOT/$n/workspace.conf" gpu)" == yes ]]
}

# ws_stopper INSTANCE-DIR — the pid of its live page stop (`vibe ws down`); fails when none. Same pid check as ws_holder.
ws_stopper() {
  local p
  p="$(jstate "$1" stops)"
  [[ "$p" =~ ^[1-9][0-9]*$ && "$(ps -o command= -p "$p" 2>/dev/null || true)" == *" ws down ${1##*/}" ]] && echo "$p"
}

# ws_state INSTANCE-DIR — waits for the GPU, starts while its holder runs ws_up, stops while a page stop runs,
# down with no id file, past limit when limit has passed, else up.
ws_state() {
  local lim
  lim="$(jstate "$1" limit)"
  if [[ -e "$1/waits" ]] && ws_holder "$1" >/dev/null; then
    echo "waits for the GPU"
  elif [[ -e "$1/starts" ]] && ws_holder "$1" >/dev/null; then
    echo starts
  elif ws_stopper "$1" >/dev/null; then
    echo stops
  elif [[ ! -s "$1/id" ]]; then
    echo down
  elif [[ "$lim" =~ ^[0-9]+$ ]] && ((lim <= $(date +%s))); then
    echo "past limit"
  else
    echo up
  fi
}

# ws_inst INSTANCE — dies unless INSTANCE names a state dir; docker's container-name rule, a job id can hold upper case.
ws_inst() {
  [[ "$1" =~ $WS_INST_RE && -d "$WS_STATES/$1" ]] || die "no instance '$1' — vibe ws status"
}

# ws_line INSTANCE-DIR — instance, state, place, then limit and address, tab-separated; state files only.
ws_line() {
  local s lim more=""
  s="$(ws_state "$1")"
  if [[ "$s" != down ]]; then
    lim="$(jstate "$1" limit)"
    more="${lim:+until $(at_time "$lim") }$(jstate "$1" url)"
  elif [[ -s "$1/hold.log" ]] && ! ws_holder "$1" >/dev/null; then
    # A gpu=yes start that failed after `ws start` returned: its holder's last line is the reason.
    more="$(tail -n 1 "$1/hold.log")"
    if [[ "$more" == "vibe: holds the GPU" ]]; then more=""; fi
  fi
  printf '%s\t%s\t%s\t%s\n' "${1##*/}" "$s" "$(jstate "$1" place)" "$more"
}

# ws_lines — ws_line of each instance.
ws_lines() {
  local d
  for d in "$WS_STATES"/*/; do
    if [[ -d "$d" ]]; then ws_line "${d%/}"; fi
  done
}

# vibe ws status [INSTANCE] — one line per instance: state, place, limit, address; state files only.
cmd_ws_status() {
  (($# <= 1)) || die "usage: vibe ws status [<instance>]"
  if (($#)); then
    ws_inst "$1"
    ws_line "$WS_STATES/$1"
  else
    ws_lines
  fi | awk -F'\t' '{ l = sprintf("%-24s %-10s %-7s %s", $1, $2, $3, $4); sub(/ +$/, "", l); print l }'
}

# ws_dir NAME — the folder of workspace NAME; dies on no such workspace or a conf that breaks the contract.
ws_dir() {
  local c
  [[ -n "$1" && "$1" != [._]* && "$(slug "$1")" == "$1" && -d "$WS_ROOT/$1" ]] || die "no workspace '$1' — vibe ws list"
  c="$(ws_check "$WS_ROOT/$1")"
  [[ "$c" == ok ]] || die "$1: bad conf: $c"
  echo "$WS_ROOT/$1"
}

# ws_name INSTANCE — its workspace: INSTANCE is <name> or <name>-<job id>; the longest name wins.
ws_name() {
  local n="$1"
  until [[ "$n" != _* && -d "$WS_ROOT/$n" ]]; do
    [[ "$n" == *-* ]] || return 1
    n="${n%-*}"
  done
  echo "$n"
}

# ws_place INSTANCE VERB [ARG...] — the place script of INSTANCE with WS_* and WS_CONF_<KEY> set (docs/workspaces.md).
# The folder: the instance's dir file (a research run), else its workspace under WS_ROOT.
# WS_NAME: the instance's name file (a research run's env file name), else empty: the place takes the folder name.
# A subshell with errexit off when tested: each lookup has its own `|| die`.
ws_place() {
  local inst="$1"
  shift
  (
    w="$(jstate "$WS_STATES/$inst" dir)"
    if [[ -z "$w" ]]; then
      n="$(ws_name "$inst")" || die "no workspace for instance $inst"
      w="$WS_ROOT/$n"
    fi
    p="$(jstate "$WS_STATES/$inst" place)" nm="$(jstate "$WS_STATES/$inst" name)"
    [[ -n "$p" && "$(slug "$p")" == "$p" && -f "$WS_ROOT/_places/$p" && -x "$WS_ROOT/_places/$p" ]] ||
      die "no place script '$p' for $inst"
    while IFS= read -r l; do export "WS_CONF_$l"; done < <(
      awk '/^[a-z]+=/ { i = index($0, "="); print toupper(substr($0, 1, i - 1)) substr($0, i) }' "$w/workspace.conf"
    )
    # A WS_HOURS the caller set (a tool job's hours=) wins over the conf's.
    export WS_INSTANCE="$inst" WS_STATE="$WS_STATES/$inst" WS_DIR="$w" WS_NAME="$nm" WS_HOURS="${WS_HOURS:-${WS_CONF_HOURS:-}}"
    # WS_SECS set: timeout(1) ends the call after WS_SECS, exit 124; no timeout(1) means no bound.
    if [[ -n "${WS_SECS:-}" ]] && t="$(command -v timeout || command -v gtimeout)"; then
      exec "$t" -k 10 "$WS_SECS" "$WS_ROOT/_places/$p" "$@"
    fi
    exec "$WS_ROOT/_places/$p" "$@"
  )
}

# ws_secrets NAME CONF — dies unless ~/.config/vibe/workspaces/NAME.env is mode 600 and sets each of CONF's secrets.
ws_secrets() {
  local f="$HOME/.config/vibe/workspaces/$1.env" s k miss=""
  s="$(jget "$2" secrets)"
  [[ -n "$s" ]] || return 0
  [[ -f "$f" ]] || die "$1 needs $s: write KEY=VALUE lines to $f, mode 600"
  case "$(ls -lL "$f")" in
    -rw-------* | -r--------*) ;;
    *) die "$f: others can read it — chmod 600 $f" ;;
  esac
  for k in $s; do
    [[ -n "$(jget "$f" "$k")" ]] || miss+=" $k"
  done
  [[ -z "$miss" ]] || die "$f does not set:$miss"
}

# ws_up INSTANCE — place up, the start script (120 s at most, VIBE_WS_START_SECS), the url;
# a failed start brings the place down again.
ws_up() {
  local st="$WS_STATES/$1" url="" secs="${VIBE_WS_START_SECS:-120}" r=0
  ws_place "$1" up || die "up of $1 failed"
  # A page or GPU start: `starts` holds `script` from here on, and stop waits for up (ws_stop_cuts).
  if [[ -e "$st/starts" ]]; then echo script >"$st/starts"; fi
  WS_SECS="$secs" ws_place "$1" exec start || r=$?
  if ((r)); then
    ws_place "$1" down >&2 || true
    if ((r == 124)); then die "start of $1 ran past $secs s — it is down again"; fi
    die "start of $1 failed — it is down again"
  fi
  if [[ -n "$(jget "$WS_ROOT/$(ws_name "$1")/workspace.conf" ports)" ]]; then
    url="$(ws_place "$1" url)" || warn "no address for $1"
    if [[ -n "$url" ]]; then echo "$url" >"$st/url"; fi
  fi
  ws_up_line "$1"
}

ws_up_line() {
  local u
  u="$(jstate "$WS_STATES/$1" url)"
  echo "$1 up${u:+ — $u}"
}

# vibe ws build NAME — docker build NAME's image at its pinned commit, tagged with it.
cmd_ws_build() {
  local d f
  (($# == 1)) || die "usage: vibe ws build <name>"
  d="$(ws_dir "$1")"
  f="$d/workspace.conf"
  [[ "$(jget "$f" runs)" != host ]] || die "$1 runs on the host: no image to build"
  [[ -n "$(jget "$f" image)" && -n "$(jget "$f" commit)" ]] || die "$1: workspace.conf needs image and commit"
  docker build -t "$(jget "$f" image):$(jget "$f" commit)" --build-arg "COMMIT=$(jget "$f" commit)" "$d"
}

# vibe ws start NAME [--place P] [--hours N] — a kind=service tool up at P (the first of its places) for N hours
# (its hours=). gpu=yes on turing, or a start from the page (VIBE_WEB: a rented place takes minutes): a detached
# `vibe ws hold` starts it, under `gpu-queue lock` for the GPU, and keeps the lock until stop.
cmd_ws_start() {
  local d f st n="${1:-}" place="" hours="" pid i u="usage: vibe ws start <name> [--place P] [--hours N]"
  local -a lock=()
  (($#)) || die "$u"
  shift
  while (($#)); do
    case "$1" in --place=* | --hours=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    (($# >= 2)) || die "$u"
    case "$1" in
      --place) place="$2" ;;
      --hours) hours="$2" ;;
      *) die "$u" ;;
    esac
    shift 2
  done
  d="$(ws_dir "$n")"
  f="$d/workspace.conf" st="$WS_STATES/$n"
  [[ "$(jget "$f" kind)" == service ]] || die "$n is kind=run: the queue runs it as a job"
  ws_secrets "$n" "$f"
  [[ "$(ws_state "$st")" == down ]] || die "$n is $(ws_state "$st") — vibe ws stop $n first"
  if [[ -z "$place" ]]; then place="$(jget "$f" places)" place="${place%%,*}"; fi
  [[ "$place" =~ ^[a-z]+$ && ",$(jget "$f" places)," == *",$place,"* ]] || die "$n has no place '$place' — places=$(jget "$f" places)"
  [[ -z "$hours" || "$hours" =~ ^[1-9][0-9]*$ ]] || die "--hours $hours: a whole number above 0"
  [[ -x "$WS_ROOT/_places/$place" ]] || die "no place script '$place' in $WS_ROOT/_places"
  mkdir -p "$st"
  echo "$place" >"$st/place"
  rm -f "$st/waits" "$st/starts" "$st/holder" "$st/url" "$st/hold.log"
  # WS_HOURS: ws_place hands it to the place's up, here or in the detached hold; empty: the conf's hours.
  if ws_gpu "$st"; then
    lock=("$GPUQ" lock --)
    : >"$st/waits"
  elif [[ -z "${VIBE_WEB:-}" ]]; then
    WS_HOURS="$hours" ws_up "$n"
    return 0
  fi
  set -m
  WS_HOURS="$hours" nohup ${lock[@]+"${lock[@]}"} "$VIBE_BIN" ws hold "$n" </dev/null >"$st/hold.log" 2>&1 &
  pid=$!
  set +m
  echo "$pid" >"$st/holder"
  for ((i = 0; ; i++)); do
    if grep -qxF "vibe: holds the GPU" "$st/hold.log"; then
      ws_up_line "$n"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      if wait "$pid"; then
        ws_up_line "$n"
        return 0
      fi
      cat "$st/hold.log" >&2
      die "start of $n failed — $st/hold.log"
    fi
    # The CLI waits for up, as a script uses the url next; the page and a wait for the lock return.
    if ((i >= 15)) && [[ -e "$st/waits" || -n "${VIBE_WEB:-}" ]]; then
      if [[ -e "$st/waits" ]]; then echo "$n waits for the GPU — vibe ws status $n"; else echo "$n starts — vibe ws status $n"; fi
      return 0
    fi
    sleep 0.2
  done
}

# vibe ws hold INSTANCE — start's detached command: the instance up; under the GPU lock, then wait until its id file goes.
cmd_ws_hold() {
  local st
  (($# == 1)) || die "usage: vibe ws hold <instance>"
  ws_inst "$1"
  st="$WS_STATES/$1"
  rm -f "$st/waits"
  : >"$st/starts"
  ws_up "$1"
  rm -f "$st/starts"
  if ws_gpu "$st"; then
    echo "vibe: holds the GPU"
    while [[ -s "$st/id" ]]; do sleep "${VIBE_WS_POLL:-10}"; done
  fi
}

# vibe ws run INSTANCE — a tool job's run (tool_run): up, the run script, down; exit: the run script's.
cmd_ws_run() {
  local r=0
  (($# == 1)) || die "usage: vibe ws run <instance>"
  ws_inst "$1"
  ws_place "$1" up || die "up of $1 failed"
  ws_place "$1" exec run || r=$?
  ws_place "$1" down || warn "down of $1 failed — vibe ws status $1"
  return "$r"
}

# ws_stop_cuts INSTANCE-DIR — true while a detached start runs the place's up: before ws_up marks `starts` with `script`.
ws_stop_cuts() { [[ -e "$1/starts" && "$(jstate "$1" starts)" != script ]]; }

# vibe ws stop INSTANCE — its stop script, then place down; a GPU holder ends then, and the lock is free.
# From the page (VIBE_WEB) a detached `vibe ws down` does it: vibe-web kills a command after 120 s.
cmd_ws_stop() {
  local st pid s i
  (($# == 1)) || die "usage: vibe ws stop <instance>"
  ws_inst "$1"
  st="$WS_STATES/$1"
  pid="$(ws_holder "$st")" || pid=""
  if [[ -e "$st/waits" && -n "$pid" ]]; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    rm -f "$st/waits" "$st/holder" "$st/hold.log"
    echo "$1 stopped — it waited for the GPU"
    return 0
  fi
  if [[ -n "$pid" ]] && ws_stop_cuts "$st"; then
    # Each place's up traps TERM and removes what it made; wait for that, 60 s at most.
    kill -TERM -- "-$pid" 2>/dev/null || true
    for ((i = 0; i < 300; i++)); do
      kill -0 -- "-$pid" 2>/dev/null || break
      sleep 0.2
    done
    rm -f "$st/starts" "$st/holder" "$st/hold.log"
    echo "$1 stopped — its place was not up yet"
    return 0
  fi
  s="$(ws_state "$st")"
  # A down beside a running start script races it: stop once it is up.
  [[ "$s" != starts ]] || die "$1 starts — stop it once it is up: vibe ws status $1"
  [[ "$s" != stops ]] || die "$1 stops already — vibe ws status $1"
  rm -f "$st/waits"
  [[ -s "$st/id" ]] || die "$1 is down"
  if [[ -n "${VIBE_WEB:-}" ]]; then
    set -m
    nohup "$VIBE_BIN" ws down "$1" </dev/null >"$st/stop.log" 2>&1 &
    echo "$!" >"$st/stops"
    set +m
    echo "$1 stops — vibe ws status $1"
    return 0
  fi
  ws_down "$1" || die "down of $1 failed — vibe ws status $1"
  echo "$1 down"
}

# vibe ws down INSTANCE — a page stop's detached command: ws_down, then the stops file goes.
# shortcut: a failed one shows only in stop.log, and the page offers Stop again; show its reason when one fails.
cmd_ws_down() {
  local r=0
  (($# == 1)) || die "usage: vibe ws down <instance>"
  ws_inst "$1"
  ws_down "$1" || r=$?
  rm -f "$WS_STATES/$1/stops"
  ((r == 0)) || die "down of $1 failed — vibe ws status $1"
  rm -f "$WS_STATES/$1/stop.log"
  echo "$1 down"
}

# ws_down INSTANCE — its stop script (300 s at most, VIBE_WS_STOP_SECS), then place down;
# then a GPU holder ends and the lock is free. down has no bound: a cut pull loses data.
ws_down() {
  local st="$WS_STATES/$1" pid secs="${VIBE_WS_STOP_SECS:-300}" r=0 rc=0
  pid="$(ws_holder "$st")" || pid=""
  if [[ -z "$pid" ]]; then rm -f "$st/holder"; fi
  WS_SECS="$secs" ws_place "$1" exec stop || r=$?
  if ((r == 124)); then
    warn "the stop script of $1 ran past $secs s — down anyway"
  elif ((r != 0 && r != 3)); then
    warn "the stop script of $1 failed (exit $r) — down anyway"
  fi
  ws_place "$1" down || rc=1
  # The lock follows the id file: a container down failed to remove keeps it.
  if [[ -n "$pid" && ! -s "$st/id" ]]; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    rm -f "$st/holder"
  fi
  rm -f "$st/hold.log"
  return "$rc"
}

# vibe ws tick — for each instance with an id: past its limit the stop script and down, else the place's tick,
# 600 s at most (VIBE_WS_TICK_SECS): one hung pull must not keep the next instance from its limit.
cmd_ws_tick() {
  local d i secs="${VIBE_WS_TICK_SECS:-600}"
  for d in "$WS_STATES"/*/; do
    d="${d%/}" i="${d##*/}"
    if [[ ! -s "$d/id" ]] || ws_stopper "$d" >/dev/null; then
      continue # down, or its page stop runs ws_down
    elif [[ -s "$d/owner" ]] && run_alive "$(jstate "$d" owner)"; then
      continue # its place run stops, pulls and downs it
    elif [[ "$(ws_state "$d")" == "past limit" ]]; then
      ws_down "$i" || warn "down of $i past its limit failed"
    else
      WS_SECS="$secs" ws_place "$i" tick || warn "tick of $i failed or ran past $secs s"
    fi
  done
}

# ws_tick_bg — the runner pass: `vibe ws tick` in the background, never two at once.
ws_tick_bg() {
  local p
  p="$(jstate "$WS_STATES" tick.pid)"
  # The command, not only a live pid: tick.pid outlives a reboot, and its pid then names another process.
  if [[ "$p" =~ ^[1-9][0-9]*$ && "$(ps -o command= -p "$p" 2>/dev/null || true)" == *" ws tick" ]]; then return 0; fi
  if ! compgen -G "$WS_STATES/*/id" >/dev/null; then return 0; fi
  "$VIBE_BIN" ws tick </dev/null >>"$WS_STATES/tick.log" 2>&1 &
  echo "$!" >"$WS_STATES/tick.pid"
}

# vibe ws box JOB — the instance dir of JOB's place run; vibe's research card reads its log, start, price and limit.
cmd_ws_box() {
  (($# == 1)) || die "usage: vibe ws box <job>"
  echo "$WS_STATES/research-${1##*/}"
}

cmd_ws() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    list | status | build | start | stop | tick | hold | down | run | box) "cmd_ws_$sub" "$@" ;;
    *) die "usage: vibe ws list|status|build|start|stop|tick — see vibe --help" ;;
  esac
}

# vibe queue gpu --place P -- CMD... — from inside a job: ask for a run at P (runpod, vast) in $VIBE_JOB_DIR/run/
# (place_queue); turing or an empty P: vibe's own `queue gpu`. Past the job's deadline= it asks for nothing.
cmd_gpu_place() {
  local d="${VIBE_JOB_DIR:-}" p u="usage: vibe queue gpu [--place P] -- CMD..."
  case "${1:-}" in --place=*) set -- --place "${1#*=}" "${@:2}" ;; esac
  (($# >= 2)) || die "$u"
  p="$2"
  shift 2
  if [[ -z "$p" || "$p" == turing ]]; then exec "$VIBE_BIN" queue gpu "$@"; fi
  [[ -n "$d" && -f "$d/job" ]] || die "vibe queue gpu runs inside a queue job (VIBE_JOB_DIR)"
  case "${1:-}" in
    -h | --help) exec "$VIBE_BIN" --help ;;
    --) shift ;;
    -*) die "$u" ;;
  esac
  (($#)) || die "$u"
  deadline_gate "$d" "queue no run"
  [[ "$(jstate "$d" drain)" != now ]] || die "research stopped (vibe queue stop --research --now): queue no run, finish the task"
  place_queue "$d" "$p" "$@"
}

# --- events (docs/vibe-extensions.md, Events) ---

# ev_pass — `vibe ws tick` in the background; per job: the GPU slot of a tool= job, the place run pass.
ev_pass() {
  local d
  ws_tick_bg
  for d in "$QDIR"/*/; do
    d="${d%/}"
    if [[ ! -f "$d/job" ]]; then continue; fi
    # A tool= job on turing with gpu=yes holds the one GPU slot until its run ends: tool_run drops the file.
    if [[ -n "$(jget "$d/job" tool)" ]]; then
      if tool_gpu "$d"; then
        [[ "$(jstate "$d" slot)" == gpu ]] || echo gpu | fresh "$d/slot" || warn "$d: slot not written"
      else
        rm -f "$d/slot"
      fi
    fi
    place_pass "$d" || warn "$d: place run pass failed"
  done
}

# ev_prepare JOB — a tool= job, not a review round: `end failed <why>` when its tool cannot run (tool_check);
# a folder result makes a report job.
ev_prepare() {
  local d="$1" c
  if [[ -z "$(jget "$d/job" tool)" || -n "$(jget "$d/job" review)" ]]; then return 0; fi
  c="$(tool_check "$d")"
  if [[ -n "$c" ]]; then
    echo "end failed $c"
  elif [[ "$(tool_conf "$d" result)" == folder && -z "$(jget "$d/job" output)" ]]; then
    echo output=report >>"$d/job"
  fi
}

# ev_start JOB — a tool= job: the run and its checks (tool_job), the agent copies of in, out, tool.log and tool-exit,
# then `prompt JOB/close.md`: the closing session runs on it.
ev_start() {
  local d="$1" x
  [[ -n "$(jget "$d/job" tool)" ]] || return 0
  tool_job "$d" || return 0
  mkdir -p "$d/agent"
  for x in in out tool.log tool-exit; do
    rm -rf "${d:?}/agent/$x"
    if [[ -e "$d/$x" ]]; then cp -R "$d/$x" "$d/agent/$x"; fi
  done
  echo "prompt $d/close.md"
}

# ev_steer JOB TEXT — a tool= job: TEXT to the steer script of its running tool, then `steered <instance>`; exit 3: not supported.
ev_steer() {
  local d="$1" inst r=0
  [[ -n "$(jget "$d/job" tool)" ]] || return 0
  inst="$(tool_inst "$d")"
  [[ "$(jstate "$d" status)" == running && -s "$WS_STATES/$inst/id" ]] || die "the tool of ${d##*/} does not run now"
  WS_HOURS="$(tool_hours "$d")" ws_place "$inst" exec steer "$2" >&2 || r=$?
  if ((r == 3)); then
    echo "vibe: $(jget "$d/job" tool): steer not supported" >&2
    exit 3
  fi
  ((r == 0)) || die "steer of $inst failed (exit $r)"
  echo "steered $inst"
}

# ev_holder — while the GPU lock is held: the label of a service whose holder holds it, else `<label> · <job>` of a
# running tool job on turing with gpu=yes; else nothing.
ev_holder() {
  local d id l
  for d in "$WS_STATES"/*/; do
    d="${d%/}"
    if [[ -d "$d" && ! -e "$d/waits" ]] && ws_holder "$d" >/dev/null && ws_gpu "$d"; then
      id="$(ws_name "${d##*/}")"
      l="$(jget "$WS_ROOT/$id/workspace.conf" label)"
      echo "${l:-$id}"
      return 0
    fi
  done
  for d in "$QDIR"/*/; do
    d="${d%/}"
    if [[ "$(jstate "$d" status)" == running ]] && tool_gpu "$d"; then
      l="$(tool_conf "$d" label)"
      echo "${l:-$(jget "$d/job" tool)} · $(short_id "$d" "$(jget "$d/job" repo)")"
      return 0
    fi
  done
}

# ev_card [HOLDER] — the page: `dot` while a tool runs, `tab<TAB><html>` lines of the Workspaces tab (ws_page);
# per tool= job `chip<TAB><id><TAB><tool> · <place>`, and while its tool runs a steer field: `button<TAB><id><TAB><html>`.
ev_card() {
  local w d id l
  GH="$(gh_url)"
  w="$(ws_page "${1:-}")"
  if [[ -n "${w%%$'\n'*}" ]]; then echo dot; fi
  printf '%s\n' "${w#*$'\n'}" | sed 's/^/tab	/'
  for d in "$QDIR"/*/; do
    d="${d%/}" id="${d##*/}"
    if [[ ! -f "$d/job" || -z "$(jget "$d/job" tool)" ]]; then continue; fi
    printf 'chip\t%s\t%s\n' "$id" "$(jget "$d/job" tool) · $(tool_place "$d")"
    if tool_up "$d" && tool_steers "$d"; then
      l="$(tool_conf "$d" label)" l="Message to ${l:-$(jget "$d/job" tool)}: it reads the text at its next step"
      printf 'button\t%s\t<span class="ask"><label>%s<textarea name="text" rows="3"></textarea></label><button data-act="steer">Send</button></span>\n' "$id" "$(esc "$l")"
    fi
  done
}

# One group ending in exit: bash reads no more of this file after a long command (a tool run, ws hold), so an
# edit in place mid-run cannot run a stale fragment.
{
  case "${1:-}" in
    describe)
      printf '%s\n' "command ws" "command queue gpu --place" "readonly ws list" "readonly ws status"
      # The `vibe --help` lines of the ws commands.
      sed -n 's/^# /help /p' <<'HELP'
#   vibe ws list                    the tools under workspaces/: name, kind, gpu, places, label: role;
#                                   a bad workspace.conf prints why, exit 1
#   vibe ws status [<instance>]     each tool instance: up, past limit, starts, waits for the GPU or down, from its state files
#   vibe ws build <name>            docker build the tool's image at its pinned commit, tagged with it
#   vibe ws start <name> [--place P] [--hours N]
#                                   a kind=service tool up at P (the first of its places) for N hours (its hours),
#                                   then its start script; gpu=yes on turing: under the gpu-queue lock, held until stop
#   vibe ws stop <instance>         its stop script, then down: data copied back, container gone, GPU lock free
#   vibe ws tick                    each instance: pull every 10 min, down past its limit (the runner, each pass)
HELP
      ;;
    cmd)
      shift
      case "${1:-} ${2:-}" in
        "queue gpu") cmd_gpu_place "${@:3}" ;;
        ws\ *) cmd_ws "${@:2}" ;;
        *) die "research: no command '$*'" ;;
      esac
      ;;
    event)
      shift
      case "${1:-}" in
        pass | prepare | start | steer | holder | card) "ev_$1" "${@:2}" ;;
        *) ;; # an event it does not hear: no output, exit 0
      esac
      ;;
    *)
      echo "research: unknown call '${1:-}' — describe, cmd or event (docs/vibe-extensions.md)" >&2
      exit 2
      ;;
  esac
  exit
}
