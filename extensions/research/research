# --- events (docs/vibe-extensions.md, Events) ---

# ev_pass — `vibe ws tick` in the background; per job: the GPU slot of a tool= job, the place run pass; then each
# worker end wakes its coordinator (fan_in).
ev_pass() {
  local d
  ws_tick_bg
  for d in "$QDIR"/*/; do
    d="${d%/}"
    if [[ ! -f "$d/job" ]]; then continue; fi
    # A tool= job on turing with gpu=yes holds the one GPU slot until its run ends: tool_run drops the file.
    if [[ -n "$(jget "$d/job" tool)" ]]; then
      if tool_gpu "$d"; then
        [[ "$(jstate "$d" slot)" == gpu ]] || echo gpu | fresh "$d/slot" || warn "$d: slot not written"
      else
        rm -f "$d/slot"
      fi
    fi
    place_pass "$d" || warn "$d: place run pass failed"
  done
  for d in "$QDIR"/*/; do
    # shortcut: a worker queued before publish=push gets it before its end, so it opens no PR; drop once none is left.
    if [[ -f "${d}job" && -n "$(jget "${d}job" hid)" && -z "$(jget "${d}job" publish)" ]]; then
      echo publish=push >>"${d}job" || warn "${d%/}: publish=push not written"
    fi
    # shortcut: a research job queued before card= sits in the card from the next pass; drop once none is left.
    if [[ -f "${d}job" && -n "$(jget "${d}job" research)" && -z "$(jget "${d}job" card)" ]]; then
      echo card=research >>"${d}job" || warn "${d%/}: card=research not written"
    fi
    fan_in "${d%/}" || warn "${d%/}: worker wake failed"
  done
}

# ev_add JOB — a research= job gets card=research; a coordinator (research=, no hid=) gets the block of fill-queue's
# references/research.md once; a follow-up (follow=1) carries its parent's prompt.
ev_add() {
  local d="$1"
  if [[ -n "$(jget "$d/job" research)" && -z "$(jget "$d/job" card)" ]]; then echo card=research >>"$d/job"; fi
  if coordinator "$d" && [[ -z "$(jget "$d/job" follow)" ]] && ! grep -qx '## Research job' "$d/prompt.md" 2>/dev/null; then
    {
      echo
      cat "$ROOT/skills/fill-queue/references/research.md"
    } >>"$d/prompt.md"
  fi
}

# ev_end JOB — after a session that ended `queued:`: the asks for workers (workers_take), then `run` for a place run
# taken (place_take), else `wait` for a coordinator: it waits for its workers with no run of its own.
ev_end() {
  local d="$1"
  if ! workers_take "$d"; then
    echo "end failed each worker this session asked for was refused — $(tail -n 1 "$d/workers.log")"
  elif place_take "$d"; then
    echo run
  elif coordinator "$d"; then
    echo wait
  fi
}

# ev_answer JOB TEXT — a slurm worker (slurm_waits): TEXT is its run's output, slurm.log; its RESULT line the run-result;
# session 2 closes the run (vibe queue follow). Then `handled <message>`.
ev_answer() {
  local d="$1"
  slurm_waits "$d" || return 0
  printf '%s\n' "$2" | fresh "$d/slurm.log" || die "${d##*/}/slurm.log not written"
  run_result "$d/slurm.log" "$d"
  # A typo must not lose the run: no RESULT line is a failed run, a bad one is refused.
  if [[ ! -s "$d/run-result" ]] && grep -q '^RESULT {' "$d/slurm.log"; then die 'bad RESULT line — RESULT {"metric": <a finite number>}'; fi
  GPUQ_EXIT=slurm GPUQ_LOG="$d/slurm.log" "$VIBE_BIN" queue follow "$d" >&2
  echo "handled queued session 2 of ${d##*/} — result: $(cat "$d/run-result" 2>/dev/null || echo none)"
}

# ev_follow FROM TO KIND — a follow-up TO of FROM keeps FROM's research stop (drain). answer: a tool run with a result
# closes again (tool_job), no new run: out/, tool-exit, tool.log and close.md go along. fix, review, gpu: no tool=, no tool
# run. gpu (GPUQ_EXIT, GPUQ_LOG): FROM/run-result from the log's RESULT line, cost 0 for a research job with none,
# and `result <text>` for the Result line of the follow-up's prompt.
ev_follow() {
  local from="$1" to="$2" r=""
  drain_copy "$from" "$to"
  case "${3:-}" in
    answer)
      if [[ -s "$from/out/result" ]]; then cp -R "$from/out" "$from/tool-exit" "$from/tool.log" "$to/"; fi
      if [[ -f "$from/close.md" ]]; then cp "$from/close.md" "$to/"; fi
      ;;
    fix | review | gpu)
      if grep -q '^tool=' "$to/job"; then
        grep -v '^tool=' "$to/job" >"$to/job.tmp.$$" || true
        mv -f "$to/job.tmp.$$" "$to/job"
      fi
      ;;
  esac
  [[ "${3:-}" == gpu ]] || return 0
  run_result "${GPUQ_LOG:-}" "$from"
  if [[ -s "$from/run-result" ]]; then
    r="$(cat "$from/run-result") ($from/run-result)"
  elif [[ "${GPUQ_EXIT:-}" =~ ^(usd|stopped)$ ]]; then
    r="none — $(tail -n 1 "$GPUQ_LOG")"
  elif [[ -n "$(jget "$from/job" research)" || -d "$from/run" ]]; then
    r="none — no RESULT line: the run failed"
  fi
  # turing and a run that never started cost 0 USD.
  if [[ -n "$(jget "$from/job" research)" && ! -s "$from/cost" ]]; then echo 0 | fresh "$from/cost" || true; fi
  if [[ -n "$r" ]]; then echo "result $r"; fi
}

# ev_prepare JOB — a tool= job, not a review round: `end failed <why>` when its tool cannot run (tool_check);
# a folder result makes a report job.
ev_prepare() {
  local d="$1" c
  if [[ -z "$(jget "$d/job" tool)" || -n "$(jget "$d/job" review)" ]]; then return 0; fi
  c="$(tool_check "$d")"
  if [[ -n "$c" ]]; then
    echo "end failed $c"
  elif [[ "$(tool_conf "$d" result)" == folder && -z "$(jget "$d/job" output)" ]]; then
    echo output=report >>"$d/job"
  fi
}

# ev_start JOB — a tool= job: the run and its checks (tool_job), the agent copies of in, out, tool.log and tool-exit,
# then `prompt JOB/close.md`: the closing session runs on it.
ev_start() {
  local d="$1" x
  [[ -n "$(jget "$d/job" tool)" ]] || return 0
  tool_job "$d" || return 0
  mkdir -p "$d/agent"
  for x in in out tool.log tool-exit; do
    rm -rf "${d:?}/agent/$x"
    if [[ -e "$d/$x" ]]; then cp -R "$d/$x" "$d/agent/$x"; fi
  done
  echo "prompt $d/close.md"
}

# ev_steer JOB TEXT — a tool= job: TEXT to the steer script of its running tool, then `steered <instance>`; exit 3: not supported.
ev_steer() {
  local d="$1" inst r=0
  [[ -n "$(jget "$d/job" tool)" ]] || return 0
  inst="$(tool_inst "$d")"
  [[ "$(jstate "$d" status)" == running && -s "$WS_STATES/$inst/id" ]] || die "the tool of ${d##*/} does not run now"
  WS_HOURS="$(tool_hours "$d")" ws_place "$inst" exec steer "$2" >&2 || r=$?
  if ((r == 3)); then
    echo "vibe: $(jget "$d/job" tool): steer not supported" >&2
    exit 3
  fi
  ((r == 0)) || die "steer of $inst failed (exit $r)"
  echo "steered $inst"
}

# ev_holder — while the GPU lock is held: the label of a service whose holder holds it, else `<label> · <job>` of a
# running tool job on turing with gpu=yes; else nothing.
ev_holder() {
  local d id l
  for d in "$WS_STATES"/*/; do
    d="${d%/}"
    if [[ -d "$d" && ! -e "$d/waits" ]] && ws_holder "$d" >/dev/null && ws_gpu "$d"; then
      id="$(ws_name "${d##*/}")"
      l="$(jget "$WS_ROOT/$id/workspace.conf" label)"
      echo "${l:-$id}"
      return 0
    fi
  done
  for d in "$QDIR"/*/; do
    d="${d%/}"
    if [[ "$(jstate "$d" status)" == running ]] && tool_gpu "$d"; then
      l="$(tool_conf "$d" label)"
      echo "${l:-$(jget "$d/job" tool)} · $(short_id "$d" "$(jget "$d/job" repo)")"
      return 0
    fi
  done
}

# ev_card [HOLDER] — the page: the Workspaces tab (`title`, `dot` while a tool runs, `tab<TAB><html>` lines: ws_page),
# the CSS, a row and a block per question (page_rows); per tool= job `chip<TAB><id><TAB><tool> · <place>`, and while
# its tool runs a steer field: `button<TAB><id><TAB><html>`.
ev_card() {
  local w d id l
  GH="$(gh_url)"
  w="$(ws_page "${1:-}")"
  printf 'title\tworkspaces\tWorkspaces\n'
  if [[ -n "${w%%$'\n'*}" ]]; then echo dot; fi
  printf '%s\n' "${w#*$'\n'}" | sed 's/^/tab	/'
  printf '%s\n' "$CARD_CSS" | sed 's/^/style	/'
  page_rows
  for d in "$QDIR"/*/; do
    d="${d%/}" id="${d##*/}"
    if [[ ! -f "$d/job" || -z "$(jget "$d/job" tool)" ]]; then continue; fi
    printf 'chip\t%s\t%s\n' "$id" "$(jget "$d/job" tool) · $(tool_place "$d")"
    if tool_up "$d" && tool_steers "$d"; then
      l="$(tool_conf "$d" label)" l="Message to ${l:-$(jget "$d/job" tool)}: it reads the text at its next step"
      printf 'button\t%s\t<span class="ask"><label>%s<textarea name="text" rows="3"></textarea></label><button data-act="steer">Send</button></span>\n' "$id" "$(esc "$l")"
    fi
  done
}

# ev_status — the Research group of `vibe queue status` (status_lines).
ev_status() { status_lines; }

# ev_report — the Research table of `vibe queue report` (research_md).
ev_report() { research_md; }

# One group ending in exit: bash reads no more of this file after a long command (a tool run, ws hold), so an
# edit in place mid-run cannot run a stale fragment.
{
  case "${1:-}" in
    describe)
      printf '%s\n' "command ws" "command queue gpu --place" "command queue worker" "command queue stop --research" \
        "command queue archive --research" "readonly ws list" "readonly ws status" "branch research" "wip RESEARCH.md" \
        "route research-archive vibe queue archive --research {slug}" "route research-stop vibe queue stop --research {slug}" \
        "route research-stop-now vibe queue stop --research {slug} --now" \
        "route ws-start vibe ws start {name} --place={place?} --hours={hours?}" "route ws-stop vibe ws stop {name}"
      # The `vibe --help` lines of the research and ws commands.
      sed -n 's/^# /help /p' <<'HELP'
#   vibe queue worker <hid> [--place turing|runpod|vast|slurm]
#                                   in a research coordinator job: a worker job for item <hid> of RESEARCH.md
#   vibe queue archive --research <slug>
#                                   every job of a research question out of the queue, once each has ended
#   vibe queue stop --research <slug> [--now]
#                                   the research starts no worker; --now: no run either, each place run is cut
#   vibe queue answer <id> <output> a slurm worker: the output of its run, then its session 2
#   vibe ws list                    the tools under workspaces/: name, kind, gpu, places, label: role;
#                                   a bad workspace.conf prints why, exit 1
#   vibe ws status [<instance>]     each tool instance: up, past limit, starts, waits for the GPU or down, from its state files
#   vibe ws build <name>            docker build the tool's image at its pinned commit, tagged with it
#   vibe ws start <name> [--place P] [--hours N]
#                                   a kind=service tool up at P (the first of its places) for N hours (its hours),
#                                   then its start script; gpu=yes on turing: under the gpu-queue lock, held until stop
#   vibe ws stop <instance>         its stop script, then down: data copied back, container gone, GPU lock free
#   vibe ws tick                    each instance: pull every 10 min, down past its limit (the runner, each pass)
HELP
      ;;
    cmd)
      shift
      case "${1:-} ${2:-}" in
        "queue gpu") cmd_gpu_place "${@:3}" ;;
        "queue worker") cmd_worker "${@:3}" ;;
        "queue stop") cmd_stop "${@:3}" ;;
        "queue archive") cmd_archive "${@:3}" ;;
        ws\ *) cmd_ws "${@:2}" ;;
        *) die "research: no command '$*'" ;;
      esac
      ;;
    event)
      shift
      case "${1:-}" in
        pass | add | prepare | start | end | answer | follow | steer | holder | card | status | report) "ev_$1" "${@:2}" ;;
        *) ;; # an event it does not hear: no output, exit 0
      esac
      ;;
    *)
      echo "research: unknown call '${1:-}' — describe, cmd or event (docs/vibe-extensions.md)" >&2
      exit 2
      ;;
  esac
  exit
}
