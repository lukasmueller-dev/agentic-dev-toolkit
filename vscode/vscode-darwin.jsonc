// macOS — add to VS Code Settings (JSON):
//   User Settings when you are sitting at the machine, or *Remote* Settings
//   (the window showing "[SSH: <your-host>]") when you reach it over SSH.
// Makes every new terminal open with `vibe status`.
{
  "terminal.integrated.profiles.osx": {
    "vibe": { "path": "zsh", "args": ["-lic", "vibe status; exec zsh"] }
  },
  "terminal.integrated.defaultProfile.osx": "vibe"
}
