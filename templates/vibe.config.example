# vibe configuration — copy to ~/.config/vibe/config
#
#   mkdir -p ~/.config/vibe
#   cp templates/vibe.config.example ~/.config/vibe/config
#
# Precedence: environment variable > this file > built-in default.
# So an env var set in your shell always wins over a value here.
#
# FORMAT: plain KEY=VALUE lines only, one per line. No command substitution,
# no pipes, no conditionals. vibe sources this file, but the Claude Code hooks
# in claude/hooks/ *parse* it instead — anything cleverer than an assignment
# would work in one place and silently not in the other.
#
# Run `vibe doctor` after editing; it validates the format and reports the
# resulting values.

# Where per-task worktrees are created, as <root>/<repo>/<task>.
# Default: ~/git/worktrees
#VIBE_WORKTREE_ROOT=/home/you/git/worktrees

# The agent launched by `vibe start` / `vibe attach`.
# Anything runnable works — vibe never assumes a particular agent.
# Default: claude
#VIBE_AGENT_CMD=claude

# Arguments that make VIBE_AGENT_CMD continue its previous conversation for a
# worktree instead of opening an empty one. Used in exactly one situation: the
# task's tmux session is still alive but its agent has exited, so `vibe attach`
# finds the pane back at a shell and starts the agent again. Unset, that restart
# gets a fresh context and HANDOFF.md carries the state.
# Agent-agnostic by default; Claude Code spells it `--continue`, which resumes
# the most recent conversation for the pane's directory.
# Default: unset
#VIBE_AGENT_RESUME_ARGS=--continue

# 1 starts every agent as `<VIBE_AGENT_CMD> --remote-control <tmux session>`,
# so each task appears under its tmux session name in claude.ai/code and the
# Claude app. Claude Code only.
# Default: 0
#VIBE_REMOTE_CONTROL=1

# Prefix for tmux session names, which are <prefix>-<repo>-<branch>.
# Default: vibe
#VIBE_TMUX_PREFIX=vibe

# Before 'vibe start' cuts a brand-new task branch off the main checkout's
# HEAD, fast-forward that checkout to its upstream first (fetch + merge
# --ff-only). Skipped automatically when the main checkout is dirty, has no
# upstream, or the fetch fails — it never blocks a start, only keeps it from
# quietly forking off local history that predates a teammate's merge. Set to
# 0 to branch off HEAD exactly as it is.
# Default: 1
#VIBE_START_PULL_MAIN=1
