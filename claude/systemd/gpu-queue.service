# gpu-queue — runs queued GPU jobs one at a time, for ever.
# Setup: docs/agent-queue.md. Skipped unless ~/.config/vibe/role holds 'server'.

[Unit]
Description=GPU job queue

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/bin/sh -c 'grep -qx server %h/.config/vibe/role || { echo "role is not server: echo server > ~/.config/vibe/role" >&2; exit 1; }'
ExecStart=%h/bin/gpu-queue run
# A restart stops the queue only: a running GPU job finishes.
KillMode=process
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
