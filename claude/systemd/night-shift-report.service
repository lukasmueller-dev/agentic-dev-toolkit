# night-shift-report — writes the latest night's report at 07:00 and copies it
# to the briefing dir (timer: night-shift-report.timer).
# Setup: docs/night-shift.md. Skipped unless ~/.config/vibe/role holds 'server'.

[Unit]
Description=night-shift morning report

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecCondition=/bin/sh -c 'grep -qx server %h/.config/vibe/role || { echo "role is not server: echo server > ~/.config/vibe/role" >&2; exit 1; }'
ExecStart=%h/bin/vibe night report --new
