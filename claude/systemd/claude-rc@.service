# claude-rc@<repo> — a Claude Code Remote Control server for ~/github/<repo>,
# in worktree mode, inside its own tmux server so it has a terminal.
# Setup: docs/remote-sessions.md. Other repo root: a drop-in that sets
# WorkingDirectory.

[Unit]
Description=Claude Code Remote Control server for %i
Wants=network-online.target
After=network-online.target

[Service]
Type=forking
WorkingDirectory=%h/github/%i
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env tmux -L claude-rc-%i new-session -d -s %i 'claude remote-control --spawn worktree --name %i'
ExecStop=/usr/bin/env tmux -L claude-rc-%i kill-server
# The server exits when claude does; restart brings its sessions back.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
