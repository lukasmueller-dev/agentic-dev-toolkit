  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "autoAllowBashIfSandboxed": true,
    "credentials": {
      "files": [
        { "mode": "deny", "path": "~/.aws/credentials" },
        { "mode": "deny", "path": "~/.ssh" },
        { "mode": "deny", "path": "~/.config/gh/hosts.yml" },
        { "mode": "deny", "path": "~/.netrc" }
      ],
      "envVars": [
        { "name": "WANDB_API_KEY", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "*.github.com",
        "*.githubusercontent.com",
        "*.hf.co",
        "*.huggingface.co",
        "api.wandb.ai",
        "crates.io",
        "files.pythonhosted.org",
        "github.com",
        "huggingface.co",
        "proxy.golang.org",
        "pypi.org",
        "registry.npmjs.org",
        "static.crates.io"
      ]
    },
    "excludedCommands": [
      "git clone *",
      "git pull *",
      "git push *",
      "rsync *",
      "scp *",
      "ssh *"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start-handoff.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/clear-config-lock.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/deny-push-force-cluster.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "runpod": {
      "source": {
        "source": "github",
        "repo": "runpod/runpod-plugins-official",
        "ref": "44ab4dc6834ce37ee60f5cf10a3afe3b289c5f38"
      }
    },
    "vast-ai": {
      "source": {
        "source": "github",
        "repo": "vast-ai/vast-claude-plugin",
        "ref": "c90a6cceb7d5fd0e206c0dc705d7750a198d7768"
      }
    }
  },
  "enabledPlugins": {
    "runpod@runpod": true,
    "vastai@vast-ai": true,
    "wandb@toolkit": true
  }
}
