#!/usr/bin/env python3
"""vibe-web — the queue page's write endpoint: one route runs one fixed argv.

Listens on 127.0.0.1:<web_port> (queue.conf, default 7341); tailscale serve
mounts it at /queue/api. Setup: docs/vibe-queue.md step 3; routes: Page actions.
"""
import datetime
import html
import json
import os
import re
import shlex
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
TOOLS = {  # argv[0] of a route -> how to run it from this checkout
    "vibe": [os.path.join(ROOT, "bin", "vibe")],
    "gpu-queue": [os.path.join(ROOT, "bin", "gpu-queue")],
    "cleanup.sh": ["bash", os.path.join(ROOT, "skills", "worktree-cleanup", "cleanup.sh")],
}
VIBE = TOOLS["vibe"][0]
QROOT = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "vibe")
QCONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "vibe", "queue.conf")
PREFIX = "/queue/api"
# route -> argv; never a shell string. "{x}" at an arg's end: body arg x, checked against ARGS[x].
ROUTES = {
    "pause": ["vibe", "queue", "pause"],
    "resume": ["vibe", "queue", "resume"],
    "conf": ["vibe", "queue", "conf", "{set}"],
    "unlimit": ["vibe", "queue", "unlimit"],
    "restart": ["systemctl", "--user", "restart", "vibe-queue"],
    "now": ["vibe", "queue", "set", "{id}", "now=1"],
    "noreview": ["vibe", "queue", "set", "{id}", "after="],
    "retry": ["vibe", "queue", "retry", "{id}"],
    "cancel": ["vibe", "queue", "cancel", "{id}"],
    "stop": ["vibe", "queue", "stop", "{id}"],
    "hold": ["vibe", "queue", "hold", "{id}", "{note}"],
    "archive": ["vibe", "queue", "archive", "{id}"],
    "answer": ["vibe", "queue", "answer", "{id}", "{text}"],
    "fix": ["vibe", "queue", "fix", "{pr}", "{text}"],
    "merge-order": ["vibe", "queue", "merge-order", "{repo}"],
    "feature-ready": ["vibe", "queue", "ready", "--feature", "{feature}"],
    "feature-archive": ["vibe", "feature", "archive", "{feature}"],
    "new": ["vibe", "queue", "new", "{repo}", "{branch}", "{done}", "{task}"],
    "roadmap": ["vibe", "queue", "roadmap", "--full", "{repo}"],
    "roadmap-new": ["vibe", "queue", "new", "--line", "{line}", "{repo}", "{branch}"],
    "opt-in": ["vibe", "queue", "new", "--opt-in", "{job}", "{repo}"],
    "run": ["vibe", "job", "run", "{repo}", "{job}"],
    "reset": ["vibe", "job", "reset", "{repo}", "{job}"],
    "triage": ["vibe", "job", "triage"],
    "gpu-cancel": ["gpu-queue", "cancel", "{gpu}"],
    "servers": ["vibe", "status", "--claude"],
    "server-restart": ["systemctl", "--user", "restart", "claude-rc@{server}"],
    "worktrees": ["cleanup.sh", "scan", "{repo}"],
    "worktree-remove": ["cleanup.sh", "remove", "{path}"],
    "sync": ["vibe", "sync", "--all"],
    "update-toolkit": ["vibe", "update-toolkit"],
}
ARGS = {
    "id": re.compile(r"[0-9]{8}-[0-9]{6}-[A-Za-z0-9._-]{1,200}"),
    "set": re.compile(r"[a-z_]{1,40}=[A-Za-z0-9.%_-]{0,40}"),
    "note": re.compile(r"[^\x00-\x1f\x7f]{1,300}"),
    "text": re.compile(r"[^\x00-\x1f\x7f]{1,2000}"),
    "pr": re.compile(r"https://github\.com/[A-Za-z0-9._-]{1,100}/[A-Za-z0-9._-]{1,100}/pull/[0-9]{1,9}"),
    "repo": re.compile(r"(/[A-Za-z0-9_][A-Za-z0-9._-]{0,100}){1,20}"),  # absolute, no .. or option
    "path": re.compile(r"(/(?!\.\.?(/|$))[A-Za-z0-9_.][A-Za-z0-9._-]{0,100}){1,20}"),  # absolute; .claude, not . or ..
    "gpu": re.compile(r"[0-9]{8}-[0-9]{6}-[0-9]{1,10}-[A-Za-z0-9._-]{1,200}"),
    "server": re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,100}"),
    "feature": re.compile(r"[a-z0-9][a-z0-9._-]{0,100}"),
    "branch": re.compile(r"[a-z0-9][a-z0-9._-]{0,100}"),
    "job": re.compile(r"[a-z0-9][a-z0-9._-]{0,100}"),
    "line": re.compile(r"[1-9][0-9]{0,5}"),
    "done": re.compile(r"[^\x00-\x1f\x7f]{1,500}"),
    "task": re.compile(r"[^\x00-\x1f\x7f]{1,2000}"),
}


def md_html(data):
    """Markdown bytes as HTML: pandoc, else escaped in <pre>."""
    try:
        return subprocess.run(["pandoc", "-f", "gfm-gfm_auto_identifiers", "-t", "html"], input=data, capture_output=True, check=True, timeout=TIMEOUT).stdout
    except (OSError, subprocess.SubprocessError):
        return b"<pre>" + html.escape(data.decode("utf-8", "replace")).encode() + b"</pre>"


def argv_of(route, body):
    """The argv of ROUTE with BODY's args filled in; None when an arg is absent or bad."""
    argv = []
    for a in ROUTES[route]:
        if a.endswith("}"):
            a, k = a[:-1].split("{")
            v = body.get(k)
            if not isinstance(v, str) or not ARGS[k].fullmatch(v):
                return None
            a += v
        argv.append(a)
    return argv


def qconf(key, default=""):
    """KEY=value from queue.conf without a trailing ` # comment`, else DEFAULT (same rule as vibe's qconf)."""
    try:
        with open(QCONF, encoding="utf-8") as f:
            for line in f:
                if line.startswith(key + "="):
                    return re.sub(r"\s#.*", "", line[len(key) + 1:]).strip() or default
    except OSError:
        pass
    return default


FILES = ("report.md", "gate.log", "pr.md", "result", "note", "log")  # GET job/<id>/<file>; log: its tail
STARTED = os.stat(os.path.realpath(__file__)).st_mtime  # update-toolkit changed it: re-exec after the reply
TIMEOUT = int(os.environ.get("VIBE_WEB_TIMEOUT") or 120)  # s per command: a hung one must not hold WRITE for ever
WRITE = threading.Lock()  # one write at a time; reads (whoami) never wait on a slow client


class Handler(BaseHTTPRequestHandler):
    timeout = 10  # a stalled client drops after 10 s
    def reply(self, code, obj, ctype="application/json"):
        body = obj if isinstance(obj, bytes) else json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy", "default-src 'none'")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def route(self):
        p = urlsplit(self.path).path
        if p.startswith(PREFIX + "/"):
            p = p[len(PREFIX):]
        return p.strip("/")

    def one(self, name):
        """The header NAME when it occurs once; else empty."""
        v = self.headers.get_all(name) or []
        return v[0] if len(v) == 1 else ""

    def login(self):
        """The caller's tailnet login when it is web_login; else None."""
        want = qconf("web_login")
        got = self.one("Tailscale-User-Login")
        return got if want and got == want else None

    def do_GET(self):
        who = self.login()
        if who is None:
            return self.reply(403, {"error": "login"})
        if self.route() == "whoami":
            return self.reply(200, {"login": who})
        if self.route().startswith("job/"):
            return self.job_file(self.route().split("/"))
        return self.reply(404, {"error": "no route"})

    def job_file(self, parts):
        """GET job/<id>/<file>: one of FILES of a queued job as text; the log's last 64 KB; a .md with ?html as HTML."""
        if len(parts) != 3 or not ARGS["id"].fullmatch(parts[1]) or parts[2] not in FILES:
            return self.reply(404, {"error": "no file"})
        try:  # O_NOFOLLOW: an agent can write the job dir; no symlink out of it
            with os.fdopen(os.open(os.path.join(QROOT, "queue", parts[1], parts[2]), os.O_RDONLY | os.O_NOFOLLOW), "rb") as f:
                if parts[2] == "log":
                    f.seek(max(0, os.fstat(f.fileno()).st_size - 65536))
                data = f.read(1 << 20)
        except OSError:
            return self.reply(404, {"error": "no file"})
        if parts[2].endswith(".md") and urlsplit(self.path).query == "html":
            return self.reply(200, md_html(data), "text/html; charset=utf-8")
        return self.reply(200, data, "text/plain; charset=utf-8")

    def do_POST(self):
        who = self.login()
        if who is None:
            return self.reply(403, {"error": "login"})
        # A cross-site form post from another tab carries the device's tailnet identity.
        origin = urlsplit(self.one("Origin")).netloc
        if not origin or origin != self.one("Host"):
            return self.reply(403, {"error": "origin"})
        if self.one("Content-Type").split(";")[0].strip() != "application/json":
            return self.reply(403, {"error": "content type"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or b"null") if 0 <= n <= 65536 else None
        except (ValueError, UnicodeDecodeError, OSError):
            body = None
        if not isinstance(body, dict):
            return self.reply(403, {"error": "body is not a JSON object"})
        if self.route() not in ROUTES:
            return self.reply(404, {"error": "no route"})
        argv = argv_of(self.route(), body)
        if argv is None:
            return self.reply(400, {"error": "bad args"})
        with WRITE:
            return self.write(who, argv)

    def write(self, who, argv):
        run = TOOLS.get(argv[0], argv[:1]) + argv[1:]
        try:
            r = subprocess.run(run, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace", check=False, timeout=TIMEOUT,
                               env=dict(os.environ, VIBE_WEB="1"))
        except subprocess.TimeoutExpired:
            r = subprocess.CompletedProcess(run, 124, "", "killed after %d s" % TIMEOUT)
        except OSError as e:
            r = subprocess.CompletedProcess(run, 127, "", str(e))
        os.makedirs(QROOT, exist_ok=True)
        with open(os.path.join(QROOT, "actions.log"), "a", encoding="utf-8") as f:
            f.write("%s\t%s\t%s\t%d\n" % (datetime.datetime.now().strftime("%F %T"), who, shlex.join(argv), r.returncode))
        try:
            subprocess.run([VIBE, "queue", "page"], stdin=subprocess.DEVNULL, capture_output=True, check=False, timeout=TIMEOUT)
        except subprocess.TimeoutExpired:
            pass
        out = r.stdout + r.stderr
        if len(out) > 16000:  # a listing leads with its first item, an error ends the output: keep both ends
            out = out[:12000] + "\n…\n" + out[-4000:]
        self.reply(200, {"code": r.returncode, "out": out})
        if argv[1:2] == ["update-toolkit"] and os.stat(os.path.realpath(__file__)).st_mtime != STARTED:
            self.wfile.flush()
            os.execv(sys.executable, [sys.executable] + sys.argv)  # the new code; sockets close on exec

    def log_message(self, fmt, *args):
        sys.stderr.write("vibe-web: %s\n" % (fmt % args))


def main():
    port = int(qconf("web_port", "7341"))
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


if __name__ == "__main__":
    main()
