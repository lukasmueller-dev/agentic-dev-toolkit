#!/usr/bin/env python3
"""vibe-web — the queue page's write endpoint: one route runs one vibe argv.

Listens on 127.0.0.1:<web_port> (queue.conf, default 7341); tailscale serve
mounts it at /queue/api. Setup and routes: docs/vibe-queue.md, step 3.
"""
import datetime
import json
import os
import shlex
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlsplit

VIBE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "vibe")
QROOT = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "vibe")
QCONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "vibe", "queue.conf")
PREFIX = "/queue/api"
# route -> vibe argv; never a shell string.
ROUTES = {
    "pause": ["queue", "pause"],
    "resume": ["queue", "resume"],
}


def qconf(key, default=""):
    """KEY=value from queue.conf, else DEFAULT (same rule as vibe's qconf)."""
    try:
        with open(QCONF, encoding="utf-8") as f:
            for line in f:
                if line.startswith(key + "="):
                    return line[len(key) + 1:].strip() or default
    except OSError:
        pass
    return default


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def route(self):
        p = urlsplit(self.path).path
        if p.startswith(PREFIX + "/"):
            p = p[len(PREFIX):]
        return p.strip("/")

    def one(self, name):
        """The header NAME when it occurs once; else empty."""
        v = self.headers.get_all(name) or []
        return v[0] if len(v) == 1 else ""

    def login(self):
        """The caller's tailnet login when it is web_login; else None."""
        want = qconf("web_login")
        got = self.one("Tailscale-User-Login")
        return got if want and got == want else None

    def do_GET(self):
        who = self.login()
        if who is None:
            return self.reply(403, {"error": "login"})
        if self.route() == "whoami":
            return self.reply(200, {"login": who})
        return self.reply(404, {"error": "no route"})

    def do_POST(self):
        who = self.login()
        if who is None:
            return self.reply(403, {"error": "login"})
        # A cross-site form post from another tab carries the device's tailnet identity.
        origin = urlsplit(self.one("Origin")).netloc
        if not origin or origin != self.one("Host"):
            return self.reply(403, {"error": "origin"})
        if self.one("Content-Type").split(";")[0].strip() != "application/json":
            return self.reply(403, {"error": "content type"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or b"null")
        except (ValueError, UnicodeDecodeError):
            body = None
        if not isinstance(body, dict):
            return self.reply(403, {"error": "body is not a JSON object"})
        argv = ROUTES.get(self.route())
        if argv is None:
            return self.reply(404, {"error": "no route"})
        r = subprocess.run([VIBE] + argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False)
        os.makedirs(QROOT, exist_ok=True)
        with open(os.path.join(QROOT, "actions.log"), "a", encoding="utf-8") as f:
            f.write("%s\t%s\t%s\t%d\n" % (datetime.datetime.now().strftime("%F %T"), who, shlex.join(["vibe"] + argv), r.returncode))
        subprocess.run([VIBE, "queue", "page"], stdin=subprocess.DEVNULL, capture_output=True, check=False)
        return self.reply(200, {"code": r.returncode, "out": (r.stdout + r.stderr)[-4000:]})

    def log_message(self, fmt, *args):
        sys.stderr.write("vibe-web: %s\n" % (fmt % args))


def main():
    port = int(qconf("web_port", "7341"))
    HTTPServer(("127.0.0.1", port), Handler).serve_forever()


if __name__ == "__main__":
    main()
