#!/usr/bin/env bash
#
# vibe — one worktree per task, opened in VS Code; git carries it between machines.
#
#   vibe start [-C <repo>] <task>   make or adopt <repo>/.claude/worktrees/<task>, open it
#                                   (runs each <agent>/vibe-start.sh <worktree> <repo>-<task>)
#   vibe sync [--all] [--wip]       push, fast-forward, report every worktree
#   vibe status --<agent>           agent servers on this machine (<agent>/vibe-status.sh)
#   vibe update-toolkit             pull the toolkit checkout, install, doctor
#   vibe queue status               the queue: running, queued, to review; one line per job by repo
#   vibe queue add [--now] <dir>... queue prepared job dirs (job, prompt.md); --now skips the window
#   vibe queue report               a fresh briefing of the jobs to review; copied to the briefing dir
#   vibe queue hold <id> <note>     keep a job for you: first in every briefing
#   vibe queue archive <id>...      move reviewed jobs out of the queue
#   vibe queue pause | resume       stop or allow new starts; running jobs finish
#   vibe queue run --<agent> [--drain]
#                                   the runner (vibe-queue.service); --drain: until nothing can start
#   vibe job list [--all] [<repo>...]
#                                   recurring jobs of every repo with .vibe-jobs/, and the repos
#                                   the fill-queue sweep covers; --all adds the jobs not opted into
#   vibe job due [--dry] [--max N]  queue every due recurring job (the 01:00 timer)
#   vibe job run <repo> <job>       queue one recurring job now
#   vibe job add <repo> <job>       opt <repo> in: write <repo>/.vibe-jobs/<job>.md
#   vibe job triage [<repo>...]     agent PRs: merge the base into conflicted ones; briefing lines
#
# Docs: docs/remote-sessions.md, docs/vibe-queue.md, docs/vibe-jobs.md.
set -euo pipefail

script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

SELF_ROOT="$(dirname "$(script_dir)")"
# shellcheck disable=SC2034  # read by the lib's die/info message prefix
LIB_PROG=vibe
# shellcheck disable=SC1091  # path only exists at runtime, resolved above
. "$SELF_ROOT/skills/_lib/lib.sh"

usage() {
  sed -n '5,24s/^# \{0,1\}//p' "$SELF_ROOT/bin/vibe"
  exit "${1:-0}"
}
warn() { echo "vibe: warning: $*" >&2; }

# default_branch REPO — origin's HEAD branch; main when origin names none.
default_branch() {
  local ref
  ref="$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  ref="${ref:-origin/main}"
  echo "${ref#origin/}"
}

TOOLKIT="$(cd -P "${VIBE_TOOLKIT:-$SELF_ROOT}" 2>/dev/null && pwd || echo "${VIBE_TOOLKIT:-$SELF_ROOT}")"

# toolkit_check — one warning line when the installed toolkit differs from origin.
toolkit_check() {
  local t="$TOOLKIT" cache stamp now def b ahead behind
  git -C "$t" rev-parse --git-dir >/dev/null 2>&1 || return 0
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/vibe/last-fetch"
  now="$(date +%s)"
  stamp="$(stat -c %Y "$cache" 2>/dev/null || stat -f %m "$cache" 2>/dev/null || echo 0)"
  if ((now - stamp >= ${VIBE_FETCH_INTERVAL:-300})); then
    mkdir -p "$(dirname "$cache")" && touch "$cache"
    GIT_TERMINAL_PROMPT=0 git -C "$t" fetch -q origin 2>/dev/null || true
  fi
  def="$(default_branch "$t")"
  b="$(git -C "$t" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [[ "$b" == "$def" ]] || warn "toolkit checkout $t is on '$b', not $def"
  [[ -z "$(git -C "$t" status --porcelain --untracked-files=no)" ]] ||
    warn "toolkit checkout $t has uncommitted changes"
  git -C "$t" rev-parse -q --verify "origin/$def" >/dev/null || return 0
  read -r ahead behind < <(git -C "$t" rev-list --left-right --count "HEAD...origin/$def" 2>/dev/null || true)
  if ((${ahead:-0} > 0 && ${behind:-0} > 0)); then
    warn "toolkit checkout has diverged from origin/$def"
  elif ((${behind:-0} > 0)); then
    warn "toolkit is $behind commits behind origin/$def — run: vibe update-toolkit"
  fi
}

# ensure_exclude MAIN — keep .claude/worktrees/ out of git status in every checkout.
ensure_exclude() {
  local f
  f="$(git -C "$1" rev-parse --git-common-dir)/info/exclude"
  case "$f" in /*) ;; *) f="$1/$f" ;; esac
  mkdir -p "$(dirname "$f")"
  grep -qxF '.claude/worktrees/' "$f" 2>/dev/null || echo '.claude/worktrees/' >>"$f"
}

# worktree_of MAIN BRANCH — path of the worktree that has BRANCH checked out.
worktree_of() {
  git -C "$1" worktree list --porcelain | awk -v b="refs/heads/$2" '
    /^worktree / { p = substr($0, 10) }
    $0 == "branch " b { print p; exit }'
}

# open_prs DIR — "branch<TAB>url" for each open PR; empty without gh.
open_prs() {
  command -v gh >/dev/null 2>&1 || return 0
  (cd "$1" && gh pr list --state open --json headRefName,url \
    -q '.[] | "\(.headRefName)\t\(.url)"' 2>/dev/null) || true
}
pr_of() { printf '%s\n' "$1" | awk -F'\t' -v b="$2" '$1 == b { print $2; exit }'; }

# open_worktree MAIN BRANCH DEFAULT — make or adopt BRANCH's worktree, run the
# agent start hooks; sets WT. Call from inside the repo.
open_worktree() {
  local main="$1" branch="$2" def="$3" s
  ensure_exclude "$main"
  git -C "$main" fetch -q origin 2>/dev/null || warn "fetch failed — using the last fetched refs"
  WT="$(worktree_of "$main" "$branch")"
  if [[ -z "$WT" ]]; then
    WT="$(worktree_dir "$branch")"
    [[ ! -e "$WT" ]] || die "$WT exists but does not hold branch '$branch'"
    ensure_worktree "$main" "$branch" "$WT" "origin/$def"
  elif [[ -z "$(git -C "$WT" status --porcelain)" ]]; then
    git -C "$WT" merge -q --ff-only '@{u}' 2>/dev/null || true
  fi
  for s in "$SELF_ROOT"/*/vibe-start.sh; do
    if [[ -f "$s" ]] && ! bash "$s" "$WT" "$(basename "$main")-$branch"; then
      warn "$s failed"
    fi
  done
}

cmd_start() {
  local repo_dir="$PWD" task="" main branch dir def pr
  while (($#)); do
    case "$1" in
      -C) repo_dir="${2:?-C needs a repo path}" && shift 2 ;;
      -h | --help) usage ;;
      -*) die "unknown option '$1'" ;;
      *)
        [[ -z "$task" ]] || die "one task only"
        task="$1"
        shift
        ;;
    esac
  done
  [[ -n "$task" ]] || usage 1
  cd "$repo_dir" || die "no such directory: $repo_dir"
  main="$(main_repo_root)"
  branch="$(slug "$task")"
  def="$(default_branch "$main")"
  [[ -n "$branch" && "$branch" != "$def" ]] || die "'$task' is not a task name"
  open_worktree "$main" "$branch" "$def"
  dir="$WT"
  pr="$(pr_of "$(open_prs "$dir")" "$branch")"
  echo "worktree: $dir"
  [[ -z "$pr" ]] || echo "PR:       $pr"
  if command -v code >/dev/null 2>&1; then
    code "$dir"
  fi
}

# sync_repo MAIN — sync each worktree of MAIN; one output line per worktree.
sync_repo() {
  local main="$1" def prs failed=0 line dir="" branch="" locked=""
  def="$(default_branch "$main")"
  ensure_exclude "$main"
  git -C "$main" fetch -q --prune origin 2>/dev/null || warn "$(basename "$main"): fetch failed"
  prs="$(open_prs "$main")"
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) dir="${line#worktree }" branch="" locked="" ;;
      "branch "*) branch="${line#branch refs/heads/}" ;;
      locked*) locked=1 ;;
      "")
        if [[ -n "$dir" ]] && ! sync_wt "$main" "$dir" "$branch" "$locked" "$def" "$prs"; then failed=1; fi
        dir=""
        ;;
    esac
  done < <(git -C "$main" worktree list --porcelain && echo)
  return "$failed"
}

# sync_wt MAIN DIR BRANCH LOCKED DEFAULT PRS — the push / ff / report rules.
sync_wt() {
  local main="$1" dir="$2" br="$3" locked="$4" def="$5" prs="$6" res="ok" note="" dirty="" counts ahead behind rc=0 name
  name="$(basename "$main")"
  [[ "$dir" == "$main" ]] || name="$name/${dir##*/}"
  [[ ! -d "$dir" ]] && res="missing" && note="directory gone — /worktree-cleanup"
  if [[ -d "$dir" && -z "$br" ]]; then
    res="detached"
  elif [[ -d "$dir" ]]; then
    [[ -z "$(git -C "$dir" status --porcelain)" ]] || dirty=1
    if [[ -n "$dirty" && "$WIP" == 1 && "$br" != "$def" && -z "$locked" ]]; then
      git -C "$dir" add -A && git -C "$dir" commit -q -m "wip: $(hostname) $(date '+%Y-%m-%d %H:%M')" && dirty="" && note="wip committed"
    fi
    if ! counts="$(git -C "$dir" rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null)"; then
      if [[ "$dir" == "$main" ]]; then
        res="no-upstream"
      elif git -C "$dir" config "branch.$br.merge" >/dev/null; then
        res="merged" note="upstream gone — /worktree-cleanup"
      elif [[ "$br" == worktree-* ]]; then
        res="local" note="app session branch, not pushed"
      elif [[ "$(git -C "$dir" rev-list --count "origin/$def..HEAD" 2>/dev/null || echo 0)" == 0 ]]; then
        res="empty" note="no commits yet"
      elif git -C "$dir" push -q -u origin "$br" 2>/dev/null; then
        res="pushed"
      else
        res="error" note="push failed" rc=1
      fi
    else
      read -r ahead behind <<<"$counts"
      if ((ahead > 0 && behind > 0)); then
        res="diverged"
      elif ((ahead > 0)) && [[ "$dir" == "$main" ]]; then
        res="ahead" note="main checkout is never pushed"
      elif ((ahead > 0)); then
        if git -C "$dir" push -q origin "$br" 2>/dev/null; then res="pushed"; else res="error" note="push failed" rc=1; fi
      elif ((behind > 0)) && [[ -n "$dirty" || -n "$locked" ]]; then
        res="behind"
      elif ((behind > 0)) && [[ "$dir" == "$main" && "$(cd -P "$main" && pwd)" == "$TOOLKIT" ]]; then
        res="behind" note="run: vibe update-toolkit"
      elif ((behind > 0)); then
        if git -C "$dir" merge -q --ff-only '@{u}' 2>/dev/null; then res="pulled"; else res="error" note="fast-forward failed" rc=1; fi
      fi
    fi
    [[ -z "$dirty" ]] || note="${note:+$note, }dirty"
    [[ -z "$locked" ]] || note="${note:+$note, }locked"
    [[ "$dir" != "$main" || "$br" == "$def" ]] || note="${note:+$note, }off $def"
  fi
  printf '%-11s %-40s %-28s %s %s\n' "$res" "$name" "${br:--}" "$note" "$(pr_of "$prs" "$br")"
  return "$rc"
}

cmd_sync() {
  local all=0 failed=0 d
  WIP=0
  while (($#)); do
    case "$1" in
      --all) all=1 ;;
      --wip) WIP=1 ;;
      -h | --help) usage ;;
      *) die "unknown option '$1'" ;;
    esac
    shift
  done
  if ((all)); then
    for d in "${VIBE_ROOT:-$(dirname "$SELF_ROOT")}"/*/; do
      [[ -d "$d/.git" ]] || continue
      sync_repo "${d%/}" || failed=1
    done
  else
    sync_repo "$(main_repo_root)" || failed=1
  fi
  return "$failed"
}

cmd_status() {
  local agent="${1:-}" s
  [[ $# -eq 1 && "$agent" == --?* ]] || die "usage: vibe status --<agent>, e.g. --claude"
  agent="${agent#--}"
  s="$SELF_ROOT/$agent/vibe-status.sh"
  [[ "$agent" != */* && -f "$s" ]] || die "no status for '$agent' — $s is missing"
  exec bash "$s"
}

cmd_update_toolkit() {
  local t="$TOOLKIT" def unit before after
  [[ $# -eq 0 ]] || die "usage: vibe update-toolkit"
  git -C "$t" rev-parse --git-dir >/dev/null 2>&1 || die "$t is not a git checkout"
  def="$(default_branch "$t")"
  [[ "$(git -C "$t" rev-parse --abbrev-ref HEAD)" == "$def" ]] || die "$t is not on $def"
  [[ -z "$(git -C "$t" status --porcelain --untracked-files=no)" ]] || die "$t has uncommitted changes"
  unit="claude/systemd/claude-rc@.service"
  before="$(git -C "$t" rev-parse -q --verify "HEAD:$unit" || true)"
  git -C "$t" pull -q --ff-only origin "$def" || die "pull failed — $t has diverged from origin/$def"
  after="$(git -C "$t" rev-parse -q --verify "HEAD:$unit" || true)"
  echo "toolkit at $(git -C "$t" log -1 --format='%h %s')"
  "$t/install.sh" || die "install.sh failed"
  "$t/install.sh" doctor || die "doctor reports problems"
  if [[ "$before" != "$after" ]] && grep -qx server "$HOME/.config/vibe/role" 2>/dev/null; then
    systemctl --user daemon-reload
    echo "unit changed; restart stops running sessions: systemctl --user restart 'claude-rc@*'"
  fi
}

# --- queue: unattended agent jobs, one worktree each (docs/vibe-queue.md) ---

# role_gate queue|job SUB [ARG...] — on a client (~/.config/vibe/role: `client <host>`),
# run a read-only SUB on the server over ssh and stop on any other.
role_gate() {
  local role="" host="" cmd
  read -r role host _ 2>/dev/null <"$HOME/.config/vibe/role" || true
  [[ "$role" != server ]] || return 0
  [[ -n "$host" ]] || die "no server configured: echo 'client <host>' > ~/.config/vibe/role"
  case "$1 ${2:-}" in
    "queue status" | "queue report" | "job list") ;;
    *) die "the queue runs on the server — ssh $host" ;;
  esac
  printf -v cmd ' %q' "$@"
  exec ssh "$host" "\$HOME/bin/vibe$cmd"
}

QROOT="${XDG_STATE_HOME:-$HOME/.local/state}/vibe"
QDIR="$QROOT/queue"
QCONF="${XDG_CONFIG_HOME:-$HOME/.config}/vibe"

# jget FILE KEY — the value of KEY=value in FILE; empty when absent.
jget() { awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1" 2>/dev/null || true; }
# jstate JOB NAME — first line of a job state file; empty when absent.
jstate() { head -n 1 "$1/$2" 2>/dev/null || true; }
# qconf KEY DEFAULT — KEY=value from ~/.config/vibe/queue.conf, else DEFAULT.
qconf() {
  local v
  v="$(jget "$QCONF/queue.conf" "$1")"
  echo "${v:-$2}"
}

# secs DUR — seconds of 90s, 30m, 2h, 1d or bare seconds; empty when malformed.
secs() {
  [[ "$1" =~ ^([0-9]+)([smhd]?)$ ]] || return 0
  case "${BASH_REMATCH[2]}" in
    m) echo $((10#${BASH_REMATCH[1]} * 60)) ;;
    h) echo $((10#${BASH_REMATCH[1]} * 3600)) ;;
    d) echo $((10#${BASH_REMATCH[1]} * 86400)) ;;
    *) echo $((10#${BASH_REMATCH[1]})) ;;
  esac
}

# window — the night window HH:MM-HH:MM from the config; the default when malformed.
window() {
  local w
  w="$(qconf night 18:00-07:00)"
  [[ "$w" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || w=18:00-07:00
  echo "$w"
}

# in_window — true while the night window is open.
in_window() {
  local w s e m
  w="$(window)"
  s=$((10#${w:0:2} * 60 + 10#${w:3:2})) e=$((10#${w:6:2} * 60 + 10#${w:9:2}))
  m="$(date +%H:%M)"
  m=$((10#${m:0:2} * 60 + 10#${m:3:2}))
  if ((s <= e)); then
    ((m >= s && m < e))
  else
    ((m >= s || m < e))
  fi
}

# job_timeout JOB — the job's timeout, 2h when it sets none.
job_timeout() {
  local t
  t="$(jget "$1/job" timeout)"
  echo "${t:-2h}"
}

# job_heavy JOB — true when the job's timeout is over the config's `heavy` (2h).
job_heavy() {
  local t h
  t="$(secs "$(job_timeout "$1")")" h="$(secs "$(qconf heavy 2h)")"
  ((${t:-7200} > ${h:-7200}))
}

# job_end JOB STATUS NOTE — final status of a job; a recurring job also
# updates its last-run / fails state (docs/vibe-jobs.md).
job_end() {
  echo "$2" >"$1/status"
  echo "$3" >"$1/note"
  date '+%F %T' >"$1/ended"
  rm -f "$1/pid"
  [[ -z "$(jget "$1/job" recurring)" ]] || job_state_update "$1" "$2"
}

# job_final JOB — true when the job has ended.
job_final() {
  case "$(jstate "$1" status)" in "done" | blocked | failed | timeout | skipped) return 0 ;; esac
  return 1
}

# branch_ok BRANCH — a slug, or jobs/<slug> (a recurring job's branch).
branch_ok() {
  local b="${1#jobs/}"
  [[ "$1" != jobs/*/* && -n "$b" && "$(slug "$b")" == "$b" ]]
}

# queue_add DIR [NOW] — move a prepared job dir (`job`, `prompt.md`) into the
# queue as <YYYYMMDD-HHMMSS>-<repo>-<branch>; NOW=1 lets it skip the window.
queue_add() {
  local src="${1%/}" now="${2:-0}" repo branch ts d
  [[ -f "$src/job" ]] || die "no job file in $src"
  repo="$(jget "$src/job" repo)" branch="$(jget "$src/job" branch)"
  [[ -n "$repo" && -n "$branch" ]] || die "$src/job needs repo= and branch="
  branch_ok "$branch" || die "bad branch '$branch'"
  mkdir -p "$QDIR" "$QROOT/incoming"
  # One id per second keeps FIFO order: a second add waits for the next second.
  ts="$(date +%Y%m%d-%H%M%S)"
  while compgen -G "$QDIR/$ts-*" >/dev/null; do
    sleep 1
    ts="$(date +%Y%m%d-%H%M%S)"
  done
  d="$QDIR/$ts-$(basename "$repo")-$(echo "$branch" | tr / -)"
  if ((now)); then echo now=1 >>"$src/job"; fi
  # A copy lands complete or not at all: the runner never sees half a job.
  if ! mv "$src" "$d" 2>/dev/null; then
    cp -R "$src" "$QROOT/incoming/${d##*/}" && mv "$QROOT/incoming/${d##*/}" "$d" && rm -rf "$src"
  fi
  echo "$d"
}

# vibe queue add [--now] DIR... — queue prepared job dirs, in argument order.
cmd_queue_add() {
  local now=0 dirs=() d
  for d in "$@"; do
    case "$d" in
      --now) now=1 ;;
      -h | --help) usage ;;
      -*) die "usage: vibe queue add [--now] <dir>..." ;;
      *) dirs+=("$d") ;;
    esac
  done
  ((${#dirs[@]})) || die "usage: vibe queue add [--now] <dir>..."
  for d in "${dirs[@]}"; do
    d="$(queue_add "$d" "$now")"
    echo "queued ${d##*/}"
  done
}

# job_prepare JOB — check the job, make or adopt its worktree. Writes
# JOB/worktree on success, a final status otherwise. A lane job also gets
# JOB/lane-pr.md, the lane PR so far. Run it in a subshell.
job_prepare() {
  local d="$1" repo branch main def wt
  repo="$(jget "$d/job" repo)" branch="$(jget "$d/job" branch)"
  [[ -f "$d/prompt.md" ]] || {
    job_end "$d" failed "no prompt.md"
    return 0
  }
  cd "$repo" 2>/dev/null || {
    job_end "$d" failed "no directory '$repo'"
    return 0
  }
  main="$(main_repo_root 2>/dev/null)" || {
    job_end "$d" failed "$repo is not a git repo"
    return 0
  }
  def="$(default_branch "$main")"
  if [[ -z "$branch" || "$branch" == "$def" ]] || ! branch_ok "$branch"; then
    job_end "$d" failed "bad branch '$branch'"
    return 0
  fi
  wt="$(worktree_of "$main" "$branch")"
  # A GPU follow-up or a job a usage limit stopped resumes in its own dirty worktree.
  if [[ -n "$wt" && "$(jget "$d/job" follow)" != 1 && "$(jstate "$d" worktree)" != "$wt" &&
  -n "$(git -C "$wt" status --porcelain)" ]]; then
    job_end "$d" skipped "$wt has uncommitted changes"
    return 0
  fi
  if [[ -z "$wt" && -e "$(worktree_dir "$branch")" ]]; then
    job_end "$d" skipped "$(worktree_dir "$branch") exists but does not hold '$branch'"
    return 0
  fi
  open_worktree "$main" "$branch" "$def"
  if [[ "$(git -C "$WT" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "$branch" ]]; then
    job_end "$d" failed "no worktree for '$branch'"
    return 0
  fi
  echo "$def" >"$d/base"
  echo "$(basename "$main")-${branch//\//-}" >"$d/name"
  echo "$WT" >"$d/worktree"
  milestones_open "$WT" >"$d/milestones"
  if [[ -n "$(jget "$d/job" lane)" ]]; then lane_body "$d" running >"$d/lane-pr.md"; fi
}

# milestones_open WT — open milestones of WT/SPEC.md; empty without one.
milestones_open() {
  [[ -f "$1/SPEC.md" ]] || return 0
  grep -c '^- \[ \]' "$1/SPEC.md" || true
}

# pr_title_fallback JOB — `agent(<branch>): <lane or result>` when the job wrote no pr.md.
pr_title_fallback() {
  local r b
  r="$(jget "$1/job" lane)" b="$(jget "$1/job" branch)"
  if [[ -z "$r" ]]; then
    r="$(jstate "$1" result)"
    r="${r#*: }"
  fi
  echo "agent(${b#jobs/}): ${r:-${1##*/}}" | cut -c 1-60
}

# lane_jobs JOB — the lane jobs (`lane=`) in the queue on JOB's repo and branch, in id order.
lane_jobs() {
  local d repo branch
  repo="$(jget "$1/job" repo)" branch="$(jget "$1/job" branch)"
  for d in "$QDIR"/*/; do
    d="${d%/}"
    if [[ -f "$d/job" && -n "$(jget "$d/job" lane)" && "$(jget "$d/job" repo)" == "$repo" &&
    "$(jget "$d/job" branch)" == "$branch" ]]; then
      echo "$d"
    fi
  done
}

# lane_body JOB STATUS — the lane PR in the pr.md shape: the title and TL;DR of the
# latest done item, a `<item> → <side-branch>` line per item out of the lane, one
# <details> per item. STATUS is JOB's status, still `running` while it publishes.
lane_body() {
  local d="$1" j item s r side more branch last="" out="" det="" n=0 ok=0 title="" t="" verify="" risks=""
  branch="$(jget "$d/job" branch)"
  while IFS= read -r j; do
    [[ -n "$j" ]] || continue
    item="$(jget "$j/job" item)" item="${item:-${j##*/}}" r="$(jstate "$j" result)"
    s="$(jstate "$j" status)"
    if [[ "$j" == "$d" ]]; then s="$2"; fi
    n=$((n + 1))
    case "$s" in
      "done")
        ok=$((ok + 1)) last="$j"
        more="$(awk '/^<\/details>/ { f = 0 } f && (NF || p) { print; p = 1 } /^<summary>/ { f = 1 }' "$j/pr.md" 2>/dev/null || true)"
        det+=$'\n'"<details>"$'\n'"<summary>$item — done</summary>"$'\n\n'"${more:-${r#*: }}"$'\n\n'"_job ${j##*/}_"$'\n\n'"</details>"$'\n'
        ;;
      blocked | failed | timeout)
        side="$(jstate "$j" side)"
        side="${side:-$branch-$item}"
        out+="- $item → $side"$'\n'
        det+=$'\n'"<details>"$'\n'"<summary>$item — $s</summary>"$'\n\n'"${r:-$(jstate "$j" note)}"$'\n\n'"_job ${j##*/}_"$'\n\n'"</details>"$'\n'
        ;;
    esac
  done < <(lane_jobs "$d")
  if [[ -n "$last" ]]; then
    title="$(head -n 1 "$last/pr.md" 2>/dev/null || true)"
    t="$(md_line "$last/pr.md" Changed)"
    verify="$(md_line "$last/pr.md" Verify)" risks="$(md_line "$last/pr.md" Decisions/risks)"
    if [[ -z "$t" ]]; then
      t="$(jstate "$last" result)" t="${t#*: }"
    fi
  fi
  printf '%s\n\n**Context:** %s\n**Changed:** %s\n%s**Verify:** %s\n**Decisions/risks:** %s\n%s\n---\n_agent lane: %s/%s done_\n' \
    "${title:-$(pr_title_fallback "$d")}" "$(jget "$d/job" lane)" "${t:-none}" "$out" "${verify:-none}" "${risks:-none}" "$det" "$ok" "$n"
}

# job_publish JOB [STATUS] — push the job's commits; open a draft PR from JOB/pr.md,
# or replace the body of the PR already open on the branch. Label: agent.
# A lane job (`lane=`) writes the PR from every lane job on the branch (lane_body);
# STATUS is the job's own status, not final yet.
# `gh pr edit` fails on gh 2.45 (it asks for the removed projectCards); gh api does not.
job_publish() {
  local d="$1" wt base branch ahead title="" url lane
  local -a tflag=()
  wt="$(jstate "$d" worktree)" base="$(jstate "$d" base)" branch="$(jget "$d/job" branch)"
  ahead="$(git -C "$wt" rev-list --count "origin/$base..HEAD" 2>/dev/null || echo 0)"
  ((ahead > 0)) || return 0
  if ! git -C "$wt" push -q -u origin "$branch"; then
    echo "push failed" >"$d/pr"
    return 0
  fi
  command -v gh >/dev/null 2>&1 || return 0
  lane="$(jget "$d/job" lane)"
  if [[ -n "$lane" ]]; then
    lane_body "$d" "${2:-}" >"$d/lane-pr.md"
    title="$(head -n 1 "$d/lane-pr.md")" tflag=(-f "title=$title")
    tail -n +2 "$d/lane-pr.md" >"$d/pr-body.md"
  else
    if [[ -f "$d/pr.md" ]]; then tail -n +2 "$d/pr.md" >"$d/pr-body.md"; else : >"$d/pr-body.md"; fi
    printf '\n---\n_agent job %s: %s_\n' "$(basename "$d")" "$(jstate "$d" result)" >>"$d/pr-body.md"
  fi
  url="$( (cd "$wt" && gh pr list --head "$branch" --state open --json url -q '.[0].url') 2>/dev/null || true)"
  if [[ -n "$url" ]]; then
    (cd "$wt" && gh api --method PATCH "repos/{owner}/{repo}/pulls/${url##*/}" -F "body=@$d/pr-body.md" "${tflag[@]+"${tflag[@]}"}") >/dev/null 2>&1 || true
  else
    if [[ -z "$lane" ]]; then title="$(head -n 1 "$d/pr.md" 2>/dev/null || true)"; fi
    [[ -n "$title" ]] || title="$(pr_title_fallback "$d")"
    url="$( (cd "$wt" && gh pr create --draft --base "$base" --head "$branch" \
      --title "$title" --body-file "$d/pr-body.md") | tail -n 1 || true)"
  fi
  if [[ -n "$url" ]]; then
    (cd "$wt" && gh label create agent --color 5319e7 --description "opened by a job runner") >/dev/null 2>&1 || true
    (cd "$wt" && gh api --method POST "repos/{owner}/{repo}/issues/${url##*/}/labels" -f 'labels[]=agent') >/dev/null 2>&1 || true
  fi
  echo "${url:-PR not created}" >"$d/pr"
}

# job_chain JOB — a SPEC.md job that ticked a milestone and left one open
# queues the next one, with the same prompt.
job_chain() {
  local d="$1" wt before after tmp
  wt="$(jstate "$d" worktree)" before="$(jstate "$d" milestones)"
  after="$(milestones_open "$wt")"
  [[ -n "$before" && -n "$after" ]] || return 0
  ((after > 0 && after < before)) || return 0
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-job.XXXXXX")"
  grep -v '^now=' "$d/job" >"$tmp/job" || true
  cp "$d/prompt.md" "$tmp/prompt.md"
  echo "next milestone → $(basename "$(queue_add "$tmp")")"
}

# limit_reset LOG — the reset epoch when the agent stopped on a usage limit; empty else.
limit_reset() {
  local ev
  ev="$(grep -oE '"rate_limit_info":\{"status":"rejected"[^}]*' "$1" 2>/dev/null | tail -n 1 || true)"
  [[ "$ev" =~ \"resetsAt\":([0-9]+) ]] || return 0
  echo "${BASH_REMATCH[1]}"
}

# at_time EPOCH — EPOCH as YYYY-MM-DD HH:MM, GNU or BSD date.
at_time() { date -d "@$1" '+%F %H:%M' 2>/dev/null || date -r "$1" '+%F %H:%M'; }

# limited — true until the usage limit a job hit resets.
limited() {
  local t
  t="$(head -n 1 "$QROOT/limit" 2>/dev/null || true)"
  [[ "$t" =~ ^[0-9]+$ ]] && ((t > $(date +%s)))
}

# job_run JOB — the agent in the job's worktree, then publish. Runs in the
# background; it writes the final status itself, so it outlives a runner restart.
job_run() {
  local d="$1" rc=0 result st note="" t reset
  date '+%F %T' >"$d/started"
  t="$(job_timeout "$d")"
  local -a tcmd=("${TIMEOUT_CMD[@]+"${TIMEOUT_CMD[@]}"}")
  if ((${#tcmd[@]})); then tcmd+=("$t"); fi
  VIBE_JOB_DIR="$d" "${tcmd[@]+"${tcmd[@]}"}" bash "$SELF_ROOT/$AGENT/vibe-job.sh" \
    "$(jstate "$d" worktree)" "$(jstate "$d" name)" "$(jget "$d/job" model)" "$d/prompt.md" "$(jget "$d/job" effort)" >"$d/log" 2>&1 || rc=$?
  result="$(jstate "$d" result)"
  reset="$(limit_reset "$d/log")"
  if [[ -n "$reset" && "$result" != "done:"* ]]; then
    # A usage limit: requeue, keep the worktree, start nothing until the reset.
    echo "$reset" >"$QROOT/limit"
    echo queued >"$d/status"
    echo "usage limit — retry after $(at_time "$reset")" >"$d/note"
    rm -f "$d/pid"
    return 0
  fi
  if ((rc == 124 || rc == 137)); then
    st=timeout note="stopped after $t"
  elif ((rc != 0)); then
    st=failed note="agent exit $rc: $(tail -n 1 "$d/log" 2>/dev/null | cut -c 1-160 || true)"
  else
    case "$result" in
      "done:"*) st="done" ;;
      "blocked:"*) st=blocked ;;
      "queued:"*) st=gpu ;;
      *) st=failed note="no result line" ;;
    esac
  fi
  job_publish "$d" "$st" || true
  job_end "$d" "$st" "${result:-$note}"
  if [[ "$st" == "done" ]]; then job_chain "$d"; fi
}

# agent_check AGENT — dies unless <agent>/vibe-job.sh exists.
agent_check() {
  [[ -n "$1" && "$1" != */* && -f "$SELF_ROOT/$1/vibe-job.sh" ]] ||
    die "no job runner for '$1' — $SELF_ROOT/$1/vibe-job.sh is missing"
}

# queue_order JOB... — the jobs that may start now, in start order: --now
# jobs, then in the night window heavy jobs, then light ones. Paused or
# limited: none.
queue_order() {
  local d night=0 now=() heavy=() light=()
  [[ ! -e "$QROOT/paused" ]] || return 0
  if limited; then return 0; fi
  if in_window; then night=1; fi
  for d in "$@"; do
    if [[ "$(jget "$d/job" now)" == 1 ]]; then
      now+=("$d")
    elif job_heavy "$d"; then
      heavy+=("$d")
    else
      light+=("$d")
    fi
  done
  if ((!night)); then heavy=(); fi
  for d in "${now[@]+"${now[@]}"}" "${heavy[@]+"${heavy[@]}"}" "${light[@]+"${light[@]}"}"; do echo "$d"; done
}

# branch_key JOB — repo and branch: one running job per branch.
branch_key() { echo "$(jget "$1/job" repo)#$(jget "$1/job" branch)"; }

# vibe queue run --<agent> [--drain] — the runner: polls the queue for ever and
# starts jobs in free slots (config slots_day 2, slots_night 4). --drain stops
# once nothing runs, waits on the GPU or may start.
cmd_queue_run() {
  local drain=0 d pid running waiting slots busy started queued=() order
  AGENT=""
  while (($#)); do
    case "$1" in
      --drain) drain=1 ;;
      -h | --help) usage ;;
      --?*)
        [[ -z "$AGENT" ]] || die "one agent only"
        AGENT="${1#--}"
        ;;
      *) die "usage: vibe queue run --<agent> [--drain], e.g. --claude" ;;
    esac
    shift
  done
  [[ -n "$AGENT" ]] || die "usage: vibe queue run --<agent> [--drain], e.g. --claude"
  agent_check "$AGENT"
  mkdir -p "$QDIR"
  TIMEOUT_CMD=()
  if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(timeout --kill-after=60)
  elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(gtimeout --kill-after=60)
  else
    warn "no timeout(1) — jobs run without a time limit"
  fi
  info "queue $QDIR: window $(window), slots $(qconf slots_day 2) by day, $(qconf slots_night 4) by night"
  while :; do
    running=0 waiting=0 busy="" queued=()
    for d in "$QDIR"/*/; do
      d="${d%/}"
      [[ -f "$d/job" ]] || continue
      case "$(jstate "$d" status)" in
        running)
          pid="$(jstate "$d" pid)"
          if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            running=$((running + 1)) busy+=" $(branch_key "$d")"
          else
            job_end "$d" failed "job process died"
          fi
          ;;
        gpu) waiting=$((waiting + 1)) ;;
        "" | queued) queued+=("$d") ;;
      esac
    done
    order="$(queue_order "${queued[@]+"${queued[@]}"}")"
    if ((drain && running == 0 && waiting == 0)) && [[ -z "$order" ]]; then break; fi
    slots="$(qconf slots_day 2)"
    if in_window; then slots="$(qconf slots_night 4)"; fi
    started=0
    while IFS= read -r d; do
      [[ -n "$d" ]] || continue
      ((running < slots)) || break
      [[ " $busy " != *" $(branch_key "$d") "* ]] || continue
      echo running >"$d/status"
      (job_prepare "$d") >>"$d/runner.log" 2>&1 || true
      if [[ "$(jstate "$d" status)" != running || ! -s "$d/worktree" ]]; then
        [[ "$(jstate "$d" status)" != running ]] || job_end "$d" failed "prepare failed — see runner.log"
        continue
      fi
      job_run "$d" >>"$d/runner.log" 2>&1 &
      echo "$!" >"$d/pid"
      running=$((running + 1)) busy+=" $(branch_key "$d")" started=1
      info "started ${d##*/}"
    done <<<"$order"
    # A drain whose only startable jobs wait on a busy branch must not spin.
    if ((drain && running == 0 && waiting == 0 && !started)); then break; fi
    sleep "${VIBE_QUEUE_POLL:-30}"
  done
  info "queue drained"
}

# queue_job ID — the job dir of ID (an id or a path); dies when absent.
queue_job() {
  local d="${1%/}"
  [[ "$d" == */* ]] || d="$QDIR/$d"
  [[ -f "$d/job" ]] || die "no job $1 in $QDIR"
  echo "$d"
}

# vibe queue hold ID NOTE... — keep a finished job unreviewed, first in every briefing.
cmd_queue_hold() {
  local d
  (($# >= 2)) || die "usage: vibe queue hold <id> <note>"
  d="$(queue_job "$1")"
  shift
  echo "$*" >"$d/held"
  echo "held ${d##*/}"
}

# vibe queue archive ID... — move reviewed jobs to archive/<YYYY-MM>/.
cmd_queue_archive() {
  local d a
  (($#)) || die "usage: vibe queue archive <id>..."
  a="$QROOT/archive/$(date +%Y-%m)"
  for d in "$@"; do
    d="$(queue_job "$d")"
    job_final "$d" || die "${d##*/} has not ended ($(jstate "$d" status)) — archive it once it has"
    mkdir -p "$a"
    mv "$d" "$a/"
    echo "archived ${d##*/}"
  done
}

cmd_queue_pause() {
  mkdir -p "$QROOT"
  touch "$QROOT/paused"
  echo "paused: no new job starts; running jobs finish"
}
cmd_queue_resume() {
  rm -f "$QROOT/paused"
  echo "resumed"
}

# vibe queue gpu -- CMD... — from inside a job: queue CMD on the GPU
# (cwd: the worktree); when it ends, a follow-up job continues the task.
cmd_queue_gpu() {
  local d="${VIBE_JOB_DIR:-}" id
  [[ -n "$d" && -f "$d/job" ]] || die "vibe queue gpu runs inside a queue job (VIBE_JOB_DIR)"
  case "${1:-}" in
    -h | --help) usage ;;
    --) shift ;;
    -*) die "usage: vibe queue gpu -- CMD..." ;;
  esac
  (($#)) || die "usage: vibe queue gpu -- CMD..."
  id="$("$SELF_ROOT/bin/gpu-queue" submit --name "${d##*/}" --dir "$PWD" \
    --then "$(printf '%q ' "$SELF_ROOT/bin/vibe" queue follow "$d")" -- "$@")" || die "gpu-queue submit failed"
  echo "$id" >"$d/gpu-job"
  echo "queued $id — now write result 'queued: <what runs>' and exit"
}

# vibe queue follow JOB — gpu-queue's --then: a follow-up job on JOB's branch
# with the run's exit code and log (GPUQ_EXIT, GPUQ_LOG). It sorts right
# after JOB, so it runs before later jobs.
cmd_queue_follow() {
  local p="${1:?usage: vibe queue follow <job dir>}" f n=1
  p="${p%/}"
  [[ -f "$p/job" ]] || die "no job at $p"
  f="$p-gpu"
  while [[ -e "$f" ]]; do
    n=$((n + 1))
    f="$p-gpu$n"
  done
  mkdir -p "$f"
  {
    cat "$p/prompt.md"
    printf '\n## GPU run finished\n\n- Exit: %s\n- Log: %s\n\n' "${GPUQ_EXIT:-?}" "${GPUQ_LOG:-?}"
    echo "An earlier session prepared and queued this run; its commits are on the branch."
    echo "Read the log and the outputs, check the done-when, finish the task."
  } >"$f/prompt.md"
  # The job file last: the runner skips a dir without one.
  {
    grep -v '^follow=' "$p/job" || true
    echo "follow=1"
  } >"$f/job"
  job_end "$p" "done" "GPU run exit ${GPUQ_EXIT:-?} → ${f##*/}"
}

# queue_header — one line: running, queued, to review, window, paused.
queue_header() {
  local d st r=0 q=0 h=0 g=0 v=0 open=closed slots
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ -f "$d/job" ]] || continue
    st="$(jstate "$d" status)"
    case "$st" in
      running) r=$((r + 1)) ;;
      gpu) g=$((g + 1)) ;;
      "" | queued)
        q=$((q + 1))
        if job_heavy "$d"; then h=$((h + 1)); fi
        ;;
      *) v=$((v + 1)) ;;
    esac
  done
  slots="$(qconf slots_day 2)"
  if in_window; then open=open slots="$(qconf slots_night 4)"; fi
  printf 'queue: %s running · %s on the GPU · %s queued (%s heavy, start in the window) · %s to review · window %s %s, %s slots' \
    "$r" "$g" "$q" "$h" "$v" "$(window)" "$open" "$slots"
  if [[ -e "$QROOT/paused" ]]; then printf ' · PAUSED'; fi
  if limited; then printf ' · USAGE LIMIT until %s' "$(at_time "$(head -n 1 "$QROOT/limit")")"; fi
  echo
}

# queue_repos — the repos of the queued jobs, sorted.
queue_repos() {
  local d
  for d in "$QDIR"/*/; do [[ ! -f "$d/job" ]] || jget "$d/job" repo; done | sort -u
}

# vibe queue status — the header, then one line per job, grouped by repo.
cmd_queue_status() {
  local repo d st txt w=0
  queue_header
  for d in "$QDIR"/*/; do
    d="${d%/}" && d="${d##*/}"
    if [[ -f "$QDIR/$d/job" && ${#d} -gt $w ]]; then w=${#d}; fi
  done
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    echo
    echo "${repo##*/}"
    for d in "$QDIR"/*/; do
      d="${d%/}"
      [[ -f "$d/job" && "$(jget "$d/job" repo)" == "$repo" ]] || continue
      st="$(jstate "$d" status)" txt="$(jget "$d/job" context)"
      if job_final "$d"; then txt="$(jstate "$d" note)"; fi
      [[ ! -f "$d/held" ]] || st="held"
      printf '  %-*s  %-8s %-5s  %s %s\n' "$w" "${d##*/}" "${st:-queued}" \
        "$(if job_heavy "$d"; then echo heavy; else echo light; fi)" "$txt" "$(jstate "$d" pr)"
    done
  done < <(queue_repos)
}

# in_list NEEDLE WORD... — true when NEEDLE is one of the words.
in_list() {
  local n="$1" w
  shift
  for w in "$@"; do [[ "$w" != "$n" ]] || return 0; done
  return 1
}

# md_line FILE KEY — the text after `**KEY:**` on its first line in FILE.
md_line() {
  local t
  t="$(grep -m 1 "^\*\*$2:\*\*" "$1" 2>/dev/null || true)"
  t="${t#\*\*"$2":\*\*}"
  echo "${t# }"
}

# report_tldr JOB — the `Changed:` line of the job's pr.md, else its result.
report_tldr() {
  local t
  t="$(md_line "$1/pr.md" Changed)"
  echo "${t:-$(jstate "$1" note)}"
}

# report_context JOB — `context=` of the job file, else the `Context:` line of pr.md or report.md.
report_context() {
  local t
  t="$(jget "$1/job" context)"
  [[ -n "$t" ]] || t="$(md_line "$1/pr.md" Context)"
  [[ -n "$t" ]] || t="$(md_line "$1/report.md" Context)"
  echo "$t"
}

# report_row JOB TEXT — one table row: id, status, context, TEXT, links.
report_row() {
  local d="$1" pr ctx links=""
  pr="$(jstate "$d" pr)" ctx="$(report_context "$d")"
  case "$pr" in http*) links="[PR]($pr)" ;; esac
  [[ ! -f "$d/report.md" ]] || links="${links:+$links · }[report](file://$d/report.md)"
  echo "| ${d##*/} | $(jstate "$d" status) | ${ctx//|//} | ${2//|//} | $links |"
}

# report_rows REPO TITLE CLASS... — one table of REPO's ended, unheld jobs in
# the classes: a status, or `pr` (done with a PR URL; `done` is then done
# without one). No rows, no table.
report_rows() {
  local repo="$1" title="$2" d cls rows=""
  shift 2
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ -f "$d/job" && ! -f "$d/held" && "$(jget "$d/job" repo)" == "$repo" ]] || continue
    job_final "$d" || continue
    cls="$(jstate "$d" status)"
    case "$(jstate "$d" pr)" in http*) [[ "$cls" != "done" ]] || cls="pr" ;; esac
    in_list "$cls" "$@" || continue
    rows+="$(report_row "$d" "$(report_tldr "$d")")"$'\n'
  done
  [[ -n "$rows" ]] || return 0
  echo
  echo "### $title"
  echo
  echo "| Job | Status | Context | TL;DR | Links |"
  echo "| --- | --- | --- | --- | --- |"
  printf '%s' "$rows"
}

# queue_report_md — the briefing: the header, held jobs under "Yours", then per
# repo ranked tables (needs a human, PRs to read, the rest), then the next
# action of every unheld job that did not finish.
queue_report_md() {
  local d st wt repo rows=""
  echo "# Vibe queue — $(date '+%F %H:%M')"
  echo
  queue_header
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ -f "$d/held" ]] || continue
    rows+="$(report_row "$d" "$(jstate "$d" held)")"$'\n'
  done
  if [[ -n "$rows" ]]; then
    printf '\n## Yours\n\n| Job | Status | Context | Note | Links |\n| --- | --- | --- | --- | --- |\n%s' "$rows"
  fi
  if [[ -f "$QROOT/triage.md" ]]; then
    echo
    cat "$QROOT/triage.md"
  fi
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    rows="$(
      report_rows "$repo" "Needs you" blocked failed timeout skipped
      report_rows "$repo" "PR ready" pr
      report_rows "$repo" "Done, nothing to read" "done"
    )"
    [[ -n "$rows" ]] || continue
    echo
    echo "## ${repo##*/}"
    echo "$rows"
  done < <(queue_repos)
  for d in "$QDIR"/*/; do
    d="${d%/}"
    st="$(jstate "$d" status)"
    case "$st" in blocked | failed | timeout | skipped) ;; *) continue ;; esac
    [[ -f "$d/job" && ! -f "$d/held" ]] || continue
    wt="$(jstate "$d" worktree)"
    echo
    echo "## ${d##*/} — $st"
    echo
    echo "- Repo: $(jget "$d/job" repo) · branch \`$(jget "$d/job" branch)\`"
    [[ -z "$wt" ]] || echo "- Worktree: $wt"
    [[ ! -f "$d/report.md" ]] || echo "- Report: $d/report.md"
    if [[ -n "$wt" && -f "$wt/HANDOFF.md" ]]; then
      echo "- Next action:"
      md_section "$wt/HANDOFF.md" "Next action" "  "
      echo "- Blockers:"
      md_section "$wt/HANDOFF.md" Blockers "  "
    fi
    case "$st" in failed | timeout) echo "- Log: $d/log" ;; esac
  done
}

# vibe queue report — a fresh briefing to QROOT/briefings/<date>-<HHMM>.md,
# copied as briefing-<…>.md with note frontmatter to the directory named in
# ~/.config/vibe/briefing-dir when that file exists.
cmd_queue_report() {
  local file copy dest
  [[ $# -eq 0 ]] || die "usage: vibe queue report"
  file="$QROOT/briefings/$(date +%F-%H%M).md"
  mkdir -p "${file%/*}"
  queue_report_md >"$file"
  echo "briefing: $file"
  copy="$(head -n 1 "$QCONF/briefing-dir" 2>/dev/null || true)"
  copy="${copy/#\~/$HOME}"
  if [[ -n "$copy" ]]; then
    dest="$copy/briefing-${file##*/}"
    mkdir -p "$copy"
    {
      printf -- '---\ncreated: %s\ntouched_by_ai: true\n---\n\n' "$(date +%F)"
      cat "$file"
    } >"$dest"
    echo "copied: $dest"
  fi
}

cmd_queue() {
  role_gate queue "$@"
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add | run | status | report | hold | archive | pause | resume | gpu | follow) "cmd_queue_$sub" "$@" ;;
    *) die "usage: vibe queue add|run|status|report|hold|archive|pause|resume — see vibe --help" ;;
  esac
}

# --- job: recurring jobs, added to the queue by the 01:00 timer (docs/vibe-jobs.md)

JOBS_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/vibe/jobs"
JOBS_ROOT="${VIBE_ROOT:-$(dirname "$SELF_ROOT")}"
JOBS_CATALOGUE="${VIBE_JOBS_CATALOGUE:-$SELF_ROOT/skills/recurring-jobs/references/jobs}"

# fm_get FILE KEY — `KEY: value` from FILE's frontmatter; empty when absent.
fm_get() {
  awk -v k="$2" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); print v; exit }' "$1" 2>/dev/null || true
}
# fm_body FILE — FILE after its frontmatter (the whole file without one).
fm_body() {
  awk 'NR == 1 && $0 != "---" { all = 1 } all { print; next } NR > 1 && !on && $0 == "---" { on = 1; next } on { print }' "$1" 2>/dev/null || true
}

# job_repos [REPO...] — absolute repo paths: the arguments, else every repo
# under the root with a .vibe-jobs/ opt-in.
job_repos() {
  local r
  if (($#)); then
    for r in "$@"; do job_repo_path "$r"; done
    return 0
  fi
  for r in "$JOBS_ROOT"/*/.vibe-jobs/; do
    r="${r%/.vibe-jobs/}"
    if [[ -n "$(job_names "$r")" ]]; then echo "$r"; fi
  done
}
job_repo_path() {
  case "$1" in */*) echo "$1" ;; *) echo "$JOBS_ROOT/$1" ;; esac
}

# job_names REPO — the jobs REPO opted into: one per <repo>/.vibe-jobs/<name>.md.
job_names() {
  local f
  for f in "$1"/.vibe-jobs/*.md; do
    [[ -f "$f" ]] || continue
    f="${f##*/}"
    case "$f" in _*) continue ;; esac
    echo "${f%.md}"
  done
}

# job_key REPO JOB KEY DEFAULT — the repo file's value, else the catalogue's, else DEFAULT.
job_key() {
  local v
  v="$(fm_get "$1/.vibe-jobs/$2.md" "$3")"
  [[ -n "$v" ]] || v="$(fm_get "$JOBS_CATALOGUE/$2.md" "$3")"
  echo "${v:-$4}"
}

# job_check REPO JOB — "ok", or why the job cannot run.
job_check() {
  local repo="$1" job="$2" sched
  [[ "$(slug "$job")" == "$job" ]] || {
    echo "bad name '$job'"
    return 0
  }
  sched="$(job_key "$repo" "$job" schedule "")"
  case "$sched" in
    daily | weekly | monthly) ;;
    "") echo "no schedule — not in the catalogue, and the repo file sets none" && return 0 ;;
    *) echo "bad schedule '$sched'" && return 0 ;;
  esac
  if [[ ! -f "$JOBS_CATALOGUE/$job.md" && -z "$(fm_body "$repo/.vibe-jobs/$job.md" | grep -v '^[[:space:]]*$' || true)" ]]; then
    echo "not in the catalogue, and the repo file has no instructions"
    return 0
  fi
  echo ok
}

# job_state REPO JOB FILE — a state file's first line (last-run epoch, fails).
job_state() { head -n 1 "$JOBS_STATE/$(basename "$1")/$2/$3" 2>/dev/null || true; }

# job_state_update JOB-DIR STATUS — done: stamp last-run, forget failures;
# failed/timeout: one more failure. Two in a row stop the job (job_due).
job_state_update() {
  local d="$1" st="$2" dir n
  dir="$JOBS_STATE/$(basename "$(jget "$d/job" repo)")/$(jget "$d/job" recurring)"
  mkdir -p "$dir"
  case "$st" in
    "done")
      date +%s >"$dir/last-run"
      rm -f "$dir/fails"
      ;;
    failed | timeout)
      n="$(head -n 1 "$dir/fails" 2>/dev/null || echo 0)"
      echo $((n + 1)) >"$dir/fails"
      ;;
  esac
}

# job_due REPO JOB — "due", "stopped" (two failures), "not due", "invalid".
job_due() {
  local repo="$1" job="$2" sched day last fails now period today
  [[ "$(job_check "$repo" "$job")" == ok ]] || {
    echo invalid
    return 0
  }
  fails="$(job_state "$repo" "$job" fails)"
  if ((${fails:-0} >= 2)); then
    echo stopped
    return 0
  fi
  sched="$(job_key "$repo" "$job" schedule "")" day="$(job_key "$repo" "$job" day "")"
  case "$sched" in
    daily) period=72000 ;;
    weekly) period=518400 ;;
    monthly) period=2332800 ;;
  esac
  last="$(job_state "$repo" "$job" last-run)"
  now="$(date +%s)"
  today="$(LC_ALL=C date +%a | tr '[:upper:]' '[:lower:]')"
  if ((now - ${last:-0} < period)) || [[ -n "$day" && "$day" != "$today" ]]; then
    echo "not due"
  else
    echo due
  fi
}

# vibe job list [--all] [REPO...] — one row per repo × job; --all adds the
# catalogue jobs REPO has not opted into, as `available`.
cmd_job_list() {
  local repo job last fails why all=0 repos=() f
  for f in "$@"; do
    case "$f" in
      --all) all=1 ;;
      -h | --help) usage ;;
      -*) die "usage: vibe job list [--all] [<repo>...]" ;;
      *) repos+=("$f") ;;
    esac
  done
  printf '%-21s %-20s %-8s %-4s %-11s %s\n' REPO JOB SCHEDULE DAY LAST-RUN STATE
  while IFS= read -r repo; do
    [[ -d "$repo" ]] || {
      printf '%-21s %s\n' "$(basename "$repo")" "no directory $repo"
      continue
    }
    while IFS= read -r job; do
      [[ -n "$job" ]] || continue
      last="$(job_state "$repo" "$job" last-run)" fails="$(job_state "$repo" "$job" fails)"
      [[ -z "$last" ]] || last="$(date -d "@$last" +%F 2>/dev/null || date -r "$last" +%F)"
      why="$(job_due "$repo" "$job")"
      case "$why" in
        invalid) why="invalid: $(job_check "$repo" "$job")" ;;
        stopped) why="stopped: $fails failures — rm $JOBS_STATE/$(basename "$repo")/$job/fails" ;;
      esac
      printf '%-21s %-20s %-8s %-4s %-11s %s\n' "$(basename "$repo")" "$job" \
        "$(job_key "$repo" "$job" schedule -)" "$(job_key "$repo" "$job" day -)" "${last:-never}" "$why"
    done < <(job_names "$repo")
    ((all)) || continue
    for f in "$JOBS_CATALOGUE"/*.md; do
      job="${f##*/}" && job="${job%.md}"
      [[ "$job" != _* && ! -f "$repo/.vibe-jobs/$job.md" ]] || continue
      printf '%-21s %-20s %-8s %-4s %-11s %s\n' "$(basename "$repo")" "$job" \
        "$(fm_get "$f" schedule)" "$(fm_get "$f" day)" - "available — vibe job add $(basename "$repo") $job"
    done
  done < <(job_repos "${repos[@]+"${repos[@]}"}")
  sweep_line
}

# sweep_line — the repos the fill-queue sweep covers (~/.config/vibe/repos).
sweep_line() {
  local conf="$QCONF/repos" line names=""
  if [[ ! -f "$conf" ]]; then
    printf '\nfill-queue sweep: no %s\n' "$conf"
    return 0
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(echo "$line" | tr -d '[:space:]')"
    [[ -z "$line" ]] || names+="${names:+, }${line##*/}"
  done <"$conf"
  # shellcheck disable=SC2088  # a literal ~ for display
  case "$conf" in "$HOME"/*) conf="~/${conf#"$HOME"/}" ;; esac
  printf '\nfill-queue sweep (%s): %s\n' "$conf" "${names:-none}"
}

# job_open_prs REPO — "branch" per open PR a runner opened; empty without gh.
job_open_prs() {
  command -v gh >/dev/null 2>&1 || return 0
  (cd "$1" && gh pr list --label agent --state open --json headRefName -q '.[].headRefName' 2>/dev/null) || true
}

# job_write DIR REPO JOB — the job dir: `job` and the rendered prompt.
# Output drops to `report` when the repo already has 2 open job PRs and this
# job's branch is not one of them.
job_write() {
  local d="$1" repo="$2" job="$3" branch output prs n tpl
  branch="jobs/$job"
  output="$(job_key "$repo" "$job" output pr)"
  if [[ "$output" == pr ]]; then
    prs="$(job_open_prs "$repo")"
    n="$(printf '%s\n' "$prs" | grep -c '^jobs/' || true)"
    if ((n >= 2)) && ! printf '%s\n' "$prs" | grep -qx "$branch"; then output=report; fi
  fi
  printf 'repo=%s\nbranch=%s\nmodel=%s\ntimeout=%s\nrecurring=%s\noutput=%s\n' \
    "$repo" "$branch" "$(job_key "$repo" "$job" model sonnet)" "$(job_key "$repo" "$job" timeout 1h)" \
    "$job" "$output" >"$d/job"
  tpl="$SELF_ROOT/skills/recurring-jobs/references/job-prompt.md"
  render_template "$tpl" \
    '<job>' "$job" \
    '<repo>' "$repo" \
    '<branch>' "$branch" \
    '<output>' "$output" \
    '<timeout>' "$(job_key "$repo" "$job" timeout 1h)" \
    '<catalogue-instructions>' "$(fm_body "$JOBS_CATALOGUE/$job.md")" \
    '<repo-instructions>' "$(fm_body "$repo/.vibe-jobs/$job.md")" \
    '<pr-template>' "$(cat "$SELF_ROOT/templates/job-pr.md")" \
    '<report-template>' "$(cat "$SELF_ROOT/templates/job-report.md")" >"$d/prompt.md"
}

# job_queue DRY "REPO JOB"... — add the jobs to the queue.
job_queue() {
  local dry="$1" item tmp d
  shift
  if (($# == 0)); then
    echo "nothing to queue"
    return 0
  fi
  for item in "$@"; do
    if ((dry)); then
      echo "would queue: $item"
      continue
    fi
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-job.XXXXXX")"
    job_write "$tmp" "${item% *}" "${item##* }"
    d="$(queue_add "$tmp")"
    echo "queued ${d##*/} ($(jget "$d/job" output))"
  done
}

# job_args ARGS... — parse --dry, --max N; the rest into REST.
job_args() {
  DRY=0 MAX=4 REST=()
  while (($#)); do
    case "$1" in
      --dry) DRY=1 ;;
      --max) MAX="${2:?--max needs a number}" && shift ;;
      -h | --help) usage ;;
      -*) die "unknown option '$1'" ;;
      *) REST+=("$1") ;;
    esac
    shift
  done
  [[ "$MAX" =~ ^[1-9][0-9]*$ ]] || die "--max wants a positive number, got '$MAX'"
}

# job_stopped REPO JOB — add a `skipped` entry for a stopped job, unless the
# queue already holds one, so the briefing shows it under "Needs you".
job_stopped() {
  local repo="$1" job="$2" d tmp
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ "$(jget "$d/job" repo)" == "$repo" && "$(jget "$d/job" branch)" == "jobs/$job" &&
    "$(jstate "$d" status)" == skipped ]] && return 0
  done
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-job.XXXXXX")"
  printf 'repo=%s\nbranch=jobs/%s\nmodel=sonnet\n' "$repo" "$job" >"$tmp/job"
  job_end "$tmp" skipped "stopped after 2 failures — rm $JOBS_STATE/$(basename "$repo")/$job/fails"
  queue_add "$tmp" >/dev/null
}

# vibe job due [--dry] [--max N] [REPO...] — add every due job to the queue,
# oldest last-run first, at most N. A stopped job lands as `skipped`.
cmd_job_due() {
  local repo job why last lines="" picked=() stopped=()
  job_args "$@"
  while IFS= read -r repo; do
    [[ -d "$repo" ]] || continue
    while IFS= read -r job; do
      [[ -n "$job" ]] || continue
      why="$(job_due "$repo" "$job")"
      case "$why" in
        due)
          last="$(job_state "$repo" "$job" last-run)"
          lines+="${last:-0} $repo $job"$'\n'
          ;;
        stopped) stopped+=("$repo $job") ;;
      esac
    done < <(job_names "$repo")
  done < <(job_repos "${REST[@]+"${REST[@]}"}")
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    ((${#picked[@]} < MAX)) || break
    picked+=("${repo#* }")
  done < <(printf '%s' "$lines" | sort -n -k1,1)
  job_queue "$DRY" "${picked[@]+"${picked[@]}"}"
  for job in "${stopped[@]+"${stopped[@]}"}"; do
    if ((!DRY)); then job_stopped "${job% *}" "${job##* }"; fi
    echo "stopped: $job (2 failures)"
  done
}

# vibe job run REPO JOB — add one job to the queue now, due or not.
cmd_job_run() {
  local repo why
  job_args "$@"
  ((${#REST[@]} == 2)) || die "usage: vibe job run <repo> <job>"
  repo="$(job_repo_path "${REST[0]}")"
  [[ -d "$repo" ]] || die "no directory $repo"
  why="$(job_check "$repo" "${REST[1]}")"
  [[ "$why" == ok ]] || die "${REST[1]} in $(basename "$repo"): $why"
  job_queue "$DRY" "$repo ${REST[1]}"
}

# TRIAGE_JQ — one line per PR: number url head base mergeable red-checks new-comments.
# Split by \037: a tab IFS collapses an empty field. New: after the last non-merge commit.
# shellcheck disable=SC2016  # jq variables, not shell ones
TRIAGE_JQ='.[] | ([.commits[] | select(.messageHeadline | startswith("Merge ") | not) | .committedDate] | max // "") as $t
| [.number, .url, .headRefName, .baseRefName, .mergeable,
   ([.statusCheckRollup[] | select((.conclusion // .state // "") | test("^(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE)$")) | (.name // .context)] | join(", ")),
   ([.comments[].createdAt, .reviews[].submittedAt] | map(select(. > $t)) | length)] | map(tostring) | join("\u001f")'

# triage_merge REPO HEAD BASE — merge origin/BASE into origin/HEAD in a scratch
# worktree and push; one line on what happened. Skips a branch a job runs on
# or one with unpushed local commits: the push would strand their work.
triage_merge() {
  local repo="$1" head="$2" base="$3" d tmp files
  for d in "$QDIR"/*/; do
    d="${d%/}"
    if [[ "$(jget "$d/job" repo)" == "$repo" && "$(jget "$d/job" branch)" == "$head" &&
    "$(jstate "$d" status)" == running ]]; then
      echo "conflicts with $base; not merged: a job runs on it"
      return 0
    fi
  done
  if [[ "$(git -C "$repo" rev-list --count "origin/$head..refs/heads/$head" 2>/dev/null || echo 0)" != 0 ]]; then
    echo "conflicts with $base; not merged: local commits not pushed"
    return 0
  fi
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-triage.XXXXXX")/wt"
  if ! git -C "$repo" worktree add -q --detach "$tmp" "origin/$head" >/dev/null 2>&1; then
    echo "conflicts with $base; not merged: no origin/$head"
    return 0
  fi
  if git -C "$tmp" merge -q --no-edit -m "Merge branch '$base' into $head" "origin/$base" >/dev/null 2>&1; then
    if git -C "$tmp" push -q origin "HEAD:refs/heads/$head" 2>/dev/null; then
      echo "merged $base and pushed"
    else
      echo "merged $base; push failed"
    fi
  else
    files="$(git -C "$tmp" diff --name-only --diff-filter=U | tr '\n' ' ')"
    git -C "$tmp" merge --abort 2>/dev/null || true
    echo "conflicts with $base in ${files% }: needs a hand merge"
  fi
  git -C "$repo" worktree remove --force "$tmp" 2>/dev/null || true
  rm -rf "${tmp%/wt}"
}

# vibe job triage [REPO...] — every open agent PR of every repo under the
# root: merge the base into a conflicted one and push; red CI and unanswered
# review comments become lines in QROOT/triage.md, which the briefing shows.
cmd_job_triage() {
  local repo n url head base mergeable red comments out lines="" r
  command -v gh >/dev/null 2>&1 || {
    echo "no gh — nothing to triage"
    return 0
  }
  local repos=("$@")
  if ((${#repos[@]} == 0)); then
    for r in "$JOBS_ROOT"/*/; do [[ ! -d "$r/.git" ]] || repos+=("${r%/}"); done
  fi
  for repo in "${repos[@]+"${repos[@]}"}"; do
    repo="$(job_repo_path "$repo")"
    out="$( (cd "$repo" && gh pr list --label agent --state open \
      --json number,url,headRefName,baseRefName,mergeable,statusCheckRollup,comments,reviews,commits \
      -q "$TRIAGE_JQ") 2>/dev/null || true)"
    [[ -n "$out" ]] || continue
    git -C "$repo" fetch -q origin 2>/dev/null || warn "$(basename "$repo"): fetch failed"
    while IFS=$'\037' read -r n url head base mergeable red comments; do
      [[ -n "$n" ]] || continue
      r="- $(basename "$repo") [#$n]($url) \`$head\`:"
      if [[ "$mergeable" == CONFLICTING ]]; then lines+="$r $(triage_merge "$repo" "$head" "$base")"$'\n'; fi
      if [[ -n "$red" ]]; then lines+="$r CI red: $red"$'\n'; fi
      if ((comments > 0)); then lines+="$r unanswered review comments: $comments"$'\n'; fi
    done <<<"$out"
  done
  mkdir -p "$QROOT"
  if [[ -z "$lines" ]]; then
    rm -f "$QROOT/triage.md"
    echo "triage: nothing to report"
    return 0
  fi
  printf '## Triage — %s\n\n%s' "$(date '+%F %H:%M')" "$lines" >"$QROOT/triage.md"
  printf '%s' "$lines"
}

# vibe job add REPO JOB — render templates/VIBE_JOB.md to <repo>/.vibe-jobs/<job>.md.
cmd_job_add() {
  local repo="${1:?usage: vibe job add <repo> <job>}" job="${2:?usage: vibe job add <repo> <job>}" f
  repo="$(job_repo_path "$repo")"
  [[ -d "$repo" ]] || die "no directory $repo"
  [[ "$(slug "$job")" == "$job" ]] || die "bad job name '$job'"
  [[ -f "$JOBS_CATALOGUE/$job.md" ]] || info "'$job' is not in the catalogue — the file needs its own schedule and instructions"
  f="$repo/.vibe-jobs/$job.md"
  [[ ! -e "$f" ]] || die "$f exists — edit it"
  mkdir -p "$repo/.vibe-jobs"
  render_template "$SELF_ROOT/templates/VIBE_JOB.md" '<job>' "$job" '<repo>' "$(basename "$repo")" >"$f"
  echo "wrote $f — edit, then commit it"
}

cmd_job() {
  role_gate job "$@"
  local sub="${1:-}"
  shift || true
  case "$sub" in
    list | due | run | add | triage) "cmd_job_$sub" "$@" ;;
    *) die "usage: vibe job list|due|run|add|triage — see vibe --help" ;;
  esac
}

case "${1:-}" in
  queue)
    shift
    cmd_queue "$@"
    ;;
  job)
    shift
    cmd_job "$@"
    ;;
  update-toolkit)
    shift
    cmd_update_toolkit "$@"
    ;;
  start | sync | status)
    cmd="$1"
    shift
    # sync fetches every repo anyway, so its check never uses the cache.
    if [[ "$cmd" == sync ]]; then VIBE_FETCH_INTERVAL=0 toolkit_check; else toolkit_check; fi
    "cmd_$cmd" "$@"
    ;;
  -h | --help | help) usage ;;
  *) die "unknown command '${1:-}' — vibe help" ;;
esac
