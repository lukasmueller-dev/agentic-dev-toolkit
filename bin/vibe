#!/usr/bin/env bash
#
# vibe — remote-first coding workflow across Mac (local) and Linux server.
#
# Core idea:
#   - Each TASK gets its own git branch + git worktree under
#     $VIBE_WORKTREE_ROOT/<repo>/<branch> (default ~/git/worktrees).
#   - On the SERVER, every task runs inside its own persistent tmux session, so
#     the agent keeps working when you disconnect SSH.
#   - On the MAC (local), no tmux is forced — you just get dropped into the worktree.
#   - Every worktree gets a HANDOFF.md so the two machines can hand off cleanly.
#
# Commands, in the order you reach for them:
#
# Daily loop:
#   vibe start <task>     Create branch+worktree for <task>, seed HANDOFF.md,
#                         then open a claude session (in tmux on server).
#   vibe attach [<task>]  Arrive at a task: fast-forward its worktree when that
#                         is safe (clean + ff-only), then attach. Never refuses
#                         — a dirty/diverged tree is reported and attached as-is.
#                         With no task, pick from a menu.
#   vibe park [<task>]    Leave a machine: refresh HANDOFF.md by running the
#                         agent headlessly, then sync. Degrades to a plain sync
#                         if the agent is missing or the headless call fails.
#   vibe done [--force] [--stop] [--discard-handoff] [--keep-brief] [<task>]
#                         Remove the worktree (branch is kept). Refuses if the
#                         worktree is dirty, holds unpushed commits, has a loop
#                         still running (--stop kills it first), if
#                         HANDOFF.md still carries content or is still on the
#                         branch at all — a finished task hands nothing off,
#                         so promote what matters, then delete the file
#                         (--discard-handoff skips only the handoff checks) —
#                         or if LOOP.md is still on the branch, where it would
#                         land in the PR diff; delete it and sync, or
#                         --keep-brief to leave it there deliberately.
#                         Infers the task from the cwd when run inside a
#                         worktree.
#
# Unattended:
#   vibe loop <task> [--until <cmd>] [--max <n>] [--prompt <file>] [--push]
#                     [--no-attach] [--dangerously-allow-all]
#                         Create branch+worktree like start, seed LOOP.md, then
#                         run the agent headlessly round after round until the
#                         --until check passes, --max rounds pass, or it stalls.
#                         Re-running on an existing loop worktree resumes it.
#                         --no-attach (server) starts the tmux session and
#                         returns instead of attaching — for starting a loop
#                         from a remote-controlled session or a script.
#
# Phone:
#   vibe rc <task>        Enable Remote Control on a running task by sending /rc
#                         into its tmux session (server only), so it can be
#                         driven from the Claude app on a phone.
#
# Visibility:
#   vibe status [--all]   Show worktrees with per-worktree sync state (dirty,
#                         ahead/behind, HANDOFF.md age), tmux state, PRs. --all
#                         scans every repo under $VIBE_WORKTREE_ROOT.
#   vibe doctor           Check tools, paths, config and upstream state.
#
# Plumbing (attach/park use these; call directly when you need the git layer):
#   vibe sync [<task>]    Commit handoff files (own commit) + the rest, then
#                         push. Aborts on divergence. Infers the task from cwd;
#                         a task argument targets that worktree from anywhere.
#   vibe resume [--rebase] [<task>]
#                         Pull remote, fast-forward only. Aborts if dirty or
#                         diverged; --rebase opts into 'git pull --rebase'.
#   vibe list             Short list of tasks.
#   vibe where            Print detected environment (local|server) and why.
#
# Requires: git, tmux (server only for persistence), optionally gh (for PR info).
#
# Config: ~/.config/vibe/config (KEY=VALUE). Environment variables win over it.
#         See templates/vibe.config.example. Run 'vibe doctor' to validate.

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
#
# Precedence, highest first:
#   1. environment variable
#   2. ~/.config/vibe/config   (override with $VIBE_CONFIG_FILE)
#   3. built-in default
#
# The config file is sourced, so it must be valid shell — but keep it to plain
# KEY=VALUE lines. `vibe doctor` enforces that, and the Claude Code hooks in
# claude/hooks/ read the same file by parsing rather than sourcing, so anything
# cleverer than an assignment will work here and silently not work there.
# ---------------------------------------------------------------------------
VIBE_CONFIG_FILE="${VIBE_CONFIG_FILE:-$HOME/.config/vibe/config}"

# Capture what the environment set before the config file can shadow it.
_env_worktree_root="${VIBE_WORKTREE_ROOT:-}"
_env_agent_cmd="${VIBE_AGENT_CMD:-}"
_env_agent_headless_args="${VIBE_AGENT_HEADLESS_ARGS:-}"
_env_loop_permissive_args="${VIBE_LOOP_PERMISSIVE_ARGS:-}"
_env_tmux_prefix="${VIBE_TMUX_PREFIX:-}"
_env_server_hostname="${VIBE_SERVER_HOSTNAME:-}"
_env_ntfy_topic="${VIBE_NTFY_TOPIC:-}"
_env_rc_on_start="${VIBE_RC_ON_START:-}"

if [[ -r "$VIBE_CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$VIBE_CONFIG_FILE"
fi

# env > config > default
VIBE_WORKTREE_ROOT="${_env_worktree_root:-${VIBE_WORKTREE_ROOT:-$HOME/git/worktrees}}"
VIBE_AGENT_CMD="${_env_agent_cmd:-${VIBE_AGENT_CMD:-claude}}"
# Arguments that turn VIBE_AGENT_CMD into a one-shot headless run (used by
# 'vibe park' to refresh HANDOFF.md). Default is Claude Code's '-p', but the
# split lets any agent be driven headlessly without hardcoding one here.
VIBE_AGENT_HEADLESS_ARGS="${_env_agent_headless_args:-${VIBE_AGENT_HEADLESS_ARGS:--p}}"
# Extra args appended to a loop's agent invocation ONLY when it is started with
# --dangerously-allow-all: the agent's "skip every permission prompt" mode.
# Empty by default; see docs/vibe-loop.md for the blast radius before setting it.
VIBE_LOOP_PERMISSIVE_ARGS="${_env_loop_permissive_args:-${VIBE_LOOP_PERMISSIVE_ARGS:-}}"
VIBE_TMUX_PREFIX="${_env_tmux_prefix:-${VIBE_TMUX_PREFIX:-vibe}}"
VIBE_SERVER_HOSTNAME="${_env_server_hostname:-${VIBE_SERVER_HOSTNAME:-}}"
VIBE_NTFY_TOPIC="${_env_ntfy_topic:-${VIBE_NTFY_TOPIC:-}}"
# Opt-in: launch the server-side agent with Remote Control already enabled, so
# a task is reachable from the Claude app without typing /rc first. Server only.
VIBE_RC_ON_START="${_env_rc_on_start:-${VIBE_RC_ON_START:-0}}"
unset _env_worktree_root _env_agent_cmd _env_agent_headless_args \
  _env_loop_permissive_args _env_tmux_prefix _env_server_hostname \
  _env_ntfy_topic _env_rc_on_start

# Files committed separately (as their own "chore: handoff" commit) by vibe sync.
VIBE_HANDOFF_FILES=("HANDOFF.md" "PROJECT_STATUS.md")

# The loop's per-worktree runtime state file. Gitignored (see loop_ignore_state),
# never committed: it holds machine-local counters and a PID, not deliverable work.
VIBE_LOOP_STATE=".vibe-loop.state"

# Where a headless agent round's own output goes. It lives inside the
# worktree's git dir, not the working tree, so it needs no gitignore entry and
# 'git add -A' can never sweep it into a commit.
VIBE_AGENT_LOG="vibe-agent.log"

# A line matches this iff it is nothing but HANDOFF.md template scaffolding:
# blank lines, '#' headings, '>' guidance quotes, '- **Field:**' metadata, and
# single-line _italic placeholders_. 'grep -v' this to surface only real,
# handed-off content. Written once here so handoff_carries_content and cmd_done
# cannot drift; claude/hooks/session-start-handoff.sh keeps a literal copy of
# the same pattern (it cannot source this script) — update both together.
VIBE_HANDOFF_SCAFFOLD_RE='^[[:space:]]*$|^#|^>|^- \*\*|^_.*_[[:space:]]*$'

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------
# Color is resolved once, here, so every command inherits the same decision:
# off when stdout isn't a terminal or NO_COLOR is set, forced on by
# CLICOLOR_FORCE even over a pipe. Getting this wrong leaks raw escapes into
# logs, files and pagers.
if [[ -n "${CLICOLOR_FORCE:-}" ]] || { [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; }; then
  c_red=$'\033[31m'
  c_grn=$'\033[32m'
  c_yel=$'\033[33m'
  c_cyn=$'\033[36m'
  c_dim=$'\033[2m'
  c_bld=$'\033[1m'
  c_off=$'\033[0m'
  vibe_ui_fancy=1
else
  c_red=""
  c_grn=""
  c_yel=""
  c_cyn=""
  c_dim=""
  c_bld=""
  c_off=""
  vibe_ui_fancy=0
fi

# One symbol per severity, used everywhere from top-level messages to the
# doctor report: ✓ ok, ⚠ warn, ✗ die/fail.
die() {
  printf '%s✗%s vibe: %s\n' "$c_red" "$c_off" "$*" >&2
  exit 1
}
info() { printf '%s%s%s\n' "$c_dim" "$*" "$c_off"; }
warn() { printf '%s⚠%s %s\n' "$c_yel" "$c_off" "$*"; }
ok() { printf '%s✓%s %s\n' "$c_grn" "$c_off" "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed."; }

# rule TITLE — a dim horizontal-rule section header ('── Title ────…'),
# used wherever a bold standalone header used to stand alone: help, status,
# doctor. One shared implementation so section headers read consistently.
# The dash run is sliced from a constant rather than built with 'tr', which
# mangles the multi-byte '─' glyph into junk bytes on this system's tr.
rule() {
  local title="$1" width=64 prefix pad
  local dash_bank='────────────────────────────────────────────────────────────────'
  prefix="── ${title} "
  pad=$((width - ${#prefix}))
  if ((pad < 4)); then pad=4; fi
  printf '%s%s%s%s\n' "$c_dim" "$prefix" "${dash_bank:0:pad}" "$c_off"
}

# spin PID MESSAGE — braille spinner shown while PID runs in the background.
# Gated on the same tty/color check as the rest of the UI (vibe_ui_fancy):
# piped output or NO_COLOR gets the plain "MESSAGE" line instead, so logs and
# captured output never see \r control sequences or a half-drawn frame.
spin() {
  local pid="$1" msg="$2"
  if [[ "$vibe_ui_fancy" != 1 ]]; then
    info "$msg"
    wait "$pid"
    return $?
  fi
  local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏') i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r%s%s%s %s' "$c_cyn" "${frames[$i]}" "$c_off" "$msg" >&2
    i=$(((i + 1) % ${#frames[@]}))
    sleep 0.1
  done
  local status=0
  wait "$pid" || status=$?
  printf '\r%*s\r' "$((${#msg} + 4))" '' >&2
  return "$status"
}

# ---------------------------------------------------------------------------
# Locating our own files
#
# vibe is normally invoked through a symlink (~/bin/vibe -> <repo>/bin/vibe),
# so $0 and $PWD both point somewhere useless. Walk the symlink chain to find
# where this script really lives, and read templates/ relative to that.
# `readlink -f` is not used: macOS shipped BSD readlink without it for years.
# ---------------------------------------------------------------------------
script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    # a relative link resolves against the directory holding the link
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  # cd -P also resolves symlinked *parent* directories
  cd -P "$(dirname "$src")" && pwd
}

VIBE_HOME="$(dirname "$(script_dir)")" # <repo>/bin/vibe -> <repo>
TEMPLATE_DIR="${TOOLKIT_TEMPLATE_DIR:-$VIBE_HOME/templates}"

# render_template FILE [TOKEN VALUE]... — print FILE with each TOKEN replaced.
# Pure bash: no sed, so a value containing the delimiter (worktree paths hold
# slashes) cannot corrupt the substitution.
render_template() {
  local tpl="$1"
  shift
  local content
  content="$(cat "$tpl")"
  while (($# >= 2)); do
    content="${content//$1/$2}"
    shift 2
  done
  printf '%s\n' "$content"
}

# ---------------------------------------------------------------------------
# Environment detection: local (Mac) vs server (Linux VPS)
#   Primary signal:  $SSH_CONNECTION is set => we are on the server via SSH.
#   Fallback signal: hostname matches VIBE_SERVER_HOSTNAME.
#   Anything else    => treated as local.
# ---------------------------------------------------------------------------
detect_env() {
  if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_TTY:-}" ]]; then
    echo "server"
    return
  fi
  if [[ -n "$VIBE_SERVER_HOSTNAME" && "$(hostname)" == "$VIBE_SERVER_HOSTNAME" ]]; then
    echo "server"
    return
  fi
  echo "local"
}

env_reason() {
  if [[ -n "${SSH_CONNECTION:-}" ]]; then
    echo "SSH_CONNECTION is set"
  elif [[ -n "${SSH_TTY:-}" ]]; then
    echo "SSH_TTY is set"
  elif [[ -n "$VIBE_SERVER_HOSTNAME" && "$(hostname)" == "$VIBE_SERVER_HOSTNAME" ]]; then
    echo "hostname matches VIBE_SERVER_HOSTNAME"
  else echo "no SSH session and hostname does not match server"; fi
}

# ---------------------------------------------------------------------------
# Git helpers
# ---------------------------------------------------------------------------
repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository."; }
repo_name() { basename "$(main_repo_root)"; }
# common dir points at the main repo's .git even from inside a worktree
main_repo_root() {
  local common
  common="$(git rev-parse --git-common-dir 2>/dev/null)" || die "not a git repo."
  # git-common-dir may be relative; resolve it, then take its parent
  common="$(cd "$(dirname "$common")" && pwd)/$(basename "$common")"
  dirname "$common"
}

# upstream_state DIR — classify DIR's HEAD against its upstream from local refs
# only (never fetches), echoing one of:
#   no-upstream  no @{u} tracking branch configured
#   insync       HEAD == @{u}
#   behind       @{u} is ahead of HEAD (a fast-forward pulls it in)
#   ahead        HEAD is ahead of @{u} (a plain push publishes it)
#   diverged     both moved since their merge-base
# The ahead/behind labels are measured against the last fetch, so a caller that
# wants a fresh answer fetches first — each keeps its own fetch and refusal
# policy (attach never blocks, sync/resume die, the loop stops) and only the
# comparison itself lives here, where it was written out four times.
upstream_state() {
  local dir="$1" local_rev remote_rev base
  git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 || {
    echo no-upstream
    return
  }
  local_rev="$(git -C "$dir" rev-parse @)"
  remote_rev="$(git -C "$dir" rev-parse '@{u}')"
  base="$(git -C "$dir" merge-base @ '@{u}')"
  if [[ "$local_rev" == "$remote_rev" ]]; then
    echo insync
  elif [[ "$local_rev" == "$base" ]]; then
    echo behind
  elif [[ "$remote_rev" == "$base" ]]; then
    echo ahead
  else
    echo diverged
  fi
}

# sanitize a task name into a branch-safe / dir-safe slug. '/' becomes '-'
# rather than vanishing, so 'docs/fix-x' and 'docsfix-x' stay distinct.
slug() { echo "$1" | tr '[:upper:] /' '[:lower:]--' | sed 's/[^a-z0-9._-]//g'; }

worktree_dir() {
  local repo="$1" branch="$2"
  echo "$VIBE_WORKTREE_ROOT/$repo/$branch"
}

# ensure_worktree MAIN BRANCH DIR — create DIR as a worktree for BRANCH.
# Preference order: existing local branch; branch on origin (fetched when
# needed, and tracked — so a branch pushed from the other machine is picked up
# instead of silently shadowed by a fresh branch off HEAD); new branch off
# HEAD. The fetch is best-effort: offline or remote-less repos fall through to
# today's branch-off-HEAD behavior.
# Kept in lockstep with skills/loop-brief/brief.sh.
ensure_worktree() {
  local main="$1" branch="$2" dir="$3"
  mkdir -p "$(dirname "$dir")"
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" worktree add "$dir" "$branch"
  else
    git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch" ||
      git -C "$main" fetch -q origin "$branch" >/dev/null 2>&1 || true
    if git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git -C "$main" worktree add --track -b "$branch" "$dir" "origin/$branch"
    else
      git -C "$main" worktree add -b "$branch" "$dir"
    fi
  fi
  info "created worktree: $dir  (branch: $branch)"
}

tmux_session_name() {
  # vibe-<repo>-<branch>, tmux disallows dots in session names
  echo "${VIBE_TMUX_PREFIX}-$1-$2" | tr '.' '-'
}

# tmux_ensure_session SESS DIR CMD — make sure a detached session SESS exists
# with working directory DIR, running CMD in its first (and only) pane when it
# has to be created. Idempotent: an existing session is left running untouched.
# Returns 0 when the session was already there, 1 when it was just created, so
# the caller can word its own "already exists" vs "starting" line.
tmux_ensure_session() {
  local sess="$1" dir="$2" cmd="$3"
  if tmux has-session -t "$sess" 2>/dev/null; then
    return 0
  fi
  tmux new-session -d -s "$sess" -c "$dir"
  tmux send-keys -t "$sess" "$cmd" C-m
  return 1
}

# tmux_attach_or_switch SESS — bring SESS to the foreground. Inside an existing
# tmux client, attach would nest a session; switch the client instead. Outside
# tmux, attach.
tmux_attach_or_switch() {
  local sess="$1"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$sess"
  else
    tmux attach-session -t "$sess"
  fi
}

# ---------------------------------------------------------------------------
# Resolving which worktree a command should act on
#
# Two ways in, both filling R_repo / R_branch / R_dir:
#   - a task argument, turned into <root>/<repo>/<branch> via repo_name+slug;
#   - inference from the cwd, when we are standing inside a vibe worktree.
# Both confirm with git that the target really is a worktree before trusting
# it, so a stray directory that merely looks like the layout is never acted on.
# ---------------------------------------------------------------------------

# resolve_by_task TASK — fill R_repo/R_branch/R_dir from a task name, or die.
# Needs a surrounding git repo (for repo_name); works from the main checkout
# or from any of the repo's worktrees.
resolve_by_task() {
  local task="$1"
  R_repo="$(repo_name)"
  R_branch="$(slug "$task")"
  R_dir="$(worktree_dir "$R_repo" "$R_branch")"
  [[ -d "$R_dir" ]] || die "no worktree for '$R_branch' (looked in $R_dir). Run: vibe start $task"
  git -C "$R_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die "$R_dir exists but is not a git worktree."
}

# infer_from_cwd — fill R_repo/R_branch/R_dir when the cwd sits inside a vibe
# worktree ($VIBE_WORKTREE_ROOT/<repo>/<branch>). Returns non-zero otherwise,
# so callers can fall back or refuse. git prints physical paths, so resolve
# ours the same way (cd/pwd -P: no readlink -f on macOS) before comparing.
infer_from_cwd() {
  local top vroot rest
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  top="$(cd "$top" && pwd -P)"
  [[ -d "$VIBE_WORKTREE_ROOT" ]] || return 1
  vroot="$(cd "$VIBE_WORKTREE_ROOT" && pwd -P)"
  case "$top" in
    "$vroot"/*/*) rest="${top#"$vroot"/}" ;;
    *) return 1 ;;
  esac
  R_repo="${rest%%/*}"
  R_branch="${rest#*/}"
  # exactly <repo>/<branch>: a deeper path is not a task root
  [[ -n "$R_repo" && -n "$R_branch" && "$R_branch" != */* ]] || return 1
  # a real worktree, not just a matching path
  git -C "$top" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  R_dir="$top"
}

# dir_for_optional_task [TASK] — echo the worktree dir a cwd-flexible command
# (sync, resume, park) should act on. A task argument targets that worktree
# from anywhere; with none we act on the current worktree, which is the cwd's
# own toplevel whether that is a vibe task or an ordinary checkout.
dir_for_optional_task() {
  local task="${1:-}"
  if [[ -n "$task" ]]; then
    resolve_by_task "$task"
    printf '%s\n' "$R_dir"
  else
    git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository."
  fi
}

# pick_task — let the user choose a task for the current repo, printing the
# chosen name on stdout. Uses fzf when it is on PATH, otherwise a plain shell
# 'select' menu. Returns non-zero (after a note) when there is nothing to pick
# or the user cancels, so callers can fall back to a usage message.
pick_task() {
  need git
  local repo base d tasks=()
  repo="$(repo_name)"
  base="$VIBE_WORKTREE_ROOT/$repo"
  if [[ -d "$base" ]]; then
    for d in "$base"/*/; do
      [[ -d "$d" ]] && tasks+=("$(basename "$d")")
    done
  fi
  if ((${#tasks[@]} == 0)); then
    warn "no tasks yet for $repo — run: vibe start <task>" >&2
    return 1
  fi

  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${tasks[@]}" | fzf --prompt='vibe task> ' --height=40% --reverse
  else
    # 'select' draws its menu on stderr and reads the choice from the tty, so
    # stdout stays clean for the chosen name that the caller captures.
    local choice
    select choice in "${tasks[@]}"; do
      [[ -n "$choice" ]] && {
        printf '%s\n' "$choice"
        break
      }
    done </dev/tty
  fi
}

# ---------------------------------------------------------------------------
# HANDOFF.md seeding — rendered from templates/, never embedded here.
# ---------------------------------------------------------------------------
seed_handoff() {
  local dir="$1" repo="$2" branch="$3"
  local f="$dir/HANDOFF.md"
  [[ -f "$f" ]] && return 0

  local tpl="$TEMPLATE_DIR/HANDOFF.md"
  [[ -f "$tpl" ]] || {
    warn "no HANDOFF template at $tpl — skipping seed"
    return 0
  }

  render_template "$tpl" \
    '<repo>' "$repo" \
    '<branch>' "$branch" \
    '<worktree>' "$dir" \
    '<date>' "$(date '+%Y-%m-%d %H:%M %Z')" \
    '<machine>' "$(detect_env) ($(hostname))" >"$f"
  info "seeded HANDOFF.md"
}

# LOOP.md seeding — rendered from templates/ (or a --prompt file), never
# embedded here. Skips an existing file, so a resumed loop keeps its log.
seed_loop() {
  local dir="$1" repo="$2" branch="$3" goal="$4" until_cmd="$5" max="$6" custom="$7"
  local f="$dir/LOOP.md"
  [[ -f "$f" ]] && return 0

  local tpl="$TEMPLATE_DIR/LOOP.md"
  [[ -n "$custom" ]] && tpl="$custom"
  [[ -f "$tpl" ]] || die "no LOOP template at $tpl"

  render_template "$tpl" \
    '<repo>' "$repo" \
    '<branch>' "$branch" \
    '<worktree>' "$dir" \
    '<goal>' "$goal" \
    '<until>' "${until_cmd:-—}" \
    '<max>' "$max" \
    '<date>' "$(date '+%Y-%m-%d %H:%M %Z')" \
    '<machine>' "$(detect_env) ($(hostname))" >"$f"
  info "seeded LOOP.md"
}

# ---------------------------------------------------------------------------
# ntfy — phone push, reusing the conventions of claude/hooks/notify-ntfy.sh:
# title "repo · branch", high priority for anything that needs attention.
# Silent no-op when the topic is unset or curl is missing — never disrupts.
# ---------------------------------------------------------------------------
ntfy_push() {
  local title="$1" prio="$2" tags="$3" body="$4"
  [[ -n "$VIBE_NTFY_TOPIC" ]] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  curl -fsS --max-time 10 \
    -H "Title: $title" \
    -H "Priority: $prio" \
    -H "Tags: $tags" \
    -d "$body" \
    "https://ntfy.sh/$VIBE_NTFY_TOPIC" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# Loop state — a per-worktree KEY=VALUE file ($VIBE_LOOP_STATE). Written
# atomically (temp + mv) so a kill mid-write leaves the previous state intact.
# Parsed, never sourced: it may hold an arbitrary --until command as a value.
# ---------------------------------------------------------------------------
loop_state_path() { echo "$1/$VIBE_LOOP_STATE"; }

# loop_get DIR KEY — echo the value for KEY, or empty. Last assignment wins.
loop_get() {
  local sf
  sf="$(loop_state_path "$1")"
  [[ -f "$sf" ]] || return 0
  sed -n "s/^$2=//p" "$sf" | tail -1
}

# loop_active DIR — true only if a runner is genuinely running: STATUS=running
# AND its recorded PID is still alive. A running status with a dead PID is a
# killed loop, which is resumable, not active.
loop_active() {
  local dir="$1" status pid
  status="$(loop_get "$dir" STATUS)"
  [[ "$status" == "running" ]] || return 1
  pid="$(loop_get "$dir" PID)"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

# loop_summary DIR — one-line "iter N/M · last R · status" for vibe status.
loop_summary() {
  local dir="$1" it mx la st
  it="$(loop_get "$dir" ITER)"
  mx="$(loop_get "$dir" MAX)"
  la="$(loop_get "$dir" LAST)"
  st="$(loop_get "$dir" STATUS)"
  printf 'iter %s/%s · last %s · %s' "${it:-0}" "${mx:-?}" "${la:-none}" "${st:-?}"
}

# loop_ignore_state DIR — make git ignore the runtime state file, so it never
# shows up as an untracked change (which would break `vibe done`/`sync`) and is
# never committed. The common info/exclude is the file git actually consults
# for a linked worktree, so target that rather than --git-path (per-worktree).
loop_ignore_state() {
  local dir="$1" common excl
  common="$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null)" || return 0
  [[ "$common" == /* ]] || common="$dir/$common"
  excl="$common/info/exclude"
  mkdir -p "$(dirname "$excl")"
  grep -qxF "$VIBE_LOOP_STATE" "$excl" 2>/dev/null ||
    printf '%s\n' "$VIBE_LOOP_STATE" >>"$excl"
}

# loop_write_state DIR KEY VALUE [KEY VALUE]... — write the loop state file as
# the given KEY=VALUE lines, stamping UPDATED automatically. Same KEY VALUE
# shape as render_template, so a caller reads as a labelled field list rather
# than eleven positional arguments whose order had to be counted twice.
# Atomic: write a temp then rename, so a kill mid-write cannot truncate it.
loop_write_state() {
  local sf tmp dir="$1"
  shift
  sf="$(loop_state_path "$dir")"
  tmp="$sf.tmp.$$"
  {
    while (($# >= 2)); do
      printf '%s=%s\n' "$1" "$2"
      shift 2
    done
    printf 'UPDATED=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$tmp"
  mv -f "$tmp" "$sf"
}

# loop_log_round DIR ITER NOTE — append one line to LOOP.md's iteration log.
loop_log_round() {
  printf -- '- iter %s (%s): %s\n' "$2" "$(date '+%Y-%m-%d %H:%M')" "$3" >>"$1/LOOP.md"
}

# loop_push DIR BRANCH — push with the same divergence guard as vibe sync.
# Returns non-zero only when the remote moved in a way a human must resolve
# (diverged, or remote ahead); a transient fetch failure is not fatal.
loop_push() {
  local dir="$1" branch="$2"
  if [[ "$(upstream_state "$dir")" == no-upstream ]]; then
    git -C "$dir" push -q -u origin "$branch"
    return
  fi
  git -C "$dir" fetch -q || return 0
  case "$(upstream_state "$dir")" in
    insync) return 0 ;;
    ahead)
      git -C "$dir" push -q origin "$branch"
      return 0
      ;;
    *)
      # behind or diverged: never merge or force under an unattended loop.
      return 1
      ;;
  esac
}

# agent_log_path DIR — absolute path to DIR's headless-agent log. Inside the
# worktree's git dir (for a linked worktree that is .git/worktrees/<name>), so
# it is per-worktree and outside anything git tracks.
agent_log_path() {
  local dir="$1" gd
  gd="$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null)" || gd="$dir"
  printf '%s/%s\n' "$gd" "$VIBE_AGENT_LOG"
}

# run_agent_headless DIR LOG MSG ARGV... — one headless agent round, with its
# own output appended to LOG instead of the terminal, and stdin closed.
#
# Both matter. A CLI agent that finds a tty on stdout probes the terminal for
# its colours (OSC 10/11); the terminal answers on the tty *input* side, where
# nobody is reading, so the line discipline echoes the reply back as visible
# garbage ("^[]11;rgb:1818/1818/1818") on top of our spinner. Its startup
# banners and warnings land there too, half-overwritten. Redirecting stdout to
# a file stops the probe at the source, and </dev/null keeps a round that
# decides to prompt from eating the loop's own input.
run_agent_headless() {
  local dir="$1" log="$2" msg="$3"
  shift 3
  mkdir -p "$(dirname "$log")"
  printf '\n=== %s · %s ===\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$msg" >>"$log"
  (cd "$dir" && exec "$@") >>"$log" 2>&1 </dev/null &
  spin "$!" "$msg"
}

# The loop itself. Everything it needs is in the state file, so this is the
# single entry point for both a fresh start and a resume-after-kill.
run_loop() {
  local dir="$1" repo="$2" branch="$3"
  local status phase iter max last until_cmd push permissive started pid
  status="running"
  phase="starting"
  iter="$(loop_get "$dir" ITER)"
  iter="${iter:-0}"
  max="$(loop_get "$dir" MAX)"
  max="${max:-10}"
  last="$(loop_get "$dir" LAST)"
  last="${last:-none}"
  until_cmd="$(loop_get "$dir" UNTIL)"
  push="$(loop_get "$dir" PUSH)"
  push="${push:-0}"
  permissive="$(loop_get "$dir" PERMISSIVE)"
  permissive="${permissive:-0}"
  started="$(loop_get "$dir" STARTED)"
  started="${started:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  pid="$$"

  local title="$repo · $branch"

  # Build the headless argv once, the same shape 'vibe park' uses. Word-
  # splitting is intentional: these are argument strings the user configured.
  # shellcheck disable=SC2206
  local -a argv=($VIBE_AGENT_CMD $VIBE_AGENT_HEADLESS_ARGS)
  if [[ "$permissive" == "1" ]]; then
    # shellcheck disable=SC2206
    argv+=($VIBE_LOOP_PERMISSIVE_ARGS)
  fi

  local no_progress=0 log
  log="$(agent_log_path "$dir")"
  ok "loop starting on $branch (max $max)${until_cmd:+, until: $until_cmd}"
  info "agent output: $log"

  while :; do
    iter=$((iter + 1))
    phase="iterating"
    loop_write_state "$dir" \
      STATUS running PHASE "$phase" ITER "$iter" MAX "$max" LAST "$last" \
      UNTIL "$until_cmd" PUSH "$push" PERMISSIVE "$permissive" PID "$pid" STARTED "$started"
    info "iteration $iter/$max"

    local before after
    before="$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo none)"

    # One headless round. LOOP.md is passed as the prompt argument, the same way
    # run_headless_handoff drives the agent, so no agent-specific flag is baked
    # in here. A crashing agent must not kill the loop.
    run_agent_headless "$dir" "$log" "iteration $iter running…" \
      "${argv[@]}" "$(cat "$dir/LOOP.md")" ||
      warn "agent exited non-zero on iteration $iter (continuing) — see $log"

    # Commit whatever the round produced, so vibe done/status account for it.
    # A change to nothing but our own LOOP.md log is not progress: undo it and
    # leave the tree clean, so "no new commit and no diff" stays true.
    git -C "$dir" add -A
    local substantive
    substantive="$(git -C "$dir" diff --cached --name-only | grep -vx 'LOOP.md' || true)"
    if [[ -n "$substantive" ]]; then
      loop_log_round "$dir" "$iter" "changed"
      git -C "$dir" add -A
      git -C "$dir" commit -q -m "vibe loop: iteration $iter on $branch"
    else
      git -C "$dir" reset -q
      git -C "$dir" checkout -q -- LOOP.md 2>/dev/null || true
    fi
    after="$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo none)"
    if [[ "$after" == "$before" ]]; then
      no_progress=$((no_progress + 1))
    else
      no_progress=0
    fi

    # Push this round's work before deciding to stop, so the final iteration is
    # never left unpushed. Same divergence guard vibe sync uses; never forces.
    if [[ "$push" == "1" ]]; then
      if ! loop_push "$dir" "$branch"; then
        status="stopped"
        warn "loop stopped: remote diverged — resolve manually, then re-run vibe loop"
        ntfy_push "$title" high warning \
          "loop stopped — remote diverged from $branch"
        break
      fi
    fi

    # Stop check.
    phase="checking"
    if [[ -n "$until_cmd" ]]; then
      if (cd "$dir" && bash -c "$until_cmd") >/dev/null 2>&1; then
        last="pass"
        status="success"
      else
        last="fail"
      fi
    fi
    loop_write_state "$dir" \
      STATUS "$status" PHASE "$phase" ITER "$iter" MAX "$max" LAST "$last" \
      UNTIL "$until_cmd" PUSH "$push" PERMISSIVE "$permissive" PID "$pid" STARTED "$started"

    if [[ "$status" == "success" ]]; then
      ok "loop done: stop check passed on iteration $iter"
      ntfy_push "$title" default heavy_check_mark \
        "loop finished — stop check passed on iteration $iter"
      break
    fi
    if ((iter >= max)); then
      status="maxed"
      warn "loop stopped: hit max $max iterations without the stop check passing"
      ntfy_push "$title" high warning \
        "loop hit its max of $max iterations without passing"
      break
    fi
    if ((no_progress >= 2)); then
      status="stalled"
      warn "loop stopped: stalled (2 rounds with no new commit and no diff)"
      ntfy_push "$title" high warning \
        "loop stalled — 2 rounds produced no change"
      break
    fi
  done

  phase="idle"
  loop_write_state "$dir" \
    STATUS "$status" PHASE "$phase" ITER "$iter" MAX "$max" LAST "$last" \
    UNTIL "$until_cmd" PUSH "$push" PERMISSIVE "$permissive" PID "$pid" STARTED "$started"
}

# loop_parse_args ARGS... — parse the 'vibe loop' flag surface into LP_*
# globals and validate it, so cmd_loop reads as a sequence of steps rather than
# opening with a hundred-line getopts. Sets: LP_task LP_until LP_max LP_prompt
# LP_push LP_permissive LP_no_attach. Dies on a bad flag or combination.
loop_parse_args() {
  local usage="usage: vibe loop <task> [--until <cmd>] [--max <n>] [--prompt <file>] [--push] [--no-attach] [--dangerously-allow-all]"
  LP_task="" LP_until="" LP_max="" LP_prompt="" LP_push=0 LP_permissive=0 LP_no_attach=0
  while (($#)); do
    case "$1" in
      --until)
        LP_until="${2-}"
        shift 2 || die "--until needs a command"
        ;;
      --until=*)
        LP_until="${1#--until=}"
        shift
        ;;
      --max)
        LP_max="${2-}"
        shift 2 || die "--max needs a number"
        ;;
      --max=*)
        LP_max="${1#--max=}"
        shift
        ;;
      --prompt)
        LP_prompt="${2-}"
        shift 2 || die "--prompt needs a file"
        ;;
      --prompt=*)
        LP_prompt="${1#--prompt=}"
        shift
        ;;
      --push)
        LP_push=1
        shift
        ;;
      --no-attach)
        LP_no_attach=1
        shift
        ;;
      --dangerously-allow-all)
        LP_permissive=1
        shift
        ;;
      -*) die "unknown option '$1' ($usage)" ;;
      *)
        LP_task="$1"
        shift
        ;;
    esac
  done
  [[ -n "$LP_task" ]] || die "$usage"
  [[ -z "$LP_max" || "$LP_max" =~ ^[0-9]+$ ]] || die "--max must be a number, got '$LP_max'"
  [[ -z "$LP_prompt" || -f "$LP_prompt" ]] || die "--prompt file not found: $LP_prompt"
  if [[ "$LP_permissive" == "1" && -z "$VIBE_LOOP_PERMISSIVE_ARGS" ]]; then
    die "--dangerously-allow-all needs VIBE_LOOP_PERMISSIVE_ARGS set (see docs/vibe-loop.md)."
  fi
  # Checked before any scaffolding: locally the loop runs in the foreground,
  # so a late refusal would leave a seeded worktree and a stale state file.
  if [[ "$LP_no_attach" == "1" && "$(detect_env)" != "server" ]]; then
    die "--no-attach needs a server tmux session — locally the loop runs in
  the foreground, so there is nothing to detach from. Start it on the server."
  fi
}

# loop_effective_settings DIR RESUMING — resolve the settings a loop actually
# runs with into LE_* globals: a new flag (LP_*) overrides, a resume carries the
# saved value forward, otherwise a default fills in. Sets: LE_iter LE_started
# LE_last LE_max LE_until LE_push LE_perm.
loop_effective_settings() {
  local dir="$1" resuming="$2"
  if ((resuming)); then
    LE_iter="$(loop_get "$dir" ITER)"
    LE_started="$(loop_get "$dir" STARTED)"
    LE_last="$(loop_get "$dir" LAST)"
    LE_max="${LP_max:-$(loop_get "$dir" MAX)}"
    LE_until="${LP_until:-$(loop_get "$dir" UNTIL)}"
    if [[ "$LP_push" == "1" ]]; then LE_push=1; else LE_push="$(loop_get "$dir" PUSH)"; fi
    if [[ "$LP_permissive" == "1" ]]; then LE_perm=1; else LE_perm="$(loop_get "$dir" PERMISSIVE)"; fi
  else
    LE_iter=0
    LE_started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    LE_last="none"
    LE_max="${LP_max:-10}"
    LE_until="$LP_until"
    LE_push="$LP_push"
    LE_perm="$LP_permissive"
  fi
  LE_max="${LE_max:-10}"
  LE_push="${LE_push:-0}"
  LE_perm="${LE_perm:-0}"
  LE_last="${LE_last:-none}"
  LE_iter="${LE_iter:-0}"
}

cmd_loop() {
  need git
  loop_parse_args "$@"
  local task="$LP_task"

  local branch repo main dir
  branch="$(slug "$task")"
  repo="$(repo_name)"
  main="$(main_repo_root)"
  dir="$(worktree_dir "$repo" "$branch")"

  # Resume vs fresh. A live runner must not be started twice.
  local resuming=0
  if [[ -d "$dir" && -f "$(loop_state_path "$dir")" ]]; then
    if loop_active "$dir"; then
      die "a loop is already running for '$branch'. Watch it: vibe attach $task"
    fi
    resuming=1
    info "resuming loop for '$branch' from saved state (iter $(loop_get "$dir" ITER))"
  fi

  [[ -d "$dir" ]] || ensure_worktree "$main" "$branch" "$dir"

  loop_effective_settings "$dir" "$resuming"

  # A fresh, non-permissive loop can't answer its own permission prompts —
  # nobody is there to. It will stall (see loop_run's stall detector) rather
  # than hang forever, but the round(s) it burns getting there are silent
  # until you check back. Warn once, at start, instead of blocking: the
  # unattended case (scripts, agents, --no-attach) must never be asked to
  # answer a prompt no one is watching for.
  if ((!resuming)) && [[ "$LE_perm" != "1" ]]; then
    warn "starting without --dangerously-allow-all: the agent keeps its normal permission prompts."
    warn "unattended, nobody can answer them — any edit or gated command the brief needs will stall the loop after 2 rounds, not run it. See docs/vibe-loop.md#permissions-and-blast-radius."
  fi

  # First-run scaffolding (seed_loop and the commit skip cleanly on resume).
  seed_loop "$dir" "$repo" "$branch" "$task" "$LE_until" "$LE_max" "$LP_prompt"
  loop_ignore_state "$dir"
  # Commit LOOP.md so a no-progress round can restore it, and so the brief and
  # its log travel between machines. The runtime state file stays gitignored.
  if [[ -n "$(git -C "$dir" status --porcelain -- LOOP.md 2>/dev/null)" ]]; then
    git -C "$dir" add LOOP.md
    git -C "$dir" commit -q -m "vibe loop: start '$branch'"
  fi

  loop_write_state "$dir" \
    STATUS running PHASE starting ITER "$LE_iter" MAX "$LE_max" LAST "$LE_last" \
    UNTIL "$LE_until" PUSH "$LE_push" PERMISSIVE "$LE_perm" PID "" STARTED "$LE_started"

  local env
  env="$(detect_env)"
  if [[ "$env" == "server" ]]; then
    need tmux
    local sess run_cmd
    sess="$(tmux_session_name "$repo" "$branch")"
    # Run the loop inside tmux so it survives disconnect. __loop-run resolves
    # everything from the state file just written.
    run_cmd="$(printf '%q' "$VIBE_HOME/bin/vibe") __loop-run $(printf '%q' "$dir")"
    if tmux_ensure_session "$sess" "$dir" "$run_cmd"; then
      info "loop session already exists: $sess"
    else
      info "starting loop in tmux session: $sess"
    fi
    if [[ "$LP_no_attach" == "1" ]]; then
      # Started from a remote-controlled session or a script: attaching would
      # nest or hang the caller. The session runs either way.
      info "loop running detached in tmux session: $sess"
      info "watch it: vibe attach $task   ·   check on it: vibe status"
    else
      tmux_attach_or_switch "$sess"
    fi
  else
    warn "local environment — running the loop in the foreground (Ctrl-C to stop)."
    warn "run it on the server for a detached session that survives disconnect."
    run_loop "$dir" "$repo" "$branch"
  fi
}

# Internal: run the loop for an existing worktree. Invoked inside tmux by
# cmd_loop; not part of the public command surface.
cmd_loop_run() {
  need git
  local dir="${1:-}"
  [[ -n "$dir" ]] || die "usage: vibe __loop-run <worktree-dir>"
  [[ -d "$dir" ]] || die "no worktree at $dir"
  [[ -f "$(loop_state_path "$dir")" ]] || die "no loop state at $dir"
  local repo branch
  repo="$(basename "$(dirname "$dir")")"
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
  run_loop "$dir" "$repo" "$branch"
}

# loop_stop DIR REPO BRANCH — kill the loop's session/process and mark the
# state stopped, so vibe done can proceed and status reads clean.
loop_stop() {
  local dir="$1" repo="$2" branch="$3" sess pid
  sess="$(tmux_session_name "$repo" "$branch")"
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "$sess" 2>/dev/null; then
    tmux kill-session -t "$sess"
    info "killed loop session $sess"
  fi
  pid="$(loop_get "$dir" PID)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
  loop_write_state "$dir" \
    STATUS stopped PHASE idle \
    ITER "$(loop_get "$dir" ITER)" MAX "$(loop_get "$dir" MAX)" LAST "$(loop_get "$dir" LAST)" \
    UNTIL "$(loop_get "$dir" UNTIL)" PUSH "$(loop_get "$dir" PUSH)" PERMISSIVE "$(loop_get "$dir" PERMISSIVE)" \
    PID "" STARTED "$(loop_get "$dir" STARTED)"
  info "loop marked stopped"
}

# handoff_carries_content FILE — true when FILE holds anything beyond the
# template's own scaffolding (see VIBE_HANDOFF_SCAFFOLD_RE). The template keeps
# every placeholder on one line precisely so this stays a line filter.
# claude/hooks/session-start-handoff.sh applies the same filter to decide
# whether to inject HANDOFF.md as session context — kept in lockstep by
# comment, since the hook cannot source this file.
handoff_carries_content() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  grep -qvE "$VIBE_HANDOFF_SCAFFOLD_RE" "$f"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_start() {
  need git
  local task="${1:-}"
  [[ -n "$task" ]] || die "usage: vibe start <task>"
  local branch
  branch="$(slug "$task")"
  local repo
  repo="$(repo_name)"
  local main
  main="$(main_repo_root)"
  local dir
  dir="$(worktree_dir "$repo" "$branch")"

  if [[ -d "$dir" ]]; then
    info "worktree already exists, attaching: $dir"
  else
    ensure_worktree "$main" "$branch" "$dir"
  fi

  seed_handoff "$dir" "$repo" "$branch"
  open_session "$repo" "$branch" "$dir"
}

open_session() {
  local repo="$1" branch="$2" dir="$3"
  local env
  env="$(detect_env)"

  if [[ "$env" == "server" ]]; then
    need tmux
    local sess launch
    sess="$(tmux_session_name "$repo" "$branch")"
    # VIBE_RC_ON_START launches the agent with Remote Control already on, so
    # the session is reachable from the phone without a later 'vibe rc'. This
    # appends Claude Code's --remote-control flag; agents without it should
    # leave VIBE_RC_ON_START at 0 and use 'vibe rc' instead.
    launch="$VIBE_AGENT_CMD"
    [[ "$VIBE_RC_ON_START" == "1" ]] && launch="$VIBE_AGENT_CMD --remote-control"
    if tmux_ensure_session "$sess" "$dir" "$launch"; then
      info "attaching to existing tmux session: $sess"
    else
      info "starting persistent tmux session: $sess"
    fi
    tmux_attach_or_switch "$sess"
  else
    # local (Mac): no forced tmux, just move into the worktree and launch agent
    info "local environment — entering worktree (no tmux)."
    cd "$dir"
    exec "$VIBE_AGENT_CMD"
  fi
}

# attach_ff DIR — fast-forward DIR to its upstream when that is safe (clean
# tree, ff-only), and print one line saying what happened either way. Unlike
# ff_worktree (the plumbing behind 'vibe resume'), this NEVER refuses: attach
# only declines to *guess about git*, never to attach. So a dirty or diverged
# worktree is reported and left alone, and the caller attaches regardless.
attach_ff() {
  local dir="$1" branch
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 0

  # A live loop owns this branch — advancing it out from under the runner is a
  # race. Attach to watch, but leave the branch to the loop.
  if loop_active "$dir"; then
    info "loop is active here — not fast-forwarding under it; attaching to watch."
    return 0
  fi

  if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
    warn "not pulling: $branch has uncommitted changes — attaching as-is"
    return 0
  fi
  if [[ "$(upstream_state "$dir")" == no-upstream ]]; then
    info "no upstream for $branch — attaching without pulling"
    return 0
  fi
  git -C "$dir" fetch -q 2>/dev/null || {
    warn "fetch failed — attaching without pulling"
    return 0
  }

  local n
  case "$(upstream_state "$dir")" in
    insync) info "$branch already up to date — attaching" ;;
    behind)
      n="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo '?')"
      git -C "$dir" merge -q --ff-only '@{u}'
      if [[ "$n" == 1 ]]; then
        ok "fast-forwarded $branch (1 commit) — attaching"
      else
        ok "fast-forwarded $branch ($n commits) — attaching"
      fi
      ;;
    ahead) info "$branch is ahead of remote — attaching ('vibe park' to push)" ;;
    diverged)
      warn "not pulling: $branch has diverged from remote — attaching as-is
  ('vibe resume --rebase' reconciles once you have decided)"
      ;;
  esac
  return 0
}

# vibe attach [<task>] — the single "arrive at a machine" verb. Fast-forwards
# the task's worktree when safe, then attaches; with no task, pick from a menu.
cmd_attach() {
  need git
  local task="${1:-}"
  [[ -n "$task" ]] || task="$(pick_task)" || die "no task selected."
  [[ -n "$task" ]] || die "usage: vibe attach <task>"
  resolve_by_task "$task"
  attach_ff "$R_dir"
  open_session "$R_repo" "$R_branch" "$R_dir"
}

# handoff_age DIR — a short human age for DIR/HANDOFF.md ("3h", "2d"), or
# "none". stat differs between GNU and BSD, so try both spellings.
handoff_age() {
  local dir="$1"
  local f="$dir/HANDOFF.md" mtime now delta
  [[ -f "$f" ]] || {
    echo "none"
    return
  }
  mtime="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)" || {
    echo "?"
    return
  }
  now="$(date +%s)"
  delta=$((now - mtime))
  if ((delta < 3600)); then
    echo "$((delta / 60))m"
  elif ((delta < 86400)); then
    echo "$((delta / 3600))h"
  else
    echo "$((delta / 86400))d"
  fi
}

# git_sync_state DIR — echo "DIRTY AHEAD BEHIND" (DIRTY is 1/0) for DIR. The
# one place that computes this, so the status dot and its detail line can
# never disagree about what state a worktree is in. Like cmd_doctor, it never
# fetches: 'ahead'/'behind' are measured against the last fetch so 'vibe
# status' stays read-only and offline.
git_sync_state() {
  local dir="$1" dirty=0 ahead behind
  [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]] && dirty=1
  ahead="$(unpushed_commits "$dir")"
  behind="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
  printf '%s %s %s\n' "$dirty" "$ahead" "$behind"
}

# worktree_state_dot DIR REPO BRANCH — a colored ● summarizing one worktree
# for 'vibe status': dim ○ when tmux is installed but no session is running
# for this task; otherwise green clean+synced, yellow dirty or ahead/behind,
# red diverged (ahead and behind at once). Locally, where tmux is never
# forced, a missing tmux binary just falls through to the git-only states.
worktree_state_dot() {
  local dir="$1" repo="$2" branch="$3"
  if command -v tmux >/dev/null 2>&1; then
    local sess
    sess="$(tmux_session_name "$repo" "$branch")"
    if ! tmux has-session -t "$sess" 2>/dev/null; then
      printf '%s○%s' "$c_dim" "$c_off"
      return
    fi
  fi
  local dirty ahead behind
  read -r dirty ahead behind <<<"$(git_sync_state "$dir")"
  if [[ "$dirty" == "1" ]]; then
    printf '%s●%s' "$c_yel" "$c_off"
  elif ((ahead > 0 && behind > 0)); then
    printf '%s●%s' "$c_red" "$c_off"
  elif ((ahead > 0 || behind > 0)); then
    printf '%s●%s' "$c_yel" "$c_off"
  else
    printf '%s●%s' "$c_grn" "$c_off"
  fi
}

# sync_state_line DIR — one dim detail line under a worktree's entry, joined
# to it with a '└─' connector.
sync_state_line() {
  local dir="$1" dirty ahead behind dirty_word dirty_c
  read -r dirty ahead behind <<<"$(git_sync_state "$dir")"
  if [[ "$dirty" == "1" ]]; then
    dirty_word="dirty"
    dirty_c="$c_yel"
  else
    dirty_word="clean"
    dirty_c="$c_grn"
  fi
  local loop=""
  [[ -f "$(loop_state_path "$dir")" ]] && loop=" · loop $(loop_summary "$dir")"
  printf '    %s└─%s %s%s%s%s · %s ahead · %s behind · handoff %s%s%s\n' \
    "$c_dim" "$c_off" "$dirty_c" "$dirty_word" "$c_off" "$c_dim" "$ahead" "$behind" "$(handoff_age "$dir")" "$loop" "$c_off"
}

# print_worktrees — the current repo's worktrees, one per line, each with a
# sync-state line. git's list starts with the main checkout itself; label
# anything that is not a vibe task so this never suggests a task 'vibe done'
# would not find. git prints physical paths, so resolve ours the same way
# before comparing (cd/pwd -P: no readlink -f on macOS).
print_worktrees() {
  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "  (not in a repo — try 'vibe status --all')"
    return
  fi
  local mainroot vroot wt="" br="" repo
  mainroot="$(main_repo_root 2>/dev/null || true)"
  [[ -d "$mainroot" ]] && mainroot="$(cd "$mainroot" && pwd -P)"
  vroot="$VIBE_WORKTREE_ROOT"
  [[ -d "$vroot" ]] && vroot="$(cd "$vroot" && pwd -P)"
  repo="$(repo_name)"

  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt="${line#worktree }" ;;
      "branch "*)
        br="${line#branch }"
        br="${br#refs/heads/}"
        print_one_worktree "$wt" "$br" "$mainroot" "$vroot" "$repo"
        ;;
      "detached") print_one_worktree "$wt" "(detached)" "$mainroot" "$vroot" "$repo" ;;
    esac
  done < <(git worktree list --porcelain 2>/dev/null)
}

print_one_worktree() {
  local wt="$1" br="$2" mainroot="$3" vroot="$4" repo="$5" tag="" dot
  if [[ -n "$mainroot" && "$wt" == "$mainroot" ]]; then
    tag="  (main checkout, not a vibe task)"
  elif [[ -n "$vroot" && "$wt" != "$vroot"/* ]]; then
    tag="  (not managed by vibe)"
  fi
  dot="$(worktree_state_dot "$wt" "$repo" "$br")"
  printf '  %s %s%s%s  %s%s%s%s\n' "$dot" "$c_cyn" "$br" "$c_off" "$c_dim" "$wt" "$tag" "$c_off"
  sync_state_line "$wt"
}

# print_all_worktrees — every vibe worktree under $VIBE_WORKTREE_ROOT, across
# all repos. Walks the directory tree rather than 'git worktree list', so it
# works from outside any git repository.
print_all_worktrees() {
  local vroot repo_dir wt_dir repo br found=0 dot
  vroot="$VIBE_WORKTREE_ROOT"
  if [[ ! -d "$vroot" ]]; then
    echo "  (no worktree root at $vroot)"
    return
  fi
  vroot="$(cd "$vroot" && pwd -P)"
  for repo_dir in "$vroot"/*/; do
    [[ -d "$repo_dir" ]] || continue
    repo="$(basename "$repo_dir")"
    for wt_dir in "$repo_dir"*/; do
      [[ -d "$wt_dir" ]] || continue
      git -C "$wt_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
      found=1
      br="$(git -C "$wt_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
      dot="$(worktree_state_dot "${wt_dir%/}" "$repo" "$br")"
      printf '  %s %s%s/%s%s  %s%s%s\n' \
        "$dot" "$c_cyn" "$repo" "$br" "$c_off" "$c_dim" "${wt_dir%/}" "$c_off"
      sync_state_line "${wt_dir%/}"
    done
  done
  ((found)) || echo "  (no vibe worktrees under $vroot)"
}

cmd_status() {
  need git
  local all=0
  case "${1:-}" in
    --all) all=1 ;;
    "") ;;
    *) die "unknown option '$1' (usage: vibe status [--all])" ;;
  esac
  printf '%sEnvironment:%s %s (%s)\n\n' "$c_bld" "$c_off" "$(detect_env)" "$(env_reason)"

  rule "Worktrees"
  if ((all)); then print_all_worktrees; else print_worktrees; fi

  # tmux sessions belonging to vibe
  if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
    printf '\n'
    rule "Active tmux sessions"
    tmux ls 2>/dev/null | grep "^${VIBE_TMUX_PREFIX}-" | sed 's/^/  /' || echo "  (none)"
  fi

  # open PRs via gh, if available and we are inside a repo
  if git rev-parse --show-toplevel >/dev/null 2>&1 && command -v gh >/dev/null 2>&1; then
    printf '\n'
    rule "Open PRs"
    gh pr list --state open 2>/dev/null | sed 's/^/  /' || echo "  (gh not authenticated)"
  fi
}

cmd_list() {
  need git
  local repo
  repo="$(repo_name)"
  local base="$VIBE_WORKTREE_ROOT/$repo"
  [[ -d "$base" ]] || {
    echo "no tasks yet for $repo"
    return
  }
  for d in "$base"/*/; do
    [[ -d "$d" ]] && printf '  %s%s%s\n' "$c_cyn" "$(basename "$d")" "$c_off"
  done
}

# unpushed_commits DIR — echo how many commits in DIR's branch exist nowhere
# on a remote. Covers the no-upstream case too: a branch that was never pushed
# has all of its commits unreachable from every remote ref.
unpushed_commits() {
  local dir="$1"
  if git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0
  else
    git -C "$dir" rev-list --count HEAD --not --remotes 2>/dev/null || echo 0
  fi
}

cmd_done() {
  need git
  local force=0 stop=0 discard_handoff=0 keep_brief=0 task=""
  while (($#)); do
    case "$1" in
      -f | --force) force=1 ;;
      --stop) stop=1 ;;
      --discard-handoff) discard_handoff=1 ;;
      --keep-brief) keep_brief=1 ;;
      -*) die "unknown option '$1' (usage: vibe done [--force] [--stop] [--discard-handoff] [--keep-brief] <task>)" ;;
      *) task="$1" ;;
    esac
    shift
  done
  local branch repo main dir
  if [[ -n "$task" ]]; then
    branch="$(slug "$task")"
    repo="$(repo_name)"
    dir="$(worktree_dir "$repo" "$branch")"
  else
    # no task given — only safe from inside a vibe worktree, where the task is
    # unambiguous. Anywhere else, refuse rather than guess a branch to destroy.
    infer_from_cwd ||
      die "not inside a vibe worktree — name the task: vibe done [--force] <task>"
    repo="$R_repo"
    branch="$R_branch"
    dir="$R_dir"
  fi
  main="$(main_repo_root)"
  [[ -d "$dir" ]] || die "no worktree at $dir"

  # A running loop owns this worktree; removing it out from under the runner
  # would corrupt the loop. Refuse unless --stop was given to kill it first.
  if loop_active "$dir"; then
    if [[ "$stop" == "1" ]]; then
      loop_stop "$dir" "$repo" "$branch"
    else
      die "a loop is still running for '$branch'. Stop it first:
  vibe done --stop $task   (kills the loop session, then removes the worktree)"
    fi
  fi

  # Refuse to destroy work. This used to be an unconditional
  # `git worktree remove --force`, which silently threw away uncommitted
  # changes and left unpushed commits reachable only from a branch you were
  # about to stop looking at.
  if [[ "$force" != 1 ]]; then
    local dirty ahead
    dirty="$(git -C "$dir" status --porcelain 2>/dev/null)"
    ahead="$(unpushed_commits "$dir")"

    if [[ -n "$dirty" ]]; then
      warn "worktree has uncommitted changes:"
      printf '%s\n' "$dirty" | sed 's/^/    /' >&2
      die "refusing to remove $dir
  Commit them, or run 'vibe sync', or re-run with --force to discard them."
    fi

    if ((ahead > 0)); then
      die "branch '$branch' has $ahead commit(s) that are on no remote.
  Run 'vibe sync' to push them, or re-run with --force to remove the
  worktree anyway (the branch is kept, so the commits stay reachable)."
    fi

    # A finished task hands nothing off. Content still in the baton is
    # information about to be orphaned on a branch nobody will look at again —
    # promote it (PROJECT_STATUS.md, repo instructions, commit body) or
    # discard it deliberately, but never silently.
    # Shares VIBE_HANDOFF_SCAFFOLD_RE with handoff_carries_content() above;
    # claude/hooks/session-start-handoff.sh mirrors it literally.
    if [[ "$discard_handoff" != 1 ]] && handoff_carries_content "$dir/HANDOFF.md"; then
      warn "HANDOFF.md still carries content:"
      grep -vE "$VIBE_HANDOFF_SCAFFOLD_RE" "$dir/HANDOFF.md" |
        sed 's/^/    /' >&2
      die "refusing to remove $dir
  Promote what is durable, then delete the file ('git rm HANDOFF.md', then
  'vibe sync') — or re-run with --discard-handoff if none of it is worth
  keeping."
    fi

    # Even cleared, the baton is not gone until the file is. The dirty and
    # unpushed guards above mean a HANDOFF.md that still exists here is
    # committed — merged, it lands in the PR diff and strays onto the default
    # branch as an empty husk. Same leak the LOOP.md guard below stops, and
    # exactly how this repo's own main grew a stray HANDOFF.md (PR #14).
    if [[ "$discard_handoff" != 1 && -f "$dir/HANDOFF.md" ]]; then
      die "HANDOFF.md is still on branch '$branch' — merged, it lands in the PR diff.
  Delete it ('git rm HANDOFF.md', then 'vibe sync') — or re-run with
  --discard-handoff to leave it on the branch deliberately."
    fi

    # The brief is start-of-task input, not deliverable. Left on the branch it
    # lands verbatim in the PR diff, so a finished task deletes it — the same
    # end-of-task discipline as the handoff, except deletion needs a commit.
    if [[ "$keep_brief" != 1 && -f "$dir/LOOP.md" ]]; then
      die "LOOP.md is still on branch '$branch' — merged, it lands in the PR diff.
  Delete it ('git rm LOOP.md', then 'vibe sync') — or re-run with
  --keep-brief to leave it on the branch deliberately."
    fi
  fi

  # kill tmux session if present
  local sess
  sess="$(tmux_session_name "$repo" "$branch")"
  if command -v tmux >/dev/null 2>&1 && tmux has-session -t "$sess" 2>/dev/null; then
    tmux kill-session -t "$sess"
    info "killed tmux session $sess"
  fi

  # Step out of the target first: 'vibe done' with no argument is run from
  # inside the worktree it is about to remove, and git refuses to remove the
  # worktree that is the current directory.
  cd "$main" 2>/dev/null || cd / || true

  # --force only when explicitly asked: otherwise let git apply its own checks
  # as a second line of defence.
  if [[ "$force" == 1 ]]; then
    git -C "$main" worktree remove "$dir" --force
  else
    git -C "$main" worktree remove "$dir"
  fi
  info "removed worktree $dir (branch '$branch' kept)"
}

# sync_dir DIR — commit handoff files first (own commit), then the rest, then
# push, refusing over divergence. All git runs through 'git -C "$dir"' so this
# works on a worktree other than the cwd (e.g. 'vibe sync <task>').
sync_dir() {
  local dir="$1"
  git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository."
  local branch root
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"
  [[ "$branch" != "HEAD" ]] || die "detached HEAD — checkout a branch first."
  root="$(git -C "$dir" rev-parse --show-toplevel)"

  # 1. handoff/status files first, as their own commit
  local handoff_paths=() f
  for f in "${VIBE_HANDOFF_FILES[@]}"; do
    [[ -e "$root/$f" ]] || continue
    if ! git -C "$dir" ls-files --error-unmatch "$f" >/dev/null 2>&1 ||
      ! git -C "$dir" diff --quiet -- "$f" 2>/dev/null ||
      ! git -C "$dir" diff --cached --quiet -- "$f" 2>/dev/null; then
      handoff_paths+=("$f")
    fi
  done
  if ((${#handoff_paths[@]})); then
    git -C "$dir" add -- "${handoff_paths[@]}"
    git -C "$dir" commit -q -m "chore: handoff ($branch @ $(date '+%Y-%m-%d %H:%M'))" \
      -- "${handoff_paths[@]}"
    info "committed handoff files: ${handoff_paths[*]}"
  fi

  # 2. the rest of the work
  if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then
    git -C "$dir" add -A
    git -C "$dir" commit -q -m "vibe sync: $branch @ $(date '+%Y-%m-%d %H:%M')"
    info "committed remaining changes on $branch"
  else
    ((${#handoff_paths[@]})) || info "nothing to commit"
  fi

  # 3. push with divergence guard
  if [[ "$(upstream_state "$dir")" == no-upstream ]]; then
    warn "no upstream set — pushing with -u"
    git -C "$dir" push -u origin "$branch"
    ok "pushed $branch (new upstream)"
    return
  fi

  git -C "$dir" fetch -q
  case "$(upstream_state "$dir")" in
    insync) ok "already in sync" ;;
    behind) die "remote is ahead. Run 'vibe resume' here first, then sync." ;;
    ahead)
      git -C "$dir" push -q origin "$branch"
      ok "pushed $branch"
      ;;
    diverged) die "branch and remote have DIVERGED. Resolve manually (git pull --rebase), then sync." ;;
  esac
}

# vibe sync [<task>] — sync the cwd's worktree, or the named task's worktree.
cmd_sync() {
  need git
  local dir
  dir="$(dir_for_optional_task "${1:-}")"
  sync_dir "$dir"
}

# ff_worktree DIR [REBASE] — fast-forward DIR to its upstream, refusing if the
# working tree is dirty or the branch has diverged. This is the plumbing behind
# 'vibe resume'; it refuses to guess, unlike attach_ff which never blocks the
# attach. REBASE=1 opts into 'git pull --rebase' for the diverged case.
ff_worktree() {
  local dir="$1" rebase="${2:-0}" branch
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD)"

  [[ -z "$(git -C "$dir" status --porcelain)" ]] ||
    die "working tree has uncommitted changes. Commit or 'vibe sync' first."

  if [[ "$(upstream_state "$dir")" == no-upstream ]]; then
    warn "no upstream for $branch — nothing to pull"
    return
  fi

  git -C "$dir" fetch -q
  case "$(upstream_state "$dir")" in
    insync) ok "already up to date" ;;
    behind)
      git -C "$dir" merge -q --ff-only '@{u}'
      ok "fast-forwarded $branch to remote"
      ;;
    ahead) warn "you are ahead of remote — nothing to pull. Run 'vibe sync' to push." ;;
    diverged)
      if [[ "$rebase" == 1 ]]; then
        warn "branch and remote have diverged — rebasing onto @{u} (--rebase)."
        git -C "$dir" pull --rebase
        ok "rebased $branch onto remote"
      else
        die "branch and remote have DIVERGED. Resolve manually, then resume
  (or opt into 'vibe resume --rebase' once you have decided)."
      fi
      ;;
  esac
}

# vibe resume [--rebase] [<task>] — fast-forward pull only, unless --rebase.
cmd_resume() {
  need git
  local rebase=0 task=""
  while (($#)); do
    case "$1" in
      --rebase) rebase=1 ;;
      -*) die "unknown option '$1' (usage: vibe resume [--rebase] [<task>])" ;;
      *) task="$1" ;;
    esac
    shift
  done
  local dir
  dir="$(dir_for_optional_task "$task")"
  ff_worktree "$dir" "$rebase"
}

# wait_for_pane_idle SESS — poll the session's pane until the agent looks like
# it is waiting for input, or a bounded timeout elapses. Returns 0 if an idle
# prompt was seen, 1 on timeout. This is polling with a short per-iteration
# wait, never a single blind sleep hoping the agent is ready.
wait_for_pane_idle() {
  local sess="$1" waited=0 max=20 tail
  while ((waited < max)); do
    # last few non-blank lines of the pane; an agent waiting for input ends in
    # its prompt box ('│ >' / '❯' / a bare '>').
    tail="$(tmux capture-pane -t "$sess" -p 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 3)"
    case "$tail" in
      *'│ >'* | *'❯'* | *'> '*) return 0 ;;
    esac
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

# vibe rc <task> — turn on Remote Control for a running task by sending '/rc'
# into its tmux session, so it can be driven from the Claude app on a phone.
# Server only: there is no persistent session to reach on local. This is what
# makes 'ssh <vps> vibe rc <task>' work from anywhere.
cmd_rc() {
  local task="${1:-}"
  [[ -n "$task" ]] || die "usage: vibe rc <task>"

  if [[ "$(detect_env)" != "server" ]]; then
    warn "vibe rc is a no-op on local: Remote Control reaches a persistent tmux
  session on the server, and there is none here. Run it on the server, e.g.
  'ssh <vps> vibe rc $task'."
    return 0
  fi

  need git
  need tmux
  # resolve_by_task confirms the worktree really exists before we try to reach
  # its session — cmd_rc used to derive the names by hand and skip that check.
  resolve_by_task "$task"
  local sess
  sess="$(tmux_session_name "$R_repo" "$R_branch")"
  tmux has-session -t "$sess" 2>/dev/null ||
    die "no tmux session '$sess' — is the task running? Try: vibe attach $task"

  # A loop session runs the runner, not an interactive agent at a prompt.
  # Sending /rc into it would land mid-iteration on the runner, not the agent.
  if loop_active "$R_dir"; then
    die "'$sess' is running a loop, not an interactive agent — there is no prompt
  to send /rc to. Watch it with 'vibe attach $task' instead."
  fi

  if wait_for_pane_idle "$sess"; then
    info "agent looks idle — sending /rc"
  else
    warn "agent did not look idle in time — sending /rc anyway"
  fi
  tmux send-keys -t "$sess" "/rc" C-m
  ok "sent /rc to $sess — open the Claude app → Code tab to connect"
}

# run_headless_handoff DIR — drive the agent once, headlessly, to refresh
# HANDOFF.md. Returns non-zero (after warning) if the agent is missing or the
# run fails, so 'vibe park' can degrade to a plain sync rather than block a
# handoff on a flaky agent.
run_headless_handoff() {
  local dir="$1" bin="${VIBE_AGENT_CMD%% *}"
  if ! command -v "$bin" >/dev/null 2>&1; then
    warn "agent '$bin' not found — skipping HANDOFF.md refresh, syncing as-is."
    return 1
  fi
  local prompt
  prompt="Refresh HANDOFF.md in this worktree as the baton for the next \
session: current state, next concrete action, blockers, and unresolved \
gotchas. Present tense only — rewrite the sections rather than appending, \
keep it under one screen, and edit only HANDOFF.md. History belongs in git, \
not here."
  # The agent command and its headless args are meant to be word-split into
  # separate arguments.
  # shellcheck disable=SC2206
  local -a argv=($VIBE_AGENT_CMD $VIBE_AGENT_HEADLESS_ARGS)
  local log
  log="$(agent_log_path "$dir")"
  if run_agent_headless "$dir" "$log" \
    "refreshing HANDOFF.md via '$VIBE_AGENT_CMD $VIBE_AGENT_HEADLESS_ARGS'…" \
    "${argv[@]}" "$prompt"; then
    ok "HANDOFF.md refreshed"
  else
    warn "headless agent run failed — syncing current HANDOFF.md as-is. See $log"
    return 1
  fi
}

# vibe park [<task>] — the leaving-machine verb. Refresh HANDOFF.md via the
# agent, then sync. The refresh is best-effort: a missing or failing agent
# still leaves the existing handoff synced rather than stranding the work.
cmd_park() {
  need git
  local dir
  dir="$(dir_for_optional_task "${1:-}")"
  # A loop parks itself by design — it commits and (with --push) syncs each
  # round. Parking on top of a live loop would race its HANDOFF refresh.
  if loop_active "$dir"; then
    die "a loop is running here — it handles its own commits. Watch it with
  'vibe attach', or stop it with 'vibe done --stop <task>' first."
  fi
  run_headless_handoff "$dir" || true
  sync_dir "$dir"
}

cmd_where() {
  printf '%s (%s)\n' "$(detect_env)" "$(env_reason)"
}

# ---------------------------------------------------------------------------
# vibe doctor — check everything vibe depends on, and report rather than fix.
# Exit 1 if anything is genuinely broken; warnings alone still exit 0.
# ---------------------------------------------------------------------------
cmd_doctor() {
  local fail=0 warned=0 n_ok=0 n_warn=0 n_fail=0
  local pass="  ${c_grn}✓${c_off}  " bad="  ${c_red}✗${c_off}  " wrn="  ${c_yel}⚠${c_off}  "

  d_ok() {
    printf '%s%s\n' "$pass" "$*"
    n_ok=$((n_ok + 1))
  }
  d_no() {
    printf '%s%s\n' "$bad" "$*"
    fail=1
    n_fail=$((n_fail + 1))
  }
  d_wn() {
    printf '%s%s\n' "$wrn" "$*"
    warned=1
    n_warn=$((n_warn + 1))
  }

  rule "Tools"
  if command -v git >/dev/null 2>&1; then
    d_ok "git         $(git --version | awk '{print $3}')"
  else
    d_no "git         not installed — vibe cannot work without it"
  fi

  if command -v tmux >/dev/null 2>&1; then
    d_ok "tmux        $(tmux -V | awk '{print $2}')"
  elif [[ "$(detect_env)" == "server" ]]; then
    d_no "tmux        not installed — sessions will not survive disconnect"
  else
    d_wn "tmux        not installed (only needed on the server)"
  fi

  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      d_ok "gh          authenticated"
    else
      d_wn "gh          installed but not authenticated — PR list will be empty"
    fi
  else
    d_wn "gh          not installed (optional — used for PR info)"
  fi

  # The agent command may legitimately be a shell function or an alias in an
  # interactive shell, so a miss here is a warning rather than a failure.
  if command -v "${VIBE_AGENT_CMD%% *}" >/dev/null 2>&1; then
    d_ok "agent       $VIBE_AGENT_CMD"
  else
    d_wn "agent       '$VIBE_AGENT_CMD' not on PATH (set VIBE_AGENT_CMD)"
  fi

  printf '\n'
  rule "Paths"
  if [[ -d "$VIBE_WORKTREE_ROOT" ]]; then
    d_ok "worktrees   $VIBE_WORKTREE_ROOT"
  elif [[ -e "$VIBE_WORKTREE_ROOT" ]]; then
    d_no "worktrees   $VIBE_WORKTREE_ROOT exists but is not a directory"
  else
    d_wn "worktrees   $VIBE_WORKTREE_ROOT does not exist yet (created on first 'vibe start')"
  fi

  if [[ -f "$TEMPLATE_DIR/HANDOFF.md" ]]; then
    d_ok "templates   $TEMPLATE_DIR"
  else
    d_no "templates   no HANDOFF.md under $TEMPLATE_DIR — new worktrees will not be seeded"
  fi

  printf '\n'
  rule "Config"
  if [[ ! -e "$VIBE_CONFIG_FILE" ]]; then
    d_wn "config      $VIBE_CONFIG_FILE not present (using env vars and defaults)"
  elif [[ ! -r "$VIBE_CONFIG_FILE" ]]; then
    d_no "config      $VIBE_CONFIG_FILE is not readable"
  else
    # This file is sourced. Insist it is only plain assignments, both because
    # anything else is a surprise and because the Claude Code hooks parse it
    # instead of sourcing it — they would silently disagree.
    local bad_lines
    # SC2016: the '$' and backtick below are regex, not shell expansion —
    # single quotes are exactly what is wanted here.
    # shellcheck disable=SC2016
    bad_lines="$(grep -nvE '^[[:space:]]*(#.*)?$|^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=[^;&|`$()]*$' \
      "$VIBE_CONFIG_FILE" || true)"
    if [[ -n "$bad_lines" ]]; then
      d_no "config      $VIBE_CONFIG_FILE has lines that are not plain KEY=VALUE:"
      printf '%s\n' "$bad_lines" | sed 's/^/         /'
    else
      d_ok "config      $VIBE_CONFIG_FILE"
    fi
  fi

  if [[ -n "$VIBE_NTFY_TOPIC" ]]; then
    d_ok "ntfy topic  set (${#VIBE_NTFY_TOPIC} chars)"
  else
    d_wn "ntfy topic  unset — phone notifications are off (see docs/notifications.md)"
  fi

  d_ok "headless    park/loop run '$VIBE_AGENT_CMD $VIBE_AGENT_HEADLESS_ARGS'"

  if [[ -n "$VIBE_LOOP_PERMISSIVE_ARGS" ]]; then
    d_wn "loop perms  VIBE_LOOP_PERMISSIVE_ARGS set — 'vibe loop --dangerously-allow-all' will skip the agent's permission prompts"
  fi

  case "$VIBE_RC_ON_START" in
    0) d_ok "rc launch   off (enable with VIBE_RC_ON_START=1 on the server)" ;;
    1)
      if [[ "$(detect_env)" == "server" ]]; then
        d_ok "rc launch   on — new sessions start with Remote Control enabled"
      else
        d_wn "rc launch   VIBE_RC_ON_START=1 but this is local — it only applies on the server"
      fi
      ;;
    *) d_no "rc launch   VIBE_RC_ON_START must be 0 or 1 (got '$VIBE_RC_ON_START')" ;;
  esac

  printf '\n'
  rule "Environment"
  d_ok "detected    $(detect_env) ($(env_reason))"
  if [[ "$(detect_env)" == "local" && -z "$VIBE_SERVER_HOSTNAME" ]]; then
    d_wn "hostname    VIBE_SERVER_HOSTNAME unset — server detection relies on SSH vars alone"
  fi

  printf '\n'
  rule "Repository"
  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    d_wn "repo        not inside a git repository (run doctor from a repo for more)"
  else
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    d_ok "repo        $(repo_name) on '${c_cyn}${branch}${c_off}'"

    if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
      d_wn "tree        uncommitted changes present"
    else
      d_ok "tree        clean"
    fi

    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      # Report against the last fetch; doctor is a read-only command and must
      # not reach out to the network behind your back.
      local a b
      a="$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
      b="$(git rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
      if ((a == 0 && b == 0)); then
        d_ok "upstream    in sync as of last fetch"
      elif ((a > 0 && b > 0)); then
        d_no "upstream    DIVERGED — $a ahead, $b behind (resolve before sync/resume)"
      elif ((a > 0)); then
        d_wn "upstream    $a commit(s) ahead — run 'vibe sync' to push"
      else
        d_wn "upstream    $b commit(s) behind — run 'vibe resume' to fast-forward"
      fi
    else
      d_wn "upstream    no upstream for '$branch' — nothing to sync against yet"
    fi
  fi

  local summary="${c_grn}✓${c_off} ${n_ok} ok"
  ((n_warn > 0)) && summary="${summary}  ${c_dim}·${c_off}  ${c_yel}⚠${c_off} ${n_warn} warnings"
  ((n_fail > 0)) && summary="${summary}  ${c_dim}·${c_off}  ${c_red}✗${c_off} ${n_fail} problems"

  printf '\n'
  if ((fail)); then
    printf '%s✗%s vibe doctor: problems found  —  %s\n' "$c_red" "$c_off" "$summary"
    return 1
  elif ((warned)); then
    printf '%s⚠%s vibe doctor: healthy, with warnings  —  %s\n' "$c_yel" "$c_off" "$summary"
  else
    printf '%s✓%s vibe doctor: healthy  —  %s\n' "$c_grn" "$c_off" "$summary"
  fi
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
cmd_help() {
  # With a command name given, print just that command's full usage (name +
  # every flag) and description, sourced from the very same help_cmd calls
  # below rather than a second copy of the text — see help_cmd's target
  # branch. Keeps the top-level listing scannable while the per-command
  # detail (e.g. 'done's four flags) still lives somewhere.
  local target="${1:-}"
  local help_found=0

  # blank — a section-separating blank line, suppressed in target mode so a
  # single-command lookup isn't surrounded by stray empty lines.
  blank() { [[ -n "$target" ]] || printf '\n'; }

  if [[ -z "$target" ]]; then
    printf '%svibe%s — remote-first coding workflow across Mac (local) and Linux server.\n\n' "$c_bld" "$c_off"
    printf "Each TASK gets its own git branch + git worktree under \$VIBE_WORKTREE_ROOT/<repo>/<branch>\n"
    printf '(default ~/git/worktrees). On the SERVER every task runs inside its own persistent tmux\n'
    printf 'session, so the agent keeps working after you disconnect SSH; on the MAC (local), no tmux\n'
    printf 'is forced — you just get dropped into the worktree. Every worktree gets a HANDOFF.md so\n'
    printf 'the two machines can hand off cleanly.\n\n'
    printf 'Commands, in the order you reach for them:\n\n'
  fi

  help_section() {
    [[ -z "$target" ]] || return 0
    rule "$*"
  }
  # help_cmd NAME FLAGS DESC...  — NAME (its base form, no flags) colored and
  # left-padded to a fixed column; each further arg is a continuation line
  # indented to the same column, so multi-line entries stay aligned with
  # single-line ones. FLAGS (may be "") renders as one dim continuation line
  # so a flag-heavy command like 'done' doesn't blow past the column — full
  # detail lives behind 'vibe help <cmd>', driven by this same call in target
  # mode instead of the column listing.
  help_cmd() {
    local name="$1" flags="$2"
    shift 2
    local bare="${name%% *}"
    if [[ -n "$target" ]]; then
      [[ "$bare" == "$target" ]] || return 0
      help_found=1
      printf '%svibe %s%s' "$c_bld" "$name" "$c_off"
      if [[ -n "$flags" ]]; then printf ' %s%s%s' "$c_dim" "$flags" "$c_off"; fi
      printf '\n\n'
      local line
      for line in "$@"; do
        printf '  %s\n' "$line"
      done
      return 0
    fi
    printf '  %s%-28s%s %s\n' "$c_grn" "$name" "$c_off" "$1"
    shift
    local line
    for line in "$@"; do
      printf '  %-28s %s\n' "" "$line"
    done
    if [[ -n "$flags" ]]; then printf '  %-28s %s%s%s\n' "" "$c_dim" "$flags" "$c_off"; fi
  }

  help_section "Daily loop:"
  help_cmd "start <task>" "" \
    "Create branch+worktree for <task>, seed HANDOFF.md," \
    "then open a claude session (in tmux on server)."
  help_cmd "attach [<task>]" "" \
    "Arrive at a task: fast-forward its worktree when that" \
    "is safe (clean + ff-only), then attach. Never refuses" \
    "— a dirty/diverged tree is reported and attached as-is." \
    "With no task, pick from a menu."
  help_cmd "park [<task>]" "" \
    "Leave a machine: refresh HANDOFF.md by running the" \
    "agent headlessly, then sync. Degrades to a plain sync" \
    "if the agent is missing or the headless call fails."
  help_cmd "done [<task>]" "[--force] [--stop] [--discard-handoff] [--keep-brief]" \
    "Remove the worktree (branch is kept). Refuses if the" \
    "worktree is dirty, holds unpushed commits, has a loop" \
    "still running (--stop kills it first), if HANDOFF.md" \
    "still carries content — a finished task hands nothing" \
    "off, so promote or discard first (--discard-handoff" \
    "skips only the handoff check) — or if LOOP.md is still" \
    "on the branch, where it would land in the PR diff;" \
    "delete it and sync, or --keep-brief to leave it there" \
    "deliberately. Infers the task from the cwd when run" \
    "inside a worktree."
  blank

  help_section "Unattended:"
  help_cmd "loop <task>" "[--until <cmd>] [--max <n>] [--prompt <file>] [--push] [--no-attach] [--dangerously-allow-all]" \
    "Create branch+worktree like start, seed LOOP.md, then" \
    "run the agent headlessly round after round until the" \
    "--until check passes, --max rounds pass, or it stalls." \
    "Re-running on an existing loop worktree resumes it." \
    "--no-attach (server) starts the tmux session and" \
    "returns instead of attaching — for starting a loop" \
    "from a remote-controlled session or a script."
  blank

  help_section "Phone:"
  help_cmd "rc <task>" "" \
    "Enable Remote Control on a running task by sending /rc" \
    "into its tmux session (server only), so it can be" \
    "driven from the Claude app on a phone."
  blank

  help_section "Visibility:"
  help_cmd "status [--all]" "" \
    "Show worktrees with per-worktree sync state (dirty," \
    "ahead/behind, HANDOFF.md age), tmux state, PRs. --all" \
    "scans every repo under \$VIBE_WORKTREE_ROOT."
  help_cmd "doctor" "" "Check tools, paths, config and upstream state."
  blank

  help_section "Plumbing (attach/park use these; call directly when you need the git layer):"
  help_cmd "sync [<task>]" "" \
    "Commit handoff files (own commit) + the rest, then" \
    "push. Aborts on divergence. Infers the task from cwd;" \
    "a task argument targets that worktree from anywhere."
  help_cmd "resume [--rebase] [<task>]" "" \
    "Pull remote, fast-forward only. Aborts if dirty or" \
    "diverged; --rebase opts into 'git pull --rebase'."
  help_cmd "list" "" "Short list of tasks."
  help_cmd "where" "" "Print detected environment (local|server) and why."
  blank

  if [[ -n "$target" ]]; then
    ((help_found)) || die "no help for '$target' (try: vibe help)"
    return 0
  fi

  printf 'Requires: git, tmux (server only for persistence), optionally gh (for PR info).\n\n'
  printf 'Config: ~/.config/vibe/config (KEY=VALUE). Environment variables win over it.\n'
  printf "        See templates/vibe.config.example. Run 'vibe doctor' to validate.\n"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
main() {
  local cmd="${1:-status}"
  shift || true
  case "$cmd" in
    start) cmd_start "$@" ;;
    loop) cmd_loop "$@" ;;
    __loop-run) cmd_loop_run "$@" ;;
    attach) cmd_attach "$@" ;;
    park) cmd_park "$@" ;;
    rc) cmd_rc "$@" ;;
    status) cmd_status "$@" ;;
    list) cmd_list "$@" ;;
    done) cmd_done "$@" ;;
    sync) cmd_sync "$@" ;;
    resume) cmd_resume "$@" ;;
    where) cmd_where "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -h | --help | help) cmd_help "$@" ;;
    *) die "unknown command '$cmd' (try: vibe help)" ;;
  esac
}
main "$@"
