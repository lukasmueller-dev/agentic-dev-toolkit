#!/usr/bin/env bash
#
# vibe — one branch + one worktree + one agent session per task.
#
# Core idea:
#   - Each TASK gets its own git branch + git worktree under
#     $VIBE_WORKTREE_ROOT/<repo>/<branch> (default ~/git/worktrees).
#   - Over SSH every task runs inside its own persistent tmux session, so the
#     agent keeps working when the connection drops. At the machine itself no
#     tmux is forced; --no-attach opts back into it.
#   - Every worktree gets a HANDOFF.md that carries context from one session
#     to the next.
#
# Commands:
#   vibe start <task> [--no-attach]
#                         Create branch+worktree for <task>, seed HANDOFF.md,
#                         then open an agent session (in tmux over SSH).
#                         --no-attach starts the tmux session and returns; that
#                         session begins from HANDOFF.md by itself.
#   vibe attach [--rebase] [<task>]
#                         Fast-forward the task's worktree when safe (clean +
#                         ff-only), then attach. Never refuses: a dirty or
#                         diverged tree is attached as-is; --rebase opts into
#                         'git pull --rebase' for the diverged case. With no
#                         task, pick from a menu.
#   vibe done [--force] [--discard-handoff] [--rm-branch] [<task>...]
#                         Remove the worktree (branch is kept). Refuses if the
#                         worktree is dirty, holds unpushed commits, or
#                         HANDOFF.md still carries content or is still on the
#                         branch (--discard-handoff skips the handoff checks).
#                         --rm-branch also deletes the branch once merged.
#   vibe status [--all]   Worktrees with sync state, HANDOFF.md age, tmux
#                         sessions, open PRs. --all scans every repo.
#   vibe doctor           Check tools, paths, config, environment, upstream.
#
# Requires: git, tmux (over SSH), optionally gh (for PR info).
#
# Config: ~/.config/vibe/config (KEY=VALUE). Environment variables win over it.
#         See templates/vibe.config.example. Run 'vibe doctor' to validate.

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
#
# Precedence, highest first:
#   1. environment variable
#   2. ~/.config/vibe/config   (override with $VIBE_CONFIG_FILE)
#   3. built-in default
#
# The config file is sourced, so it must be valid shell — but keep it to plain
# KEY=VALUE lines. `vibe doctor` enforces that, and the Claude Code hooks in
# claude/hooks/ read the same file by parsing rather than sourcing, so anything
# cleverer than an assignment will work here and silently not work there.
# ---------------------------------------------------------------------------
VIBE_CONFIG_FILE="${VIBE_CONFIG_FILE:-$HOME/.config/vibe/config}"

# Capture what the environment set before the config file can shadow it.
_env_worktree_root="${VIBE_WORKTREE_ROOT:-}"
_env_agent_cmd="${VIBE_AGENT_CMD:-}"
_env_agent_resume_args="${VIBE_AGENT_RESUME_ARGS:-}"
_env_tmux_prefix="${VIBE_TMUX_PREFIX:-}"
_env_start_pull_main="${VIBE_START_PULL_MAIN:-}"

if [[ -r "$VIBE_CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$VIBE_CONFIG_FILE"
fi

# env > config > default
VIBE_WORKTREE_ROOT="${_env_worktree_root:-${VIBE_WORKTREE_ROOT:-$HOME/git/worktrees}}"
VIBE_AGENT_CMD="${_env_agent_cmd:-${VIBE_AGENT_CMD:-claude}}"
# Arguments that make VIBE_AGENT_CMD pick its previous conversation back up
# instead of starting a fresh one. Used in exactly one place: when 'vibe
# attach'/'vibe start' finds the task's tmux session alive but its agent gone,
# so the pane is back at a shell. Empty by default and deliberately
# agent-agnostic (Claude Code spells it '--continue') — unset, the agent is
# relaunched with a fresh context and HANDOFF.md carries the state.
VIBE_AGENT_RESUME_ARGS="${_env_agent_resume_args:-${VIBE_AGENT_RESUME_ARGS:-}}"
VIBE_TMUX_PREFIX="${_env_tmux_prefix:-${VIBE_TMUX_PREFIX:-vibe}}"
# Best-effort fast-forward of the main checkout's current branch to its
# upstream before 'vibe start' branches a brand-new task off its HEAD, so the
# new branch does not fork from local history that predates a teammate's
# merge. Never blocks: see ff_main_quiet. Set to 0 to branch off HEAD as-is.
VIBE_START_PULL_MAIN="${_env_start_pull_main:-${VIBE_START_PULL_MAIN:-1}}"
unset _env_worktree_root _env_agent_cmd _env_agent_resume_args \
  _env_tmux_prefix _env_start_pull_main

# A line matches this iff it is nothing but HANDOFF.md template scaffolding:
# blank lines, '#' headings, '>' guidance quotes, '- **Field:**' metadata, and
# single-line _italic placeholders_. 'grep -v' this to surface only real,
# handed-off content. Written once here so handoff_carries_content and cmd_done
# cannot drift. Two literal copies exist elsewhere, in files that cannot
# source this script: claude/hooks/session-start-handoff.sh and
# skills/_lib/vibe-lib.sh — update all three together.
VIBE_HANDOFF_SCAFFOLD_RE='^[[:space:]]*$|^#|^>|^- \*\*|^_.*_[[:space:]]*$'

# open_session's kickoff turn for a genuinely fresh agent launch under
# --no-attach (a new tmux session, or a dead pane restarted without
# VIBE_AGENT_RESUME_ARGS) when handoff_carries_content is true. The
# SessionStart hook only injects HANDOFF.md as context; nobody submits it as a
# turn, so a session nobody is attaching to would otherwise sit at an idle
# prompt with the handoff loaded but never acted on.
#
# --no-attach is the whole trigger: it is exactly the case where no human is
# arriving to say go. A session someone *is* attaching to opens with the
# handoff already in context and waits for them, rather than spending the
# first turn on a decision they were about to make themselves.
#
# Fixed rather than configurable: it names no agent and no CLI flag, just the
# next thing to do.
VIBE_HANDOFF_KICKOFF_PROMPT="Begin per HANDOFF.md."

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------
# Color is resolved once, here, so every command inherits the same decision:
# off when stdout isn't a terminal or NO_COLOR is set, forced on by
# CLICOLOR_FORCE even over a pipe. Getting this wrong leaks raw escapes into
# logs, files and pagers.
if [[ -n "${CLICOLOR_FORCE:-}" ]] || { [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; }; then
  c_red=$'\033[31m'
  c_grn=$'\033[32m'
  c_yel=$'\033[33m'
  c_cyn=$'\033[36m'
  c_dim=$'\033[2m'
  c_bld=$'\033[1m'
  c_off=$'\033[0m'
  vibe_ui_fancy=1
else
  c_red=""
  c_grn=""
  c_yel=""
  c_cyn=""
  c_dim=""
  c_bld=""
  c_off=""
  vibe_ui_fancy=0
fi

# One symbol per severity, used everywhere from top-level messages to the
# doctor report: ✓ ok, ⚠ warn, ✗ die/fail.
die() {
  printf '%s✗%s vibe: %s\n' "$c_red" "$c_off" "$*" >&2
  exit 1
}
info() { printf '%s%s%s\n' "$c_dim" "$*" "$c_off"; }
warn() { printf '%s⚠%s %s\n' "$c_yel" "$c_off" "$*"; }
ok() { printf '%s✓%s %s\n' "$c_grn" "$c_off" "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed."; }

# shq STRING — STRING wrapped in single quotes, safe to paste into a command
# line that /bin/sh will parse. Not the same job as printf '%q': that quotes
# for *bash*, and renders a control byte as $'\033', which dash reads as four
# literal characters. Anything carrying colour escapes — which is anything
# built by info/ok/warn — has to be quoted this way instead.
shq() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# rule TITLE — a dim horizontal-rule section header ('── Title ────…'),
# used wherever a bold standalone header used to stand alone: help, status,
# doctor. One shared implementation so section headers read consistently.
# The dash run is sliced from a constant rather than built with 'tr', which
# mangles the multi-byte '─' glyph into junk bytes on this system's tr.
rule() {
  local title="$1" width=64 prefix pad
  local dash_bank='────────────────────────────────────────────────────────────────'
  prefix="── ${title} "
  pad=$((width - ${#prefix}))
  if ((pad < 4)); then pad=4; fi
  printf '%s%s%s%s\n' "$c_dim" "$prefix" "${dash_bank:0:pad}" "$c_off"
}

# spin PID MESSAGE — braille spinner shown while PID runs in the background.
# Gated on the same tty/color check as the rest of the UI (vibe_ui_fancy):
# piped output or NO_COLOR gets the plain "MESSAGE" line instead, so logs and
# captured output never see \r control sequences or a half-drawn frame.
spin() {
  local pid="$1" msg="$2"
  if [[ "$vibe_ui_fancy" != 1 ]]; then
    info "$msg"
    wait "$pid"
    return $?
  fi
  local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏') i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r%s%s%s %s' "$c_cyn" "${frames[$i]}" "$c_off" "$msg" >&2
    i=$(((i + 1) % ${#frames[@]}))
    sleep 0.1
  done
  local status=0
  wait "$pid" || status=$?
  printf '\r%*s\r' "$((${#msg} + 4))" '' >&2
  return "$status"
}

# ---------------------------------------------------------------------------
# Locating our own files
#
# vibe is normally invoked through a symlink (~/bin/vibe -> <repo>/bin/vibe),
# so $0 and $PWD both point somewhere useless. Walk the symlink chain to find
# where this script really lives, and read templates/ relative to that.
# `readlink -f` is not used: macOS shipped BSD readlink without it for years.
# ---------------------------------------------------------------------------
script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    # a relative link resolves against the directory holding the link
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  # cd -P also resolves symlinked *parent* directories
  cd -P "$(dirname "$src")" && pwd
}

VIBE_HOME="$(dirname "$(script_dir)")" # <repo>/bin/vibe -> <repo>
TEMPLATE_DIR="${TOOLKIT_TEMPLATE_DIR:-$VIBE_HOME/templates}"

# render_template FILE [TOKEN VALUE]... — print FILE with each TOKEN replaced.
# KEEP IN LOCKSTEP with skills/_lib/vibe-lib.sh, which carries a copy for the
# brief-staging skills (they cannot source this file).
# Pure bash: no sed, so a value containing the delimiter (worktree paths hold
# slashes) needs no escaping. One left-to-right scan: the earliest remaining
# token occurrence is copied out with its value and scanning resumes AFTER
# the inserted value, so a value that itself contains another token (a task
# named "document the <machine> placeholder") renders literally instead of
# being re-substituted by a later pass — the old one-token-at-a-time
# ${content//tok/val} loop got that wrong. Avoiding ${var//pat/rep} entirely
# also retires the bash ≥5.2 patsub_replacement hazard ('&' in the value
# expanding to the matched pattern) this function used to shopt around.
render_template() {
  local tpl="$1"
  shift
  local -a toks=() vals=()
  while (($# >= 2)); do
    toks+=("$1")
    vals+=("$2")
    shift 2
  done
  local rest out="" pre
  rest="$(cat "$tpl")"
  local i best_at best_i
  while [[ -n "$rest" ]]; do
    best_at=-1 best_i=0
    for ((i = 0; i < ${#toks[@]}; i++)); do
      # prefix before the token's first occurrence; unchanged means absent
      pre="${rest%%"${toks[$i]}"*}"
      if [[ "$pre" != "$rest" ]] && ((best_at < 0 || ${#pre} < best_at)); then
        best_at=${#pre}
        best_i=$i
      fi
    done
    if ((best_at < 0)); then
      out+="$rest"
      break
    fi
    out+="${rest:0:best_at}${vals[$best_i]}"
    rest="${rest:$((best_at + ${#toks[$best_i]}))}"
  done
  printf '%s\n' "$out"
}

# ---------------------------------------------------------------------------
# Environment detection: 'ssh' when this session came in over SSH, where the
# work has to outlive the connection, else 'local'.
# ---------------------------------------------------------------------------
detect_env() {
  if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_TTY:-}" ]]; then
    echo "ssh"
  else
    echo "local"
  fi
}

env_reason() {
  if [[ -n "${SSH_CONNECTION:-}" ]]; then
    echo "SSH_CONNECTION is set"
  elif [[ -n "${SSH_TTY:-}" ]]; then
    echo "SSH_TTY is set"
  else echo "no SSH session"; fi
}

# ---------------------------------------------------------------------------
# Git helpers
# ---------------------------------------------------------------------------
repo_root() { git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository."; }
repo_name() { basename "$(main_repo_root)"; }
# common dir points at the main repo's .git even from inside a worktree
main_repo_root() {
  local common
  common="$(git rev-parse --git-common-dir 2>/dev/null)" || die "not a git repo."
  # git-common-dir may be relative; resolve it, then take its parent
  common="$(cd "$(dirname "$common")" && pwd)/$(basename "$common")"
  dirname "$common"
}

# upstream_state DIR — classify DIR's HEAD against its upstream from local refs
# only (never fetches), echoing one of:
#   no-upstream  no @{u} tracking branch configured
#   insync       HEAD == @{u}
#   behind       @{u} is ahead of HEAD (a fast-forward pulls it in)
#   ahead        HEAD is ahead of @{u} (a plain push publishes it)
#   diverged     both moved since their merge-base
# The ahead/behind labels are measured against the last fetch, so a caller that
# wants a fresh answer fetches first — each keeps its own fetch and refusal
# policy and only the comparison itself lives here.
upstream_state() {
  local dir="$1" local_rev remote_rev base
  git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 || {
    echo no-upstream
    return
  }
  local_rev="$(git -C "$dir" rev-parse @)"
  remote_rev="$(git -C "$dir" rev-parse '@{u}')"
  base="$(git -C "$dir" merge-base @ '@{u}')"
  if [[ "$local_rev" == "$remote_rev" ]]; then
    echo insync
  elif [[ "$local_rev" == "$base" ]]; then
    echo behind
  elif [[ "$remote_rev" == "$base" ]]; then
    echo ahead
  else
    echo diverged
  fi
}

# sanitize a task name into a branch-safe / dir-safe slug. '/' becomes '-'
# rather than vanishing, so 'docs/fix-x' and 'docsfix-x' stay distinct.
slug() { echo "$1" | tr '[:upper:] /' '[:lower:]--' | sed 's/[^a-z0-9._-]//g'; }

worktree_dir() {
  local repo="$1" branch="$2"
  echo "$VIBE_WORKTREE_ROOT/$repo/$branch"
}

# is_worktree DIR — true when DIR is there *and* git knows it as a working
# tree. The two questions are one question everywhere vibe asks it: a task
# directory that has been deleted and one that has been reduced to a husk are
# the same thing to every command that wants to act on the worktree inside it.
is_worktree() {
  [[ -d "$1" ]] || return 1
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

# ff_main_quiet MAIN — best-effort fast-forward of MAIN's checked-out branch
# to its upstream, called right before a brand-new task branch is cut from
# MAIN's HEAD. Mirrors attach_ff's fetch/ff-only logic but without its
# "attaching" framing, and never refuses: a disabled setting, a dirty tree, no
# upstream, or a failed fetch are all silently skipped, so 'vibe start' always
# still branches off whatever HEAD already is rather than blocking on git.
ff_main_quiet() {
  local main="$1"
  [[ "$VIBE_START_PULL_MAIN" == "1" ]] || return 0
  [[ -z "$(git -C "$main" status --porcelain 2>/dev/null)" ]] || return 0
  [[ "$(upstream_state "$main")" != no-upstream ]] || return 0
  git -C "$main" fetch -q 2>/dev/null || return 0
  [[ "$(upstream_state "$main")" == behind ]] || return 0
  local branch n
  branch="$(git -C "$main" rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 0
  n="$(git -C "$main" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo '?')"
  git -C "$main" merge -q --ff-only '@{u}' 2>/dev/null || return 0
  if [[ "$n" == 1 ]]; then
    ok "fast-forwarded $branch (1 commit) before branching"
  else
    ok "fast-forwarded $branch ($n commits) before branching"
  fi
}

# ensure_worktree MAIN BRANCH DIR — create DIR as a worktree for BRANCH.
# Preference order: existing local branch; branch on origin (fetched when
# needed, and tracked — so a branch pushed from another machine is picked up
# instead of silently shadowed by a fresh branch off HEAD); new branch off
# HEAD. The fetch is best-effort: offline or remote-less repos fall through to
# today's branch-off-HEAD behavior. Only the final case — genuinely cutting a
# new branch from MAIN's own HEAD — calls ff_main_quiet first: the other two
# reuse a branch's own history, so MAIN being stale does not affect them.
# Kept in lockstep with skills/_lib/vibe-lib.sh.
ensure_worktree() {
  local main="$1" branch="$2" dir="$3"
  mkdir -p "$(dirname "$dir")"
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" worktree add "$dir" "$branch"
  else
    git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch" ||
      git -C "$main" fetch -q origin "$branch" >/dev/null 2>&1 || true
    if git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git -C "$main" worktree add --track -b "$branch" "$dir" "origin/$branch"
    else
      ff_main_quiet "$main"
      git -C "$main" worktree add -b "$branch" "$dir"
    fi
  fi
  info "created worktree: $dir  (branch: $branch)"
}

tmux_session_name() {
  # vibe-<repo>-<branch>, tmux disallows dots in session names
  echo "${VIBE_TMUX_PREFIX}-$1-$2" | tr '.' '-'
}

# tmux_live_session SESS — true when tmux is installed here *and* SESS is
# running. The local paths have to be able to ask that question on a machine
# with no tmux at all, where a bare 'tmux has-session' is a command-not-found
# rather than an answer.
tmux_live_session() {
  command -v tmux >/dev/null 2>&1 || return 1
  tmux has-session -t "$1" 2>/dev/null
}

# session_in_tmux SESS NO_ATTACH — true when this task's session belongs in
# tmux rather than in the terminal the command was typed into:
#   - over SSH, where the work has to outlive the connection;
#   - --no-attach anywhere: something other than this process must hold it;
#   - a session that already exists, so 'vibe attach' never execs a second
#     agent against a worktree a detached one is still running in.
session_in_tmux() {
  local sess="$1" no_attach="${2:-0}"
  if [[ "$(detect_env)" == "ssh" || "$no_attach" == "1" ]]; then
    return 0
  fi
  tmux_live_session "$sess"
}

# no_attach_needs_tmux — refuse --no-attach on a machine with no tmux. The flag
# promises the session outlives the command that started it, and tmux is the
# only thing here that can keep that promise: this process cannot, since it
# returns. Over SSH tmux is required anyway; locally it is optional, so this
# is where a machine without it finds out — before anything is scaffolded, and
# with both ways out named.
no_attach_needs_tmux() {
  command -v tmux >/dev/null 2>&1 || die "--no-attach needs tmux — it is what holds
  the session once nobody is attached, and this machine has none. Install tmux,
  or drop --no-attach and let the session open in this terminal."
}

# tmux_ensure_session SESS DIR CMD — make sure a detached session SESS exists
# with working directory DIR, running CMD in its first (and only) pane when it
# has to be created. Idempotent: an existing session is left running untouched.
# Returns 0 when the session was already there, 1 when it was just created, so
# the caller can word its own "already exists" vs "starting" line.
tmux_ensure_session() {
  local sess="$1" dir="$2" cmd="$3"
  if tmux has-session -t "$sess" 2>/dev/null; then
    return 0
  fi
  tmux new-session -d -s "$sess" -c "$dir"
  tmux send-keys -t "$sess" "$cmd" C-m
  return 1
}

# drain_tty — discard whatever the terminal sent us while a child owned the
# screen, before the shell gets the prompt back.
#
# tmux asks the terminal for its foreground and background colours (OSC 10 and
# OSC 11) on *every* attach. The terminal answers on the tty input side, and
# over a laggy SSH link the answer can still be in flight when the client goes
# away — a quick detach, or a session whose program just exited. It then lands
# in the shell that inherited the terminal, which shows it sitting on the
# prompt as "10;rgb:cccc/cccc/cccc11;rgb:1818/1818/1818" (readline eats the
# ESC as a meta prefix and echoes the rest). That is one Enter away from being
# run as a command, so it is worth swallowing rather than living with.
#
# Flushing what has already arrived is not enough: over a slow link the answer
# is still in flight when we look, and any fixed grace period is a guess about
# the latency. So ask a question of our own instead — DSR 6, "where is the
# cursor" — and read until its answer's terminating 'R'. A terminal answers in
# order, so every stale answer queued ahead of ours is swallowed on the way,
# however long the round trip takes. Colour answers are lowercase ("rgb:"), so
# they can never be mistaken for the terminator.
#
# The read is silent (-s) so nothing it swallows is echoed onto the prompt,
# and its timeout is a whole second because bash 3.2 — still what macOS ships
# — rejects a fractional one. That second is only ever spent on a terminal
# that does not answer DSR, which is a terminal that would not have answered
# the colour query either: nothing to drain, nothing lost.
drain_tty() {
  [[ -t 0 ]] || return 0
  local junk
  # To /dev/tty, not stdout: 'vibe attach >log' must not get the query in it.
  printf '\033[6n' >/dev/tty 2>/dev/null || return 0
  # shellcheck disable=SC2034 # 'junk' is a sink, and 'R' is -d's terminator:
  # both are meant to go unread — the point is the discarding, not the value.
  read -r -s -t 1 -d R junk 2>/dev/null || true
  return 0
}

# tmux_pane_cmd SESS — the command running in SESS's active pane. Empty when
# tmux cannot say, which includes a session that does not exist: it reports
# that on stderr and still exits 0, so this can never be used as an existence
# check. Ask 'has-session' for that.
tmux_pane_cmd() {
  tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null || true
}

# pane_is_idle_shell CMD — true when a pane is sitting at a shell prompt with
# nothing of ours running in it. This is the one condition under which vibe may
# type into a pane: anything else running there (an agent, an editor, a build)
# would receive the keystrokes as input. An empty CMD counts as idle — tmux
# only leaves it empty for a session it cannot see, and every caller has
# already confirmed the session exists.
pane_is_idle_shell() {
  case "${1:-}" in
    "" | bash | -bash | zsh | -zsh | sh | dash | fish) return 0 ;;
    *) return 1 ;;
  esac
}

# in_this_tmux_session SESS — true when this very process is running inside
# SESS. Two commands turn on it: 'vibe attach <this task>', where switching a
# client to where it already is would be a no-op, and 'vibe done', where
# killing SESS SIGHUPs the process doing the killing.
in_this_tmux_session() {
  [[ -n "${TMUX:-}" ]] || return 1
  local cur
  cur="$(tmux display-message -p '#{session_name}' 2>/dev/null || true)"
  [[ -n "$cur" && "$cur" == "$1" ]]
}

# end_task_session SESS SUMMARY — kill a finished task's tmux session, and make
# sure SUMMARY is still readable once it is gone.
#
# Over SSH 'vibe done' is normally run from inside the very session it
# ends, and that is where its output went. A tmux client owns the terminal's
# alternate screen, so when it goes away the terminal restores what was there
# *before* the attach: the pane's output is not scrolled off, it is erased.
# What the user is left staring at is the 'vibe start' output from hours ago,
# followed by tmux's own '[exited]' — which reads as though 'vibe done' had
# just started a session. Printing earlier cannot fix that; there is no
# ordering that survives the screen being swapped out from under it.
#
# 'detach-client -E' is the way out. It replaces the departing client with a
# command of our choosing, and that command runs in the *outer* terminal, on
# its normal screen, so what it prints lands in the scrollback the user keeps.
# It prints the summary and then kills the session from there — from outside,
# with the client already gone.
end_task_session() {
  local sess="$1" summary="$2"
  command -v tmux >/dev/null 2>&1 || return 0
  tmux has-session -t "$sess" 2>/dev/null || return 0

  info "killing tmux session $sess"
  if in_this_tmux_session "$sess"; then
    # One printf argument per line, rather than one string with newlines in
    # it: the command is handed to tmux as a single argv element and to the
    # shell verbatim, and keeping it to one line keeps both parsers boring.
    local cmd line
    cmd="printf '%s\\n'"
    while IFS= read -r line; do
      cmd="$cmd $(shq "$line")"
    done <<<"$summary
$(info "ended tmux session $sess")"
    if tmux detach-client -s "$sess" -E "$cmd; tmux kill-session -t $(shq "$sess")"; then
      return 0
    fi
    # tmux older than 2.4 has no -E: it rejects the whole command, leaving the
    # client attached and the session alive. Fall through to the plain kill
    # rather than strand either — the summary is lost, as it was before.
    warn "this tmux cannot hand the summary back to the outer terminal (needs 2.4+)"
  fi
  tmux kill-session -t "$sess"
}

# tmux_attach_or_switch SESS — bring SESS to the foreground. Inside an existing
# tmux client, attach would nest a session; switch the client instead. Outside
# tmux, attach.
tmux_attach_or_switch() {
  local sess="$1"
  if [[ -n "${TMUX:-}" ]]; then
    # Switching a client to the session it is already in is a silent no-op, so
    # 'vibe attach <this task>' from inside the task looked like it did
    # nothing at all. Say so instead.
    if in_this_tmux_session "$sess"; then
      info "already in this session: $sess"
      return 0
    fi
    tmux switch-client -t "$sess"
  else
    # Only the attach path takes the terminal away and hands it back, so only
    # it can be left holding a stale answer to tmux's colour query. Keep
    # attach's own status: draining is cleanup, and must not turn a failed
    # attach into a silent success.
    local rc=0
    tmux attach-session -t "$sess" || rc=$?
    drain_tty
    return "$rc"
  fi
}

# ---------------------------------------------------------------------------
# Resolving which worktree a command should act on
#
# Two ways in, both filling R_repo / R_branch / R_dir:
#   - a task argument, turned into <root>/<repo>/<branch> via repo_name+slug;
#   - inference from the cwd, when we are standing inside a vibe worktree.
# Both confirm with git that the target really is a worktree before trusting
# it, so a stray directory that merely looks like the layout is never acted on.
# ---------------------------------------------------------------------------

# resolve_by_task TASK — fill R_repo/R_branch/R_dir from a task name, or die.
# Needs a surrounding git repo (for repo_name); works from the main checkout
# or from any of the repo's worktrees.
resolve_by_task() {
  local task="$1"
  R_repo="$(repo_name)"
  R_branch="$(slug "$task")"
  R_dir="$(worktree_dir "$R_repo" "$R_branch")"
  [[ -d "$R_dir" ]] || die "no worktree for '$R_branch' (looked in $R_dir). Run: vibe start $task"
  git -C "$R_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die "$R_dir exists but is not a git worktree."
}

# infer_from_cwd — fill R_repo/R_branch/R_dir when the cwd sits inside a vibe
# worktree ($VIBE_WORKTREE_ROOT/<repo>/<branch>). Returns non-zero otherwise,
# so callers can fall back or refuse. git prints physical paths, so resolve
# ours the same way (cd/pwd -P: no readlink -f on macOS) before comparing.
infer_from_cwd() {
  local top vroot rest
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
  top="$(cd "$top" && pwd -P)"
  [[ -d "$VIBE_WORKTREE_ROOT" ]] || return 1
  vroot="$(cd "$VIBE_WORKTREE_ROOT" && pwd -P)"
  case "$top" in
    "$vroot"/*/*) rest="${top#"$vroot"/}" ;;
    *) return 1 ;;
  esac
  R_repo="${rest%%/*}"
  R_branch="${rest#*/}"
  # exactly <repo>/<branch>: a deeper path is not a task root
  [[ -n "$R_repo" && -n "$R_branch" && "$R_branch" != */* ]] || return 1
  # a real worktree, not just a matching path
  git -C "$top" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  R_dir="$top"
}

# pick_task — let the user choose a task for the current repo, printing the
# chosen name on stdout. Uses fzf when it is on PATH, otherwise a plain shell
# 'select' menu. Returns non-zero (after a note) when there is nothing to pick
# or the user cancels, so callers can fall back to a usage message.
pick_task() {
  need git
  local repo base d tasks=()
  repo="$(repo_name)"
  base="$VIBE_WORKTREE_ROOT/$repo"
  if [[ -d "$base" ]]; then
    for d in "$base"/*/; do
      [[ -d "$d" ]] && tasks+=("$(basename "$d")")
    done
  fi
  if ((${#tasks[@]} == 0)); then
    warn "no tasks yet for $repo — run: vibe start <task>" >&2
    return 1
  fi

  if command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "${tasks[@]}" | fzf --prompt='vibe task> ' --height=40% --reverse
  else
    # 'select' draws its menu on stderr and reads the choice from the tty, so
    # stdout stays clean for the chosen name that the caller captures.
    local choice
    select choice in "${tasks[@]}"; do
      [[ -n "$choice" ]] && {
        printf '%s\n' "$choice"
        break
      }
    done </dev/tty
  fi
}

# ---------------------------------------------------------------------------
# HANDOFF.md seeding — rendered from templates/, never embedded here.
# ---------------------------------------------------------------------------
seed_handoff() {
  local dir="$1" repo="$2" branch="$3"
  local f="$dir/HANDOFF.md"
  [[ -f "$f" ]] && return 0

  local tpl="$TEMPLATE_DIR/HANDOFF.md"
  [[ -f "$tpl" ]] || {
    warn "no HANDOFF template at $tpl — skipping seed"
    return 0
  }

  render_template "$tpl" \
    '<repo>' "$repo" \
    '<branch>' "$branch" \
    '<worktree>' "$dir" \
    '<date>' "$(date '+%Y-%m-%d %H:%M %Z')" \
    '<machine>' "$(hostname)" >"$f"
  info "seeded HANDOFF.md"
}

# handoff_carries_content FILE — true when FILE holds anything beyond the
# template's own scaffolding (see VIBE_HANDOFF_SCAFFOLD_RE). The template keeps
# every placeholder on one line precisely so this stays a line filter.
# claude/hooks/session-start-handoff.sh applies the same filter to decide
# whether to inject HANDOFF.md as session context, and skills/_lib/vibe-lib.sh
# carries it for the brief-staging skills — both kept in lockstep by comment,
# since neither can source this file.
handoff_carries_content() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  grep -qvE "$VIBE_HANDOFF_SCAFFOLD_RE" "$f"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_start() {
  need git
  local usage="usage: vibe start <task> [--no-attach]"
  local task="" no_attach=0
  while (($#)); do
    case "$1" in
      --no-attach)
        no_attach=1
        shift
        ;;
      -*) die "unknown option '$1' ($usage)" ;;
      *)
        # Reject a second bare word rather than silently keeping the last:
        # 'vibe start sota 2026-W30' used to make branch '2026-w30' and drop
        # the rest. A task name with spaces has to be quoted.
        [[ -z "$task" ]] ||
          die "one task at a time — got '$task' then '$1'; quote a name with spaces ($usage)"
        task="$1"
        shift
        ;;
    esac
  done
  [[ -n "$task" ]] || die "$usage"
  # Checked before any scaffolding: a late refusal would leave a seeded
  # worktree behind.
  if [[ "$no_attach" == "1" ]]; then no_attach_needs_tmux; fi
  local branch
  branch="$(slug "$task")"
  local repo
  repo="$(repo_name)"
  local main
  main="$(main_repo_root)"
  local dir
  dir="$(worktree_dir "$repo" "$branch")"

  if [[ -d "$dir" ]]; then
    info "worktree already exists, attaching: $dir"
  else
    ensure_worktree "$main" "$branch" "$dir"
  fi

  seed_handoff "$dir" "$repo" "$branch"
  open_session "$repo" "$branch" "$dir" "$no_attach"
}

# open_session REPO BRANCH DIR [NO_ATTACH] — bring the task's session to the
# foreground. Which half runs is session_in_tmux's call, not a machine's:
# wherever something is holding the session (SSH, --no-attach, a session
# already running) tmux owns it and we attach to it; otherwise the agent is
# exec'd into this terminal. NO_ATTACH=1 leaves the tmux session running
# detached instead of attaching.
open_session() {
  local repo="$1" branch="$2" dir="$3" no_attach="${4:-0}"
  local sess
  sess="$(tmux_session_name "$repo" "$branch")"

  if session_in_tmux "$sess" "$no_attach"; then
    need tmux
    local launch="$VIBE_AGENT_CMD" launch_fresh
    # launch_fresh is what actually starts a brand-new conversation (a new
    # tmux session, or a dead pane restarted with no resume args) — launch
    # itself stays free of the kickoff so it can still be combined with
    # VIBE_AGENT_RESUME_ARGS below without carrying it into a resumed
    # conversation. Only --no-attach kicks off: see
    # VIBE_HANDOFF_KICKOFF_PROMPT. printf %q quotes the prompt as a single
    # shell word, since tmux send-keys types this string into a live shell
    # rather than exec'ing an argv.
    launch_fresh="$launch"
    if [[ "$no_attach" == "1" ]] && handoff_carries_content "$dir/HANDOFF.md"; then
      launch_fresh="$launch $(printf '%q' "$VIBE_HANDOFF_KICKOFF_PROMPT")"
    fi
    if tmux_ensure_session "$sess" "$dir" "$launch_fresh"; then
      info "attaching to existing tmux session: $sess"
      # The session outlives the agent. When the agent exits, the pane falls
      # back to a shell and the session keeps running — so attaching alone
      # hands over a bare prompt in the worktree instead of the task's agent,
      # silently and with no error. Start it again. VIBE_AGENT_RESUME_ARGS,
      # when set, picks the previous conversation back up rather than opening
      # an empty one. A pane running anything else is left strictly alone: the
      # agent may still be working, and send-keys would type into it.
      local pane_cmd relaunch
      pane_cmd="$(tmux_pane_cmd "$sess")"
      if pane_is_idle_shell "$pane_cmd"; then
        relaunch="$launch_fresh"
        if [[ -n "$VIBE_AGENT_RESUME_ARGS" ]]; then
          relaunch="$launch $VIBE_AGENT_RESUME_ARGS"
          info "agent not running there — resuming it: $relaunch"
        else
          info "agent not running there — starting it: $relaunch"
        fi
        tmux send-keys -t "$sess" "$relaunch" C-m
      fi
    else
      info "starting persistent tmux session: $sess"
    fi
    if [[ "$no_attach" == "1" ]]; then
      # Started without a tty (ssh <host> vibe start …) or from a script:
      # attaching would fail or hang the caller. The session runs either way.
      info "session running detached: $sess"
      info "watch it: vibe attach $branch   ·   check on it: vibe status"
    else
      tmux_attach_or_switch "$sess"
    fi
  else
    # Nothing is holding a session here, so this terminal becomes it: move
    # into the worktree and launch the agent in place. Word-split on purpose:
    # VIBE_AGENT_CMD may carry flags ("claude --model x"),
    # and exec'ing it as one word treats the whole string as a command name.
    #
    # No kickoff turn here: --no-attach takes the tmux branch above on every
    # machine, so this branch is by construction someone sitting at the
    # terminal it execs into. The SessionStart hook puts the handoff in
    # context and they say go.
    info "local environment — entering worktree (no tmux)."
    cd "$dir"
    # shellcheck disable=SC2206
    local -a agent_argv=($VIBE_AGENT_CMD)
    exec "${agent_argv[@]}"
  fi
}

# attach_ff DIR [REBASE] — fast-forward DIR to its upstream when that is safe
# (clean tree, ff-only), and print one line saying what happened either way.
# NEVER refuses: a dirty or diverged worktree is reported and left alone, and
# the caller attaches regardless. REBASE=1 opts into 'git pull --rebase' for
# the diverged case.
attach_ff() {
  local dir="$1" rebase="${2:-0}" branch
  branch="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)" || return 0

  if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
    warn "not pulling: $branch has uncommitted changes — attaching as-is"
    return 0
  fi
  if [[ "$(upstream_state "$dir")" == no-upstream ]]; then
    info "no upstream for $branch — attaching without pulling"
    return 0
  fi
  git -C "$dir" fetch -q 2>/dev/null || {
    warn "fetch failed — attaching without pulling"
    return 0
  }

  local n
  case "$(upstream_state "$dir")" in
    insync) info "$branch already up to date — attaching" ;;
    behind)
      n="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo '?')"
      git -C "$dir" merge -q --ff-only '@{u}'
      if [[ "$n" == 1 ]]; then
        ok "fast-forwarded $branch (1 commit) — attaching"
      else
        ok "fast-forwarded $branch ($n commits) — attaching"
      fi
      ;;
    ahead) info "$branch is ahead of remote — attaching" ;;
    diverged)
      if [[ "$rebase" == 1 ]]; then
        if git -C "$dir" pull -q --rebase; then
          ok "rebased $branch onto remote — attaching"
        else
          warn "rebase of $branch stopped — resolve it in the session"
        fi
      else
        warn "not pulling: $branch has diverged from remote — attaching as-is
  ('vibe attach --rebase' reconciles once you have decided)"
      fi
      ;;
  esac
  return 0
}

# vibe attach [--rebase] [<task>] — fast-forward the task's worktree when
# safe, then attach; with no task, pick from a menu.
cmd_attach() {
  need git
  local task="" rebase=0
  while (($#)); do
    case "$1" in
      --rebase) rebase=1 ;;
      -*) die "unknown option '$1' (usage: vibe attach [--rebase] [<task>])" ;;
      *) task="$1" ;;
    esac
    shift
  done
  [[ -n "$task" ]] || task="$(pick_task)" || die "no task selected."
  [[ -n "$task" ]] || die "usage: vibe attach [--rebase] <task>"
  resolve_by_task "$task"
  attach_ff "$R_dir" "$rebase"
  open_session "$R_repo" "$R_branch" "$R_dir"
}

# handoff_age DIR — a short human age for DIR/HANDOFF.md ("3h", "2d"), or
# "none". stat differs between GNU and BSD, so try both spellings.
handoff_age() {
  local dir="$1"
  local f="$dir/HANDOFF.md" mtime now delta
  [[ -f "$f" ]] || {
    echo "none"
    return
  }
  mtime="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)" || {
    echo "?"
    return
  }
  now="$(date +%s)"
  delta=$((now - mtime))
  if ((delta < 3600)); then
    echo "$((delta / 60))m"
  elif ((delta < 86400)); then
    echo "$((delta / 3600))h"
  else
    echo "$((delta / 86400))d"
  fi
}

# upstream_ref_state DIR — echo 'ok', 'gone', or 'none' for DIR's branch. This
# answers a narrower question than upstream_state above, which cannot tell a
# branch that was never pushed from one whose remote branch has been deleted:
# 'rev-parse @{u}' fails identically for both, so both come back 'no-upstream'.
#
#   ok    an upstream is configured and its remote-tracking ref still exists
#   gone  an upstream is configured but the ref is gone — the branch was
#         deleted on the remote, which after a merged PR is the usual signal
#         that the task is finished and 'vibe done' can clean it up
#   none  no upstream configured (never pushed, or a detached HEAD)
#
# 'for-each-ref' is what separates 'gone' from 'none'. Like the rest of 'vibe
# status' this never fetches, so 'gone' reflects the last 'git fetch --prune',
# not the remote right now.
upstream_ref_state() {
  local dir="$1" branch
  branch="$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null)" || {
    echo none
    return
  }
  branch_upstream_state "$dir" "$branch"
}

# branch_upstream_state REPO BRANCH — the same ok/gone/none verdict for a branch
# named explicitly, from any checkout of REPO. The form 'vibe done --rm-branch'
# needs, because by the time it asks, the branch's own worktree is gone.
branch_upstream_state() {
  local repo="$1" branch="$2" up="" track=""
  read -r up track <<<"$(git -C "$repo" for-each-ref \
    --format='%(upstream:short) %(upstream:track)' \
    "refs/heads/$branch" 2>/dev/null)" || true
  if [[ -z "$up" ]]; then
    echo none
  elif [[ "$track" == "[gone]" ]]; then
    echo gone
  else
    echo ok
  fi
}

# git_sync_state DIR — echo "DIRTY AHEAD BEHIND UPSTREAM" (DIRTY is 1/0) for
# DIR. The one place that computes this, so the status dot and its detail line
# can never disagree about what state a worktree is in. Like cmd_doctor, it
# never fetches: 'ahead'/'behind' are measured against the last fetch so 'vibe
# status' stays read-only and offline.
git_sync_state() {
  local dir="$1" dirty=0 ahead behind
  [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]] && dirty=1
  ahead="$(unpushed_commits "$dir")"
  behind="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
  printf '%s %s %s %s\n' "$dirty" "$ahead" "$behind" "$(upstream_ref_state "$dir")"
}

# worktree_state_word DIR REPO BRANCH — one word summarizing a worktree, the
# single place that verdict is decided:
#
#   missing   git lists the worktree but its directory is gone
#   idle      tmux is installed here but no session is running for this task
#   dirty     uncommitted changes
#   merged    the upstream branch is gone and nothing is left unpushed — a
#             merged PR, ready for 'vibe done'
#   diverged  unpushed commits *and* commits to pull
#   unsynced  one or the other
#   clean     nothing to do
#
# Locally, where tmux is never forced, a missing tmux binary just falls
# through to the git-only states.
worktree_state_word() {
  local dir="$1" repo="$2" branch="$3"
  # First, because every state below it is a reading of a directory that has
  # to exist. Judged by git alone a vanished worktree is clean, level with its
  # upstream and carrying no handoff — it reports as a healthy idle task
  # forever, which is exactly how one goes unnoticed.
  if ! is_worktree "$dir"; then
    echo missing
    return
  fi
  if command -v tmux >/dev/null 2>&1; then
    local sess
    sess="$(tmux_session_name "$repo" "$branch")"
    if ! tmux has-session -t "$sess" 2>/dev/null; then
      echo idle
      return
    fi
  fi
  local dirty ahead behind upstream
  read -r dirty ahead behind upstream <<<"$(git_sync_state "$dir")"
  if [[ "$dirty" == "1" ]]; then
    echo dirty
  elif [[ "$upstream" == "gone" && "$ahead" == "0" ]]; then
    echo merged
  elif ((ahead > 0 && behind > 0)); then
    echo diverged
  elif ((ahead > 0 || behind > 0)); then
    echo unsynced
  else
    echo clean
  fi
}

# worktree_state_dot DIR REPO BRANCH — worktree_state_word as the colored ●
# 'vibe status' prints: dim ○ idle, green clean, cyan merged, yellow dirty or
# out of sync, red diverged.
worktree_state_dot() {
  case "$(worktree_state_word "$@")" in
    missing) printf '%s✗%s' "$c_red" "$c_off" ;;
    idle) printf '%s○%s' "$c_dim" "$c_off" ;;
    dirty | unsynced) printf '%s●%s' "$c_yel" "$c_off" ;;
    merged) printf '%s●%s' "$c_cyn" "$c_off" ;;
    diverged) printf '%s●%s' "$c_red" "$c_off" ;;
    *) printf '%s●%s' "$c_grn" "$c_off" ;;
  esac
}

# sync_state_line DIR — one dim detail line under a worktree's entry, joined
# to it with a '└─' connector.
sync_state_line() {
  local dir="$1" dirty ahead behind upstream dirty_word dirty_c
  # Every number below comes from running git in DIR, and git in a directory
  # that is not there answers with zeros — a clean, in-sync worktree. Say what
  # is actually wrong, and name the command that clears it.
  if ! is_worktree "$dir"; then
    printf '    %s└─%s %sdirectory is gone%s%s — run %s to clear what is left%s\n' \
      "$c_dim" "$c_off" "$c_red" "$c_off" "$c_dim" "'vibe done <task>'" "$c_off"
    return
  fi
  read -r dirty ahead behind upstream <<<"$(git_sync_state "$dir")"
  if [[ "$dirty" == "1" ]]; then
    dirty_word="dirty"
    dirty_c="$c_yel"
  else
    dirty_word="clean"
    dirty_c="$c_grn"
  fi
  # 'behind' is only meaningful against a live upstream; with none, or one
  # that has been deleted, say so instead of printing a hard-coded 0.
  local sync
  case "$upstream" in
    ok) sync="$ahead ahead · $behind behind" ;;
    gone) sync="$ahead ahead · ${c_cyn}upstream gone${c_off}${c_dim}" ;;
    *) sync="$ahead unpushed · no upstream" ;;
  esac
  printf '    %s└─%s %s%s%s%s · %s · handoff %s%s\n' \
    "$c_dim" "$c_off" "$dirty_c" "$dirty_word" "$c_off" "$c_dim" "$sync" "$(handoff_age "$dir")" "$c_off"
}

# ---------------------------------------------------------------------------
# Worktree enumeration
#
# The two scopes 'vibe status' offers — this repo, or every repo under the
# worktree root — are generators emitting one tab-separated record per
# worktree.
#
# Record fields, in order:
#   PATH      the worktree directory
#   BRANCH    as it should be displayed (see DETACHED)
#   REPO      repository name, which with BRANCH gives the tmux session name
#   KIND      task | main (the repo's own checkout) | unmanaged (outside the
#             worktree root — a worktree 'vibe done' would not find)
#   DETACHED  1 when HEAD is detached, in which case BRANCH is a placeholder
#             and not a branch name at all
# ---------------------------------------------------------------------------

# worktree_records — the current repo's worktrees, from 'git worktree list'.
# That list starts with the main checkout itself, so label anything that is
# not a vibe task rather than presenting it as one. git prints physical paths,
# so resolve ours the same way before comparing (cd/pwd -P: no readlink -f on
# macOS).
worktree_records() {
  local mainroot vroot wt="" br="" repo line kind det
  mainroot="$(main_repo_root 2>/dev/null || true)"
  if [[ -d "$mainroot" ]]; then mainroot="$(cd "$mainroot" && pwd -P)"; fi
  vroot="$VIBE_WORKTREE_ROOT"
  if [[ -d "$vroot" ]]; then vroot="$(cd "$vroot" && pwd -P)"; fi
  repo="$(repo_name)"

  while IFS= read -r line; do
    case "$line" in
      "worktree "*)
        wt="${line#worktree }"
        continue
        ;;
      "branch "*)
        br="${line#branch }"
        br="${br#refs/heads/}"
        det=0
        ;;
      "detached")
        br="(detached)"
        det=1
        ;;
      *) continue ;;
    esac
    kind=task
    if [[ -n "$mainroot" && "$wt" == "$mainroot" ]]; then
      kind=main
    elif [[ -n "$vroot" && "$wt" != "$vroot"/* ]]; then
      kind=unmanaged
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$wt" "$br" "$repo" "$kind" "$det"
  done < <(git worktree list --porcelain 2>/dev/null)
}

# worktree_records_all — every vibe worktree under $VIBE_WORKTREE_ROOT, across
# all repos. Walks the directory tree rather than 'git worktree list', so it
# works from outside any git repository. Everything it finds is a task by
# construction, so KIND is always 'task'.
worktree_records_all() {
  local vroot repo_dir wt_dir repo br det
  vroot="$VIBE_WORKTREE_ROOT"
  [[ -d "$vroot" ]] || return 0
  vroot="$(cd "$vroot" && pwd -P)"
  for repo_dir in "$vroot"/*/; do
    [[ -d "$repo_dir" ]] || continue
    repo="$(basename "$repo_dir")"
    for wt_dir in "$repo_dir"*/; do
      [[ -d "$wt_dir" ]] || continue
      git -C "$wt_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
      br="$(git -C "$wt_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
      det=0
      git -C "$wt_dir" symbolic-ref --quiet HEAD >/dev/null 2>&1 || det=1
      printf '%s\t%s\t%s\t%s\t%s\n' "${wt_dir%/}" "$br" "$repo" task "$det"
    done
  done
}

# print_worktrees — the current repo's worktrees, one per line, each with a
# sync-state line.
print_worktrees() {
  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "  (not in a repo — try 'vibe status --all')"
    return
  fi
  local wt br repo kind det
  while IFS=$'\t' read -r wt br repo kind det; do
    print_one_worktree "$wt" "$br" "$repo" "$kind"
  done < <(worktree_records)
}

print_one_worktree() {
  local wt="$1" br="$2" repo="$3" kind="$4" tag="" dot
  case "$kind" in
    main) tag="  (main checkout, not a vibe task)" ;;
    unmanaged) tag="  (not managed by vibe)" ;;
  esac
  dot="$(worktree_state_dot "$wt" "$repo" "$br")"
  printf '  %s %s%s%s  %s%s%s%s\n' "$dot" "$c_cyn" "$br" "$c_off" "$c_dim" "$wt" "$tag" "$c_off"
  sync_state_line "$wt"
}

# print_all_worktrees — the --all listing: repo/branch rather than a bare
# branch, since one glance covers every repo.
print_all_worktrees() {
  local vroot wt br repo kind det found=0 dot
  vroot="$VIBE_WORKTREE_ROOT"
  if [[ ! -d "$vroot" ]]; then
    echo "  (no worktree root at $vroot)"
    return
  fi
  vroot="$(cd "$vroot" && pwd -P)"
  while IFS=$'\t' read -r wt br repo kind det; do
    found=1
    dot="$(worktree_state_dot "$wt" "$repo" "$br")"
    printf '  %s %s%s/%s%s  %s%s%s\n' \
      "$dot" "$c_cyn" "$repo" "$br" "$c_off" "$c_dim" "$wt" "$c_off"
    sync_state_line "$wt"
  done < <(worktree_records_all)
  ((found)) || echo "  (no vibe worktrees under $vroot)"
}

cmd_status() {
  need git
  local all=0
  while (($#)); do
    case "$1" in
      --all) all=1 ;;
      *) die "unknown option '$1' (usage: vibe status [--all])" ;;
    esac
    shift
  done
  printf '%sEnvironment:%s %s (%s)\n\n' "$c_bld" "$c_off" "$(detect_env)" "$(env_reason)"

  rule "Worktrees"
  if ((all)); then print_all_worktrees; else print_worktrees; fi

  # tmux sessions belonging to vibe — scoped to this repo unless --all, same
  # as the worktree listing above
  if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
    printf '\n'
    rule "Active tmux sessions"
    local sess_prefix="${VIBE_TMUX_PREFIX}-"
    if ((!all)) && git rev-parse --show-toplevel >/dev/null 2>&1; then
      sess_prefix="${VIBE_TMUX_PREFIX}-$(repo_name)-"
    fi
    local sess_line sess_found=0
    while IFS= read -r sess_line; do
      [[ "$sess_line" == "${sess_prefix}"* ]] || continue
      printf '  %s\n' "$sess_line"
      sess_found=1
    done < <(tmux ls 2>/dev/null)
    ((sess_found)) || echo "  (none)"
  fi

  # open PRs via gh, if available and we are inside a repo
  if git rev-parse --show-toplevel >/dev/null 2>&1 && command -v gh >/dev/null 2>&1; then
    printf '\n'
    rule "Open PRs"
    gh pr list --state open 2>/dev/null | sed 's/^/  /' || echo "  (gh not authenticated)"
  fi
}

# unpushed_commits DIR — echo how many commits in DIR's branch exist nowhere
# on a remote. Covers the no-upstream case too: a branch that was never pushed
# has all of its commits unreachable from every remote ref.
unpushed_commits() {
  local dir="$1"
  if git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0
  else
    git -C "$dir" rev-list --count HEAD --not --remotes 2>/dev/null || echo 0
  fi
}

cmd_done() {
  need git
  local force=0 discard_handoff=0 rm_branch=0
  local tasks=()
  while (($#)); do
    case "$1" in
      -f | --force) force=1 ;;
      --discard-handoff) discard_handoff=1 ;;
      --rm-branch) rm_branch=1 ;;
      -*) die "unknown option '$1' (usage: vibe done [--force] [--discard-handoff] [--rm-branch] <task>...)" ;;
      *) tasks+=("$1") ;;
    esac
    shift
  done

  # 0 or 1 task: run inline, so a failure's 'die' exits the whole command with
  # its own message — the plain single-task behaviour this command has always
  # had, including inferring the task from the cwd when none was named.
  if ((${#tasks[@]} <= 1)); then
    done_one "$force" "$discard_handoff" "$rm_branch" "${tasks[0]:-}"
    return
  fi

  # 2+ tasks, e.g. `vibe done task_1 task_2` — same idea as `git branch -d a
  # b`: attempt every one, keep going past a failure, fail the command overall
  # only once all of them have been tried. Each runs in a subshell so a 'die'
  # inside done_one exits only that task's attempt, not the whole loop.
  #
  # Step out before the first removal: each attempt changes directory only
  # inside its own subshell, so removing the worktree this shell stands in
  # would leave every later attempt starting from a deleted cwd, where the
  # repo/worktree resolution dies before that task's guards even run.
  cd "$(main_repo_root)"

  # Then put the task that owns *this* session last, if one of them does.
  # Killing it SIGHUPs vibe itself, so every task named after it would never be
  # attempted — silently, with a zero exit, because the shell is gone before
  # anything can report it. Deferring is enough: the kill only ever cuts off
  # work that comes after it.
  local repo_here ordered=() deferred=() t
  repo_here="$(repo_name)"
  for t in "${tasks[@]}"; do
    if in_this_tmux_session "$(tmux_session_name "$repo_here" "$(slug "$t")")"; then
      deferred+=("$t")
    else
      ordered+=("$t")
    fi
  done
  tasks=("${ordered[@]+"${ordered[@]}"}" "${deferred[@]+"${deferred[@]}"}")

  local failed=0
  for t in "${tasks[@]}"; do
    if (done_one "$force" "$discard_handoff" "$rm_branch" "$t"); then
      :
    else
      failed=1
    fi
  done
  ((failed == 0))
}

# done_one FORCE DISCARD_HANDOFF RM_BRANCH TASK — remove one
# task's worktree (branch kept unless RM_BRANCH). TASK may be "" to infer the
# task from the cwd, which is only meaningful when 'vibe done' was given no task
# names at all.
done_one() {
  local force="$1" discard_handoff="$2" rm_branch="$3" task="$4"
  local branch repo main dir
  if [[ -n "$task" ]]; then
    branch="$(slug "$task")"
    repo="$(repo_name)"
    dir="$(worktree_dir "$repo" "$branch")"
  else
    # no task given — only safe from inside a vibe worktree, where the task is
    # unambiguous. Anywhere else, refuse rather than guess a branch to destroy.
    infer_from_cwd ||
      die "not inside a vibe worktree — name the task: vibe done [--force] <task>"
    repo="$R_repo"
    branch="$R_branch"
    dir="$R_dir"
  fi
  main="$(main_repo_root)"

  # A task routinely outlives its worktree directory: deleted by hand, wiped
  # with the volume it sat on, or removed on a machine that shares the
  # checkout. What is left behind — git's worktree registration, the branch,
  # and the tmux session 'vibe status' keeps listing — is precisely what this
  # command exists to clear, so hand those cases to done_stale instead of
  # dying on the missing directory. Dying there left the one command that
  # finishes a task refusing exactly when there was a mess to finish, with no
  # other command able to kill the orphaned session.
  if ! is_worktree "$dir"; then
    done_stale "$repo" "$branch" "$dir" "$main" "$rm_branch" "$force"
    return
  fi

  # Refuse to destroy work. This used to be an unconditional
  # `git worktree remove --force`, which silently threw away uncommitted
  # changes and left unpushed commits reachable only from a branch you were
  # about to stop looking at.
  if [[ "$force" != 1 ]]; then
    local dirty ahead
    dirty="$(git -C "$dir" status --porcelain 2>/dev/null)"
    ahead="$(unpushed_commits "$dir")"

    if [[ -n "$dirty" ]]; then
      warn "worktree has uncommitted changes:"
      printf '%s\n' "$dirty" | sed 's/^/    /' >&2
      die "refusing to remove $dir
  Commit them, or re-run with --force to discard them."
    fi

    if ((ahead > 0)); then
      die "branch '$branch' has $ahead commit(s) that are on no remote.
  Push them ('git push'), or re-run with --force to remove the
  worktree anyway (the branch is kept, so the commits stay reachable)."
    fi

    # A finished task hands nothing off. Content still in the baton is
    # information about to be orphaned on a branch nobody will look at again —
    # promote it (PROJECT_STATUS.md, repo instructions, commit body) or
    # discard it deliberately, but never silently.
    # Shares VIBE_HANDOFF_SCAFFOLD_RE with handoff_carries_content() above;
    # claude/hooks/session-start-handoff.sh mirrors it literally.
    if [[ "$discard_handoff" != 1 ]] && handoff_carries_content "$dir/HANDOFF.md"; then
      warn "HANDOFF.md still carries content:"
      grep -vE "$VIBE_HANDOFF_SCAFFOLD_RE" "$dir/HANDOFF.md" |
        sed 's/^/    /' >&2
      die "refusing to remove $dir
  Promote what is durable, then delete the file ('git rm HANDOFF.md', commit,
  push) — or re-run with --discard-handoff if none of it is worth keeping."
    fi

    # Even cleared, the baton is not gone until the file is. The dirty and
    # unpushed guards above mean a HANDOFF.md that still exists here is
    # committed — merged, it lands in the PR diff and strays onto the default
    # branch as an empty husk — exactly how this repo's own main grew a stray
    # HANDOFF.md (PR #14).
    if [[ "$discard_handoff" != 1 && -f "$dir/HANDOFF.md" ]]; then
      die "HANDOFF.md is still on branch '$branch' — merged, it lands in the PR diff.
  Delete it ('git rm HANDOFF.md', commit, push) — or re-run with
  --discard-handoff to leave it on the branch deliberately."
    fi
  fi

  # Step out of the target first: 'vibe done' with no argument is run from
  # inside the worktree it is about to remove, and git refuses to remove the
  # worktree that is the current directory.
  cd "$main" 2>/dev/null || cd / || true

  # --force only when explicitly asked: otherwise let git apply its own checks
  # as a second line of defence. The explicit die is what keeps that defence
  # real in multi-task mode: there each attempt runs as the tested condition
  # of an 'if', which switches errexit off through the whole subshell — so
  # without it, git's refusal (say, a locked worktree) would fall through to
  # the success message and a zero exit.
  if [[ "$force" == 1 ]]; then
    git -C "$main" worktree remove "$dir" --force ||
      die "could not remove worktree $dir (see git's message above)"
  else
    git -C "$main" worktree remove "$dir" ||
      die "could not remove worktree $dir (see git's message above)"
  fi
  # The outcome is composed into a variable and then printed, rather than
  # printed directly: run from inside the task's own session, this pane is
  # about to be erased, and end_task_session needs a copy of what was on it to
  # replay in the terminal the user is left with. Capturing rather than
  # re-wording keeps the two identical, including delete_branch's verdict —
  # which is not knowable up front, since it keeps an unmerged branch.
  local summary
  if [[ "$rm_branch" == 1 ]]; then
    summary="$(
      info "removed worktree $dir"
      delete_branch "$main" "$branch" "$force"
    )"
  else
    summary="$(info "removed worktree $dir (branch '$branch' kept)")"
  fi
  printf '%s\n' "$summary"

  # The tmux kill goes last, and every message above it is already printed.
  # Over SSH 'vibe done' is normally run from inside the task's own
  # session, so this kill SIGHUPs the very process running it: anything left
  # after this line does not happen. Killing first meant the worktree was
  # never removed and not a byte was printed — not even the refusals above,
  # which all die further down the same doomed pane.
  #
  # In multi-task 'vibe done a b', each done_one runs in its own subshell, so a
  # kill only ends the whole command when the session being killed is the one
  # vibe is running in. cmd_done defers that task to last for exactly that
  # reason.
  local sess
  sess="$(tmux_session_name "$repo" "$branch")"
  end_task_session "$sess" "$summary"
}

# worktree_registered MAIN DIR — true when git still lists DIR among MAIN's
# worktrees, whether or not the directory itself is still there. That is the
# state git calls 'prunable', and it is invisible to a [[ -d ]] test.
#
# git records the physical path it resolved at 'worktree add' time, while DIR
# is built from $VIBE_WORKTREE_ROOT as configured — so a worktree root reached
# through a symlink makes the two spellings differ. Compare against the
# resolved form as well (the root still exists even when the task directory
# does not, which is what makes this resolvable at all).
worktree_registered() {
  local main="$1" dir="$2" alt="" vroot line p
  vroot="$VIBE_WORKTREE_ROOT"
  if [[ -d "$vroot" ]]; then
    vroot="$(cd "$vroot" && pwd -P)"
    case "$dir" in
      "$VIBE_WORKTREE_ROOT"/*) alt="$vroot/${dir#"$VIBE_WORKTREE_ROOT"/}" ;;
    esac
  fi
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) p="${line#worktree }" ;;
      *) continue ;;
    esac
    if [[ "$p" == "$dir" ]] || [[ -n "$alt" && "$p" == "$alt" ]]; then
      return 0
    fi
  done < <(git -C "$main" worktree list --porcelain 2>/dev/null)
  return 1
}

# done_stale REPO BRANCH DIR MAIN RM_BRANCH FORCE — finish a task whose
# worktree directory is gone (or is no longer a worktree).
#
# None of done_one's guards run here, and none of them need to: every one of
# them protects work that lives *in* the worktree, and that directory is
# already gone — there is no dirty tree to lose, no HANDOFF.md left to
# promote. What remains is the bookkeeping that outlives it, and each piece is
# cleared only if it is actually there:
#
#   registration   git still lists the worktree, marked prunable. Pruning is
#                  the operation git offers for exactly this state, and unlike
#                  'worktree remove' it can only ever drop the record of a
#                  directory that is already missing — so a husk directory
#                  someone still wants is never deleted from under them.
#   tmux session   the visible symptom: 'vibe status' lists a session for a
#                  task whose directory does not exist, and before this
#                  nothing could kill it short of tmux by hand.
#   branch         kept, exactly as in the normal path, unless --rm-branch.
#                  The commits live on it, so keeping it is what makes this
#                  cleanup non-destructive: it removes only records of things
#                  that are already gone.
#
# With none of the three present there is nothing to finish, so refuse rather
# than report a cleanup that did nothing.
done_stale() {
  local repo="$1" branch="$2" dir="$3" main="$4" rm_branch="$5" force="$6"
  local sess registered=0 session_live=0 branch_here=0 residue=0
  sess="$(tmux_session_name "$repo" "$branch")"
  if worktree_registered "$main" "$dir"; then registered=1; fi
  if tmux_live_session "$sess"; then session_live=1; fi
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then branch_here=1; fi

  # A branch on its own is not residue: every branch in the repo would qualify,
  # and 'vibe done <any branch name>' would report having cleaned up a task
  # that never existed. It counts only when --rm-branch gives it something to
  # do.
  if ((registered || session_live)); then residue=1; fi
  if ((rm_branch && branch_here)); then residue=1; fi
  if ((!residue)); then
    die "no worktree at $dir
  Nothing of '$branch' is left here either: git has no worktree registered
  for it and no tmux session is running. Run 'vibe status' to see this
  repo's tasks."
  fi

  if [[ -d "$dir" ]]; then
    warn "$dir is not a git worktree — leaving the directory alone"
  else
    warn "worktree directory is already gone: $dir"
  fi

  if ((registered)); then
    git -C "$main" worktree prune >/dev/null 2>&1 || true
  fi

  # Composed and then printed, for the same reason as done_one's summary: run
  # from inside the task's own session, this pane is about to be erased, and
  # end_task_session replays what was on it in the terminal the user keeps.
  local summary
  summary="$(
    if ((registered)) && worktree_registered "$main" "$dir"; then
      warn "git still lists a worktree at $dir
  It is not prunable while a directory sits there. Remove that directory if
  it is junk, or run 'git -C $main worktree repair $dir' if it should still
  be a worktree."
    elif ((registered)); then
      info "pruned git's worktree record for $dir"
    fi
    if ((rm_branch)); then
      info "finished stale task '$branch'"
      delete_branch "$main" "$branch" "$force"
    else
      info "finished stale task '$branch' (branch kept — the commits are on it)"
    fi
  )"
  printf '%s\n' "$summary"

  # Last, as in done_one: this can be the session vibe itself is running in.
  end_task_session "$sess" "$summary"
}

# default_base_ref MAIN — the ref a finished task's work should have landed in.
# 'origin/HEAD' is the remote's own answer, but it is only written at clone
# time, so fall back to whatever branch the main checkout is on — which is what
# 'vibe start' branched from in the first place.
default_base_ref() {
  local main="$1" ref=""
  ref="$(git -C "$main" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)" || ref=""
  if [[ -z "$ref" ]]; then
    ref="$(git -C "$main" symbolic-ref --quiet --short HEAD 2>/dev/null)" || ref=""
  fi
  [[ -n "$ref" ]] || ref="main"
  printf '%s\n' "$ref"
}

# delete_branch MAIN BRANCH FORCE — delete a finished task's local branch, once
# its worktree is gone (git refuses while a worktree still holds the branch).
#
# Never fails the command. The worktree removal this follows has already
# succeeded and been reported, so a branch that is not safe to drop is kept
# with a warning rather than turning a successful cleanup into an error.
#
# Two independent reasons to consider the work landed, either one enough:
#
#   ancestor of the base    the commits are reachable from the default branch,
#                           so deleting the branch loses nothing. This is the
#                           merge-commit PR case.
#   upstream gone           the remote branch was deleted, which after a merged
#                           PR is the finish signal — and the only one left when
#                           the PR was squashed or rebased, since neither leaves
#                           the local commits reachable from the base at all.
#
# 'git branch -d' is deliberately *not* the check being relied on: git only
# compares against HEAD when no upstream is set, and against the upstream when
# one is, so a pushed branch whose PR is still open is "fully merged" as far as
# '-d' is concerned and would be deleted without a murmur. The ancestor test
# above asks the question actually being asked, and '-D' then carries it out.
delete_branch() {
  local main="$1" branch="$2" force="$3"

  if [[ "$force" == 1 ]]; then
    if git -C "$main" branch -D "$branch" >/dev/null 2>&1; then
      info "deleted branch '$branch' (--force)"
    else
      warn "could not delete branch '$branch' — run 'git branch -D $branch' to see why"
    fi
    return 0
  fi

  # Prune first: 'gone' otherwise reflects the last fetch, and the PR whose
  # merge prompted this cleanup was very likely merged seconds ago. Offline is
  # not fatal — say so and judge from what is already known.
  if git -C "$main" remote get-url origin >/dev/null 2>&1; then
    git -C "$main" fetch -q --prune origin >/dev/null 2>&1 ||
      warn "could not reach origin — judging '$branch' from the last fetch"
  fi

  local base reason=""
  base="$(default_base_ref "$main")"
  if git -C "$main" merge-base --is-ancestor "$branch" "$base" 2>/dev/null; then
    reason="merged into $base"
  elif [[ "$(branch_upstream_state "$main" "$branch")" == gone ]]; then
    reason="upstream gone"
  else
    warn "branch '$branch' kept: not merged into $base, and its remote branch still exists.
  Merge the pull request first, or drop it deliberately with
  'git branch -D $branch'."
    return 0
  fi

  if git -C "$main" branch -D "$branch" >/dev/null 2>&1; then
    info "deleted branch '$branch' ($reason)"
  else
    warn "could not delete branch '$branch' — run 'git branch -D $branch' to see why"
  fi
}

# ---------------------------------------------------------------------------
# vibe doctor — check everything vibe depends on, and report rather than fix.
# Exit 1 if anything is genuinely broken; warnings alone still exit 0.
# ---------------------------------------------------------------------------
cmd_doctor() {
  local n_ok=0 n_warn=0 n_fail=0
  local pass="  ${c_grn}✓${c_off}  " bad="  ${c_red}✗${c_off}  " wrn="  ${c_yel}⚠${c_off}  "

  d_ok() {
    printf '%s%s\n' "$pass" "$*"
    n_ok=$((n_ok + 1))
  }
  d_no() {
    printf '%s%s\n' "$bad" "$*"
    n_fail=$((n_fail + 1))
  }
  d_wn() {
    printf '%s%s\n' "$wrn" "$*"
    n_warn=$((n_warn + 1))
  }

  rule "Tools"
  if command -v git >/dev/null 2>&1; then
    d_ok "git         $(git --version | awk '{print $3}')"
  else
    d_no "git         not installed — vibe cannot work without it"
  fi

  if command -v tmux >/dev/null 2>&1; then
    d_ok "tmux        $(tmux -V | awk '{print $2}')"
  elif [[ "$(detect_env)" == "ssh" ]]; then
    d_no "tmux        not installed — sessions will not survive an SSH disconnect"
  else
    d_wn "tmux        not installed — needed over SSH and by --no-attach"
  fi

  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      d_ok "gh          authenticated"
    else
      d_wn "gh          installed but not authenticated — PR list will be empty"
    fi
  else
    d_wn "gh          not installed (optional — used for PR info)"
  fi

  # The agent command may legitimately be a shell function or an alias in an
  # interactive shell, so a miss here is a warning rather than a failure.
  if command -v "${VIBE_AGENT_CMD%% *}" >/dev/null 2>&1; then
    d_ok "agent       $VIBE_AGENT_CMD"
  else
    d_wn "agent       '$VIBE_AGENT_CMD' not on PATH (set VIBE_AGENT_CMD)"
  fi

  printf '\n'
  rule "Paths"
  if [[ -d "$VIBE_WORKTREE_ROOT" ]]; then
    d_ok "worktrees   $VIBE_WORKTREE_ROOT"
  elif [[ -e "$VIBE_WORKTREE_ROOT" ]]; then
    d_no "worktrees   $VIBE_WORKTREE_ROOT exists but is not a directory"
  else
    d_wn "worktrees   $VIBE_WORKTREE_ROOT does not exist yet (created on first 'vibe start')"
  fi

  if [[ -f "$TEMPLATE_DIR/HANDOFF.md" ]]; then
    d_ok "templates   $TEMPLATE_DIR"
  else
    d_no "templates   no HANDOFF.md under $TEMPLATE_DIR — new worktrees will not be seeded"
  fi

  printf '\n'
  rule "Config"
  if [[ ! -e "$VIBE_CONFIG_FILE" ]]; then
    d_wn "config      $VIBE_CONFIG_FILE not present (using env vars and defaults)"
  elif [[ ! -r "$VIBE_CONFIG_FILE" ]]; then
    d_no "config      $VIBE_CONFIG_FILE is not readable"
  else
    # This file is sourced. Insist it is only plain assignments, both because
    # anything else is a surprise and because the Claude Code hooks parse it
    # instead of sourcing it — they would silently disagree.
    local bad_lines
    # SC2016: the '$' and backtick below are regex, not shell expansion —
    # single quotes are exactly what is wanted here.
    # shellcheck disable=SC2016
    bad_lines="$(grep -nvE '^[[:space:]]*(#.*)?$|^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=[^;&|`$()]*$' \
      "$VIBE_CONFIG_FILE" || true)"
    if [[ -n "$bad_lines" ]]; then
      d_no "config      $VIBE_CONFIG_FILE has lines that are not plain KEY=VALUE:"
      printf '%s\n' "$bad_lines" | sed 's/^/         /'
    else
      d_ok "config      $VIBE_CONFIG_FILE"
    fi
  fi

  if [[ -n "$VIBE_AGENT_RESUME_ARGS" ]]; then
    d_ok "resume      attach restarts a dead agent as '$VIBE_AGENT_CMD $VIBE_AGENT_RESUME_ARGS'"
  else
    d_ok "resume      attach restarts a dead agent with a fresh context (set VIBE_AGENT_RESUME_ARGS to continue the old one)"
  fi

  printf '\n'
  rule "Environment"
  d_ok "detected    $(detect_env) ($(env_reason))"

  printf '\n'
  rule "Repository"
  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    d_wn "repo        not inside a git repository (run doctor from a repo for more)"
  else
    local branch
    branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    d_ok "repo        $(repo_name) on '${c_cyn}${branch}${c_off}'"

    if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
      d_wn "tree        uncommitted changes present"
    else
      d_ok "tree        clean"
    fi

    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      # Report against the last fetch; doctor is a read-only command and must
      # not reach out to the network behind your back.
      local a b
      a="$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
      b="$(git rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
      if ((a == 0 && b == 0)); then
        d_ok "upstream    in sync as of last fetch"
      elif ((a > 0 && b > 0)); then
        d_no "upstream    DIVERGED — $a ahead, $b behind ('vibe attach --rebase' reconciles)"
      elif ((a > 0)); then
        d_wn "upstream    $a commit(s) ahead — push them"
      else
        d_wn "upstream    $b commit(s) behind — 'vibe attach' fast-forwards"
      fi
    else
      d_wn "upstream    no upstream for '$branch' yet"
    fi
  fi

  local summary="${c_grn}✓${c_off} ${n_ok} ok"
  ((n_warn > 0)) && summary="${summary}  ${c_dim}·${c_off}  ${c_yel}⚠${c_off} ${n_warn} warnings"
  ((n_fail > 0)) && summary="${summary}  ${c_dim}·${c_off}  ${c_red}✗${c_off} ${n_fail} problems"

  printf '\n'
  if ((n_fail > 0)); then
    printf '%s✗%s vibe doctor: problems found  —  %s\n' "$c_red" "$c_off" "$summary"
    return 1
  elif ((n_warn > 0)); then
    printf '%s⚠%s vibe doctor: healthy, with warnings  —  %s\n' "$c_yel" "$c_off" "$summary"
  else
    printf '%s✓%s vibe doctor: healthy  —  %s\n' "$c_grn" "$c_off" "$summary"
  fi
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
cmd_help() {
  # With a command name given, print just that command's full usage (name +
  # every flag) and description, sourced from the very same help_cmd calls
  # below rather than a second copy of the text — see help_cmd's target
  # branch. Keeps the top-level listing scannable while the per-command
  # detail (e.g. 'done's four flags) still lives somewhere.
  local target="${1:-}"
  local help_found=0

  # blank — a section-separating blank line, suppressed in target mode so a
  # single-command lookup isn't surrounded by stray empty lines.
  blank() { [[ -n "$target" ]] || printf '\n'; }

  if [[ -z "$target" ]]; then
    printf '%svibe%s — one branch + one worktree + one agent session per task.\n\n' "$c_bld" "$c_off"
    printf "Each TASK gets its own git branch + git worktree under \$VIBE_WORKTREE_ROOT/<repo>/<branch>\n"
    printf '(default ~/git/worktrees). Over SSH every task runs inside its own persistent tmux\n'
    printf 'session, so the agent keeps working after you disconnect. Every worktree gets a\n'
    printf 'HANDOFF.md that carries context from one session to the next.\n\n'
  fi

  help_section() {
    [[ -z "$target" ]] || return 0
    rule "$*"
  }
  # help_cmd NAME FLAGS DESC...  — NAME (its base form, no flags) colored and
  # left-padded to a fixed column; each further arg is a continuation line
  # indented to the same column, so multi-line entries stay aligned with
  # single-line ones. FLAGS (may be "") renders as one dim continuation line
  # so a flag-heavy command like 'done' doesn't blow past the column — full
  # detail lives behind 'vibe help <cmd>', driven by this same call in target
  # mode instead of the column listing.
  help_cmd() {
    local name="$1" flags="$2"
    shift 2
    local bare="${name%% *}"
    if [[ -n "$target" ]]; then
      [[ "$bare" == "$target" ]] || return 0
      help_found=1
      printf '%svibe %s%s' "$c_bld" "$name" "$c_off"
      if [[ -n "$flags" ]]; then printf ' %s%s%s' "$c_dim" "$flags" "$c_off"; fi
      printf '\n\n'
      local line
      for line in "$@"; do
        printf '  %s\n' "$line"
      done
      return 0
    fi
    printf '  %s%-28s%s %s\n' "$c_grn" "$name" "$c_off" "$1"
    shift
    local line
    for line in "$@"; do
      printf '  %-28s %s\n' "" "$line"
    done
    if [[ -n "$flags" ]]; then printf '  %-28s %s%s%s\n' "" "$c_dim" "$flags" "$c_off"; fi
  }

  help_section "Tasks:"
  help_cmd "start <task>" "[--no-attach]" \
    "Create branch+worktree for <task>, seed HANDOFF.md," \
    "then open an agent session (in tmux over SSH)." \
    "--no-attach starts the tmux session and returns;" \
    "that session begins from HANDOFF.md by itself."
  help_cmd "attach [<task>]" "[--rebase]" \
    "Fast-forward the task's worktree when safe (clean +" \
    "ff-only), then attach. Never refuses: a dirty or" \
    "diverged tree is attached as-is; --rebase opts into" \
    "'git pull --rebase' when diverged. With no task, pick" \
    "from a menu."
  help_cmd "done [<task>...]" "[--force] [--discard-handoff] [--rm-branch]" \
    "Remove the worktree (branch is kept). Refuses if the" \
    "worktree is dirty, holds unpushed commits, or if" \
    "HANDOFF.md still carries content or is still on the" \
    "branch — promote, then 'git rm' it (--discard-handoff" \
    "skips both handoff checks). A task whose directory is" \
    "gone is finished from what is left (git's record, the" \
    "tmux session). --rm-branch also deletes the branch once" \
    "merged or its remote branch is gone. Infers the task" \
    "from the cwd. Several tasks: each in turn, like" \
    "'git branch -d a b'."
  blank

  help_section "Visibility:"
  help_cmd "status [--all]" "" \
    "Show worktrees with sync state (dirty, ahead/behind," \
    "HANDOFF.md age), tmux sessions, open PRs. --all scans" \
    "every repo under \$VIBE_WORKTREE_ROOT."
  help_cmd "doctor" "" "Check tools, paths, config, environment and upstream."
  blank

  if [[ -n "$target" ]]; then
    ((help_found)) || die "no help for '$target' (try: vibe help)"
    return 0
  fi

  printf 'Requires: git, tmux (over SSH), optionally gh (for PR info).\n\n'
  printf 'Config: ~/.config/vibe/config (KEY=VALUE). Environment variables win over it.\n'
  printf "        See templates/vibe.config.example. Run 'vibe doctor' to validate.\n"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
main() {
  local cmd="${1:-status}"
  shift || true
  case "$cmd" in
    start) cmd_start "$@" ;;
    attach) cmd_attach "$@" ;;
    status) cmd_status "$@" ;;
    done) cmd_done "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -h | --help | help) cmd_help "$@" ;;
    *) die "unknown command '$cmd' (try: vibe help)" ;;
  esac
}
main "$@"
