#!/usr/bin/env bash
#
# vibe — one worktree per task, opened in VS Code; git carries it between machines.
#
#   vibe start [-C <repo>] <task>   make or adopt <repo>/.claude/worktrees/<task>, open it
#                                   (runs each <agent>/vibe-start.sh <worktree> <repo>-<task>)
#   vibe sync [--all] [--wip]       push, fast-forward, report every worktree
#   vibe status --<agent>           agent servers on this machine (<agent>/vibe-status.sh)
#   vibe update-toolkit             pull the toolkit checkout, install, doctor
#   vibe queue status               the queue: running, queued, PRs to review, jobs with no PR; two lines per job by repo
#   vibe queue add [--now|--at HH:MM] <dir>...
#                                   queue prepared job dirs (job, prompt.md); --now starts them first,
#                                   --at holds them until that local time (the next one if it passed)
#   vibe queue new [--now] [--model M] [--timeout T] [--kind code|gpu] <repo> <branch> <done-when> <task>...
#                                   queue a job rendered from fill-queue's job-prompt.md
#   vibe queue new --line <n> <repo> <branch>
#                                   the same for item <n> of the last roadmap listing, still open on origin
#   vibe queue new --opt-in <job> <repo>
#                                   a job that opts <repo> into a recurring job and commits it
#   vibe queue roadmap [--full] <repo>  open PROJECT_ROADMAP.md items on origin: <line>: <title>, or the whole item
#   vibe queue report               the report of the jobs to review, on stdout
#   vibe queue hold <id> <note>     keep a job for you: first in every report
#   vibe queue archive <id>...      move reviewed jobs out of the queue
#   vibe queue pause | resume       stop or allow new starts; running jobs finish
#   vibe queue page                 write the phone page now (the runner writes it each pass)
#   vibe queue conf <key>=<value>   set one queue.conf key: slots, after, review_*, memory_max, steer
#   vibe queue unlimit              forget the usage limit: jobs start again
#   vibe queue set <id> now=1|after=
#                                   a queued job: start it next, or with no review
#   vibe queue retry <id>           a failed, timeout or skipped job again as a new job; the old one archived
#   vibe queue cancel <id>          a queued job ends skipped, note cancelled
#   vibe queue stop <id>            the runner stops a running job: failed, note stopped, no requeue;
#                                   a tool job's run: its stop script, then down
#   vibe queue steer <id> <text>    a running job: the text to its session (steer=1 in queue.conf);
#                                   a tool job's run: to its steer script; exit 3 there: not supported
#   vibe queue answer <id> <answer> a blocked job again with your answer (HANDOFF.md, or a lane retry); the old one archived
#   vibe queue fix <pr-url> <text>  a follow-up job on the PR's branch: fix <text>
#   vibe queue ready <pr-url>...|--feature <slug>
#                                   no failing check, no SPEC.md, RESEARCH.md or HANDOFF.md: mark each PR ready
#   vibe queue merge-order <repo>   the repo's ready PRs, smallest first, with the PRs each can conflict with
#   vibe queue run --<agent> [--drain]
#                                   the runner (vibe-queue.service); --drain: until nothing can start
#   vibe feature add <file>         register a feature: branches in several repos that merge together
#   vibe feature ready <slug>       the human test passed: the batch waits for the merges
#   vibe feature archive <slug>...  move merged features out of the queue; refuses an open member PR
#   vibe ws list                    the tools under workspaces/: name, kind, gpu, places, label: role;
#                                   a bad workspace.conf prints why, exit 1
#   vibe ws status [<instance>]     each tool instance: up, past limit, starts, waits for the GPU or down, from its state files
#   vibe ws build <name>            docker build the tool's image at its pinned commit, tagged with it
#   vibe ws start <name> [--place P] [--hours N]
#                                   a kind=service tool up at P (the first of its places) for N hours (its hours),
#                                   then its start script; gpu=yes on turing: under the gpu-queue lock, held until stop
#   vibe ws stop <instance>         its stop script, then down: data copied back, container gone, GPU lock free
#   vibe ws tick                    each instance: pull every 10 min, down past its limit (the runner, each pass)
#   vibe job list [--all] [<repo>...]
#                                   recurring jobs of every repo with .vibe-jobs/, and the repos
#                                   the fill-queue sweep covers; --all adds the jobs not opted into
#   vibe job due [--dry] [--max N]  queue every due recurring job (the 01:00 timer)
#   vibe job run <repo> <job>       queue one recurring job now
#   vibe job add <repo> <job>       opt <repo> in: write <repo>/.vibe-jobs/<job>.md
#   vibe job reset <repo> <job>     forget the failures of a stopped job
#   vibe job triage [<repo>...]     agent PRs: merge the base into conflicted ones; your /fix starts a fix job; triage lines
#
# Docs: docs/remote-sessions.md, docs/vibe-queue.md, docs/vibe-jobs.md, docs/workspaces.md.
# shellcheck disable=SC2317  # the closing exit makes shellcheck read every function as unreachable
set -euo pipefail

script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

SELF_ROOT="$(dirname "$(script_dir)")"
# shellcheck disable=SC2034  # read by the lib's die/info message prefix
LIB_PROG=vibe
# shellcheck disable=SC1091  # path only exists at runtime, resolved above
. "$SELF_ROOT/skills/_lib/lib.sh"

usage() {
  # The header from line 5 to its first bare `#`: no line range to keep in step.
  awk 'NR >= 5 && /^#$/ { exit } NR >= 5 { sub(/^# ?/, ""); print }' "$SELF_ROOT/bin/vibe"
  exit "${1:-0}"
}
warn() { echo "vibe: warning: $*" >&2; }

# default_branch REPO — origin's HEAD branch; main when origin names none.
default_branch() {
  local ref
  ref="$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  ref="${ref:-origin/main}"
  echo "${ref#origin/}"
}

TOOLKIT="$(cd -P "${VIBE_TOOLKIT:-$SELF_ROOT}" 2>/dev/null && pwd || echo "${VIBE_TOOLKIT:-$SELF_ROOT}")"

# toolkit_check — one warning line when the installed toolkit differs from origin.
toolkit_check() {
  local t="$TOOLKIT" cache stamp now def b ahead behind
  git -C "$t" rev-parse --git-dir >/dev/null 2>&1 || return 0
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/vibe/last-fetch"
  now="$(date +%s)"
  stamp="$(stat -c %Y "$cache" 2>/dev/null || stat -f %m "$cache" 2>/dev/null || echo 0)"
  if ((now - stamp >= ${VIBE_FETCH_INTERVAL:-300})); then
    mkdir -p "$(dirname "$cache")" && touch "$cache"
    GIT_TERMINAL_PROMPT=0 git -C "$t" fetch -q origin 2>/dev/null || true
  fi
  def="$(default_branch "$t")"
  b="$(git -C "$t" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [[ "$b" == "$def" ]] || warn "toolkit checkout $t is on '$b', not $def"
  [[ -z "$(git -C "$t" status --porcelain --untracked-files=no)" ]] ||
    warn "toolkit checkout $t has uncommitted changes"
  git -C "$t" rev-parse -q --verify "origin/$def" >/dev/null || return 0
  read -r ahead behind < <(git -C "$t" rev-list --left-right --count "HEAD...origin/$def" 2>/dev/null || true)
  if ((${ahead:-0} > 0 && ${behind:-0} > 0)); then
    warn "toolkit checkout has diverged from origin/$def"
  elif ((${behind:-0} > 0)); then
    warn "toolkit is $behind commits behind origin/$def — run: vibe update-toolkit"
  fi
}

# ensure_exclude MAIN — keep .claude/worktrees/ out of git status in every checkout.
ensure_exclude() {
  local f
  f="$(git -C "$1" rev-parse --git-common-dir)/info/exclude"
  case "$f" in /*) ;; *) f="$1/$f" ;; esac
  mkdir -p "$(dirname "$f")"
  grep -qxF '.claude/worktrees/' "$f" 2>/dev/null || echo '.claude/worktrees/' >>"$f"
}

# clear_config_lock DIR — remove the empty read-only .git/config.lock a sandboxed
# agent leaves behind; a git lock is writable. It blocks worktree add and push -u.
clear_config_lock() {
  local f
  f="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 0
  case "$f" in /*) ;; *) f="$1/$f" ;; esac
  f="$f/config.lock"
  if [[ -f "$f" && ! -s "$f" && ! -w "$f" ]]; then rm -f "$f"; fi
}

# worktree_of MAIN BRANCH — path of the worktree that has BRANCH checked out.
worktree_of() {
  git -C "$1" worktree list --porcelain | awk -v b="refs/heads/$2" '
    /^worktree / { p = substr($0, 10) }
    $0 == "branch " b { print p; exit }'
}

# same_dir A B — A and B are one directory. git prints physical paths; the
# runner's records may hold the logical one (/var/… vs /private/var/… on macOS).
same_dir() {
  local a b
  a="$(cd -P "$1" 2>/dev/null && pwd)" b="$(cd -P "$2" 2>/dev/null && pwd)"
  [[ -n "$a" && "$a" == "$b" ]]
}

# open_prs DIR — "branch<TAB>url" for each open PR; empty without gh.
open_prs() {
  command -v gh >/dev/null 2>&1 || return 0
  (cd "$1" && gh pr list --state open --json headRefName,url \
    -q '.[] | "\(.headRefName)\t\(.url)"' 2>/dev/null) || true
}
pr_of() { printf '%s\n' "$1" | awk -F'\t' -v b="$2" '$1 == b { print $2; exit }'; }

# open_worktree MAIN BRANCH DEFAULT — make or adopt BRANCH's worktree, run the
# agent start hooks; sets WT. Call from inside the repo.
open_worktree() {
  local main="$1" branch="$2" def="$3" s
  ensure_exclude "$main"
  clear_config_lock "$main"
  git -C "$main" fetch -q origin 2>/dev/null || warn "fetch failed — using the last fetched refs"
  WT="$(worktree_of "$main" "$branch")"
  if [[ -z "$WT" ]]; then
    WT="$(worktree_dir "$branch")"
    [[ ! -e "$WT" ]] || die "$WT exists but does not hold branch '$branch'"
    ensure_worktree "$main" "$branch" "$WT" "origin/$def"
  elif [[ -z "$(agent_git -C "$WT" status --porcelain)" ]]; then
    agent_git -C "$WT" merge -q --ff-only '@{u}' 2>/dev/null || true
  fi
  for s in "$SELF_ROOT"/*/vibe-start.sh; do
    if [[ -f "$s" ]] && ! bash "$s" "$WT" "$(basename "$main")-$branch"; then
      warn "$s failed"
    fi
  done
}

cmd_start() {
  local repo_dir="$PWD" task="" main branch dir def pr
  while (($#)); do
    case "$1" in
      -C) repo_dir="${2:?-C needs a repo path}" && shift 2 ;;
      -h | --help) usage ;;
      -*) die "unknown option '$1'" ;;
      *)
        [[ -z "$task" ]] || die "one task only"
        task="$1"
        shift
        ;;
    esac
  done
  [[ -n "$task" ]] || usage 1
  cd "$repo_dir" || die "no such directory: $repo_dir"
  main="$(main_repo_root)"
  branch="$(slug "$task")"
  def="$(default_branch "$main")"
  [[ -n "$branch" && "$branch" != "$def" ]] || die "'$task' is not a task name"
  open_worktree "$main" "$branch" "$def"
  dir="$WT"
  pr="$(pr_of "$(open_prs "$dir")" "$branch")"
  echo "worktree: $dir"
  [[ -z "$pr" ]] || echo "PR:       $pr"
  if command -v code >/dev/null 2>&1; then
    code "$dir"
  fi
}

# sync_repo MAIN — sync each worktree of MAIN; one output line per worktree.
sync_repo() {
  local main def prs failed=0 line dir="" branch="" locked=""
  main="$(cd -P "$1" && pwd)" # git prints physical paths; sync_wt compares them
  def="$(default_branch "$main")"
  ensure_exclude "$main"
  git -C "$main" fetch -q --prune origin 2>/dev/null || warn "$(basename "$main"): fetch failed"
  prs="$(open_prs "$main")"
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) dir="${line#worktree }" branch="" locked="" ;;
      "branch "*) branch="${line#branch refs/heads/}" ;;
      locked*) locked=1 ;;
      "")
        if [[ -n "$dir" ]] && ! sync_wt "$main" "$dir" "$branch" "$locked" "$def" "$prs"; then failed=1; fi
        dir=""
        ;;
    esac
  done < <(git -C "$main" worktree list --porcelain && echo)
  return "$failed"
}

# sync_wt MAIN DIR BRANCH LOCKED DEFAULT PRS — the push / ff / report rules.
sync_wt() {
  local main="$1" dir="$2" br="$3" locked="$4" def="$5" prs="$6" res="ok" note="" dirty="" counts ahead behind rc=0 name
  name="$(basename "$main")"
  [[ "$dir" == "$main" ]] || name="$name/${dir##*/}"
  [[ ! -d "$dir" ]] && res="missing" && note="directory gone — /worktree-cleanup"
  if [[ -d "$dir" && -z "$br" ]]; then
    res="detached"
  elif [[ -d "$dir" ]]; then
    [[ -z "$(agent_git -C "$dir" status --porcelain)" ]] || dirty=1
    if [[ -n "$dirty" && "$WIP" == 1 && "$br" != "$def" && -z "$locked" ]]; then
      agent_git -C "$dir" add -A && agent_git -C "$dir" commit -q -m "wip: $(hostname) $(date '+%Y-%m-%d %H:%M')" && dirty="" && note="wip committed"
    fi
    if ! counts="$(agent_git -C "$dir" rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null)"; then
      if [[ "$dir" == "$main" || "$br" == "$def" ]]; then
        res="no-upstream"
      elif agent_git -C "$dir" config "branch.$br.merge" >/dev/null; then
        res="gone" note="upstream deleted — /worktree-cleanup checks for a merged PR"
      elif [[ "$br" == worktree-* ]]; then
        res="local" note="app session branch, not pushed"
      elif [[ "$(agent_git -C "$dir" rev-list --count "origin/$def..HEAD" 2>/dev/null || echo 0)" == 0 ]]; then
        res="empty" note="no commits yet"
      elif agent_push "$dir" -q -u origin "$br" 2>/dev/null; then
        res="pushed"
      else
        res="error" note="push failed" rc=1
      fi
    else
      read -r ahead behind <<<"$counts"
      if ((ahead > 0 && behind > 0)); then
        res="diverged"
      elif ((ahead > 0)) && [[ "$dir" == "$main" || "$br" == "$def" ]]; then
        res="ahead" note="the default branch is never pushed"
      elif ((ahead > 0)); then
        if agent_push "$dir" -q origin "$br" 2>/dev/null; then res="pushed"; else res="error" note="push failed" rc=1; fi
      elif ((behind > 0)) && [[ -n "$dirty" || -n "$locked" ]]; then
        res="behind"
      elif ((behind > 0)) && [[ "$dir" == "$main" && "$(cd -P "$main" && pwd)" == "$TOOLKIT" ]]; then
        res="behind" note="run: vibe update-toolkit"
      elif ((behind > 0)); then
        if agent_git -C "$dir" merge -q --ff-only '@{u}' 2>/dev/null; then res="pulled"; else res="error" note="fast-forward failed" rc=1; fi
      fi
    fi
    if [[ "$note" == "push failed" && -n "$LFS_REFUSED" ]]; then note="push failed (git-lfs: push by hand)"; fi
    [[ -z "$dirty" ]] || note="${note:+$note, }dirty"
    [[ -z "$locked" ]] || note="${note:+$note, }locked"
    [[ "$dir" != "$main" || "$br" == "$def" ]] || note="${note:+$note, }off $def"
  fi
  printf '%-11s %-40s %-28s %s %s\n' "$res" "$name" "${br:--}" "$note" "$(pr_of "$prs" "$br")"
  return "$rc"
}

cmd_sync() {
  local all=0 failed=0 d
  WIP=0
  while (($#)); do
    case "$1" in
      --all) all=1 ;;
      --wip) WIP=1 ;;
      -h | --help) usage ;;
      *) die "unknown option '$1'" ;;
    esac
    shift
  done
  if ((all)); then
    for d in "${VIBE_ROOT:-$(dirname "$SELF_ROOT")}"/*/; do
      [[ -d "$d/.git" ]] || continue
      sync_repo "${d%/}" || failed=1
    done
  else
    sync_repo "$(main_repo_root)" || failed=1
  fi
  return "$failed"
}

cmd_status() {
  local agent="${1:-}" s
  [[ $# -eq 1 && "$agent" == --?* ]] || die "usage: vibe status --<agent>, e.g. --claude"
  agent="${agent#--}"
  s="$SELF_ROOT/$agent/vibe-status.sh"
  [[ "$agent" != */* && -f "$s" ]] || die "no status for '$agent' — $s is missing"
  exec bash "$s"
}

cmd_update_toolkit() {
  local t="$TOOLKIT" def units before after rbefore rafter wbefore wafter
  [[ $# -eq 0 ]] || die "usage: vibe update-toolkit"
  git -C "$t" rev-parse --git-dir >/dev/null 2>&1 || die "$t is not a git checkout"
  def="$(default_branch "$t")"
  [[ "$(git -C "$t" rev-parse --abbrev-ref HEAD)" == "$def" ]] || die "$t is not on $def"
  [[ -z "$(git -C "$t" status --porcelain --untracked-files=no)" ]] || die "$t has uncommitted changes"
  units="claude/systemd" # each unit is linked: a changed one needs daemon-reload
  before="$(git -C "$t" rev-parse -q --verify "HEAD:$units" || true)"
  rbefore="$(git -C "$t" ls-tree HEAD -- bin/vibe skills/_lib/lib.sh)"
  wbefore="$(git -C "$t" ls-tree HEAD -- bin/vibe-web)"
  git -C "$t" pull -q --ff-only origin "$def" || die "pull failed — $t has diverged from origin/$def"
  after="$(git -C "$t" rev-parse -q --verify "HEAD:$units" || true)"
  rafter="$(git -C "$t" ls-tree HEAD -- bin/vibe skills/_lib/lib.sh)"
  wafter="$(git -C "$t" ls-tree HEAD -- bin/vibe-web)"
  echo "toolkit at $(git -C "$t" log -1 --format='%h %s')"
  "$t/install.sh" || die "install.sh failed"
  "$t/install.sh" doctor || die "doctor reports problems"
  if [[ "$before" != "$after" ]] && grep -qx server "$HOME/.config/vibe/role" 2>/dev/null; then
    systemctl --user daemon-reload
    echo "units reloaded; a changed claude-rc@ unit takes effect after: systemctl --user restart 'claude-rc@*' (stops running sessions)"
  fi
  # The runner holds bin/vibe and the lib in memory; running jobs survive (KillMode=process).
  if [[ "$rbefore" != "$rafter" ]] && grep -qx server "$HOME/.config/vibe/role" 2>/dev/null; then
    systemctl --user restart vibe-queue.service
    echo "runner restarted: vibe-queue.service"
  fi
  if [[ "$wbefore" != "$wafter" && -n "${VIBE_WEB:-}" ]]; then
    # A restart from the page kills this request: vibe-web re-execs itself after its reply.
    echo "page endpoint restarts after this reply"
  elif [[ "$wbefore" != "$wafter" ]] && grep -qx server "$HOME/.config/vibe/role" 2>/dev/null; then
    if systemctl --user try-restart vibe-web.service; then
      echo "page endpoint restarted if it was running: vibe-web.service"
    else
      warn "vibe-web.service not restarted"
    fi
  fi
}

# --- queue: unattended agent jobs, one worktree each (docs/vibe-queue.md) ---

# role_gate queue|job|feature|ws SUB [ARG...] — on a client (~/.config/vibe/role: `client <host>`),
# run a read-only SUB on the server over ssh and stop on any other.
role_gate() {
  local role="" host="" cmd
  read -r role host _ 2>/dev/null <"$HOME/.config/vibe/role" || true
  [[ "$role" != server ]] || return 0
  [[ -n "$host" ]] || die "no server configured: echo 'client <host>' > ~/.config/vibe/role"
  case "$1 ${2:-}" in
    "queue status" | "queue report" | "job list" | "ws list" | "ws status") ;;
    *) die "the queue runs on the server — ssh $host" ;;
  esac
  printf -v cmd ' %q' "$@"
  exec ssh "$host" "\$HOME/bin/vibe$cmd"
}

QROOT="${XDG_STATE_HOME:-$HOME/.local/state}/vibe"
QDIR="$QROOT/queue"
QCONF="${XDG_CONFIG_HOME:-$HOME/.config}/vibe"

# jget FILE KEY — the value of KEY=value in FILE; empty when absent.
jget() { awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1" 2>/dev/null || true; }
# jstate JOB NAME — first line of a job state file; empty when absent.
jstate() { head -n 1 "$1/$2" 2>/dev/null || true; }
# qconf KEY DEFAULT — KEY=value from ~/.config/vibe/queue.conf without a trailing ` # comment`, else DEFAULT.
qconf() {
  local v
  v="$(jget "$QCONF/queue.conf" "$1")"
  v="${v%%[[:space:]]#*}"
  v="${v%"${v##*[![:space:]]}"}"
  echo "${v:-$2}"
}

# job_timeout JOB — the job's timeout, 2h when it sets none.
job_timeout() {
  local t
  t="$(jget "$1/job" timeout)"
  echo "${t:-2h}"
}

# job_end JOB STATUS NOTE — final status of a job; a recurring job also
# updates its last-run / fails state (docs/vibe-jobs.md). `gpu` never replaces
# a final status: a fast GPU run's `queue follow` has ended the job first.
job_end() {
  if [[ "$2" != gpu ]] || ! job_final "$1"; then
    echo "$2" >"$1/status"
    echo "$3" >"$1/note"
  fi
  date '+%F %T' >"$1/ended"
  rm -f "$1/pid"
  [[ -z "$(jget "$1/job" recurring)" ]] || job_state_update "$1" "$2"
}

# job_final JOB — true when the job has ended.
job_final() {
  case "$(jstate "$1" status)" in "done" | blocked | failed | timeout | skipped) return 0 ;; esac
  return 1
}

# job_settled JOB — true when the job is final and its process no longer writes: `queue follow`
# sets `done` while the runner still gates and publishes (a pid file, no `ended` file).
job_settled() {
  job_final "$1" || return 1
  [[ ! -e "$1/pid" || -e "$1/ended" ]]
}

# branch_ok BRANCH — a slug, or jobs/<slug> (a recurring job's branch).
branch_ok() {
  local b="${1#jobs/}"
  [[ "$1" != jobs/*/* && -n "$b" && "$(slug "$b")" == "$b" ]]
}

# queue_add DIR [NOW] [AT] — move a prepared job dir (`job`, `prompt.md`) into the
# queue as <YYYYMMDD-HHMMSS>-<repo>-<branch>; NOW=1 starts it first; AT (`YYYY-MM-DD HH:MM`) holds it until then.
queue_add() {
  local src="${1%/}" now="${2:-0}" at="${3:-}" repo branch ts d
  [[ -f "$src/job" ]] || die "no job file in $src"
  repo="$(jget "$src/job" repo)" branch="$(jget "$src/job" branch)"
  [[ -n "$repo" && -n "$branch" ]] || die "$src/job needs repo= and branch="
  branch_ok "$branch" || die "bad branch '$branch'"
  mkdir -p "$QDIR" "$QROOT/incoming"
  # One id per second keeps FIFO order: a second add waits for the next second.
  ts="$(date +%Y%m%d-%H%M%S)"
  while compgen -G "$QDIR/$ts-*" >/dev/null; do
    sleep 1
    ts="$(date +%Y%m%d-%H%M%S)"
  done
  d="$QDIR/$ts-$(basename "$repo")-$(echo "$branch" | tr / -)"
  if ((now)); then echo now=1 >>"$src/job"; fi
  if [[ -n "$at" ]]; then echo "at=$at" >>"$src/job"; fi
  # A copy lands complete or not at all: the runner never sees half a job.
  if ! mv "$src" "$d" 2>/dev/null; then
    cp -R "$src" "$QROOT/incoming/${d##*/}" && mv "$QROOT/incoming/${d##*/}" "$d" && rm -rf "$src"
  fi
  echo "$d"
}

# verify_ok DIR — dies when DIR/job sets verify= to a bad value, on a lane job, or on a job with no review.
# shortcut: `vibe queue set <id> after=` later drops the verify step with the review; refuse it there if that bites.
verify_ok() {
  local v
  v="$(jget "$1/job" verify)"
  [[ -n "$v" ]] || return 0
  [[ "$v" == app || "$v" == blast-radius || "$v" == app,blast-radius ]] || die "$1: verify=$v — app, blast-radius or app,blast-radius"
  [[ -z "$(jget "$1/job" lane)" ]] || die "$1: verify= on a lane job"
  if ! review_on "$1" || [[ "$(jget "$1/job" output)" == report ]]; then die "$1: verify= on a job with no review"; fi
}

# deadline_of JOBFILE — epoch of its deadline= (`YYYY-MM-DD HH:MM`, local time); empty with none; dies on a bad one.
deadline_of() {
  local v e=""
  v="$(jget "$1" deadline)"
  [[ -n "$v" ]] || return 0
  if [[ "$v" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]]; then e="$(epoch_of "$v:00")"; fi
  [[ -n "$e" ]] || die "$1: deadline=$v — YYYY-MM-DD HH:MM"
  echo "$e"
}

# at_exists DAY HH:MM — true when that local time exists: a clock change skips an hour; GNU date refuses it, BSD date moves it.
at_exists() {
  local e
  e="$(epoch_of "$1 $2:00")"
  [[ -n "$e" && "$(at_time "$e")" == "$1 $2" ]]
}

# next_at HH:MM — `YYYY-MM-DD HH:MM` of the next HH:MM in local time: today while it is ahead, else tomorrow; dies on a bad time or one a clock change skips.
next_at() {
  local day
  [[ "$1" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "bad time '$1' — HH:MM, 00:00 to 23:59"
  day="$(date +%F)"
  at_exists "$day" "$1" || die "$1 does not exist on $day (clock change)"
  if (($(epoch_of "$day $1:00") <= $(date +%s))); then
    day="$(date -d '+1 day' +%F 2>/dev/null || date -v+1d +%F)"
    at_exists "$day" "$1" || die "$1 does not exist on $day (clock change)"
  fi
  echo "$day $1"
}

# at_due JOB — false while the job's at= (`YYYY-MM-DD HH:MM`, local time) is ahead; a job with now=1 is always due.
at_due() {
  local a e
  a="$(jget "$1/job" at)"
  if [[ -z "$a" || "$(jget "$1/job" now)" == 1 ]]; then return 0; fi
  e="$(epoch_of "$a:00")"
  [[ -z "$e" || "$e" -le "$(date +%s)" ]]
}

# vibe queue add [--now|--at HH:MM] DIR... — queue prepared job dirs, in argument order; refuses them all on a bad after=, verify= or deadline=.
cmd_queue_add() {
  local now=0 at="" dirs=() d use="usage: vibe queue add [--now|--at HH:MM] <dir>..."
  while (($#)); do
    case "$1" in
      --now) now=1 ;;
      --at)
        (($# > 1)) || die "$use"
        shift
        at="$(next_at "$1")"
        ;;
      -h | --help) usage ;;
      -*) die "$use" ;;
      *) dirs+=("$1") ;;
    esac
    shift
  done
  ((${#dirs[@]})) || die "$use"
  ((!now)) || [[ -z "$at" ]] || die "--now and --at do not go together"
  for d in "${dirs[@]}"; do
    [[ "$(jget "$d/job" after)" =~ ^(review|code)?$ ]] || die "$d: after=$(jget "$d/job" after) — review, code or empty"
    verify_ok "$d"
    deadline_of "$d/job" >/dev/null
  done
  for d in "${dirs[@]}"; do
    d="$(queue_add "$d" "$now" "$at")"
    echo "queued ${d##*/}${at:+ — starts $at}"
  done
}

# job_prepare JOB — check the job, make or adopt its worktree. Writes
# JOB/worktree on success, a final status otherwise. A lane job also gets
# JOB/start (the branch tip) and JOB/lane-pr.md (the lane PR so far). Run it in a subshell.
job_prepare() {
  local d="$1" repo branch main def wt c
  repo="$(jget "$d/job" repo)" branch="$(jget "$d/job" branch)"
  [[ -f "$d/prompt.md" ]] || {
    job_end "$d" failed "no prompt.md"
    return 0
  }
  if [[ -n "$(jget "$d/job" tool)" && -z "$(jget "$d/job" review)" ]]; then
    c="$(tool_check "$d")"
    if [[ -n "$c" ]]; then
      job_end "$d" failed "$c"
      return 0
    fi
    # A folder result makes a report job.
    if [[ "$(tool_conf "$d" result)" == folder && -z "$(jget "$d/job" output)" ]]; then
      echo output=report >>"$d/job"
    fi
  fi
  cd "$repo" 2>/dev/null || {
    job_end "$d" failed "no directory '$repo'"
    return 0
  }
  main="$(main_repo_root 2>/dev/null)" || {
    job_end "$d" failed "$repo is not a git repo"
    return 0
  }
  def="$(default_branch "$main")"
  if [[ -z "$branch" || "$branch" == "$def" ]] || ! branch_ok "$branch"; then
    job_end "$d" failed "bad branch '$branch'"
    return 0
  fi
  wt="$(worktree_of "$main" "$branch")"
  # A GPU follow-up or a job a usage limit stopped resumes in its own dirty worktree.
  if [[ -n "$wt" && "$(jget "$d/job" follow)" != 1 ]] && ! same_dir "$(jstate "$d" worktree)" "$wt" &&
    [[ -n "$(agent_git -C "$wt" status --porcelain)" ]]; then
    job_end "$d" skipped "$wt has uncommitted changes"
    return 0
  fi
  if [[ -z "$wt" && -e "$(worktree_dir "$branch")" ]]; then
    job_end "$d" skipped "$(worktree_dir "$branch") exists but does not hold '$branch'"
    return 0
  fi
  open_worktree "$main" "$branch" "$def"
  if [[ "$(agent_git -C "$WT" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "$branch" ]]; then
    job_end "$d" failed "no worktree for '$branch'"
    return 0
  fi
  echo "$def" >"$d/base"
  echo "$(basename "$main")-${branch//\//-}" >"$d/name"
  echo "$WT" >"$d/worktree"
  milestones_open "$WT" >"$d/milestones"
  feature_prompt "$d"
  if [[ -n "$(jget "$d/job" lane)" ]]; then
    # A job a usage limit stopped keeps its first start commit.
    [[ -f "$d/start" ]] || agent_git -C "$WT" rev-parse HEAD >"$d/start"
    lane_body "$d" running >"$d/lane-pr.md"
  fi
}

# milestones_open WT — open milestones of WT/SPEC.md; empty without one.
milestones_open() {
  [[ -f "$1/SPEC.md" ]] || return 0
  grep -c '^- \[ \]' "$1/SPEC.md" || true
}

# pr_title_fallback JOB — `agent(<branch>): <lane or result>` when the job wrote no pr.md.
pr_title_fallback() {
  local r b
  r="$(jget "$1/job" lane)" b="$(jget "$1/job" branch)"
  if [[ -z "$r" ]]; then
    r="$(jstate "$1" result)"
    r="${r#*: }"
  fi
  echo "agent(${b#jobs/}): ${r:-${1##*/}}" | cut -c 1-60
}

# job_gate JOB — run origin's `.vibe-jobs/gate` (default branch, a fresh
# fetch: never the worktree or a ref the job could move) in the job's worktree,
# unsandboxed, bounded by the job's timeout. Exit code: JOB/gate; output: JOB/gate.log.
job_gate() {
  local d="$1" wt cmd rc=0
  wt="$(jstate "$d" worktree)"
  agent_git -C "$wt" fetch -q origin "refs/heads/$(jstate "$d" base)" 2>/dev/null || return 0
  cmd="$(agent_git -C "$wt" show FETCH_HEAD:.vibe-jobs/gate 2>/dev/null || true)"
  [[ -n "$cmd" ]] || return 0
  local -a tcmd=("${MEM_CMD[@]+"${MEM_CMD[@]}"}" "${TIMEOUT_CMD[@]+"${TIMEOUT_CMD[@]}"}")
  if ((${#TIMEOUT_CMD[@]})); then tcmd+=("$(job_timeout "$d")"); fi
  printf '$ %s\n' "$cmd" >"$d/gate.log"
  (cd "$wt" && "${tcmd[@]+"${tcmd[@]}"}" bash -c "$cmd") </dev/null >>"$d/gate.log" 2>&1 || rc=$?
  echo "$rc" >"$d/gate"
}

# branch_jobs REPO BRANCH — the job dirs in the queue on REPO's BRANCH, in id order.
branch_jobs() {
  awk -v r="repo=$1" -v b="branch=$2" '
    function flush() { if (nr && nb) print dir }
    FNR == 1 { flush(); nr = nb = 0; dir = FILENAME; sub(/\/job$/, "", dir) }
    $0 == r { nr = 1 }
    $0 == b { nb = 1 }
    END { flush() }' "$QDIR"/*/job 2>/dev/null || true
}

# job_item JOB — `item=` of the job, else its id.
job_item() {
  local i
  i="$(jget "$1/job" item)"
  echo "${i:-${1##*/}}"
}

# side_suffix JOB — ` → <side-branch>` when the job left its lane, else nothing.
side_suffix() {
  local s
  s="$(jstate "$1" side)"
  if [[ -n "$s" ]]; then echo " → $s"; fi
}

# lane_jobs JOB — the lane jobs (`lane=`) in the queue on JOB's repo and branch, in id order.
lane_jobs() {
  local j
  while IFS= read -r j; do
    if [[ -n "$(jget "$j/job" lane)" ]]; then echo "$j"; fi
  done < <(branch_jobs "$(jget "$1/job" repo)" "$(jget "$1/job" branch)")
}

# group_of JOB — sets GROUP, the jobs on JOB's repo and branch, and for their row
# G_PROGRESS (done/total), G_NEXT (running or next item), G_PR, G_CTX (`lane=`, else the latest context).
group_of() {
  local d s c run="" nxt="" ok=0
  GROUP=() G_PR="" G_CTX=""
  while IFS= read -r d; do
    GROUP+=("$d")
    s="$(jstate "$d" status)"
    case "$s" in
      "done") ok=$((ok + 1)) ;;
      running | gpu) run="$(job_item "$d")" ;;
      "" | queued) [[ -n "$nxt" ]] || nxt="$(job_item "$d")" ;;
    esac
    c="$(jstate "$d" pr)"
    if [[ -n "$c" ]]; then G_PR="$c"; fi
    c="$(jget "$d/job" lane)"
    [[ -n "$c" ]] || c="$(report_context "$d")"
    if [[ -n "$c" ]]; then G_CTX="$c"; fi
  done < <(branch_jobs "$(jget "$1/job" repo)" "$(jget "$1/job" branch)")
  G_PROGRESS="$ok/${#GROUP[@]}" G_NEXT="${run:-${nxt:--}}"
}

# lane_body JOB STATUS — the lane PR in the pr.md shape: the title and TL;DR of the
# latest done item, a `<item> → <side-branch>` line per item out of the lane, one
# <details> per item. STATUS is JOB's status, still `running` while it publishes.
lane_body() {
  local d="$1" j item s r side more branch last="" out="" det="" n=0 ok=0 title="" t="" verify="" risks=""
  branch="$(jget "$d/job" branch)"
  while IFS= read -r j; do
    [[ -n "$j" ]] || continue
    item="$(job_item "$j")" r="$(jstate "$j" result)"
    s="$(jstate "$j" status)"
    if [[ "$j" == "$d" ]]; then s="$2"; fi
    n=$((n + 1))
    case "$s" in
      "done")
        ok=$((ok + 1)) last="$j"
        more="$(awk '/^<\/details>/ { f = 0 } f && (NF || p) { print; p = 1 } /^<summary>/ { f = 1 }' "$j/pr.md" 2>/dev/null || true)"
        det+=$'\n'"<details>"$'\n'"<summary>$item — done</summary>"$'\n\n'"${more:-${r#*: }}"$'\n\n'"_job ${j##*/}_"$'\n\n'"</details>"$'\n'
        ;;
      blocked | failed | timeout)
        side="$(jstate "$j" side)"
        side="${side:-$branch-$item}"
        out+="- $item → $side"$'\n'
        det+=$'\n'"<details>"$'\n'"<summary>$item — $s</summary>"$'\n\n'"${r:-$(jstate "$j" note)}"$'\n\n'"_job ${j##*/}_"$'\n\n'"</details>"$'\n'
        ;;
    esac
  done < <(lane_jobs "$d")
  if [[ -n "$last" ]]; then
    title="$(head -n 1 "$last/pr.md" 2>/dev/null || true)"
    t="$(md_line "$last/pr.md" Changed)"
    verify="$(md_line "$last/pr.md" Verify)" risks="$(md_line "$last/pr.md" Decisions/risks)"
    if [[ -z "$t" ]]; then
      t="$(jstate "$last" result)" t="${t#*: }"
    fi
  fi
  printf '%s\n\n**Context:** %s\n**Changed:** %s\n%s**Verify:** %s\n**Decisions/risks:** %s\n%s\n---\n_agent lane: %s/%s done_\n' \
    "${title:-$(pr_title_fallback "$d")}" "$(jget "$d/job" lane)" "${t:-none}" "$out" "${verify:-none}" "${risks:-none}" "$det" "$ok" "$n"
}

# lane_leave JOB STATUS — a lane job that did not finish leaves the lane: a WIP commit
# of its changes, its work on <branch>-<item> (pushed, no PR), the lane worktree back at
# JOB/start. Only a lane job has JOB/start. Runs under `|| true`, so each step guards itself.
lane_leave() {
  local d="$1" wt branch item start side
  start="$(jstate "$d" start)"
  [[ -n "$start" ]] || return 0
  wt="$(jstate "$d" worktree)" branch="$(jget "$d/job" branch)"
  item="$(job_item "$d")" side="$branch-$item"
  if [[ -n "$(agent_git -C "$wt" status --porcelain)" ]]; then
    agent_git -C "$wt" add -A && agent_git -C "$wt" commit -q -m "wip: $item ($2)" || return 0
  fi
  agent_git -C "$wt" branch -f "$side" HEAD || return 0
  agent_git -C "$wt" reset -q --hard "$start" || return 0
  echo "$side" >"$d/side"
  agent_push "$wt" -q --force origin "$side" || echo "push of $side failed" >&2
}

# epoch_of 'YYYY-MM-DD HH:MM:SS' — the epoch seconds of a local time, GNU or BSD date; empty when malformed.
epoch_of() {
  [[ -n "$1" ]] || return 0
  date -d "$1" +%s 2>/dev/null || date -j -f '%Y-%m-%d %H:%M:%S' "$1" +%s 2>/dev/null || true
}

# ev_num EVENT KEY — the number after "KEY": in a stream-json EVENT; empty when absent.
ev_num() {
  local re="\"$2\":(-?[0-9][0-9.eE+-]*)"
  if [[ "$1" =~ $re ]]; then echo "${BASH_REMATCH[1]}"; fi
}

# job_result JOB — the last `result` event of the job's log; empty without one.
job_result() { grep '"type":"result"' "$1/log" 2>/dev/null | tail -n 1 || true; }

# job_span JOB — "<start> <end>" epoch seconds of the job's run (end: now while it runs); empty without a start.
job_span() {
  local s e
  s="$(epoch_of "$(jstate "$1" started)")" e="$(epoch_of "$(jstate "$1" ended)")"
  if [[ -n "$s" ]]; then echo "$s ${e:-$(date +%s)}"; fi
}

# job_delta JOB — 5h-limit use in points, last minus first rate_limit_event of the job's log; empty under 2 events or when resetsAt changes.
job_delta() {
  grep -oE '"five_hour":\{"utilization":[0-9.eE+-]+,"resetsAt":[0-9]+' "$1/log" 2>/dev/null |
    awk -F'[:,]' 'NR == 1 { u0 = $3; r0 = $5 } { u1 = $3; if ($5 != r0) moved = 1 }
      END { if (NR > 1 && !moved) printf "%.4f", (u1 - u0) * 100 }' || true
}

# job_limit_pct JOB — the job's share of its 5h-limit delta in %: its $ over the $ of every
# job that ran at the same time (the job included), each scaled by its overlap time.
# Empty when the delta or any overlapping job's cost is missing. Interactive use is not in the sum.
# A job that ended before this one started is skipped by its `ended` string: no fork, no log.
job_limit_pct() {
  local d="$1" delta s e k ks ke ov c rows="" self="" from="" end
  local re='^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$'
  delta="$(job_delta "$d")"
  read -r s e <<<"$(job_span "$d")"
  [[ -n "$delta" && -n "${s:-}" ]] || return 0
  [[ ! -f "$d/started" ]] || read -r from <"$d/started" || true
  [[ "$from" =~ $re ]] || from=""
  for k in "$QDIR"/*/ "$QROOT"/archive/*/*/; do
    k="${k%/}"
    [[ -f "$k/started" ]] || continue
    end=""
    [[ ! -f "$k/ended" ]] || read -r end <"$k/ended" || true
    if [[ -n "$from" && "$end" =~ $re && "$end" < "$from" ]]; then continue; fi
    read -r ks ke <<<"$(job_span "$k")"
    [[ -n "${ks:-}" ]] || continue
    # Times have 1s resolution: a run from t to t spans one second.
    ov=$(((ke < e ? ke : e) - (ks > s ? ks : s) + 1))
    ((ov > 0)) || continue
    c="$(ev_num "$(job_result "$k")" total_cost_usd)"
    [[ -n "$c" ]] || return 0
    rows+="$c $ov $((ke - ks + 1))"$'\n'
    if [[ "${k##*/}" == "${d##*/}" ]]; then self="$c"; fi
  done
  [[ -n "$self" ]] || return 0
  printf '%s' "$rows" | awk -v delta="$delta" -v self="$self" \
    '{ tot += $1 * $2 / $3 } END { if (tot > 0) printf "%.0f", delta * self / tot }'
}

# job_stats JOB — `≈$1.04 API · ≈2% 5h est. · 40 turns · 11m` from the job's last `result`
# event (the $ is the API price, not a bill); empty without one.
job_stats() {
  local ev cost turns ms
  ev="$(job_result "$1")"
  cost="$(ev_num "$ev" total_cost_usd)" turns="$(ev_num "$ev" num_turns)" ms="$(ev_num "$ev" duration_ms)"
  [[ -n "$cost" && -n "$turns" && -n "$ms" ]] || return 0
  awk -v c="$cost" -v p="$(job_limit_pct "$1")" -v t="$turns" -v ms="$ms" 'BEGIN {
    printf "≈$%.2f API", c
    if (p != "") printf " · ≈%d%% 5h est.", p
    printf " · %d turns · %.0fm\n", t, ms / 60000 }'
}

# limit_line — `limit 5h: 46%, resets 14:30` from the newest rate_limit_event in any job log; empty without one.
limit_line() {
  local f ev u t re='"five_hour":\{"utilization":([0-9.eE+-]+),"resetsAt":([0-9]+)'
  while IFS= read -r f; do
    ev="$(grep '"type":"rate_limit_event"' "$f" 2>/dev/null | tail -n 1 || true)"
    [[ "$ev" =~ $re ]] || continue
    u="$(awk -v u="${BASH_REMATCH[1]}" 'BEGIN { printf "%.0f", u * 100 }')"
    t="$(at_time "${BASH_REMATCH[2]}")"
    echo "limit 5h: $u%, resets ${t#* }"
    return 0
  done < <(ls -t "$QDIR"/*/log 2>/dev/null)
}

# gate_md JOB — the PR-body block for the job's gate result; nothing when no gate ran.
gate_md() {
  [[ -f "$1/gate" ]] || return 0
  # shellcheck disable=SC2016  # markdown fences, not command substitution
  printf '\n**Gate:** exit %s\n\n```\n%s\n```\n' "$(jstate "$1" gate)" "$(tail -n 20 "$1/gate.log")"
}

# job_publish JOB [STATUS] — push the job's commits; open a draft PR from JOB/pr.md,
# or replace the body of the PR already open on the branch. Label: agent.
# A lane job (`lane=`) writes the PR from every lane job on the branch (lane_body);
# STATUS is the job's own status, not final yet. A job with `event=` (triage_fix) also comments its result.
# `gh pr edit` fails on gh 2.45 (it asks for the removed projectCards); gh api does not.
job_publish() {
  local d="$1" wt base branch ahead title="" url lane stats feat r
  local -a tflag=()
  wt="$(jstate "$d" worktree)" base="$(jstate "$d" base)" branch="$(jget "$d/job" branch)"
  ahead="$(agent_git -C "$wt" rev-list --count "origin/$base..HEAD" 2>/dev/null || echo 0)"
  ((ahead > 0)) || return 0
  clear_config_lock "$wt"
  if ! agent_push "$wt" -q -u origin "$branch"; then
    if [[ -n "$LFS_REFUSED" ]]; then echo "push failed (git-lfs: push by hand)" >"$d/pr"; else echo "push failed" >"$d/pr"; fi
    return 0
  fi
  command -v gh >/dev/null 2>&1 || return 0
  lane="$(jget "$d/job" lane)"
  if [[ -n "$lane" ]]; then
    lane_body "$d" "${2:-}" >"$d/lane-pr.md"
    title="$(head -n 1 "$d/lane-pr.md")" tflag=(-f "title=$title")
    tail -n +2 "$d/lane-pr.md" >"$d/pr-body.md"
    gate_md "$d" >>"$d/pr-body.md"
  else
    if [[ -f "$d/pr.md" ]]; then tail -n +2 "$d/pr.md" >"$d/pr-body.md"; else : >"$d/pr-body.md"; fi
    gate_md "$d" >>"$d/pr-body.md"
    stats="$(job_stats "$d")"
    printf '\n---\n_agent job %s: %s%s_\n' "$(basename "$d")" "$(jstate "$d" result)" "${stats:+ · $stats}" >>"$d/pr-body.md"
  fi
  feat="$(feature_of "$(jget "$d/job" repo)" "$branch")"
  if [[ -n "$feat" ]]; then feature_body "$d" "$feat"; fi
  url="$( (cd "$wt" && gh pr list --head "$branch" --state open --json url -q '.[0].url') 2>/dev/null || true)"
  if [[ -n "$url" ]]; then
    (cd "$wt" && gh api --method PATCH "repos/{owner}/{repo}/pulls/${url##*/}" -F "body=@$d/pr-body.md" "${tflag[@]+"${tflag[@]}"}") >/dev/null 2>&1 || true
  else
    if [[ -z "$lane" ]]; then title="$(head -n 1 "$d/pr.md" 2>/dev/null || true)"; fi
    [[ -n "$title" ]] || title="$(pr_title_fallback "$d")"
    url="$( (cd "$wt" && gh pr create --draft --base "$base" --head "$branch" \
      --title "$title" --body-file "$d/pr-body.md") | tail -n 1 || true)"
  fi
  if [[ -n "$url" ]]; then
    (cd "$wt" && gh label create agent --color 5319e7 --description "opened by a job runner") >/dev/null 2>&1 || true
    (cd "$wt" && gh api --method POST "repos/{owner}/{repo}/issues/${url##*/}/labels" -f 'labels[]=agent') >/dev/null 2>&1 || true
  fi
  echo "${url:-PR not created}" >"$d/pr"
  if [[ -n "$(jget "$d/job" event)" && "$url" == http* ]]; then
    r="$(jstate "$d" result)"
    (cd "$wt" && gh api --method POST "repos/{owner}/{repo}/issues/${url##*/}/comments" \
      -f "body=**Fix job** \`${d##*/}\`: ${r:-failed}") >/dev/null 2>&1 || true
  fi
  if [[ -n "$feat" && "$url" == http* ]]; then feature_set_pr "$feat" "$(jget "$d/job" repo)" "$branch" "$url"; fi
}

# job_chain JOB — a SPEC.md job that ticked a milestone and left one open
# queues the next one, with the same prompt.
job_chain() {
  local d="$1" wt before after tmp
  wt="$(jstate "$d" worktree)" before="$(jstate "$d" milestones)"
  after="$(milestones_open "$wt")"
  [[ -n "$before" && -n "$after" ]] || return 0
  ((after > 0 && after < before)) || return 0
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-job.XXXXXX")"
  grep -Ev '^(now|at)=' "$d/job" >"$tmp/job" || true
  cp "$d/prompt.md" "$tmp/prompt.md"
  echo "next milestone → $(basename "$(queue_add "$tmp")")"
}

# job_session JOB — keep the session id of the `system/init` event in JOB/log
# as JOB/session; a log without one leaves the file as it is.
job_session() {
  local ev
  ev="$(grep -m 1 '"subtype":"init"' "$1/log" 2>/dev/null || true)"
  [[ "$ev" =~ \"session_id\":\"([A-Za-z0-9_-]+)\" ]] || return 0
  echo "${BASH_REMATCH[1]}" >"$1/session"
}

# limit_reset LOG — the reset epoch when the agent stopped on a usage limit; empty else.
limit_reset() {
  local ev
  ev="$(grep -oE '"rate_limit_info":\{"status":"rejected"[^}]*' "$1" 2>/dev/null | tail -n 1 || true)"
  [[ "$ev" =~ \"resetsAt\":([0-9]+) ]] || return 0
  echo "${BASH_REMATCH[1]}"
}

# at_time EPOCH — EPOCH as YYYY-MM-DD HH:MM, GNU or BSD date.
at_time() { date -d "@$1" '+%F %H:%M' 2>/dev/null || date -r "$1" '+%F %H:%M'; }

# limited — true until the usage limit a job hit resets.
limited() {
  local t
  t="$(head -n 1 "$QROOT/limit" 2>/dev/null || true)"
  [[ "$t" =~ ^[0-9]+$ ]] && ((t > $(date +%s)))
}

# secs DURATION — a timeout(1) duration, N[smhd], in whole seconds.
secs() {
  awk -v t="$1" 'BEGIN {
    u = substr(t, length(t)); m = u == "m" ? 60 : u == "h" ? 3600 : u == "d" ? 86400 : 1
    printf "%d\n", t * m }'
}

# agent_exec JOB TIMEOUT SCRIPT ARG... — <agent>/SCRIPT in its memory scope under
# timeout(1), JOB as $VIBE_JOB_DIR; its pid in JOB/agent-pid. Exit 124: the time limit; 137: killed before it.
agent_exec() {
  local d="$1" t="$2" s="$3" rc=0 start="$SECONDS"
  shift 3
  local -a tcmd=("${MEM_CMD[@]+"${MEM_CMD[@]}"}" "${TIMEOUT_CMD[@]+"${TIMEOUT_CMD[@]}"}")
  if ((${#TIMEOUT_CMD[@]})); then tcmd+=("$t"); fi
  VIBE_JOB_DIR="$d" "${tcmd[@]+"${tcmd[@]}"}" bash "$SELF_ROOT/$AGENT/$s" "$@" &
  echo "$!" >"$d/agent-pid"
  wait "$!" || rc=$?
  rm -f "$d/agent-pid"
  # timeout(1) exits 137 too, when TERM left the agent running past --kill-after.
  if ((rc == 137 && ${#TIMEOUT_CMD[@]})) && ((SECONDS - start >= $(secs "$t"))); then rc=124; fi
  return "$rc"
}

# job_agent JOB TIMEOUT PROMPT [SESSION] [MAX_TURNS] — one agent session in the
# job's worktree, appended to JOB/log; its exit code. SESSION resumes that session.
# steer=1 in queue.conf: the FIFO JOB/steer for `vibe queue steer` while the session runs.
job_agent() {
  local rc=0
  if [[ "$(qconf steer "")" == 1 ]]; then rm -f "$1/steer" && mkfifo "$1/steer"; fi
  agent_exec "$1" "$2" vibe-job.sh "$(jstate "$1" worktree)" "$(jstate "$1" name)" "$(jget "$1/job" model)" \
    "$3" "$(jget "$1/job" effort)" "${4:-}" "${5:-}" >>"$1/log" 2>&1 || rc=$?
  rm -f "$1/steer"
  return "$rc"
}

# job_handoff JOB — after a timeout: resume the job's session for one turn
# that commits HANDOFF.md and writes `result`. No session, no resume.
job_handoff() {
  local d="$1"
  [[ -s "$d/session" ]] || return 0
  {
    echo "The time limit stopped this job."
    echo "Overwrite HANDOFF.md in the worktree root with State, Next action and Blockers."
    echo "Commit it with any work in progress."
    echo "If $d/result does not exist, write it: failed: out of time — <what is left>."
  } >"$d/resume.md"
  job_agent "$d" 10m "$d/resume.md" "$(jstate "$d" session)" 5 || true
}

# job_after JOB — what runs after the job's commits: `after=` in the job file,
# else in queue.conf, else `review`. `code`: the review without lean-review. Present but empty means nothing.
job_after() {
  if grep -q '^after=' "$1/job" 2>/dev/null; then
    jget "$1/job" after
  elif grep -q '^after=' "$QCONF/queue.conf" 2>/dev/null; then
    qconf after "" # qconf drops a trailing # comment
  else
    echo review
  fi
}

# review_on JOB — true when the job wants a review: after= is `review` or `code`.
review_on() {
  case "$(job_after "$1")" in review | code) return 0 ;; esac
  return 1
}

# review_passes JOB — the passes of the job's review rounds, for the page.
review_passes() {
  if [[ "$(job_after "$1")" == code ]]; then echo /code-review; else echo "/code-review + lean-review"; fi
}

# review_due JOB — true when the job wants a review and has commits ahead of its base.
review_due() {
  local d="$1" ahead
  if ! review_on "$d" || [[ "$(jget "$d/job" output)" == report ]]; then return 1; fi
  ahead="$(agent_git -C "$(jstate "$d" worktree)" rev-list --count "origin/$(jstate "$d" base)..HEAD" 2>/dev/null || echo 0)"
  ((ahead > 0))
}

# review_base JOB — the job a review round (<id>-review<N>) or the verify step (<id>-verify) follows; else JOB.
review_base() {
  local r
  r="$(jget "$1/job" review)"
  case "$r" in
    "") echo "$1" ;;
    verify) echo "${1%-verify}" ;;
    *) echo "${1%-review"$r"}" ;;
  esac
}

# review_follow JOB N — queue round N of the review: a follow-up job on the same branch,
# <id>-review<N>; N=verify queues the verify step, <id>-verify.
# It carries the PR text, the result, the session and the rounds so far.
review_follow() {
  local d="$1" n="$2" s="review$2" f x
  if [[ "$n" == verify ]]; then s=verify; fi
  f="$(review_base "$d")-$s"
  mkdir -p "$f"
  for x in prompt.md pr.md result session rounds round-details.md; do
    if [[ -f "$d/$x" ]]; then cp "$d/$x" "$f/$x"; fi
  done
  follow_job "$d" "$f" "review=$n" "timeout=$(qconf review_timeout 1h)"
}

# review_agent JOB TIMEOUT N — the reviewer: its JSON result in JOB/review.json; its exit code.
review_agent() {
  local d="$1" model
  model="$(jget "$d/job" review_model)"
  agent_exec "$d" "$2" vibe-review.sh "$(jstate "$d" worktree)" "$(jstate "$d" name)-review$3" \
    "${model:-$(qconf review_model sonnet)}" "$(qconf review_level high)" "$(jstate "$d" base)" \
    "$(job_after "$d")" >"$d/review.json" 2>>"$d/log"
}

# review_findings JOB — JOB/findings from JOB/review.json: one numbered line per
# finding. Fails when the reviewer left no structured_output.findings array.
review_findings() {
  jq -e '.structured_output.findings | type == "array"' "$1/review.json" >/dev/null 2>&1 || return 1
  jq -r '.structured_output.findings | to_entries[] | "\(.key + 1). `\(.value.file):\(.value.line // "?")` — \(.value.summary | tostring | gsub("\n"; " ")) Failure: \(.value.failure_scenario | tostring | gsub("\n"; " "))"' \
    "$1/review.json" >"$1/findings"
}

# review_fix JOB TIMEOUT — resume the job's session: it fixes or rejects each
# finding and writes JOB/verdicts. No session, no fix: every finding stays open.
review_fix() {
  local d="$1"
  [[ -s "$d/session" ]] || return 0
  {
    echo "A reviewer found problems in your commits on this branch."
    echo "Check each one. Fix it in a new commit, or reject it with a reason."
    echo
    cat "$d/findings"
    echo
    echo "Write $d/verdicts, one line per finding:"
    echo "<number>=fixed <commit sha>, <number>=rejected <reason>, or <number>=open."
    echo "Do not change result or pr.md. Do not push."
  } >"$d/fix.md"
  job_agent "$d" "$2" "$d/fix.md" "$(jstate "$d" session)"
}

# review_big WORKTREE BEFORE — true when the commits since BEFORE are not trivial:
# over `review_trivial` changed lines, or a file outside *.md.
review_big() {
  local add del file lines=0 big=0
  while IFS=$'\t' read -r add del file; do
    [[ -n "$file" ]] || continue
    case "$file" in *.md) ;; *) big=1 ;; esac
    lines=$((lines + ${add//-/0} + ${del//-/0}))
  done < <(agent_git -C "$1" diff --numstat "$2" HEAD)
  ((big || lines > $(qconf review_trivial 20)))
}

# review_tally JOB COUNT — "3 fixed, 1 rejected, 1 open" from JOB/verdicts.
review_tally() {
  local d="$1" i fixed=0 rej=0 out=""
  for ((i = 1; i <= $2; i++)); do
    case "$(jget "$d/verdicts" "$i")" in
      fixed*) fixed=$((fixed + 1)) ;;
      rejected*) rej=$((rej + 1)) ;;
    esac
  done
  if ((fixed)); then out="$fixed fixed"; fi
  if ((rej)); then out+="${out:+, }$rej rejected"; fi
  if (($2 - fixed - rej)); then out+="${out:+, }$(($2 - fixed - rej)) open"; fi
  echo "$out"
}

# review_pr_md JOB — JOB/pr.md with the review: the rounds on one line above
# <details>, the findings and verdicts at the end of it. Makes a missing pr.md
# (fallback title) or <details> block.
review_pr_md() {
  local d="$1"
  {
    if [[ -f "$d/pr.md" ]]; then cat "$d/pr.md"; else pr_title_fallback "$d"; fi
    if ! grep -q '^<details>' "$d/pr.md" 2>/dev/null || ! grep -q '^</details>' "$d/pr.md"; then
      printf '\n<details>\n<summary>Details</summary>\n\n</details>\n'
    fi
  } >"$d/pr.base"
  local only=""
  if [[ "$(job_after "$d")" == code ]]; then only=" (/code-review only)"; fi
  awk -v rounds="**Review:** $(cat "$d/rounds")$only" -v det="$d/round-details.md" '
    function cat(f,  l) { while ((getline l < f) > 0) print l; close(f) }
    { line[NR] = $0 }
    /^<details>/ && !first { first = NR }
    /^<\/details>/ { last = NR }
    END {
      for (i = 1; i <= NR; i++) {
        if (i == first) { print rounds; print "" }
        if (i == last) { if (line[i - 1] != "") print ""; cat(det) }
        print line[i]
      }
    }' "$d/pr.base" >"$d/pr.md"
  rm -f "$d/pr.base"
}

# job_review JOB — round N of a review: a fresh reviewer on base...HEAD, then the
# job's session fixes what it found. A fix that is not trivial earns another round;
# the last round publishes the PR with the rounds in its body.
job_review() {
  local d="$1" n t rc=0 count=0 before wt line f v i=0 s=s next=0 prev ev e
  n="$(jget "$d/job" review)" t="$(job_timeout "$d")" wt="$(jstate "$d" worktree)"
  : >"$d/log"
  review_agent "$d" "$t" "$n" || rc=$?
  if stopped "$d"; then return 0; fi
  if ((rc == 124)); then
    line="R$n: timeout"
  elif ((rc != 0)) || ! review_findings "$d"; then
    line="R$n: review failed"
  else
    count="$(grep -c '' "$d/findings" || true)"
    if ((count == 1)); then s=""; fi
    line="R$n: $count finding$s"
    if ((count > 0)); then
      before="$(agent_git -C "$wt" rev-parse HEAD)"
      review_fix "$d" "$t" || rc=$?
      if stopped "$d"; then return 0; fi
      ev="$(job_result "$d")"
      if ((rc != 0)) || [[ "$ev" == *'"is_error":true'* ]]; then
        # A fix cut off (timeout, API error, crash) may leave half a fix: fail, no publish; `vibe queue retry` adopts the worktree.
        e="$(ev_num "$ev" api_error_status)"
        if ((rc == 124)); then
          e="timeout"
        elif [[ -n "$e" ]]; then
          e="API error $e"
        elif ((rc)); then
          e="agent exit $rc"
        else
          e="error result"
        fi
        # shortcut: untracked files do not count (sandbox placeholders); count them once a leftover skips a job.
        if [[ -n "$(agent_git -C "$wt" status --porcelain -uno)" ]]; then e+="; $wt has uncommitted changes"; fi
        job_end "$d" failed "$line → fix failed: $e"
        return 0
      else
        line+=" → $(review_tally "$d" "$count")"
        if ((n < $(qconf review_rounds 2))) && review_big "$wt" "$before"; then next=1; fi
      fi
    fi
  fi
  {
    echo "**R$n** — ${line#*: }"
    echo
    if [[ -f "$d/findings" ]]; then
      while IFS= read -r f; do
        i=$((i + 1)) v="$(jget "$d/verdicts" "$i")"
        echo "$f → ${v:-open}"
      done <"$d/findings"
      echo
    fi
  } >>"$d/round-details.md"
  prev="$(cat "$d/rounds" 2>/dev/null || true)"
  echo "${prev:+$prev · }$line" >"$d/rounds"
  if stopped "$d"; then return 0; fi
  if ((next)); then
    review_follow "$d" $((n + 1))
  elif [[ -n "$(jget "$d/job" verify)" ]]; then
    review_follow "$d" verify
  else
    review_publish "$d" || return 0
  fi
  job_end "$d" "done" "$line"
}

# review_publish JOB — the rounds into pr.md, the gate, the PR. False when a stop ended the job.
review_publish() {
  review_pr_md "$1"
  job_gate "$1" || true
  if stopped "$1"; then return 1; fi
  job_publish "$1" || true
}

# job_verify JOB — after the last review round: a fresh agent drives the app (the repo's verify skill)
# and/or runs blast-radius, per `verify=`. Its verdict (JOB/verify) joins the Review line, its commands
# go in <details>; a moved HEAD or a changed tracked file is `V: dirty`. Then the gate and the PR, except on dirty.
job_verify() {
  local d="$1" k wt tip model rc=0 v="" skip="" prev
  k="$(jget "$d/job" verify)" wt="$(jstate "$d" worktree)"
  : >"$d/log"
  if [[ "$k" == app* ]] && ! compgen -G "$wt/.claude/skills/verify-*/SKILL.md" >/dev/null; then
    k="${k#app}" k="${k#,}" skip="no verify skill"
  fi
  if [[ -n "$k" ]]; then
    tip="$(git -C "$wt" rev-parse HEAD)" model="$(jget "$d/job" review_model)"
    agent_exec "$d" "$(job_timeout "$d")" vibe-verify.sh "$wt" "$(jstate "$d" name)-verify" \
      "${model:-$(qconf review_model sonnet)}" "$(jstate "$d" base)" "$k" >"$d/verify.json" 2>>"$d/log" || rc=$?
    if stopped "$d"; then return 0; fi
    # shortcut: untracked files do not count (sandbox placeholders); count them once a leftover skips a job.
    if [[ "$(git -C "$wt" rev-parse HEAD)" != "$tip" || -n "$(git -C "$wt" status --porcelain -uno)" ]]; then
      v=dirty
    elif ((rc == 124)); then
      v=timeout
    elif ((rc != 0)) || ! v="$(jq -er '.structured_output.verdict | select(. == "pass" or . == "fail")' "$d/verify.json" 2>/dev/null)"; then
      v="verify failed"
    fi
  fi
  if [[ -n "$skip" ]]; then v="${v:+$v, }$skip"; fi
  echo "$v" >"$d/verify"
  prev="$(cat "$d/rounds" 2>/dev/null || true)"
  echo "${prev:+$prev · }V: $v" >"$d/rounds"
  {
    echo "**V** — $v"
    echo
    if jq -e '.structured_output.checks | length > 0' "$d/verify.json" >/dev/null 2>&1; then
      # Indented, not fenced: a ``` or </details> line in the output stays code.
      jq -r '.structured_output.checks[] | "$ \(.command)\n\(.output)" | "    " + gsub("\n"; "\n    ")' "$d/verify.json"
      echo
    fi
  } >>"$d/round-details.md"
  if [[ "$v" == dirty* ]]; then
    # No gate, no push: the verifier's commit or edit is unreviewed and must not reach origin.
    review_pr_md "$d"
  else
    review_publish "$d" || return 0
  fi
  job_end "$d" "done" "V: $v"
}

# stopped JOB — true when `vibe queue stop` asked for it; the job then ends failed, no publish.
# A lane job leaves the lane first, so the next item starts from a clean worktree.
stopped() {
  [[ -e "$1/stop" ]] || return 1
  lane_leave "$1" stopped || true
  job_end "$1" failed stopped
}

# tool_inst JOB — the workspace instance of a tool= job: <tool>-<job id>.
tool_inst() { echo "$(jget "$1/job" tool)-${1##*/}"; }

# tool_conf JOB KEY — KEY from the workspace.conf of the job's tool; empty when absent.
tool_conf() { jget "$WS_ROOT/$(jget "$1/job" tool)/workspace.conf" "$2"; }

# tool_place JOB — place= of a tool= job, else the first of its tool's places.
tool_place() {
  local p
  p="$(jget "$1/job" place)"
  [[ -n "$p" ]] || p="$(tool_conf "$1" places)"
  echo "${p%%,*}"
}

# tool_hours JOB — hours= of a tool= job, else of its tool's workspace.conf.
tool_hours() {
  local h
  h="$(jget "$1/job" hours)"
  echo "${h:-$(tool_conf "$1" hours)}"
}

# tool_gpu JOB — true for a tool= job whose run is to come or runs, on turing with gpu=yes: under the GPU lock.
tool_gpu() {
  [[ -n "$(jget "$1/job" tool)" && ! -f "$1/tool-exit" && "$(tool_conf "$1" gpu)" == yes && "$(tool_place "$1")" == turing ]]
}

# tool_check JOB — why a tool= job cannot run (docs/workspaces.md, Queue job); empty when it can.
tool_check() {
  local n f p h m
  n="$(jget "$1/job" tool)" p="$(tool_place "$1")" h="$(tool_hours "$1")"
  f="$WS_ROOT/$n/workspace.conf"
  if ! m="$( (ws_dir "$n" >/dev/null && ws_secrets "$n" "$f") 2>&1)"; then
    echo "${m#vibe: }"
  elif [[ "$(tool_conf "$1" kind)" != run ]]; then
    echo "$n is kind=service — vibe ws start $n"
  elif [[ ",$(tool_conf "$1" places)," != *",$p,"* ]]; then
    echo "$n has no place '$p' — places=$(tool_conf "$1" places)"
  elif [[ ! -x "$WS_ROOT/_places/$p" ]]; then
    echo "no place script '$p' in $WS_ROOT/_places — place= names another"
  elif ! [[ "$h" =~ ^[1-9][0-9]*$ ]]; then
    echo "hours=$h: a whole number above 0, in the job or $f"
  elif ! [[ "$(tool_inst "$1")" =~ $WS_INST_RE ]]; then
    echo "instance '$(tool_inst "$1")': letters, digits, . _ - only — the repo folder or the branch breaks it"
  fi
}

# tool_run JOB — the run of a tool= job in its instance: in/ (a clone of the worktree, the job's
# in/brief.md and in/args), then `vibe ws run`, under the GPU lock for gpu=yes on turing.
# A stop TERMs the run, then the stop script and down. Writes JOB/tool.log, out/ (plain files and dirs only:
# a link would read host files, a FIFO blocks a read), then tool-exit. The instance is the job's alone:
# once down, its state dir goes.
tool_run() {
  local d="$1" inst st h f pid rc=0
  inst="$(tool_inst "$d")" h="$(tool_hours "$d")"
  st="$WS_STATES/$inst"
  local -a runcmd=("$SELF_ROOT/bin/vibe" ws run "$inst")
  : >"$d/tool.log"
  mkdir -p "$st"
  # A job process that died left its instance up: down first; up brings its data/ back.
  if [[ -s "$st/id" ]]; then WS_HOURS="$h" ws_down "$inst" >>"$d/tool.log" 2>&1 || true; fi
  tool_place "$d" >"$st/place"
  rm -rf "$st/in" "$st/out" "$d/out"
  mkdir -p "$st/in"
  for f in brief.md args; do
    if [[ -f "$d/in/$f" ]]; then cp "$d/in/$f" "$st/in/$f"; fi
  done
  if ! agent_git clone -q --single-branch "$(jstate "$d" worktree)" "$st/in/repo" >>"$d/tool.log" 2>&1; then
    rm -rf "$st"
    return 0
  fi
  if tool_gpu "$d"; then
    runcmd=("$SELF_ROOT/bin/gpu-queue" lock -- "${runcmd[@]}")
  fi
  # Its own process group: a stop TERMs a lock waiter, `vibe ws run` and the place's exec at once.
  set -m
  WS_HOURS="$h" "${runcmd[@]}" </dev/null >>"$d/tool.log" 2>&1 &
  pid=$!
  set +m
  while kill -0 "$pid" 2>/dev/null; do
    if [[ -e "$d/stop" ]]; then
      kill -TERM -- "-$pid" 2>/dev/null || true
      break
    fi
    sleep "${VIBE_WS_POLL:-10}"
  done
  wait "$pid" || rc=$?
  if [[ -e "$d/stop" && -s "$st/id" ]]; then WS_HOURS="$h" ws_down "$inst" >>"$d/tool.log" 2>&1 || true; fi
  if [[ -d "$st/out" ]]; then
    cp -R "$st/out" "$d/out" >>"$d/tool.log" 2>&1 || true
    find "$d/out" ! -type f ! -type d -delete 2>/dev/null || rm -rf "$d/out"
  fi
  # Last: a job process that dies before it runs the tool again.
  echo "$rc" >"$d/tool-exit"
  if [[ ! -s "$st/id" ]]; then rm -rf "$st"; fi
}

# tool_unsafe WT — the first path FETCH_HEAD adds, changes or deletes against WT's HEAD in agent or git
# config (.claude/, CLAUDE.md, .mcp.json, .vibe-jobs/, .github/ …); `?` when the diff fails.
# The closing session and the review run in WT on the host and load that config.
tool_unsafe() {
  local f
  f="$(agent_git -c core.quotePath=false -C "$1" diff --no-renames --name-only HEAD FETCH_HEAD)" || {
    echo "?"
    return 0
  }
  printf '%s\n' "$f" | grep -Ei -m 1 '(^"?|/)(\.claude|\.mcp\.json|claude(\.local)?\.md|agents\.md|gemini\.md|\.vibe-jobs|\.gitattributes|\.gitmodules|\.githooks|\.github)(/|"?$)' || true
}

# tool_job JOB — a tool= job up to its closing session: the run once (tool_run), a result=branch
# fast-forwarded onto the job's branch, JOB/close.md (prompt.md, tool-run.md at its end).
# False once the job has ended: a stop, no out/result, a failed: out/result, a done branch result with no bundle, a bad or unsafe
# branch, no fast-forward, no close.md.
# Runs as a tested condition: each failure is handled, not left to errexit.
# A requeue after a crash redoes what is not done: tool-exit marks the run, close.md the check and the merge too.
tool_job() {
  local d="$1" wt b x e
  wt="$(jstate "$d" worktree)"
  if [[ ! -f "$d/close.md" ]]; then
    if [[ ! -f "$d/tool-exit" ]]; then tool_run "$d"; fi
    if stopped "$d"; then return 1; fi
    if [[ ! -s "$d/out/result" ]]; then
      x="$(tail -n 1 "$d/tool.log" 2>/dev/null | cut -c 1-160)"
      e="$(jstate "$d" tool-exit)"
      job_end "$d" failed "no out/result, tool exit ${e:-none} — tool.log: $x"
      return 1
    fi
    # A failed run has nothing to check: its line is the job's result, no closing session.
    if [[ "$(jstate "$d/out" result)" == failed:* ]]; then
      job_end "$d" failed "$(jstate "$d/out" result | cut -c 1-160)"
      return 1
    fi
    b="$(jstate "$d/out" branch)"
    # tool-run.md tells the closing session that the branch holds the tool's commits.
    if [[ "$(tool_conf "$d" result)" == branch && ! -f "$d/out/repo.bundle" && "$(jstate "$d/out" result)" == done:* ]]; then
      job_end "$d" failed "out/result is done: but there is no out/repo.bundle — tool.log"
      return 1
    fi
    if [[ "$(tool_conf "$d" result)" == branch && -f "$d/out/repo.bundle" ]]; then
      if ! { git check-ref-format --allow-onelevel "$b" && agent_git -C "$wt" fetch -q "$d/out/repo.bundle" -- "$b"; } >>"$d/tool.log" 2>&1; then
        job_end "$d" failed "out/repo.bundle: no branch '$b' — tool.log"
        return 1
      fi
      x="$(tool_unsafe "$wt")"
      if [[ -n "$x" ]]; then
        job_end "$d" failed "out/repo.bundle changes $x: agent and git config stay out of a tool's commits"
        return 1
      fi
      if ! agent_git -C "$wt" merge -q --ff-only FETCH_HEAD >>"$d/tool.log" 2>&1; then
        job_end "$d" failed "out/repo.bundle: '$b' does not fast-forward $(jget "$d/job" branch) — tool.log"
        return 1
      fi
    fi
  fi
  # `if ! { … } >f` misses a failed redirect (bash keeps its status unnegated): `||` catches it.
  {
    cat "$d/prompt.md" && echo && cat "$SELF_ROOT/skills/fill-queue/references/tool-run.md"
  } >"$d/close.md" || {
    job_end "$d" failed "close.md not written — runner.log"
    return 1
  }
}

# job_run JOB — the agent in the job's worktree, the gate, then publish; a job with a
# review due queues the review instead, and the review gates and publishes. A retry after a usage
# limit resumes the saved session. Runs in the background; it writes the final
# status itself, so it outlives a runner restart.
job_run() {
  local d="$1" rc=0 result st note="" t reset r p="$1/prompt.md"
  date '+%F %T' >"$d/started"
  r="$(jget "$d/job" review)"
  if [[ "$r" == verify ]]; then
    job_verify "$d"
    return 0
  elif [[ -n "$r" ]]; then
    job_review "$d"
    return 0
  fi
  t="$(job_timeout "$d")"
  : >"$d/log"
  if [[ -n "$(jget "$d/job" tool)" ]]; then
    tool_job "$d" || return 0
    p="$d/close.md"
  fi
  job_agent "$d" "$t" "$p" "$(jstate "$d" session)" || rc=$?
  job_session "$d"
  if stopped "$d"; then return 0; fi
  result="$(jstate "$d" result)"
  reset="$(limit_reset "$d/log")"
  if [[ -n "$reset" && "$result" != "done:"* ]]; then
    # A usage limit: requeue, keep the worktree, start nothing until the reset.
    echo "$reset" >"$QROOT/limit"
    echo queued >"$d/status"
    echo "usage limit — retry after $(at_time "$reset")" >"$d/note"
    rm -f "$d/pid"
    return 0
  fi
  if ((rc == 124)); then
    st=timeout note="stopped after $t"
    job_handoff "$d"
    result="$(jstate "$d" result)"
  elif ((rc == 137)); then
    st=failed result="" note="agent killed (SIGKILL): past its memory cap (${MEM_MAX:-none}), or oomd"
  elif ((rc != 0)); then
    st=failed note="agent exit $rc: $(tail -n 1 "$d/log" 2>/dev/null | cut -c 1-160 || true)"
  else
    case "$result" in
      "done:"*) st="done" ;;
      "blocked:"*) st=blocked ;;
      "queued:"*) st=gpu ;;
      *) st=failed note="no result line" ;;
    esac
  fi
  if stopped "$d"; then return 0; fi
  case "$st" in failed | blocked | timeout) lane_leave "$d" "$st" || true ;; esac
  if [[ "$st" == "done" ]] && review_due "$d" && review_follow "$d" 1; then
    :
  else
    job_gate "$d" || true
    # A stop during the gate: the gate runs out, then nothing is pushed.
    if stopped "$d"; then return 0; fi
    job_publish "$d" "$st" || true
  fi
  job_end "$d" "$st" "${result:-$note}"
  if [[ "$st" == "done" ]]; then job_chain "$d"; fi
}

# agent_check AGENT — dies unless <agent>/vibe-job.sh exists.
agent_check() {
  [[ -n "$1" && "$1" != */* && -f "$SELF_ROOT/$1/vibe-job.sh" ]] ||
    die "no job runner for '$1' — $SELF_ROOT/$1/vibe-job.sh is missing"
}

# queue_order JOB... — the jobs that may start now, in start order: --now
# jobs, then the rest. Paused or limited: none.
queue_order() {
  local d now=() rest=()
  [[ ! -e "$QROOT/paused" ]] || return 0
  if limited; then return 0; fi
  for d in "$@"; do
    if [[ "$(jget "$d/job" now)" == 1 ]]; then
      now+=("$d")
    else
      rest+=("$d")
    fi
  done
  for d in "${now[@]+"${now[@]}"}" "${rest[@]+"${rest[@]}"}"; do echo "$d"; done
}

# branch_key JOB — repo and branch: one running job per branch.
branch_key() { echo "$(jget "$1/job" repo)#$(jget "$1/job" branch)"; }

# mem_setup — MEM_CMD and MEM_MAX: every agent and gate runs in its own systemd
# scope capped at memory_max (queue.conf; default 100% ÷ slots, read at start), so a
# job past its cap, or the one oomd picks, dies alone instead of vibe-queue.service.
# No user manager (macOS, a container): no cap, no scope.
mem_setup() {
  local slots
  slots="$(qconf slots 4)"
  ((slots > 0)) || slots=1
  MEM_MAX="$(qconf memory_max "$((100 / slots))%")"
  MEM_CMD=(systemd-run --user --scope --quiet --collect -p "MemoryMax=$MEM_MAX" -p MemorySwapMax=0)
  if command -v systemd-run >/dev/null 2>&1 && "${MEM_CMD[@]}" true >/dev/null 2>&1; then
    info "memory cap per job: $MEM_MAX"
  else
    MEM_CMD=() MEM_MAX=""
    warn "no systemd user manager — jobs run without a memory cap"
  fi
}

# vibe queue run --<agent> [--drain] — the runner: polls the queue for ever and
# starts jobs in free slots (config slots, 4). --drain stops
# once nothing runs, waits on the GPU or may start.
cmd_queue_run() {
  local drain=0 d pid apid running waiting slots busy started queued=() order gpu_tool
  AGENT=""
  while (($#)); do
    case "$1" in
      --drain) drain=1 ;;
      -h | --help) usage ;;
      --?*)
        [[ -z "$AGENT" ]] || die "one agent only"
        AGENT="${1#--}"
        ;;
      *) die "usage: vibe queue run --<agent> [--drain], e.g. --claude" ;;
    esac
    shift
  done
  [[ -n "$AGENT" ]] || die "usage: vibe queue run --<agent> [--drain], e.g. --claude"
  agent_check "$AGENT"
  mkdir -p "$QDIR"
  TIMEOUT_CMD=()
  if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(timeout --kill-after=60)
  elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(gtimeout --kill-after=60)
  else
    warn "no timeout(1) — jobs run without a time limit"
  fi
  mem_setup
  info "queue $QDIR: $(qconf slots 4) slots"
  while :; do
    queue_web || warn "queue page not written: $QROOT/web/index.html"
    ws_tick_bg
    # Before the scan: a follow-up a place run makes this pass is in it.
    for d in "$QDIR"/*/; do place_pass "${d%/}"; done
    running=0 waiting=0 busy="" queued=() gpu_tool=0
    for d in "$QDIR"/*/; do
      d="${d%/}"
      [[ -f "$d/job" ]] || continue
      case "$(jstate "$d" status)" in
        running)
          pid="$(jstate "$d" pid)"
          if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            running=$((running + 1)) busy+=" $(branch_key "$d")"
            if tool_gpu "$d"; then gpu_tool=1; fi
            # vibe queue stop: TERM the agent; job_run then ends the job.
            # agent-pid is agent-writable: only a positive pid, else `kill 0` TERMs the runner's own group.
            apid="$(jstate "$d" agent-pid)"
            if [[ -e "$d/stop" && "$apid" =~ ^[1-9][0-9]*$ ]]; then kill "$apid" 2>/dev/null || true; fi
          elif stopped "$d"; then
            :
          elif [[ ! -e "$d/requeued" ]]; then
            # Died once (oomd, reboot): run again in its own worktree, one time.
            date '+%F %T' >"$d/requeued"
            echo queued >"$d/status"
            echo "job process died — re-queued once" >"$d/note"
            rm -f "$d/pid"
            queued+=("$d")
          else
            job_end "$d" failed "job process died twice"
          fi
          ;;
        "done")
          # `queue follow` marked a job that still published; its process died before `job_end`.
          if [[ -s "$d/pid" && ! -e "$d/ended" ]] && ! kill -0 "$(jstate "$d" pid)" 2>/dev/null; then
            job_end "$d" "done" "$(jstate "$d" note)"
          fi
          ;;
        gpu) waiting=$((waiting + 1)) ;;
        "" | queued)
          if follow_ready "$d" && at_due "$d"; then queued+=("$d"); else waiting=$((waiting + 1)); fi
          ;;
      esac
    done
    order="$(queue_order "${queued[@]+"${queued[@]}"}")"
    if ((drain && running == 0 && waiting == 0)) && [[ -z "$order" ]]; then break; fi
    slots="$(qconf slots 4)"
    started=0
    while IFS= read -r d; do
      [[ -n "$d" ]] || continue
      ((running < slots)) || break
      [[ " $busy " != *" $(branch_key "$d") "* ]] || continue
      # One GPU tool run at a time: the next waits queued, not in a slot inside `gpu-queue lock`.
      # shortcut: a GPU run outside the queue still makes that one wait in its slot; cap it if that bites.
      if ((gpu_tool)) && tool_gpu "$d"; then continue; fi
      echo running >"$d/status"
      (job_prepare "$d") >>"$d/runner.log" 2>&1 || true
      if [[ "$(jstate "$d" status)" != running || ! -s "$d/worktree" ]]; then
        [[ "$(jstate "$d" status)" != running ]] || job_end "$d" failed "prepare failed — see runner.log"
        continue
      fi
      job_run "$d" >>"$d/runner.log" 2>&1 &
      echo "$!" >"$d/pid"
      running=$((running + 1)) busy+=" $(branch_key "$d")" started=1
      if tool_gpu "$d"; then gpu_tool=1; fi
      info "started ${d##*/}"
    done <<<"$order"
    # A drain whose only startable jobs wait on a busy branch must not spin.
    if ((drain && running == 0 && waiting == 0 && !started)); then break; fi
    sleep "${VIBE_QUEUE_POLL:-30}"
  done
  info "queue drained"
}

# queue_job ID — the job dir of ID (an id or a path); dies when absent.
queue_job() {
  local d="${1%/}"
  [[ "$d" == */* ]] || d="$QDIR/$d"
  [[ -f "$d/job" ]] || die "no job $1 in $QDIR"
  echo "$d"
}

# vibe queue hold ID NOTE... — keep a finished job unreviewed, first in every report.
cmd_queue_hold() {
  local d
  (($# >= 2)) || die "usage: vibe queue hold <id> <note>"
  d="$(queue_job "$1")"
  shift
  echo "$*" >"$d/held"
  echo "held ${d##*/}"
}

# vibe queue archive ID... — move reviewed jobs to archive/<YYYY-MM>/.
cmd_queue_archive() {
  local d a
  (($#)) || die "usage: vibe queue archive <id>..."
  a="$QROOT/archive/$(date +%Y-%m)"
  for d in "$@"; do
    d="$(queue_job "$d")"
    job_settled "$d" || die "${d##*/} has not ended ($(jstate "$d" status)) — archive it once it has"
    mkdir -p "$a"
    mv "$d" "$a/"
    echo "archived ${d##*/}"
  done
}

cmd_queue_pause() {
  mkdir -p "$QROOT"
  touch "$QROOT/paused"
  echo "paused: no new job starts; running jobs finish"
}
cmd_queue_resume() {
  rm -f "$QROOT/paused"
  echo "resumed"
}
# vibe queue unlimit — forget the usage limit: jobs start again.
cmd_queue_unlimit() {
  rm -f "$QROOT/limit"
  echo "usage limit cleared"
}

# vibe queue conf KEY=VALUE — set one queue.conf key; refuses an unknown key or a bad value.
cmd_queue_conf() {
  local k v re f="$QCONF/queue.conf"
  [[ $# == 1 && "$1" == *=* ]] || die "usage: vibe queue conf <key>=<value>"
  k="${1%%=*}" v="${1#*=}"
  case "$k" in
    slots) re='^[1-9][0-9]?$' ;;
    after) re='^(review|code)?$' ;;
    review_rounds) re='^[0-9]$' ;;
    review_trivial) re='^[0-9]{1,5}$' ;;
    review_model) re='^[a-z][a-z0-9.-]*$' ;;
    review_level) re='^(low|medium|high|xhigh|max)$' ;;
    review_timeout) re='^[1-9][0-9]*[smhd]?$' ;;
    memory_max) re='^([1-9][0-9]*[KMGT%]?|infinity)$' ;;
    steer) re='^[01]?$' ;;
    *) die "unknown key '$k' — slots after review_rounds review_trivial review_model review_level review_timeout memory_max steer" ;;
  esac
  [[ "$v" =~ $re ]] || die "bad value for $k: '$v'"
  mkdir -p "$QCONF"
  {
    grep -v "^$k=" "$f" 2>/dev/null || true
    echo "$k=$v"
  } >"$f.tmp.$$"
  mv -f "$f.tmp.$$" "$f"
  echo "$k=$v"
}

# is_queued JOB — true while the job waits to start.
is_queued() {
  case "$(jstate "$1" status)" in "" | queued) return 0 ;; esac
  return 1
}

# vibe queue set ID now=1|after= — a queued job: start it next, or with no review.
cmd_queue_set() {
  local d
  [[ $# == 2 && ("$2" == now=1 || "$2" == after=) ]] || die "usage: vibe queue set <id> now=1|after="
  d="$(queue_job "$1")"
  is_queued "$d" || die "${d##*/} is $(jstate "$d" status), not queued"
  {
    grep -v "^${2%%=*}=" "$d/job" || true
    echo "$2"
  } >"$d/job.tmp.$$"
  mv -f "$d/job.tmp.$$" "$d/job"
  echo "${d##*/}: $2"
}

# vibe queue retry ID — a failed, timeout or skipped job again as a new job (job,
# prompt.md, its own worktree); the old one is archived.
cmd_queue_retry() {
  local d tmp n
  [[ $# == 1 ]] || die "usage: vibe queue retry <id>"
  d="$(queue_job "$1")"
  case "$(jstate "$d" status)" in failed | timeout | skipped) ;; *) die "${d##*/} is $(jstate "$d" status) — retry takes failed, timeout or skipped" ;; esac
  [[ -f "$d/prompt.md" ]] || die "no prompt.md in ${d##*/}"
  if [[ -z "$(jget "$d/job" repo)" ]] || ! branch_ok "$(jget "$d/job" branch)"; then die "bad repo or branch in ${d##*/}"; fi
  # follow_dir: a failed review round comes back as an agent job with its base job's timeout.
  tmp="$(follow_dir "$d")"
  # Its own worktree: job_prepare then takes the job's own uncommitted work.
  if [[ -f "$d/worktree" ]]; then cp "$d/worktree" "$tmp/worktree"; fi
  n="$(queue_add "$tmp")"
  cmd_queue_archive "$d" >/dev/null
  echo "queued ${n##*/}; archived ${d##*/}"
}

# vibe queue cancel ID — a queued job ends skipped, note cancelled.
cmd_queue_cancel() {
  local d
  [[ $# == 1 ]] || die "usage: vibe queue cancel <id>"
  d="$(queue_job "$1")"
  is_queued "$d" || die "${d##*/} is $(jstate "$d" status), not queued — stop takes a running job"
  job_end "$d" skipped cancelled
  echo "cancelled ${d##*/}"
}

# vibe queue stop ID — the runner stops a running job on its next pass: failed, note
# stopped; no requeue, no publish. A tool job's run: the job's process stops it (tool_run).
cmd_queue_stop() {
  local d
  [[ $# == 1 ]] || die "usage: vibe queue stop <id>"
  d="$(queue_job "$1")"
  [[ "$(jstate "$d" status)" == running ]] || die "${d##*/} is $(jstate "$d" status), not running — cancel takes a queued job"
  date '+%F %T' >"$d/stop"
  echo "stop asked: the runner ends ${d##*/} on its next pass"
}

# vibe queue steer ID TEXT... — TEXT to a running job's session (its FIFO, steer=1), else to the
# steer script of a tool job whose run is up; each takes it at its next boundary.
cmd_queue_steer() {
  local d inst r=0
  (($# >= 2)) || die "usage: vibe queue steer <id> <text>"
  d="$(queue_job "$1")"
  shift
  [[ -n "$*" ]] || die "usage: vibe queue steer <id> <text>" # an empty text ends the session's input
  if [[ "$(jstate "$d" status)" == running && -p "$d/steer" ]]; then
    printf '%s\0' "$*" 1<>"$d/steer" # read-write: no wait for a reader
    echo "steered ${d##*/}"
    return 0
  fi
  [[ -n "$(jget "$d/job" tool)" ]] || die "${d##*/} takes no steer now — its session needs steer=1 in queue.conf at start"
  inst="$(tool_inst "$d")"
  [[ "$(jstate "$d" status)" == running && -s "$WS_STATES/$inst/id" ]] || die "the tool of ${d##*/} does not run now"
  WS_HOURS="$(tool_hours "$d")" ws_place "$inst" exec steer "$*" || r=$?
  if ((r == 3)); then die "$(jget "$d/job" tool): steer not supported"; fi
  ((r == 0)) || die "steer of $inst failed (exit $r)"
  echo "steered $inst"
}

# branch_idle JOB — dies while a job on JOB's repo and branch is queued or running.
branch_idle() {
  local j s
  while IFS= read -r j; do
    s="$(jstate "$j" status)"
    case "$s" in "" | queued | running | gpu) die "${j##*/} on $(jget "$1/job" branch) is ${s:-queued} — wait until it ends" ;; esac
  done < <(branch_jobs "$(jget "$1/job" repo)" "$(jget "$1/job" branch)")
}

# follow_dir JOB — a fresh dir with JOB's job (no now=, at=, follow=, review=), prompt.md and in/; echoes it.
# A review round or the verify step gets its base job's timeout back: an agent job, not a review.
follow_dir() {
  local tmp r t
  [[ -f "$1/prompt.md" ]] || die "no prompt.md in ${1##*/}"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-job.XXXXXX")"
  r="$(jget "$1/job" review)"
  if [[ -z "$r" ]]; then
    grep -Ev '^(now|at|follow)=' "$1/job" >"$tmp/job" || true
  else
    grep -Ev '^(now|at|follow|review|timeout)=' "$1/job" >"$tmp/job" || true
    t="$(jget "$(review_base "$1")/job" timeout)"
    if [[ -n "$t" ]]; then echo "timeout=$t" >>"$tmp/job"; fi
  fi
  cp "$1/prompt.md" "$tmp/prompt.md"
  if [[ -d "$1/in" ]]; then cp -R "$1/in" "$tmp/in"; fi
  echo "$tmp"
}

# task_append PROMPT LINE... — the lines end the `## Task` section of PROMPT.
task_append() {
  local f="$1" t
  shift
  t="$(mktemp "$f.XXXXXX")" && ADD="$(printf '%s\n' "$@")" awk '
    function put() { if (!t) { print ENVIRON["ADD"]; print ""; t = 1 } }
    s && /^## / { put() }
    { print }
    $0 == "## Task" { s = 1 }
    END { if (s) put(); else { print ""; print ENVIRON["ADD"] } }' "$f" | awk 'NF || !b { print } { b = !NF }' >"$t" && mv -f "$t" "$f"
}

# vibe queue answer ID TEXT... — /review-jobs' requeue: the answer in place of Next action and Blockers of the job's HANDOFF.md (commit,
# push) or, for a lane side job, in a retry prompt; a follow-up job is queued, the original archived.
cmd_queue_answer() {
  local d tmp side item n st text wt branch t
  (($# >= 2)) || die "usage: vibe queue answer <id> <answer>"
  d="$(queue_job "$1")"
  shift
  text="$*" side="$(jstate "$d" side)" branch="$(jget "$d/job" branch)"
  st="$(jstate "$d" status)"
  case "$st" in blocked | failed | timeout) ;; *) die "${d##*/} is ${st:-queued} — answer takes blocked, failed or timeout" ;; esac
  if [[ -z "$side" ]]; then
    branch_idle "$d"
    wt="$(jstate "$d" worktree)"
    [[ -f "$wt/HANDOFF.md" ]] || die "no HANDOFF.md in the worktree ${wt:-of the job} — retry takes a job without one"
    t="$(mktemp "$wt/HANDOFF.md.XXXXXX")"
    ANS="Answer: $text" awk '
      /^## / { s = ($0 == "## Next action" || $0 == "## Blockers"); if (s) { print; print ""; print ENVIRON["ANS"]; print ""; f = 1; next } }
      !s { print }
      END { if (!f) { print ""; print "## Blockers"; print ""; print ENVIRON["ANS"] } }' "$wt/HANDOFF.md" >"$t"
    mv -f "$t" "$wt/HANDOFF.md"
    if ! git -C "$wt" diff --quiet -- HANDOFF.md; then
      git -C "$wt" commit -q -m "docs(handoff): ${d##*/} unblocked" -- HANDOFF.md || die "commit in $wt failed"
    fi
    git -C "$wt" push -q origin "HEAD:refs/heads/$branch" || die "push of $branch failed"
    tmp="$(follow_dir "$d")"
    cp "$d/worktree" "$tmp/worktree"
  else
    tmp="$(follow_dir "$d")"
    item="$(job_item "$d")"
    group_of "$d"
    st=""
    if [[ "$G_PR" == http* ]]; then st="$(gh pr view "$G_PR" --json state -q .state)" || die "gh pr view $G_PR failed"; fi
    # The lane PR open: the item joins the lane again; else a new branch from the default branch.
    if [[ "$st" != OPEN ]]; then
      grep -Ev '^(branch|lane|item)=' "$tmp/job" >"$tmp/job.new" || true
      echo "branch=$branch-$item-retry" >>"$tmp/job.new"
      mv -f "$tmp/job.new" "$tmp/job"
    fi
    task_append "$tmp/prompt.md" "Earlier try: git diff $(jstate "$d" start)..$side. Do not merge it." "Answer: $text"
  fi
  # A tool run with a result: the follow-up closes that run again (tool_job), no new run; close.md: no new merge.
  if [[ -s "$d/out/result" ]]; then cp -R "$d/out" "$d/tool-exit" "$d/tool.log" "$tmp/"; fi
  if [[ -f "$d/close.md" ]]; then cp "$d/close.md" "$tmp/"; fi
  n="$(queue_add "$tmp")"
  cmd_queue_archive "$d" >/dev/null
  echo "queued ${n##*/}; archived ${d##*/}"
}

# vibe queue fix URL TEXT... — a follow-up job on the branch of the PR at URL (its newest job,
# queued or archived) with TEXT as the task; refuses while a job on that branch is queued or running.
# VIBE_EVENT (triage_fix): the PR event the job answers, as `event=` in its job file.
cmd_queue_fix() {
  local url="${1:-}" d tmp n
  (($# >= 2)) || die "usage: vibe queue fix <pr-url> <what to fix>"
  shift
  d="$(grep -lxF -- "$url" "$QDIR"/*/pr "$QROOT"/archive/*/*/pr 2>/dev/null | awk -F/ '{ print $(NF - 1) "\t" $0 }' | sort | awk -F'\t' 'END { print $2 }' || true)"
  [[ -n "$d" ]] || die "no job has PR $url"
  d="${d%/pr}"
  branch_idle "$d"
  tmp="$(follow_dir "$d")"
  # A fix on a tool job's PR is agent work on its branch: no tool run.
  grep -Ev '^(item|event|tool)=' "$tmp/job" >"$tmp/job.new" || true
  if [[ -n "${VIBE_EVENT:-}" ]]; then echo "event=$VIBE_EVENT" >>"$tmp/job.new"; fi
  mv -f "$tmp/job.new" "$tmp/job"
  task_append "$tmp/prompt.md" "Fix on $url (the task above is done; do only this): $*"
  n="$(queue_add "$tmp")"
  echo "queued ${n##*/}"
}

# pr_check URL — dies when the PR at URL has a failing check or SPEC.md, RESEARCH.md or HANDOFF.md in its diff.
pr_check() {
  local c f
  c="$(gh pr view "$1" --json statusCheckRollup -q '.statusCheckRollup[] | if (.conclusion // "") != "" then .conclusion else (.state // .status // "") end')" || die "gh pr view $1 failed"
  if grep -qxE 'FAILURE|ERROR|CANCELLED|TIMED_OUT|ACTION_REQUIRED|STARTUP_FAILURE' <<<"$c"; then die "$1 has a failing check"; fi
  f="$(gh pr diff "$1" --name-only)" || die "gh pr diff $1 failed"
  if grep -qxE 'SPEC\.md|RESEARCH\.md|HANDOFF\.md' <<<"$f"; then die "$1 still holds SPEC.md, RESEARCH.md or HANDOFF.md"; fi
}

# vibe queue ready URL...|--feature SLUG — check every PR first, then mark each ready.
# --feature: the member PRs of a feature in `your test`, then `vibe feature ready`.
cmd_queue_ready() {
  local u r b p urls=()
  if [[ "${1:-}" == --feature ]]; then
    [[ $# == 2 && -f "$FROOT/$2.md" ]] || die "usage: vibe queue ready --feature <slug> (a feature in $FROOT)"
    feature_row "$FROOT/$2.md"
    [[ "$F_PILL" == "your test" ]] || die "feature $2 is $F_PILL — ready takes 'your test'"
    while IFS='|' read -r r b p _; do
      [[ -n "$r" ]] || continue
      [[ "$p" == http* ]] || die "${r##*/} $b has no PR"
      urls+=("$p")
    done <<<"$F_MEMBERS"
  else
    (($#)) || die "usage: vibe queue ready <pr-url>...|--feature <slug>"
    urls=("$@")
  fi
  for u in "${urls[@]}"; do pr_check "$u"; done
  for u in "${urls[@]}"; do
    gh pr ready "$u" >/dev/null || die "gh pr ready $u failed"
    echo "ready $u"
  done
  if [[ "$1" == --feature ]]; then cmd_feature_ready "$2"; fi
}

# vibe queue merge-order REPO — REPO's open non-draft PRs, smallest diff first; each names the later PRs
# that touch one of its files (they can conflict after it merges).
cmd_queue_merge_order() {
  local prs n files=""
  if [[ $# != 1 ]] || ! git -C "$1" rev-parse --git-dir >/dev/null 2>&1; then die "usage: vibe queue merge-order <repo>"; fi
  prs="$(cd "$1" && gh pr list --state open --limit 1000 --json number,isDraft,additions,deletions \
    -q '.[] | select(.isDraft | not) | "\(.additions + .deletions)\t\(.number)"')" || die "gh pr list failed in $1"
  if [[ -z "$prs" ]]; then
    echo "no ready PR in ${1##*/}"
    return 0
  fi
  prs="$(sort -n -k1,1 -k2,2 <<<"$prs")"
  while IFS=$'\t' read -r _ n; do
    files+="$(cd "$1" && gh pr diff "$n" --name-only | awk -v n="$n" '{ print n "\t" $0 }')"$'\n' || die "gh pr diff $n failed in $1"
  done <<<"$prs"
  printf '%s\n\n%s' "$prs" "$files" | awk -F'\t' '
    !NF { f = 1; next }
    !f { o[++k] = $2; sz[$2] = $1; next }
    { has[$1, $2] = 1; fl[$1] = fl[$1] SUBSEP $2 }
    END {
      for (i = 1; i <= k; i++) {
        c = ""; m = split(substr(fl[o[i]], 2), x, SUBSEP)
        for (j = i + 1; j <= k; j++) for (y = 1; y <= m; y++) if (has[o[j], x[y]]) { c = c (c ? ", " : "") "#" o[j]; break }
        printf "%d. #%s — %s lines%s\n", i, o[i], sz[o[i]], (c ? " — can conflict: " c : "")
      }
    }'
}

# roadmap_head REPO — origin's default branch tip, fetched now.
roadmap_head() {
  git -C "$1" fetch -q origin 2>/dev/null || warn "${1##*/}: fetch failed"
  git -C "$1" rev-parse -q --verify "origin/$(default_branch "$1")^{commit}" || die "no origin/$(default_branch "$1") in ${1##*/}"
}

# roadmap_items REPO REV — `<line><TAB><text>` per open top-level item of PROJECT_ROADMAP.md at REV;
# continuation lines join the text.
roadmap_items() {
  local md
  md="$(git -C "$1" show "$2:PROJECT_ROADMAP.md" 2>/dev/null)" || die "no PROJECT_ROADMAP.md at ${2:0:7} in ${1##*/}"
  awk '
    function flush() { if (n) print n "\t" t; n = 0 }
    /^- \[ \] / { flush(); n = NR; t = substr($0, 7); next }
    n && /^[ \t]+[^ \t]/ { s = $0; sub(/^[ \t]+/, "", s); t = t " " s; next }
    { flush() }
    END { flush() }' <<<"$md"
}

# roadmap_pin REPO — the file that holds the origin commit `vibe queue roadmap` listed last for REPO.
roadmap_pin() { echo "$QROOT/roadmap/$(printf '%s' "$1" | tr / %)"; }

# vibe queue roadmap [--full] REPO — REPO's open roadmap items on origin: `<line>: <title>`, with --full `<line>: <item>`; `new --line` reads this listing.
cmd_queue_roadmap() {
  local items head pin full=0
  if [[ "${1:-}" == --full ]]; then full=1 && shift; fi
  [[ $# == 1 && -d "$1" ]] || die "usage: vibe queue roadmap [--full] <repo>"
  head="$(roadmap_head "$1")" || exit 1
  items="$(roadmap_items "$1" "$head")" || exit 1
  pin="$(roadmap_pin "$(cd "$1" && pwd)")"
  mkdir -p "${pin%/*}"
  echo "$head" >"$pin"
  [[ -n "$items" ]] || {
    echo "no open roadmap item in ${1##*/}"
    return 0
  }
  if ((full)); then
    awk -F'\t' '{ print $1 ": " $2 }' <<<"$items"
    return 0
  fi
  awk -F'\t' '{ t = $2; if (match(t, /^\*\*[^*]+\*\*/)) t = substr(t, 3, RLENGTH - 4); else if (length(t) > 80) t = substr(t, 1, 80) "…"; print $1 ": " t }' <<<"$items"
}

# vibe queue new [--now] [--model M] [--timeout T] [--kind code|gpu] REPO BRANCH DONE-WHEN TASK...
#   | --line N REPO BRANCH | --opt-in JOB REPO — a job from skills/fill-queue/references/job-prompt.md:
# a task, the roadmap item at line N on origin, or a job that opts REPO into recurring JOB.
# Refuses no done-when and a branch with a queued or running job.
cmd_queue_new() {
  local first=0 model=sonnet timeout=2h kind=code line="" optin="" repo branch dw task source=new title tmp n head pin
  local use="usage: vibe queue new [--now] [--model M] [--timeout T] [--kind code|gpu] <repo> <branch> <done-when> <task>... | --line <n> <repo> <branch> | --opt-in <job> <repo>"
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --now) first=1 ;;
      --model) model="${2:-}" && shift ;;
      --timeout) timeout="${2:-}" && shift ;;
      --kind) kind="${2:-}" && shift ;;
      --line) line="${2:-}" && shift ;;
      --opt-in) optin="${2:-}" && shift ;;
      *) die "$use" ;;
    esac
    shift
  done
  [[ "$model" =~ ^[a-z][a-z0-9.-]*$ && "$timeout" =~ ^[1-9][0-9]*[smhd]?$ && "$kind" =~ ^(code|gpu)$ ]] || die "bad --model, --timeout or --kind"
  if [[ -n "$optin" ]]; then
    (($# == 1)) || die "$use"
    [[ -f "$JOBS_CATALOGUE/$optin.md" && "$optin" != _* ]] || die "no recurring job '$optin' in the catalogue"
    repo="$1" branch="opt-in-$optin"
    task="Opt this repo into the recurring job \`$optin\`: run \`vibe job add \"\$PWD\" $optin\` in the worktree root, keep or change each key for this repo, write its instructions, commit. Catalogue entry: \`$JOBS_CATALOGUE/$optin.md\`."
    dw="\`git show HEAD:.vibe-jobs/$optin.md\` succeeds and \`vibe job list \"\$PWD\"\` shows \`$optin\`, not invalid"
  elif [[ -n "$line" ]]; then
    if (($# != 2)) || [[ ! "$line" =~ ^[1-9][0-9]*$ ]]; then die "$use"; fi
    repo="$1" branch="$2"
    [[ -d "$repo" ]] || die "no directory $repo"
    head="$(roadmap_head "$repo")" || exit 1
    # Line N of the listing you read, not of origin now: a merge that deletes an item above shifts the lines.
    pin="$(head -n 1 "$(roadmap_pin "$(cd "$repo" && pwd)")" 2>/dev/null || true)"
    task="$(roadmap_items "$repo" "${pin:-$head}" | awk -F'\t' -v n="$line" '$1 == n { print $2 }')" || exit 1
    [[ -n "$task" ]] || die "no open roadmap item at line $line of ${repo##*/}"
    line="$(roadmap_items "$repo" "$head" | T="$task" awk -F'\t' '!f && $2 == ENVIRON["T"] { print $1; f = 1 }')" || exit 1
    [[ -n "$line" ]] || die "the item changed or left origin since the listing: run vibe queue roadmap again"
    dw="$(sed -nE 's/.*[Dd]one when:? *//p' <<<"$task")"
    source="\`PROJECT_ROADMAP.md:$line\`"
  else
    (($# >= 4)) || die "$use"
    repo="$1" branch="$2" dw="$3"
    shift 3
    task="$*"
  fi
  [[ -n "$dw" ]] || die "no done-when: a job needs one"
  repo="$(job_repo_path "$repo")"
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "no git repo at $repo"
  repo="$(cd "$repo" && pwd)"
  branch_ok "$branch" || die "bad branch '$branch': a slug"
  if [[ -n "$optin" && -e "$repo/.vibe-jobs/$optin.md" ]]; then die "${repo##*/} already has .vibe-jobs/$optin.md"; fi
  title="$(sed -nE 's/^\*\*([^*]+)\*\*.*/\1/p' <<<"$task")"
  if [[ -z "$title" ]]; then title="${task:0:80}"; fi
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-job.XXXXXX")"
  printf 'repo=%s\nbranch=%s\nmodel=%s\ncontext=%s\ntimeout=%s\n' "$repo" "$branch" "$model" "$title" "$timeout" >"$tmp/job"
  (branch_idle "$tmp") || {
    rm -rf "$tmp"
    exit 1
  }
  # shellcheck disable=SC2016  # a literal template slot
  render_template "$SELF_ROOT/skills/fill-queue/references/job-prompt.md" \
    '<task title>' "$title" \
    '<task, verbatim from its source>' "$task" \
    '<context>' "$title" \
    '<done-when>' "$dw" \
    '<one of: `PROJECT_ROADMAP.md:<line>` · `HANDOFF.md` next action · new>' "$source" \
    '<code | gpu>' "$kind" \
    '<repo>' "$repo" \
    '<branch>' "$branch" \
    '<timeout>' "$timeout" \
    '<the pr template, verbatim>' "$(cat "$SELF_ROOT/templates/job-pr.md")" \
    '<the report template, verbatim>' "$(cat "$SELF_ROOT/templates/job-report.md")" >"$tmp/prompt.md"
  n="$(queue_add "$tmp" "$first")"
  echo "queued ${n##*/}"
}

cmd_queue_page() {
  queue_web || die "queue page not written: $QROOT/web/index.html"
  echo "wrote $QROOT/web/index.html"
}

# vibe queue gpu [--place P] -- CMD... — from inside a job: queue CMD on the GPU
# (cwd: the worktree); when it ends, a follow-up job continues the task.
# --place runpod|vast: the runner runs CMD there in the repo's .claude/research/ (place_run).
# Past the job's deadline= it queues nothing: the hard stop of a research job's budget.
cmd_queue_gpu() {
  local d="${VIBE_JOB_DIR:-}" id dl p="" u="usage: vibe queue gpu [--place P] -- CMD..."
  [[ -n "$d" && -f "$d/job" ]] || die "vibe queue gpu runs inside a queue job (VIBE_JOB_DIR)"
  case "${1:-}" in --place=*) set -- --place "${1#*=}" "${@:2}" ;; esac
  if [[ "${1:-}" == --place ]]; then
    (($# >= 2)) || die "$u"
    p="$2"
    shift 2
  fi
  case "${1:-}" in
    -h | --help) usage ;;
    --) shift ;;
    -*) die "$u" ;;
  esac
  (($#)) || die "$u"
  dl="$(deadline_of "$d/job")" || exit 1
  if [[ -n "$dl" ]] && (($(date +%s) >= dl)); then
    die "past this job's deadline ($(jget "$d/job" deadline)): queue no run, finish the task"
  fi
  if [[ -n "$p" && "$p" != turing ]]; then
    place_queue "$d" "$p" "$@"
    return 0
  fi
  id="$("$SELF_ROOT/bin/gpu-queue" submit --name "${d##*/}" --dir "$PWD" \
    --then "$(printf '%q ' "$SELF_ROOT/bin/vibe" queue follow "$d")" -- "$@")" || die "gpu-queue submit failed"
  echo "$id" >"$d/gpu-job"
  echo "queued $id — now write result 'queued: <what runs>' and exit"
}

# place_queue JOB PLACE CMD... — vibe queue gpu --place: JOB/run/ gets place, commit (the worktree's HEAD) and cmd
# (CMD as a bash script); the runner's pass starts the run (place_pass). One error line when the folder cannot run there.
place_queue() {
  local d="$1" p="$2" wt f=.claude/research c t
  shift 2
  wt="$(jstate "$d" worktree)"
  c="$wt/$f/workspace.conf"
  [[ -d "$wt/$f" ]] || die "no $f/ in $wt: --place $p runs the repo's research folder — docs/vibe-queue.md#research-jobs"
  t="$(ws_check "$wt/$f")"
  [[ "$t" == ok ]] || die "$f/workspace.conf: $t"
  [[ "$(jget "$c" kind) $(jget "$c" result)" == "run folder" ]] || die "$f/workspace.conf needs kind=run and result=folder"
  [[ ",$(jget "$c" places)," == *",$p,"* ]] || die "$f/workspace.conf has no place '$p' — places=$(jget "$c" places)"
  [[ -n "$(jget "$c" hours)" ]] || die "$f/workspace.conf needs hours=: the limit of a run"
  [[ -n "$(jget "$c" image)" && -n "$(jget "$c" commit)" ]] || die "$f/workspace.conf needs image= and commit=: $p rents that image"
  [[ -x "$WS_ROOT/_places/$p" ]] || die "no place script '$p' in $WS_ROOT/_places"
  [[ -f "$wt/$f/run" && -x "$wt/$f/run" ]] || die "$f/run is missing or not executable: the place runs it"
  [[ -z "$(agent_git -C "$wt" status --porcelain -- "$f")" ]] || die "commit $f/ first: the run takes the worktree's HEAD"
  [[ ! -e "$d/run" ]] || die "this job queued its run already ($d/run): one run per session"
  t="$(mktemp -d "$d/.run.XXXXXX")"
  echo "$p" >"$t/place"
  agent_git -C "$wt" rev-parse HEAD >"$t/commit"
  printf '#!/usr/bin/env bash\n%s\n' "$(printf '%q ' "$@")" >"$t/cmd"
  mv "$t" "$d/run"
  echo "queued a run at $p — now write result 'queued: <what runs>' and exit"
}

# place_pass JOB — the runner pass for JOB/run/: start place_run once. A run whose process died before
# run/exit (a reboot) ends as infra; its instance goes down at its limit (vibe ws tick).
place_pass() {
  local d="$1" p
  if [[ ! -f "$d/job" || ! -f "$d/run/place" || -e "$d/run/exit" ]]; then return 0; fi
  p="$(jstate "$d/run" pid)"
  if [[ -z "$p" ]]; then
    place_run "$d" >>"$d/runner.log" 2>&1 &
    echo "$!" >"$d/run/pid"
  elif ! kill -0 "$p" 2>/dev/null && [[ ! -e "$d/run/exit" ]]; then
    echo "the run process died (a reboot?) — vibe ws status research-${d##*/}" >"$d/infra"
    echo infra >"$d/run/exit"
    (GPUQ_EXIT=infra GPUQ_LOG="$d/run/log" cmd_queue_follow "$d") >>"$d/runner.log" 2>&1 || true
  fi
}

# place_run JOB — JOB's run in instance research-<id>: in/repo holds run/commit alone (depth 1: no other branch
# leaves turing), in/cmd the command, in/repo/.claude/research/ the folder. The usd gate (place_gate), up, exec run
# until the stop bound before the limit, then exec stop, pull, down. All output to run/log; /ws/out to JOB/out/.
# A failed fetch, price or up writes JOB/infra; a refused start ends as usd. Then cost, run/exit and the follow-up.
place_run() {
  local d="$1" inst="research-${1##*/}" st lim secs stop="${VIBE_WS_STOP_SECS:-300}" rc=0 t0=""
  st="$WS_STATES/$inst"
  mkdir -p "$st/in"
  jstate "$d/run" place >"$st/place"
  echo "$st/in/repo/.claude/research" >"$st/dir"
  {
    cp "$d/run/cmd" "$st/in/cmd" && chmod +x "$st/in/cmd" &&
      agent_git init -q "$st/in/repo" &&
      agent_git -C "$st/in/repo" fetch -q --depth 1 "$(jstate "$d" worktree)" "$(jstate "$d/run" commit)" &&
      agent_git -C "$st/in/repo" checkout -q --detach FETCH_HEAD
  } >>"$d/run/log" 2>&1 || rc=infra
  if [[ "$rc" == 0 ]]; then place_gate "$d" "$inst" >>"$d/run/log" 2>&1 || rc=$?; fi
  case "$rc" in 1) rc=usd ;; 2) rc=infra ;; esac
  if [[ "$rc" == 0 ]]; then
    t0="$(date +%s)"
    ws_place "$inst" up >>"$d/run/log" 2>&1 || rc=infra
  fi
  if [[ "$rc" == infra ]]; then
    tail -n 1 "$d/run/log" >"$d/infra"
  elif [[ "$rc" == 0 ]]; then
    lim="$(jstate "$st" limit)" secs=""
    # The stop script runs before the limit: its RESULT line lands in run/log, not in a tick's log.
    if [[ "$lim" =~ ^[0-9]+$ ]]; then secs=$((lim - $(date +%s) - stop)); fi
    if [[ -n "$secs" ]] && ((secs < 1)); then secs=1; fi
    WS_SECS="$secs" ws_place "$inst" exec run >>"$d/run/log" 2>&1 || rc=$?
    if ((rc == 124)); then WS_SECS="$stop" ws_place "$inst" exec stop >>"$d/run/log" 2>&1 || true; fi
    ws_place "$inst" pull >>"$d/run/log" 2>&1 || true
    ws_place "$inst" down >>"$d/run/log" 2>&1 || echo "vibe: down of $inst failed — vibe ws status $inst" >>"$d/run/log"
  fi
  if [[ -d "$st/out" ]]; then
    rm -rf "$d/out"
    cp -R "$st/out" "$d/out" >>"$d/run/log" 2>&1 || true
    find "$d/out" ! -type f ! -type d -delete 2>/dev/null || rm -rf "$d/out"
  fi
  if [[ ! -s "$st/id" ]]; then
    # The instance is gone: cost is price × the time from up to now. A live one keeps hours × price (down at its limit).
    if [[ -n "$t0" ]]; then
      awk -v p="$(jstate "$d/run" price)" -v s=$(($(date +%s) - t0)) 'BEGIN { printf "%.2f\n", p * s / 3600 }' >"$d/cost"
    fi
    rm -rf "$st"
  fi
  echo "$rc" >"$d/run/exit"
  GPUQ_EXIT="$rc" GPUQ_LOG="$d/run/log" cmd_queue_follow "$d"
}

# place_gate JOB INST — run/price: the USD per hour of INST's place (its exit 3: 0). With usd= in JOB/job, a start
# is refused when spent (the cost of each live or archived job of JOB's research=) + hours × price is above usd.
# A start writes cost = hours × price: a run counts at its full hours while it runs. Exit 1: refused, 2: no price.
place_gate() {
  local d="$1" h p u r s=0 j rc=0 n=0 l="$QROOT/usd.lock"
  h="$(jget "$WS_STATES/$2/in/repo/.claude/research/workspace.conf" hours)"
  p="$(WS_SECS=60 ws_place "$2" price)" || rc=$?
  if ((rc == 3)); then
    p=0
  elif ((rc)) || [[ ! "$p" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "vibe: no price from $(jstate "$WS_STATES/$2" place) (exit $rc)${p:+: $p}"
    return 2
  fi
  echo "$p" >"$d/run/price"
  # One gate at a time: a run that starts in the same pass sees this one's cost. A lock held 10 s is stale.
  until mkdir "$l" 2>/dev/null; do
    n=$((n + 1))
    if ((n >= 50)); then
      rmdir "$l" 2>/dev/null || true
      n=0
    fi
    sleep 0.2
  done
  u="$(jget "$d/job" usd)" r="$(jget "$d/job" research)"
  if [[ -n "$r" ]]; then
    s="$(for j in "$QDIR"/*/ "$QROOT"/archive/*/*/; do
      if [[ "${j%/}" != "$d" && -s "${j}cost" && "$(jget "${j}job" research)" == "$r" ]]; then head -n 1 "${j}cost"; fi
    done | awk '{ s += $1 } END { printf "%.2f", s }')"
  fi
  if [[ -n "$u" ]] && ! awk -v s="$s" -v h="$h" -v p="$p" -v u="$u" 'BEGIN { exit !(s + h * p <= u) }'; then
    rmdir "$l" 2>/dev/null || true
    echo "usd gate: spent $s + $h h × $p USD/h is above usd=$u: no start"
    return 1
  fi
  awk -v h="$h" -v p="$p" 'BEGIN { printf "%.2f\n", h * p }' >"$d/cost"
  rmdir "$l" 2>/dev/null || true
}

# run_result LOG JOB — JOB/run-result: the json of LOG's last `RESULT {` line; none when it does not parse
# or its metric is no finite number.
run_result() {
  local j
  rm -f "$2/run-result"
  j="$(grep -a '^RESULT {' "$1" 2>/dev/null | tail -n 1)" || true
  # jq 1.7 reads NaN and Infinity as numbers: a diverged run must not pass.
  j="$(printf '%s' "${j#RESULT }" | jq -ce 'select(.metric | type == "number" and (isnan | not) and (isinfinite | not))' 2>/dev/null)" || j=""
  if [[ -n "$j" ]]; then echo "$j" >"$2/run-result"; fi
}

# follow_job FROM TO [KEY=value...] — TO/job: FROM's job file with follow=1, parent=FROM and the
# KEY=value lines (they replace FROM's), no tool=: a review round or a GPU follow-up runs no tool.
# Last, so the runner skips TO until it is whole.
follow_job() {
  local from="$1" to="$2" l keys="follow|parent|tool"
  shift 2
  for l in "$@"; do keys+="|${l%%=*}"; done
  {
    grep -Ev "^($keys)=" "$from/job" || true
    echo "follow=1"
    echo "parent=${from##*/}"
    for l in "$@"; do echo "$l"; done
  } >"$to/job"
}

# vibe queue follow JOB — gpu-queue's --then: a follow-up job on JOB's branch
# with the run's exit code and log (GPUQ_EXIT, GPUQ_LOG). It sorts right
# after JOB, so it runs before later jobs. GPUQ_EXIT=cancelled: JOB ends failed, no follow-up.
cmd_queue_follow() {
  local p="${1:?usage: vibe queue follow <job dir>}" f n=1 r=""
  p="${p%/}"
  [[ -f "$p/job" ]] || die "no job at $p"
  if [[ "${GPUQ_EXIT:-}" == cancelled ]]; then
    job_end "$p" failed "GPU run cancelled"
    return 0
  fi
  run_result "${GPUQ_LOG:-}" "$p"
  if [[ -s "$p/run-result" ]]; then
    r="$(cat "$p/run-result") ($p/run-result)"
  elif [[ "${GPUQ_EXIT:-}" == usd ]]; then
    r="none — $(tail -n 1 "$GPUQ_LOG")"
  elif [[ -n "$(jget "$p/job" research)" || -d "$p/run" ]]; then
    r="none — no RESULT line: the run failed"
  fi
  # turing and a run that never started cost 0 USD.
  if [[ -n "$(jget "$p/job" research)" && ! -s "$p/cost" ]]; then echo 0 >"$p/cost"; fi
  f="$p-gpu"
  while [[ -e "$f" ]]; do
    n=$((n + 1))
    f="$p-gpu$n"
  done
  mkdir -p "$f"
  {
    cat "$p/prompt.md"
    printf '\n## GPU run finished\n\n- Exit: %s\n- Log: %s\n' "${GPUQ_EXIT:-?}" "${GPUQ_LOG:-?}"
    if [[ -n "$r" ]]; then printf -- '- Result: %s\n' "$r"; fi
    if [[ -s "$p/infra" ]]; then printf -- '- Infra: %s\n' "$(head -n 1 "$p/infra")"; fi
    echo
    echo "An earlier session prepared and queued this run; its commits are on the branch."
    echo "Read the log and the outputs, check the done-when, finish the task."
  } >"$f/prompt.md"
  follow_job "$p" "$f"
  if [[ "$(jstate "$p" status)" == running && ! -e "$p/ended" ]]; then
    # The job still publishes: its own job_end writes `ended`, and the follow-up waits for it.
    echo "done" >"$p/status"
    echo "GPU run exit ${GPUQ_EXIT:-?} → ${f##*/}" >"$p/note"
  else
    # Any other state (gpu, a requeued job) has no process left to write `ended`.
    job_end "$p" "done" "GPU run exit ${GPUQ_EXIT:-?} → ${f##*/}"
  fi
}

# follow_ready JOB — false while JOB is a follow-up whose parent job has no `ended` file.
follow_ready() {
  local p
  p="$(jget "$1/job" parent)"
  [[ -z "$p" || ! -d "$QDIR/$p" || -e "$QDIR/$p/ended" ]]
}

# gpu_state_dir — the state dir of bin/gpu-queue.
gpu_state_dir() { echo "${GPU_QUEUE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gpu-queue}"; }

# gpu_outside STATE... — `STATE<TAB>ID` per gpu-queue run in the STATE dirs (running queued held parked finished)
# that no job's `gpu-job` names (a live or an archived job), in the order given; finished: the last 3 (ids start with the submit time).
# Files only; a missing dir (held/, parked/) gives no row.
gpu_outside() {
  local own=$'\n' d s id list
  # Live and archived jobs (as job_limit_pct does); read, not jstate: no fork per archived job.
  for d in "$QDIR"/*/ "$QROOT"/archive/*/*/; do
    [[ -f "${d}gpu-job" ]] || continue
    read -r id <"${d}gpu-job" || true
    own+="$id"$'\n'
  done
  for s in "$@"; do
    list=""
    for d in "$(gpu_state_dir)/$s"/*/; do
      [[ -d "$d" ]] || continue
      d="${d%/}" id="${d##*/}"
      [[ "$id" != *.tmp ]] || continue # shortcut: a submit under way is <id>.tmp, and so is a run named *.tmp; no run has been
      if [[ "$own" != *$'\n'"$id"$'\n'* ]]; then list+="$id"$'\n'; fi
    done
    if [[ "$s" == finished ]]; then list="$(printf '%s' "$list" | tail -n 3)"; fi
    while IFS= read -r id; do
      if [[ -n "$id" ]]; then printf '%s\t%s\n' "$s" "$id"; fi
    done <<<"$list"
  done
}

# gpu_busy — true while the gpu-queue lock is held: flock, else its mkdir lock (with_lock in bin/gpu-queue).
gpu_busy() {
  local l
  l="$(gpu_state_dir)/gpu.lock"
  if command -v flock >/dev/null 2>&1; then
    [[ -e "$l" ]] && ! flock -n "$l" true
  else
    [[ -d "$l.d" ]]
  fi
}

# gpu_holder — who holds the GPU lock, first match: a running gpu job (its name), a running outside gpu-queue run
# (its name), a workspace whose holder holds the lock (its label), a running tool job on turing with gpu=yes
# (`<label> · <name>`); else `busy`. Empty while the lock is free.
gpu_holder() {
  local d id l
  gpu_busy || return 0
  for d in "$QDIR"/*/; do
    d="${d%/}" id="$(jstate "$d" gpu-job)"
    if [[ -n "$id" && "$(jstate "$d" status)" == gpu && -d "$(gpu_state_dir)/running/$id" ]]; then
      short_id "$d" "$(jget "$d/job" repo)"
      return 0
    fi
  done
  IFS=$'\t' read -r _ id < <(gpu_outside running) || true
  if [[ -n "$id" ]]; then
    echo "${id#*-*-*-}"
    return 0
  fi
  for d in "$WS_STATES"/*/; do
    d="${d%/}"
    if [[ -d "$d" && ! -e "$d/waits" ]] && ws_holder "$d" >/dev/null && ws_gpu "$d"; then
      id="$(ws_name "${d##*/}")"
      l="$(jget "$WS_ROOT/$id/workspace.conf" label)"
      echo "${l:-$id}"
      return 0
    fi
  done
  for d in "$QDIR"/*/; do
    d="${d%/}"
    if [[ "$(jstate "$d" status)" == running ]] && tool_gpu "$d"; then
      l="$(tool_conf "$d" label)"
      echo "${l:-$(jget "$d/job" tool)} · $(short_id "$d" "$(jget "$d/job" repo)")"
      return 0
    fi
  done
  echo busy
}

# short TEXT — TEXT cut to 80 characters, `…` last when cut; iconv -c drops a half character at the cut or the start.
# shortcut: under the C locale (the runner unit sets none) the cut counts bytes, so non-ASCII text shows shorter; upgrade: set a UTF-8 locale in the unit.
short() {
  local t="$1" c="" u
  if ((${#t} > 80)); then t="${t:0:79}" c="…"; fi
  u="$(printf '%s' "$t" | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null)" || true # exit 1 when it drops a byte; no iconv: keep the text
  printf '%s%s' "${u:-$t}" "$c"
}

# log_tail FILE — the last non-blank line of the last 4 KB of FILE, one line: ANSI codes and control
# characters gone, a `\r` a line break (the last frame of a progress bar).
log_tail() {
  local esc=$'\033' t
  t="$(tail -c 4096 "$1" 2>/dev/null | tr '\r' '\n' | sed -E "s/$esc\[[0-9;?]*[A-Za-z]//g" | tr '\001-\011\013-\037\177' ' ' |
    awk 'NF { l = $0 } END { gsub(/^ +| +$/, "", l); print l }')" || true
  short "$t"
}

# span_text SECONDS — `45s`, `12m`, `3h05m`.
span_text() {
  if (($1 < 60)); then
    echo "$1s"
  elif (($1 < 3600)); then
    echo "$(($1 / 60))m"
  else
    printf '%dh%02dm\n' $(($1 / 3600)) $(($1 % 3600 / 60))
  fi
}

# gpu_row STATE ID — the fields of one gpu_outside run, joined by US (a tab would merge empty ones):
# DIR ELAPSED CMD THEN LOG WANDB EXIT ENDED. A finished run has only EXIT and ENDED; ELAPSED: running only.
# The wandb link: the first run URL in the log (grep -m1 on the file, no pipe: SIGPIPE under pipefail).
gpu_row() {
  local d dir="" el="" cmd="" hook="" log="" w="" ex="" en="" t now
  local re='https://[A-Za-z0-9.-]*wandb[A-Za-z0-9.-]*/[A-Za-z0-9_./-]+/runs/[A-Za-z0-9_-]+'
  d="$(gpu_state_dir)/$1/$2"
  if [[ "$1" == finished ]]; then
    ex="$(jstate "$d" exit)" en="$(jstate "$d" ended)" en="${en%:*}"
  else
    dir="$(jstate "$d" dir)" cmd="$(jstate "$d" cmd)" hook="$(jstate "$d" "then")"
    log="$(log_tail "$d/log")"
    w="$(grep -m1 -o -E "$re" "$d/log" 2>/dev/null)" || true
    t="$(epoch_of "$(jstate "$d" started)")" now="$(date +%s)"
    if [[ "$1" == running && -n "$t" ]]; then el="$(span_text $((now > t ? now - t : 0)))"; fi
  fi
  printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$dir" "$el" "$(short "${cmd% }")" "$(short "$hook")" "$log" "${w%%$'\n'*}" "$ex" "$en"
}

# queue_counts — running, on the GPU, queued, PRs to review, ended jobs with no PR.
# On the GPU: jobs with status `gpu`, plus the running and queued gpu-queue runs no job started (gpu_outside).
# A PR counts once by the URL in a job's `pr` file. A `done` job with no URL is covered by a URL on
# its repo and branch (a review round, a lane item) and waits while a job there is live (its review
# round is queued). A failed or blocked job with no URL always counts. Files only: no gh, every 30 s.
queue_counts() {
  local d r=0 q=0 g=0 s u kind rows=""
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ -f "$d/job" ]] || continue
    s="$(jstate "$d" status)" kind=end u=""
    case "$s" in
      running) r=$((r + 1)) kind=live ;;
      gpu) g=$((g + 1)) kind=live ;;
      "" | queued) q=$((q + 1)) kind=live ;;
      *)
        if [[ "$s" == "done" ]]; then kind="done"; fi
        u="$(jstate "$d" pr)"
        case "$u" in http*) ;; *) u="" ;; esac
        ;;
    esac
    rows+="$(jget "$d/job" repo)"$'\t'"$(jget "$d/job" branch)"$'\t'"$u"$'\t'"$kind"$'\n'
  done
  g=$((g + $(gpu_outside running queued | wc -l)))
  echo "$r $g $q $(printf '%s' "$rows" | awk -F'\t' '
    { k = $1 "\t" $2 }
    $4 == "live" { live[k] = 1; next }
    $3 != "" { has[k] = 1; u[$3] = 1 }
    $4 == "end" { if ($3 == "") o++; next }
    { n[k]++ }
    END { for (x in u) p++; for (k in n) if (!(k in has) && !(k in live)) o += n[k]; print p + 0, o + 0 }')"
}

# queue_flags — the slots, PAUSED, the usage limit.
queue_flags() {
  printf '%s slots' "$(qconf slots 4)"
  if [[ -e "$QROOT/paused" ]]; then printf ' · PAUSED'; fi
  if limited; then printf ' · USAGE LIMIT until %s' "$(at_time "$(head -n 1 "$QROOT/limit")")"; fi
  echo
}

# queue_header — one line: the counts, then the flags.
queue_header() {
  local r g q p o
  read -r r g q p o <<<"$(queue_counts)"
  echo "queue: $r running · $g on the GPU · $q queued · $p to review · $o no PR · $(queue_flags)"
}

# queue_repos — the repos of the queued jobs, sorted.
queue_repos() {
  local d
  for d in "$QDIR"/*/; do [[ ! -f "$d/job" ]] || jget "$d/job" repo; done | sort -u
}

# short_id JOB REPO — the job's id without <time>-<repo>-.
short_id() {
  local id="${1##*/}" re='^[0-9]{8}-[0-9]{6}-'
  if [[ "$id" =~ $re ]]; then
    id="${id#"${BASH_REMATCH[0]}"}"
    id="${id#"${2##*/}"-}"
  fi
  echo "$id"
}

# phase_mark JOB — the job as a phase: ✓ done or at its gate, ▶ running, ✗ ended otherwise, ○ to come.
phase_mark() {
  case "$(jstate "$1" status)" in
    "done") echo "✓" ;;
    running) if [[ -f "$1/gate.log" ]]; then echo "✓"; else echo "▶"; fi ;;
    gpu) echo "▶" ;;
    blocked | failed | timeout | skipped) echo "✗" ;;
    *) echo "○" ;;
  esac
}

# job_phases JOB — the phases of JOB's chain (its base job, review rounds, verify step), one
# `<mark> <phase>` line each, for the page and the status. R2 shows once queued, Verify only with
# `verify=`; Gate and PR come from the chain's last job and drop once it ended without them.
job_phases() {
  local b last n=1 m v k
  b="$(review_base "$1")" last="$b"
  echo "$(phase_mark "$b") Agent"
  if [[ "$(jget "$b/job" output)" == report ]]; then
    if [[ -s "$b/report.md" ]]; then echo "✓ Report"; elif job_final "$b"; then echo "✗ Report"; else echo "○ Report"; fi
    return 0
  fi
  while [[ -f "$b-review$n/job" ]]; do
    last="$b-review$n" m="$(phase_mark "$b-review$n")" v=""
    if job_final "$last"; then
      v="$(jstate "$last" note)" v="${v#R"$n": }" v="${v##*→ }"
      case "$v" in timeout | "review failed") m="✗" ;; esac
    fi
    echo "$m R$n${v:+ $v}"
    n=$((n + 1))
  done
  if ((n == 1)) && review_on "$b" && ! job_final "$b"; then echo "○ R1"; fi
  k="$(jget "$b/job" verify)"
  if [[ -f "$b-verify/job" ]]; then
    last="$b-verify" m="$(phase_mark "$b-verify")" v="$(jstate "$b-verify" verify)"
    if [[ -z "$v" ]] && job_final "$last"; then v="$(jstate "$last" note)"; fi
    if verify_failed "$last"; then m="✗"; fi
    echo "$m Verify $k${v:+ $v}"
  elif [[ -n "$k" ]] && ! job_final "$last"; then
    echo "○ Verify $k"
  fi
  v="$(jstate "$last" gate)"
  if [[ -n "$v" ]]; then
    if [[ "$v" == 0 ]]; then echo "✓ Gate"; else echo "✗ Gate exit $v"; fi
  elif ! job_final "$last"; then
    if [[ -f "$last/gate.log" ]]; then echo "▶ Gate"; else echo "○ Gate"; fi
  fi
  v="$(jstate "$last" pr)"
  case "$v" in
    http*) echo "✓ PR" ;;
    "") if ! job_final "$last"; then echo "○ PR"; fi ;;
    *) echo "✗ PR $v" ;;
  esac
}

# queue_jobs PRINTER — the GPU group (`PRINTER repo GPU`, `PRINTER gpu ID STATE ELAPSED DIR CMD THEN LOG WANDB EXIT ENDED`
# per outside run (gpu_row's fields), `PRINTER end`),
# the Features group (`PRINTER repo Features`, `PRINTER feature NAME PILL
# PROGRESS CONTEXT ITEMS MEMBERS` per feature, `PRINTER end`), then per repo with a job outside every
# feature `PRINTER repo NAME`, a card per job or branch (branch_card), `PRINTER end`.
# ITEMS, MEMBERS: feature_row's F_ITEMS and F_MEMBERS.
queue_jobs() {
  local repo d b f seen head s id rows el cmd hook log w ex en
  rows="$(gpu_outside running queued held parked finished)"
  if [[ -n "$rows" ]]; then
    "$1" repo GPU
    while IFS=$'\t' read -r s id; do
      IFS=$'\037' read -r d el cmd hook log w ex en <<<"$(gpu_row "$s" "$id")"
      "$1" gpu "$id" "$s" "$el" "$d" "$cmd" "$hook" "$log" "$w" "$ex" "$en"
    done <<<"$rows"
    "$1" end
  fi
  feature_keys
  if [[ -n "$(feature_files)" ]]; then
    "$1" repo Features
    while IFS= read -r f; do
      feature_row "$f"
      "$1" feature "$(basename "$f" .md)" "$F_PILL" "$F_PROGRESS" "$(md_line "$f" Context)" "${F_ITEMS%$'\n'}" "${F_MEMBERS%$'\n'}"
    done < <(feature_files)
    "$1" end
  fi
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    seen=$'\n' head=0
    for d in "$QDIR"/*/; do
      d="${d%/}"
      [[ -f "$d/job" && "$(jget "$d/job" repo)" == "$repo" ]] || continue
      b="$(jget "$d/job" branch)"
      [[ "$seen" != *$'\n'"$b"$'\n'* ]] || continue
      if is_member "$d"; then continue; fi
      if ((!head)); then
        "$1" repo "${repo##*/}" "$repo"
        head=1
      fi
      branch_card "$1" "$d" "$(short_id "$d" "$repo")" "$b"
      if ((${#GROUP[@]} > 1)); then seen+="$b"$'\n'; fi
    done
    if ((head)); then "$1" end; fi
  done < <(queue_repos)
}

# branch_card PRINTER JOB JOBNAME LANENAME — JOB alone on its branch: job_card as JOBNAME, with its phases. A branch
# with 2+ jobs (group_of): `PRINTER lane LANENAME STATUS PROGRESS NEXT PR CONTEXT DIR ITEMS ALL PHASES`.
# ITEMS: a `NAME STATUS NOTE` line per lane job that needs you; DIR: its running job.
# ALL: the lane's job directories, one per line. PHASES: job_phases of DIR, else of the latest chain.
branch_card() {
  local j st run=0 you=0 wait=0 items="" dir="" all="" repo b base=""
  group_of "$2"
  if ((${#GROUP[@]} < 2)); then
    job_card "$1" "$2" "$3" "$(job_phases "$2")"
    return 0
  fi
  repo="$(jget "$2/job" repo)"
  for j in "${GROUP[@]}"; do
    # Not the last of GROUP: the glob puts <id>-gpu before <id>.
    b="$(review_base "$j")"
    if [[ "$b" > "$base" ]]; then base="$b"; fi
    st="$(jstate "$j" status)"
    [[ ! -f "$j/held" ]] || st="held"
    all+="$j"$'\n'
    case "$st" in
      running | gpu) run=1 dir="$j" ;;
      "" | queued) wait=1 ;;
      held | blocked | failed | timeout | skipped)
        you=1
        items+="$(printf '%s  %-8s %s%s' "$(short_id "$j" "$repo")" "$st" "$(jstate "$j" note)" "$(side_suffix "$j")")"$'\n'
        ;;
    esac
  done
  st="done"
  if ((run)); then st=running; elif ((you)); then st=blocked; elif ((wait)); then st=queued; fi
  "$1" lane "$4" "$st" "$G_PROGRESS" "$G_NEXT" "$G_PR" "$G_CTX" "$dir" "${items%$'\n'}" "${all%$'\n'}" "$(job_phases "${dir:-$base}")"
}

# job_card PRINTER JOB NAME [PHASES] — `PRINTER job NAME STATUS TEXT PR JOB PHASES`; TEXT: the context, the note once final.
job_card() {
  local st txt
  st="$(jstate "$2" status)" txt="$(jget "$2/job" context)"
  if job_final "$2"; then txt="$(jstate "$2" note)"; elif is_queued "$2" && ! at_due "$2"; then txt="starts $(jget "$2/job" at) · $txt"; fi
  [[ ! -f "$2/held" ]] || st="held"
  "$1" job "$3" "${st:-queued}" "$txt$(side_suffix "$2")" "$(jstate "$2" pr)" "$2" "${4:-}"
}

# status_line repo|feature|gpu|job|lane|end … — queue_jobs for a narrow terminal: name and status, text and phases below.
status_line() {
  local r b p ms note
  case "$1" in
    repo) printf '\n%s\n' "$2" ;;
    gpu)
      if [[ "$3" == finished ]]; then
        printf '  %s  exit %s%s\n' "$2" "${10}" "${11:+ · ${11}}"
      else
        printf '  %s  %s%s\n' "$2" "$3" "${4:+ $4}"
        printf '%s\n' "$5" "${8:+log: $8}" "${6:+cmd: $6}" "${7:+then: $7}" "${9:+wandb: $9}" | sed -e '/^$/d' -e 's/^/    /'
      fi
      ;;
    job)
      printf '  %s  %s\n' "$2" "$3"
      if [[ -n "$4$5" ]]; then printf '    %s\n' "$4${5:+ $5}"; fi
      if [[ -n "${7:-}" ]]; then printf '    %s\n' "${7//$'\n'/ · }"; fi
      ;;
    lane)
      printf '  %s · %s · %s%s\n    %s\n' "$2" "$4" "$5" "${6:+ · $6}" "$7"
      if [[ -n "${11:-}" ]]; then printf '    %s\n' "${11//$'\n'/ · }"; fi
      if [[ -n "$9" ]]; then printf '%s\n' "$9" | sed 's/^/    /'; fi
      ;;
    feature)
      printf '  %s · %s · %s\n' "$2" "$4" "$3"
      if [[ -n "$5" ]]; then printf '    %s\n' "$5"; fi
      while IFS='|' read -r r b p ms note; do
        if [[ -n "$r" ]]; then printf '    %s · %s  %s%s\n' "${r##*/}" "$b" "$ms" "${note:+  $note}"; fi
      done <<<"$7"
      ;;
  esac
}

# vibe queue status — the header, then per repo each job on two lines, or one row
# per branch with 2+ jobs and a line below it for each job that needs the user.
cmd_queue_status() {
  queue_header
  queue_jobs status_line
}

# esc TEXT — TEXT with & < > " as HTML entities.
esc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

# job_steps JOB — the last 10 tool steps of the job's log, oldest first; empty without jq.
job_steps() {
  command -v jq >/dev/null 2>&1 || return 0
  tail -n 400 "$1/log" 2>/dev/null | jq -R -r 'fromjson? | select(.type == "assistant") | .message.content[]?
    | select(.type == "tool_use") | (.input.description // (.name + " " + (.input.command // .input.file_path // .input.pattern // .input.path // "" | tostring | .[0:100])))
    | gsub("\\s+"; " ")' 2>/dev/null | tail -n 10 || true
}

# btn_rows WRITE CONFIRM — the two button lists with an empty grid row between them, when both are filled.
btn_rows() { printf '%s%s%s' "$1" "${1:+${2:+<hr>}}" "$2"; }

# ask ROUTE FIELD LABEL BUTTON [ATTR] — a labelled field and its send button; page.js posts each named field of
# the .ask with the nearest .jacts data. FIELD text: a textarea, else one line.
ask() {
  local f="<input name=\"$2\">"
  if [[ "$2" == text ]]; then f="<textarea name=\"$2\" rows=\"3\"></textarea>"; fi
  printf '<span class="ask"><label>%s%s</label><button data-act="%s"%s>%s</button></span>' "$(esc "$3")" "$f" "$1" "${5:+ $5}" "$4"
}

# act_btn ROUTE — the one markup of a write button or field that a row and its block share: retry, answer, fix,
# archive, feature-ready, feature-archive; routes in bin/vibe-web.
act_btn() {
  case "$1" in
    retry) printf '%s' '<button data-act="retry">Retry</button>' ;;
    answer) ask answer text 'Your answer: the job runs again with it' 'Send answer' ;;
    fix) ask fix text 'Fix job: what to change on the PR' 'Start fix job' ;;
    archive) printf '%s' '<button data-act="archive" data-confirm>Archive</button>' ;;
    feature-ready) printf '%s' '<button data-act="feature-ready" data-confirm title="Your human test passed: mark every member PR ready">Test passed</button>' ;;
    feature-archive) printf '%s' '<button data-act="feature-archive" data-confirm>Archive</button>' ;;
  esac
}

# tool_up JOB — true while a tool= job runs its tool: running, no tool-exit yet.
tool_up() { [[ -n "$(jget "$1/job" tool)" && "$(jstate "$1" status)" == running && ! -f "$1/tool-exit" ]]; }

# tool_steers JOB — true when the job's tool has a steer script without the contract's bare `exit 3`.
# shortcut: reads the script, never runs it; upgrade when a steer script answers 3 only at run time.
tool_steers() {
  local f
  f="$WS_ROOT/$(jget "$1/job" tool)/steer"
  [[ -x "$f" ]] && ! grep -qx 'exit 3' "$f"
}

# tool_tail FILE — its last 10 non-blank lines from the last 8 KB: ANSI codes and control characters gone, a `\r` a line break.
tool_tail() {
  local esc=$'\033'
  tail -c 8192 "$1" 2>/dev/null | tr '\r' '\n' | sed -E "s/$esc\[[0-9;?]*[A-Za-z]//g" | tr '\001-\011\013-\037\177' ' ' | awk 'NF' | tail -n 10 || true
}

# job_buttons JOB — the card's fields, file links, then write buttons by status, data-confirm ones last; routes in bin/vibe-web, shown after whoami.
job_buttons() {
  local a="" b="" c="" pr gpu="" f links=""
  pr="$(jstate "$1" pr)"
  case "$(jstate "$1" status)" in
    "" | queued)
      if [[ "$(jget "$1/job" now)" != 1 ]]; then b+='<button data-act="now">Start next</button>'; fi
      if review_on "$1"; then b+='<button data-act="noreview">No review</button>'; fi
      c+='<button data-act="cancel" data-confirm>Cancel</button>'
      ;;
    running) c+='<button data-act="stop" data-confirm>Stop</button>' ;;
    gpu)
      gpu="$(jstate "$1" gpu-job)"
      if [[ -n "$gpu" ]]; then c+='<button data-act="gpu-cancel" data-confirm>Cancel GPU run</button>'; fi
      ;;
    failed | timeout | skipped) b+="$(act_btn retry)" ;;
  esac
  case "$(jstate "$1" status)" in
    blocked | failed | timeout) a+="$(act_btn answer)" ;;
    "done") if [[ "$pr" == http* ]]; then a+="$(act_btn fix)"; fi ;;
  esac
  if tool_up "$1" && tool_steers "$1"; then
    f="$(tool_conf "$1" label)"
    a+="$(ask steer text "Steer ${f:-$(jget "$1/job" tool)}: it reads the text at its next step" Send)"
  fi
  if job_final "$1"; then
    if [[ ! -f "$1/held" ]]; then a+="$(ask hold note 'Hold: your note' Hold)"; fi
    c+="$(act_btn archive)"
  fi
  # GET job/<id>/<file> in bin/vibe-web; a log as its tail, out/files as a list.
  for f in report.md pr.md gate.log result note log tool.log out/report.md; do
    if [[ -s "$1/$f" ]]; then links+="<a href=\"/queue/api/job/$(esc "${1##*/}")/$f\">$f</a>"; fi
  done
  if [[ -d "$1/out/files" ]]; then links+="<a href=\"/queue/api/job/$(esc "${1##*/}")/out/files\">out/files/</a>"; fi
  printf '<div class="jacts" data-id="%s"%s%s>%s%s%s</div>' "$(esc "${1##*/}")" "${pr:+ data-pr=\"$(esc "$pr")\"}" "${gpu:+ data-gpu=\"$(esc "$gpu")\"}" "$a" "${links:+<div class=\"files\">$links</div>}" "$(btn_rows "$b" "$c")"
}

# status_card feature|gpu|job|lane … — the card of one queue_jobs item: the body of its panel block (page_row);
# a lane unpacks into a job card per job, a feature into a card per member. The phase line opens to name the review passes.
status_card() {
  local pill txt pr dir items="" link="" extra="" steps="" details="" t nl=$'\n' all="" j list="" cls="" name="${2:-}" st="${3:-}"
  local r b p ms ph="" l c rs=""
  case "$1" in
    gpu)
      # An outside gpu-queue run: the pill is its state and elapsed time, or its exit code; the text its dir, or its end time.
      pill="$3${4:+ $4}" txt="$5" pr=""
      if [[ "$3" == finished ]]; then pill="exit ${10}" txt="${11}"; fi
      extra="$(esc "$(printf '%s\n' "${8:+log: $8}" "${6:+cmd: $6}" "${7:+then: $7}" | sed '/^$/d')" | sed 's#.*#<p class="stats">&</p>#')"
      if [[ -n "${9:-}" ]]; then extra+="<p class=\"stats\"><a href=\"$(esc "$9")\">wandb run</a></p>"; fi
      ;;
    job) pill="$3" txt="$4" pr="$5" dir="$6" ph="${7:-}" ;;
    lane) pill="$4" txt="$7" pr="$6" dir="$8" items="$9" all="${10}" cls=" lane" ph="${11:-}" ;;
    feature)
      pill="$3" txt="$5" pr="" dir="" items="$6" cls=" lane feature" name="$2 · $4"
      case "$3" in
        "your test") extra="$(act_btn feature-ready)" ;;
        merge) extra="$(act_btn feature-archive)" ;;
      esac
      if [[ -n "$extra" ]]; then extra="<div class=\"jacts\" data-feature=\"$(esc "$2")\">$extra</div>"; fi
      ;;
  esac
  if [[ "$1" != job && "$1" != lane && "$1" != feature && "$1" != gpu ]]; then return 0; fi
  # A feature, member or outside GPU run state takes the look of a job status.
  case "$st" in
    "needs you" | "no PR") st=blocked ;;
    "your test" | parked) st=held ;;
    merge | "no job" | finished) st="done" ;;
  esac
  case "$pr" in
    http*) link=" <a href=\"$(esc "$pr")\">PR</a>" ;;
    ?*) txt="$txt $pr" ;;
  esac
  if [[ -n "$ph" ]]; then
    t=""
    while IFS= read -r l; do
      case "$l" in "✗ "*) c=' class="x"' ;; "▶ "*) c=' class="r"' ;; *) c="" ;; esac
      t+="${t:+ · }<span$c>$(esc "$l")</span>"
      l="${l#* }" l="${l%% *}"
      case "$l" in R[0-9]*) rs+="${rs:+, }$l" ;; esac
    done <<<"$ph"
    if [[ -n "$rs" ]]; then
      ph="<details class=\"phases\"><summary>$t</summary><p>$rs: $(review_passes "$dir")</p></details>"
    else
      ph="<p class=\"phases\">$t</p>"
    fi
  fi
  if [[ "$1" == lane && "$5" != - ]]; then extra="<p>next: $(esc "$5")</p>"; fi
  if [[ -n "$items" ]]; then extra+="$(esc "$items" | sed 's#.*#<p>&</p>#')"; fi
  if [[ "$1" == job ]]; then
    t="$(job_stats "$dir")"
    if [[ -n "$t" ]]; then extra+="<p class=\"stats\">$(esc "$t")</p>"; fi
    if [[ -n "$dir" ]] && tool_up "$dir"; then
      # &#10;: page_row joins a block to one line. awk, not ${//}: `&` in its replacement is the match on bash 5.2.
      t="$(esc "$(tool_tail "$dir/tool.log")" | awk '{ printf "%s%s", (NR > 1 ? "&#10;" : ""), $0 }')"
      extra+="<p class=\"lbl\">tool.log · last 10 lines</p><pre class=\"tlog\">$t</pre>"
    fi
    if [[ -n "$dir" ]]; then extra+="$(job_buttons "$dir")"; fi
  fi
  case "$(jstate "${dir:-/nonexistent}" status)" in running | gpu) steps="$(job_steps "$dir")" ;; esac
  if [[ -n "$steps" ]]; then
    t="$(stat -c %Y "$dir/log" 2>/dev/null || stat -f %m "$dir/log" 2>/dev/null || echo 0)"
    details="<details><summary>$(at_time "$t" | cut -c 12-) · $(esc "${steps##*"$nl"}")</summary><ol>$(esc "$steps" | sed 's#.*#<li>&</li>#')</ol></details>"
  fi
  if [[ -n "$all" ]]; then
    while IFS= read -r j; do list+="$(job_card status_card "$j" "$(job_item "$j")")"; done <<<"$all"
    details+="<details class=\"stack\"><summary>${pill#*/} jobs</summary>$list</details>"
  fi
  if [[ "$1" == feature ]]; then
    while IFS='|' read -r r b p ms _; do
      [[ -n "$r" ]] || continue
      j="$(branch_jobs "$r" "$b" | awk 'NR == 1')"
      if [[ -n "$j" ]]; then
        list+="$(branch_card status_card "$j" "${r##*/} · $b" "${r##*/} · $b")"
      else
        list+="$(status_card job "${r##*/} · $b" "$ms" "" "$p" "")"
      fi
    done <<<"$7"
    details+="<details class=\"stack\"><summary>${4#*/} branches</summary>$list</details>"
  fi
  printf '<div class="job%s s-%s"><div class="top"><b>%s</b><span class="pill">%s</span></div><p>%s%s</p>%s%s%s</div>\n' \
    "$cls" "$(esc "$st")" "$(esc "$name")" "$(esc "$pill")" "$(esc "$txt")" "$link" "$ph" "$extra" "$details"
}

# md_html — Markdown on stdin as HTML, file links as plain text: pandoc, else <pre>.
# The Lua filter turns raw HTML into code and a link or image with a scheme other than
# http, https or mailto (`javascript:`, `data:`) into its text.
md_html() {
  local md out raw='
function RawBlock(e) return pandoc.CodeBlock(e.text) end
function RawInline(e) return pandoc.Code(e.text) end
local function ok(u)
  local s = u:gsub("[%c%s]", ""):lower():match("^([a-z][a-z0-9+.-]*):")
  return not s or s == "http" or s == "https" or s == "mailto"
end
function Link(l) if not ok(l.target) then return l.content end end
function Image(i) if not ok(i.src) then return i.caption end end'
  md="$(sed -E 's/\[([^]]*)\]\(file:[^)]*\)/\1/g')"
  if command -v pandoc >/dev/null 2>&1 && out="$(printf '%s\n' "$md" | pandoc -f gfm-gfm_auto_identifiers --lua-filter=<(printf '%s\n' "$raw") -t html 2>/dev/null)"; then
    printf '%s\n' "$out"
  else
    printf '<pre>%s</pre>\n' "$(esc "$md")"
  fi
}

# config_md settings|recurring|actions — the queue settings; `vibe job list` as a table and its sweep line; the last 20 page actions.
config_md() {
  local limit=none conf="$QCONF"
  case "$1" in
    settings)
      if limited; then limit="until $(at_time "$(head -n 1 "$QROOT/limit")")"; fi
      printf '| Setting | Value |\n| --- | --- |\n'
      printf '| Slots | %s |\n' "$(qconf slots 4)"
      printf '| Paused | %s |\n' "$(if [[ -e "$QROOT/paused" ]]; then echo yes; else echo no; fi)"
      printf '| Usage limit | %s |\n' "$limit"
      # shellcheck disable=SC2088  # a literal ~ for display
      case "$conf" in "$HOME"/*) conf="~/${conf#"$HOME"/}" ;; esac
      # shellcheck disable=SC2016  # Markdown backticks, not an expansion
      printf '\nFrom `%s`: `queue.conf`, `repos`.\n' "$conf"
      ;;
    recurring)
      # shellcheck disable=SC2119  # no arguments: every repo
      cmd_job_list | awk '
        NR == 1 { print "| Repo | Job | Schedule | Day | Last run | State |"; print "| --- | --- | --- | --- | --- | --- |"; next }
        /^$/ || /^fill-queue sweep/ { print; next }
        { s = $0; for (i = 1; i <= 5; i++) sub(/^[^ ]+ +/, "", s); printf "| %s | %s | %s | %s | %s | %s |\n", $1, $2, $3, $4, $5, s }'
      ;;
    actions)
      printf '| Time | Login | Command | Exit |\n| --- | --- | --- | --- |\n'
      tail -n 20 "$QROOT/actions.log" | awk -F'\t' '{ gsub(/\|/, "\\|", $3); l[NR] = sprintf("| %s | %s | `%s` | %s |", $1, $2, $3, $4) } END { for (i = NR; i > 0; i--) print l[i] }'
      ;;
  esac
}

# page_buttons REPO_OPTIONS — the Config page's Actions, read-only first, data-confirm ones last; routes in bin/vibe-web.
page_buttons() {
  local b='<button data-act="servers">Servers</button>' c
  if [[ -n "$1" ]]; then b+="<span class=\"ask\"><label>Repo<select name=\"repo\">$1</select></label><button data-act=\"worktrees\">Worktrees</button></span>"; fi
  b+='<button data-act="triage">Triage PRs</button>'
  b+='<button data-act="sync">Sync worktrees</button>'
  c='<button data-act="restart" data-confirm>Restart runner</button>'
  c+='<button data-act="update-toolkit" data-confirm>Update toolkit</button>'
  c+="$(ask server-restart server 'Server to restart (Servers lists them)' 'Restart server' data-confirm)"
  btn_rows "$b" "$c"
}

# page_repos — the sweep repos (~/.config/vibe/repos), then the opted-in ones; each once, as a path.
page_repos() {
  local line
  {
    if [[ -f "$QCONF/repos" ]]; then
      while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="$(echo "$line" | tr -d '[:space:]')"
        if [[ -n "$line" ]]; then job_repo_path "$line"; fi
      done <"$QCONF/repos"
    fi
    # shellcheck disable=SC2119  # no arguments: every opted-in repo
    job_repos
  } | awk '!seen[$0]++'
}

# rec_buttons REPO [reset] — per recurring job of REPO a .jacts with its Run button, and Reset when asked and the job stopped.
# A nested .jacts has display: contents: its buttons sit in the outer grid, its data-job reaches page.js.
rec_buttons() {
  local j e
  e="$(esc "$1")"
  while IFS= read -r j; do
    [[ -n "$j" ]] || continue
    printf '<div class="jacts" data-repo="%s" data-job="%s"><button data-act="run">%s</button>' "$e" "$(esc "$j")" "$(esc "$j")"
    if [[ -n "${2:-}" && "$(job_due "$1" "$j")" == stopped ]]; then printf '<button data-act="reset">Reset %s</button>' "$(esc "$j")"; fi
    printf '</div>'
  done < <(job_names "$1")
}

# new_work — the New job block (#new): the new-job form, then per repo Roadmap, Opt in and its recurring jobs.
new_work() {
  local r j b e avail opts="" out="" rec
  while IFS= read -r r; do
    [[ -e "$r/.git" ]] || continue
    e="$(esc "$r")" avail=""
    opts+="<option value=\"$e\">$(esc "${r##*/}")</option>"
    for j in "$JOBS_CATALOGUE"/*.md; do
      j="${j##*/}" && j="${j%.md}"
      if [[ "$j" != _* && ! -f "$r/.vibe-jobs/$j.md" ]]; then avail+="<option>$(esc "$j")</option>"; fi
    done
    b='<button data-act="roadmap">Roadmap</button>'
    if [[ -n "$avail" ]]; then b+="<span class=\"ask\"><label>Recurring job<select name=\"job\">$avail</select></label><button data-act=\"opt-in\">Opt in</button></span>"; fi
    rec="$(rec_buttons "$r")"
    b+="${rec:+<span class=\"lbl\">Run recurring</span>$rec}"
    out+="<div class=\"jacts\" data-repo=\"$e\"><span class=\"lbl\">$(esc "${r##*/}")</span>$b</div>"
  done < <(page_repos)
  [[ -n "$opts" ]] || return 0
  printf '<div class="jacts"><span class="ask"><label>Repo<select name="repo">%s</select></label><label>Task<textarea name="task" rows="3"></textarea></label><label>Done when: a command that checks it<input name="done"></label><label>Branch slug<input name="branch"></label><button data-act="new">Queue job</button></span></div>%s\n' "$opts" "$out"
}

# config_page — the Config page: settings with Set config, Actions, recurring jobs with Run and Reset, the last 20 page actions.
config_page() {
  local r e rec="" opts="" x
  while IFS= read -r r; do
    [[ -e "$r/.git" ]] || continue
    e="$(esc "$r")"
    opts+="<option value=\"$e\">$(esc "${r##*/}")</option>"
    x="$(rec_buttons "$r" reset)"
    if [[ -n "$x" ]]; then rec+="<div class=\"jacts\"><span class=\"lbl\">$(esc "${r##*/}")</span>$x</div>"; fi
  done < <(page_repos)
  printf '<section class="sec"><h2>Settings</h2><div class="md">\n%s\n</div><div class="jacts">%s</div></section>\n' \
    "$(config_md settings | md_html)" "$(ask conf set 'Set config: key=value, e.g. slots=3' 'Set config')"
  printf '<section class="sec"><h2>Actions</h2><div class="jacts">%s</div></section>\n' "$(page_buttons "$opts")"
  printf '<section class="sec"><h2>Recurring jobs</h2><div class="md">\n%s\n</div>%s</section>\n' "$(config_md recurring | md_html)" "$rec"
  if [[ -s "$QROOT/actions.log" ]]; then
    printf '<section class="sec"><h2>Page actions</h2><div class="md">\n%s\n</div></section>\n' "$(config_md actions | md_html)"
  fi
}

# ws_page HOLDER — line 1: the rail's service links; then the Workspaces page: per kind=service tool a row with lamp, label,
# role, place, time up and left (warn under 30 min), Open UI ↗ and Stop, or Start (a place and hours form for 2+ places);
# then the run tools in one line. HOLDER: gpu_holder, named on turing for a gpu=yes tool. Routes ws-start, ws-stop.
ws_page() {
  local d n f l s st lamp line b e p u t x lim now rail="" rows="" runs="" opts hold="${1:-}"
  now="$(date +%s)"
  for d in "$WS_ROOT"/*/; do
    n="${d%/}" n="${n##*/}"
    if [[ ! -d "$d" || "$n" == _* || "$(slug "$n")" != "$n" || "$(ws_check "$WS_ROOT/$n")" != ok ]]; then continue; fi
    f="$WS_ROOT/$n/workspace.conf" l="$(jget "$f" label)" l="${l:-$n}"
    if [[ "$(jget "$f" kind)" != service ]]; then
      runs+="${runs:+, }$l"
      continue
    fi
    st="$WS_STATES/$n" s="$(ws_state "$st")" e="$(esc "$n")" p="$(jstate "$st" place)" b="" u=""
    line="$(esc "$p") · $(esc "$s")" lamp=warn
    case "$s" in
      down)
        lamp=off p="$(jget "$f" places)" t="$(jget "$f" hours)"
        line="Off · places: $(esc "${p//,/, }")${t:+ · default $(esc "$t") h}"
        t="$(ws_line "$st" | cut -f 4)"
        if [[ -d "$st" && -n "$t" ]]; then line+=" · <span class=\"bad\">$(esc "$t")</span>"; fi
        if [[ "$p" == *,* ]]; then
          opts=""
          while IFS= read -r t; do
            if [[ "$t" == turing && -n "$hold" && "$(jget "$f" gpu)" == yes ]]; then
              x="waits: $hold holds the GPU"
              if [[ "$hold" == busy ]]; then x="waits for the GPU"; fi
              opts+="<option value=\"turing\">turing — $(esc "$x")</option>"
            else
              opts+="<option>$(esc "$t")</option>"
            fi
          done < <(tr , '\n' <<<"$p")
          # No hours= in the conf: the field may stay empty (data-opt), and the start has no limit, as from the CLI.
          t="$(jget "$f" hours)" x=" data-opt placeholder=\"no limit\""
          if [[ -n "$t" ]]; then x=" value=\"$(esc "$t")\""; fi
          b="<div class=\"jacts\" data-name=\"$e\"><span class=\"ask\"><label>Place<select name=\"place\">$opts</select></label><label>Hours<input name=\"hours\" type=\"number\" min=\"1\"$x></label><button data-act=\"ws-start\">Start</button></span></div>"
        else
          b="<span class=\"jacts p\" data-name=\"$e\"><button data-act=\"ws-start\">Start</button></span>"
        fi
        ;;
      up | "past limit")
        t="$(jstate "$st" started)" lim="$(jstate "$st" limit)" u="$(jstate "$st" url)"
        if [[ "$s" == "past limit" ]]; then
          lamp=bad line+=": the next tick stops it"
        else
          lamp=ok
          if [[ "$t" =~ ^[0-9]+$ ]]; then line+=" $(printf '%d:%02d' $(((now - t) / 3600)) $(((now - t) % 3600 / 60)))"; fi
          if [[ "$lim" =~ ^[0-9]+$ ]]; then
            t="$(span_text $((lim > now ? lim - now : 0))) left"
            if ((lim - now < 1800)); then t="<span class=\"warn\">$t</span>"; fi
            line+=" · $t"
          else
            line+=" · no limit"
          fi
        fi
        case "$u" in http://* | https://*) b="<a class=\"btn ui\" href=\"$(esc "$u")\" target=\"_blank\" rel=\"noopener\">Open UI ↗</a>" ;; esac
        b+="<span class=\"jacts p\" data-name=\"$e\"><button data-act=\"ws-stop\" data-confirm>Stop</button></span>"
        ;;
      "waits for the GPU" | starts)
        if [[ "$s" != starts ]] || ws_stop_cuts "$st"; then b="<span class=\"jacts p\" data-name=\"$e\"><button data-act=\"ws-stop\" data-confirm>Stop</button></span>"; fi
        ;;
    esac
    rail+="<a href=\"#ws-$e\"><i class=\"lamp l-$lamp\"></i>$(esc "$l")</a>"
    rows+="<div class=\"wrow\" id=\"ws-$e\"><i class=\"lamp l-$lamp\"></i><div class=\"t\"><b>$(esc "$l") <span class=\"role\">· $(esc "$(jget "$f" role)")</span></b><span class=\"why\">$line</span></div>$b</div>"
  done
  echo "$rail"
  printf '<section class="sec" aria-label="Services">%s</section>\n' "${rows:-<p class=\"none\">No service under workspaces/.</p>}"
  if [[ -n "$runs" ]]; then printf '<p class="note">%s run as queue jobs.</p>\n' "$(esc "$runs")"; fi
}

# item_why LINE — `NAME STATUS: NOTE` of a lane or feature item line `NAME  STATUS  NOTE` (2+ spaces apart); the status once.
item_why() {
  local n="${1%%  *}" r="${1#*  }" s
  s="${r%%  *}" r="${r#*  }"
  r="${r#"${r%%[! ]*}"}"
  case "$r" in "$s"*) echo "$n $r" ;; *) echo "$n $s${r:+: $r}" ;; esac
}

# page_row repo|end|job|lane|feature|gpu … — a queue_jobs printer: `<section><TAB><row>`, then `blk<TAB><block>`, per item.
# Section: you (the Needs-you rules), run, queued, held or done. The row: lamp, title and reason as a link to the
# block (#job-<key>), the phase bar while it runs, tool chip, repo label, run time, one primary button.
# The block (hidden; the panel shows it): lamp, state, title, meta line, then the item's status_card.
page_row() {
  local sec lamp t="${2:-}" why="" pr="" dir="" ph="" k="" chip="" label="${P_REPO:-}" prog="" btn="" b="" bar="" el="" nm="" l c s e j fj="" body
  local st="${3:-}" meta="" pre="" x
  case "$1" in
    repo)
      P_REPO="$2" P_PATH="${3:-}"
      return 0
      ;;
    job) why="$4" pr="$5" dir="$6" ph="${7:-}" k="${6##*/}" ;;
    lane) prog="$4" why="$7" pr="$6" dir="$8" ph="${11:-}" k="$P_REPO/$2" ;;
    feature) prog="$4" why="$3${5:+ · $5}" k="feature/$2" chip=feature label="" ;;
    gpu) k="$2" el="$4" why="${8:-$5}" chip=GPU label="${5##*/}" ;;
    *) return 0 ;;
  esac
  case "$1/$3" in
    */running | */gpu) sec=run lamp=ok ;;
    */queued | */) sec=queued lamp=off ;;
    */held | gpu/parked) sec=held lamp=held ;;
    job/blocked) sec=you lamp=bad btn=answer ;;
    job/failed | job/timeout | job/skipped) sec=you lamp=bad btn=retry ;;
    lane/blocked | "feature/needs you") sec=you lamp=bad ;;
    "feature/your test") sec=you lamp=you btn=feature-ready ;;
    feature/merge) sec=you lamp=you btn=feature-archive ;;
    gpu/finished) sec="done" lamp="done" why="exit ${10}${11:+ · ${11}}" ;;
    *) sec="done" lamp="done" ;;
  esac
  if [[ "$1" == job && "$3" == held ]]; then why="$(jstate "$dir" held)"; fi
  # A lane needs you while an item is blocked, failed, timed out or skipped, also while another item runs
  # (report_rows lists that item on its own); a held item is in Held already. Its first such item is the reason.
  if [[ "$1" == lane ]]; then
    l=""
    while IFS= read -r x; do
      c="${x#*  }" && c="${c%% *}"
      if [[ -n "$x" && "$c" != held ]]; then l="$x" && break; fi
    done <<<"${9:-}"
    if [[ -n "$l" ]]; then
      sec=you lamp=bad why="$(item_why "$l")"
    elif [[ "$3" == blocked ]]; then
      sec=held lamp=held
    fi
  fi
  # A feature that needs you: its first blocking member is the reason, not the context.
  if [[ "$sec/$lamp/$1" == you/bad/feature && -n "$6" ]]; then why="$(item_why "${6%%$'\n'*}")"; fi
  # A done job whose gate or verify failed needs you, in a lane too, also while it runs (report_rows lists it on its own).
  case "$1/$sec" in
    job/done) if checks_failed "$dir"; then fj="$dir"; fi ;;
    lane/*)
      while IFS= read -r j; do
        if [[ -n "$j" && "$(jstate "$j" status)" == "done" && ! -f "$j/held" ]] && checks_failed "$j"; then fj="$j"; fi
      done <<<"${10}"
      ;;
  esac
  if [[ -n "$fj" ]]; then
    sec=you lamp=bad c="$(jstate "$fj" gate)"
    if [[ "$c" =~ ^[1-9] ]]; then why="gate exit $c"; else why="verify: $(jstate "$fj" verify)"; fi
    if [[ "$1" == lane ]]; then why="$(short_id "$fj" "$P_REPO"): $why"; fi
    if [[ "$pr" == http* ]]; then btn=fix; fi
    st="$why"
  elif [[ "$sec" == "done" && "$1" != gpu ]]; then
    if pr_missed "$pr"; then
      sec=you lamp=bad why="$pr" st="$pr"
    elif [[ "$pr" == http* ]]; then
      sec=you lamp=you btn=open why="PR #${pr##*/} to review" st="PR #${pr##*/} to review"
    elif [[ "$1" == job ]]; then
      btn=archive
    fi
  fi
  if [[ "$1" == job && -n "$(jget "$dir/job" tool)" ]]; then chip="$(jget "$dir/job" tool) · $(tool_place "$dir")"; fi
  if [[ "$sec" == run && -n "$dir" ]]; then
    read -r s e <<<"$(job_span "$dir")"
    if [[ -n "$s" ]]; then el="$(printf '%d:%02d' $(((e - s) / 3600)) $(((e - s) % 3600 / 60)))"; fi
  fi
  # The phase bar: a segment per phase line, the running step's name after it.
  if [[ "$sec" == run && -n "$ph" ]]; then
    while IFS= read -r l; do
      case "$l" in "✓ "*) c=' class="ok"' ;; "▶ "*) c=' class="run"' nm="${l#▶ }" ;; "✗ "*) c=' class="bad"' ;; *) c="" ;; esac
      bar+="<i$c></i>"
    done <<<"$ph"
    case "$nm" in R[0-9]*) nm="Review ${nm#R}" ;; esac
    bar="<span class=\"pbar\" title=\"$(esc "${ph//$'\n'/ · }")\">$bar${nm:+<span>$(esc "$nm")</span>}</span>"
  fi
  j="${fj:-$dir}"
  case "$btn" in
    # A field: the row's button opens the block, page.js focuses its first field; a lane's card has no Fix field.
    answer) b="<span class=\"jacts p\"><a class=\"btn go\" href=\"#job-$(esc "$k")\">Answer</a></span>" ;;
    fix)
      b="<span class=\"jacts p\"><a class=\"btn go\" href=\"#job-$(esc "$k")\">Fix</a></span>"
      if [[ "$1" == lane ]]; then pre="<div class=\"jacts\" data-id=\"$(esc "${j##*/}")\" data-pr=\"$(esc "$pr")\">$(act_btn fix)</div>"; fi
      ;;
    open) b="<a class=\"btn\" href=\"$(esc "$pr")\" target=\"_blank\" rel=\"noopener\">Open PR</a>" ;;
    feature-*) b="<span class=\"jacts p\" data-feature=\"$(esc "$2")\">$(act_btn "$btn")</span>" ;;
    ?*) b="<span class=\"jacts p\" data-id=\"$(esc "${j##*/}")\"${pr:+ data-pr=\"$(esc "$pr")\"}>$(act_btn "$btn")</span>" ;;
  esac
  body="$(status_card "$@")"
  # A lane that ended has no dir: the repo comes from queue_jobs' repo line.
  if [[ "$pr" == http* && -n "${P_PATH:-}" ]]; then
    body+="<div class=\"jacts\" data-repo=\"$(esc "$P_PATH")\"><button data-act=\"merge-order\">Merge order</button></div>"
  fi
  if [[ "$1" == job ]]; then l="$(jget "$dir/job" branch)"; else l=""; fi
  for c in "$label" "$l" "$chip" "$el"; do meta+="${c:+${meta:+ · }$c}"; done
  printf '%s\t<div class="row" data-k="%s"><i class="lamp l-%s"></i><a class="t" href="#job-%s"><b>%s%s</b>%s</a>%s%s%s%s%s</div>\n' \
    "$sec" "$(esc "$k")" "$lamp" "$(esc "$k")" "$(esc "$t")" "${prog:+ <span class=\"n\">$(esc "$prog")</span>}" "${why:+<span class=\"why\">$(esc "$why")</span>}" \
    "$bar" "${chip:+<span class=\"chip\">$(esc "$chip")</span>}" "${label:+<code class=\"repo\">$(esc "$label")</code>}" \
    "${el:+<span class=\"el\">$(esc "$el")</span>}" "$b"
  printf 'blk\t<div class="blk" id="job-%s" hidden><div class="bh"><i class="lamp l-%s"></i><span class="st">%s</span><h2>%s%s</h2>%s</div>%s%s</div>\n' \
    "$(esc "$k")" "$lamp" "$(esc "$st")" "$(esc "$t")" "${prog:+ <span class=\"n\">$(esc "$prog")</span>}" "${meta:+<code class=\"meta\">$(esc "$meta")</code>}" \
    "$pre" "${body//$'\n'/}"
}

# page_sections ROWS — of page_row's lines, the Needs-you count on line 1, then the page's sections: Needs you and
# Running open, then Queued, Held, Triage (triage.md) and Done folded to one line, each only when it has a row.
page_sections() {
  local s h you="" run="" que="" held="" dn="" ny=0 nr=0 nq=0 nh=0 nd=0 tri="" nt
  while IFS=$'\t' read -r s h; do
    case "$s" in
      you) you+="$h" ny=$((ny + 1)) ;;
      run) run+="$h" nr=$((nr + 1)) ;;
      queued) que+="$h" nq=$((nq + 1)) ;;
      held) held+="$h" nh=$((nh + 1)) ;;
      "done") dn+="$h" nd=$((nd + 1)) ;;
    esac
  done <<<"$1"
  echo "$ny"
  printf '<section class="sec" data-k="you"><h2>Needs you <span class="n">%s</span></h2>%s</section>\n' "$ny" "${you:-<p class=\"none\">Nothing needs you.</p>}"
  printf '<section class="sec" data-k="run"><h2>Running <span class="n">%s</span></h2>%s</section>\n' "$nr" "${run:-<p class=\"none\">No job runs.</p>}"
  if ((nq)); then printf '<details class="sec" data-k="queued"><summary>Queued <span class="n">%s</span></summary>%s</details>\n' "$nq" "$que"; fi
  if ((nh)); then printf '<details class="sec" data-k="held"><summary>Held <span class="n">%s</span></summary>%s</details>\n' "$nh" "$held"; fi
  if [[ -f "$QROOT/triage.md" ]]; then
    nt="$(grep -c '^- ' "$QROOT/triage.md" || true)"
    tri="$(md_html <"$QROOT/triage.md")"
    printf '<details class="sec" data-k="triage"><summary>Triage <span class="n">%s</span></summary><div class="md">\n%s\n</div></details>\n' "$nt" "$tri"
  fi
  if ((nd)); then printf '<details class="sec" data-k="done"><summary>Done <span class="n">%s</span></summary>%s</details>\n' "$nd" "$dn"; fi
}

# page_status RUNNING HOLDER — the header line: lamp, slots in use, paused, the usage limit or the 5h use, the GPU holder,
# the render time.
page_status() {
  local lamp=ok t="" lim
  lim="$(limit_line)"
  if [[ -e "$QROOT/paused" ]]; then lamp=warn t=" · paused"; fi
  if limited; then
    # A weekly limit resets days later: the date stays unless it is today.
    lim="$(at_time "$(head -n 1 "$QROOT/limit")")"
    if [[ "${lim%% *}" == "$(date +%F)" ]]; then lim="${lim#* }"; fi
    lamp=bad t+=" · usage limit until $lim"
  elif [[ -n "$lim" ]]; then
    t+=" · $lim"
  fi
  if [[ -n "$2" ]]; then t+=" · GPU: $2"; fi
  printf '<i class="lamp l-%s"></i><span>%s of %s slots%s · <span class="updated" data-t="%s">updated %s</span></span>' \
    "$lamp" "$1" "$(qconf slots 4)" "$(esc "$t")" "$(date +%s)" "$(date '+%H:%M:%S')"
}

# queue_web — QROOT/web/index.html, page.js and fonts/ from templates/; the runner writes them each pass.
# Per-process tmp files: vibe-web runs `vibe queue page` while the runner may be mid-pass.
queue_web() {
  local f="$QROOT/web/index.html" r rows jobs you tab=vibe yn="" x hb hold ws
  read -r r _ <<<"$(queue_counts)"
  hold="$(gpu_holder)" ws="$(ws_page "$hold")"
  rows="$(queue_jobs page_row)"
  jobs="$(page_sections "$rows")"
  you="${jobs%%$'\n'*}" jobs="${jobs#*$'\n'}"
  if ((you > 0)); then tab="($you) vibe" yn="$you"; fi
  hb='<button data-act="pause">Pause</button>'
  if [[ -e "$QROOT/paused" ]]; then hb='<button data-act="resume">Resume</button>'; fi
  if limited; then hb+='<button data-act="unlimit">Clear limit</button>'; fi
  mkdir -p "${f%/*}/fonts" || return 1
  # The page's only script: CSP script-src 'self' blocks HTML an agent wrote into a note or a triage line.
  cp "$SELF_ROOT/templates/queue-page.js" "$f.js.$$" && mv -f "$f.js.$$" "${f%/*}/page.js" || return 1
  # Fonts from the page's own origin: the CSP blocks Google Fonts. Copied when the repo's copy is newer.
  for x in "$SELF_ROOT"/templates/fonts/*; do
    if [[ "$x" -nt "${f%/*}/fonts/${x##*/}" ]]; then
      cp "$x" "$f.font.$$" && mv -f "$f.font.$$" "${f%/*}/fonts/${x##*/}" || return 1
    fi
  done
  if render_template "$SELF_ROOT/templates/queue-page.html" \
    '<tab>' "$tab" \
    '<you>' "$yn" \
    '<status>' "$(page_status "$r" "$hold")" \
    '<actions>' "$hb" \
    '<jobs>' "$jobs" \
    '<wsrail>' "${ws%%$'\n'*}" \
    '<workspaces>' "${ws#*$'\n'}" \
    '<config>' "$(config_page)" \
    '<blocks>' "$(awk -F'\t' '$1 == "blk" { print substr($0, 5) }' <<<"$rows")" \
    '<new>' "$(new_work)" >"$f.tmp.$$"; then
    mv -f "$f.tmp.$$" "$f"
  else
    rm -f "$f.tmp.$$"
    return 1
  fi
}

# in_list NEEDLE WORD... — true when NEEDLE is one of the words.
in_list() {
  local n="$1" w
  shift
  for w in "$@"; do [[ "$w" != "$n" ]] || return 0; done
  return 1
}

# md_line FILE KEY — the text after `**KEY:**` on its first line in FILE.
md_line() {
  local t
  t="$(grep -m 1 "^\*\*$2:\*\*" "$1" 2>/dev/null || true)"
  t="${t#\*\*"$2":\*\*}"
  echo "${t# }"
}

# report_tldr JOB — the `Changed:` line of the job's pr.md, else its result.
report_tldr() {
  local t
  t="$(md_line "$1/pr.md" Changed)"
  echo "${t:-$(jstate "$1" note)}"
}

# report_context JOB — `context=` of the job file, else the `Context:` line of pr.md or report.md.
report_context() {
  local t
  t="$(jget "$1/job" context)"
  [[ -n "$t" ]] || t="$(md_line "$1/pr.md" Context)"
  [[ -n "$t" ]] || t="$(md_line "$1/report.md" Context)"
  echo "$t"
}

# report_row JOB TEXT — one table row: id, status, context, gate, verify and TEXT and the job's cost, links.
report_row() {
  local d="$1" pr ctx g v links="" txt="${2//|//}" stats
  pr="$(jstate "$d" pr)" ctx="$(report_context "$d")" g="$(jstate "$d" gate)" v="$(jstate "$d" verify)" stats="$(job_stats "$d")"
  case "$pr" in http*) links="[PR]($pr)" ;; esac
  [[ ! -f "$d/report.md" ]] || links="${links:+$links · }[report](file://$d/report.md)"
  if [[ -n "$stats" ]]; then txt="${txt:+$txt · }$stats"; fi
  if [[ -n "$v" ]]; then txt="V: $v · $txt"; fi
  if [[ -n "$g" ]]; then
    links="${links:+$links · }[gate](file://$d/gate.log)"
    if [[ "$g" == 0 ]]; then txt="gate exit 0 · $txt"; else txt="**gate exit $g** · $txt"; fi
  fi
  echo "| ${d##*/} | $(jstate "$d" status) | ${ctx//|//} | $txt | $links |"
}

# checks_failed JOB — true when the gate failed, or the verify step failed (verify_failed).
checks_failed() {
  [[ "$(jstate "$1" gate)" =~ ^[1-9] ]] && return 0
  verify_failed "$1"
}

# verify_failed JOB — true when the verify step failed, changed the tree or gave no verdict.
verify_failed() {
  case "$(jstate "$1" verify)" in fail* | dirty* | timeout* | "verify failed"*) return 0 ;; esac
  return 1
}

# pr_missed TEXT — true when a job's `pr` text says that no PR carries its commits.
pr_missed() { [[ "$1" == "push failed"* || "$1" == "PR not created"* ]]; }

# report_rows REPO TITLE CLASS... — one table of REPO's ended, unheld jobs in
# the classes: a status, `gate` (done with a failing gate or verify step), `nopr` (done, `pr` holds
# `push failed…` or `PR not created`), or `pr` (done with a PR URL; `done` is then done without one).
# That `pr` note leads the row in every class. A branch with 2+ jobs is one row (group_of) in the `pr`
# or `done` table; a job of it that needs the user keeps its own row. No rows, no table.
report_rows() {
  local repo="$1" title="$2" d b cls rows="" seen=$'\n' links nx note pr grp
  shift 2
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ -f "$d/job" && ! -f "$d/held" && "$(jget "$d/job" repo)" == "$repo" ]] || continue
    job_settled "$d" || continue
    cls="$(jstate "$d" status)" note=""
    if [[ "$cls" == "done" ]] && checks_failed "$d"; then cls=gate; fi
    # A done member job is in its feature's row.
    if [[ "$cls" == "done" ]] && is_member "$d"; then continue; fi
    group_of "$d"
    pr="$(jstate "$d" pr)" grp=0
    if ((${#GROUP[@]} > 1)) && [[ "$cls" == "done" ]]; then pr="$G_PR" grp=1; fi
    if pr_missed "$pr"; then
      note="**$pr** · "
      if [[ "$cls" == "done" ]]; then cls="nopr"; fi
    elif [[ "$pr" == http* && "$cls" == "done" ]]; then
      cls="pr"
    fi
    in_list "$cls" "$@" || continue
    if ((grp)); then
      b="$(jget "$d/job" branch)"
      [[ "$seen" != *$'\n'"$b"$'\n'* ]] || continue
      seen+="$b"$'\n'
      links=""
      case "$pr" in http*) links="[PR]($pr)" ;; esac
      nx="$G_NEXT"
      if [[ "$nx" == - && "${G_PROGRESS%/*}" == "${G_PROGRESS#*/}" ]]; then nx="$(report_tldr "$(printf '%s\n' "${GROUP[@]}" | LC_ALL=C sort | tail -n 1)")"; fi
      rows+="| $b | $G_PROGRESS | ${G_CTX//|//} | ${note//|//}${nx//|//} | $links |"$'\n'
      continue
    fi
    rows+="$(report_row "$d" "$note$(report_tldr "$d")$(side_suffix "$d")")"$'\n'
  done
  [[ -n "$rows" ]] || return 0
  echo
  echo "### $title"
  echo
  echo "| Job | Status | Context | TL;DR | Links |"
  echo "| --- | --- | --- | --- | --- |"
  printf '%s' "$rows"
}

# feature_md — the report's Features table: per feature its pill, done/members, context,
# each member as its PR link (else repo:branch) and its state, the file. No feature, no table.
feature_md() {
  local f r b p ms rows="" mem ctx
  while IFS= read -r f; do
    feature_row "$f"
    mem=""
    while IFS='|' read -r r b p ms _; do
      [[ -n "$r" ]] || continue
      if [[ "$p" == http* ]]; then mem+="${mem:+ · }[${r##*/}#${p##*/}]($p) $ms"; else mem+="${mem:+ · }${r##*/}:$b $ms"; fi
    done <<<"$F_MEMBERS"
    ctx="$(md_line "$f" Context)"
    rows+="| $(basename "$f" .md) | $F_PILL | $F_PROGRESS | ${ctx//|//} | $mem | [file](file://$f) |"$'\n'
  done < <(feature_files)
  [[ -n "$rows" ]] || return 0
  printf '\n## Features\n\n| Feature | State | Done | Context | Members | Links |\n| --- | --- | --- | --- | --- | --- |\n%s' "$rows"
}

# queue_front_md — held jobs under "Yours", then the triage lines: the top of the report. The page has its own: page_sections.
queue_front_md() {
  local d rows=""
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ -f "$d/held" ]] || continue
    rows+="$(report_row "$d" "$(jstate "$d" held)")"$'\n'
  done
  if [[ -n "$rows" ]]; then
    printf '\n## Yours\n\n| Job | Status | Context | Note | Links |\n| --- | --- | --- | --- | --- |\n%s' "$rows"
  fi
  if [[ -f "$QROOT/triage.md" ]]; then
    echo
    cat "$QROOT/triage.md"
  fi
}

# queue_report_md — the report: the header (with the 5h limit), queue_front_md, the
# Features table, then per repo ranked tables (needs a human, PRs to read, the rest), then the next
# action of every unheld job that did not finish or failed its gate.
queue_report_md() {
  local d st g wt repo rows="" lim
  echo "# Vibe queue — $(date '+%F %H:%M')"
  echo
  lim="$(limit_line)"
  echo "$(queue_header)${lim:+ · $lim}"
  queue_front_md
  feature_keys
  feature_md
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    rows="$(
      report_rows "$repo" "Needs you" blocked failed timeout skipped gate nopr
      report_rows "$repo" "PR ready" pr
      report_rows "$repo" "Done, nothing to read" "done"
    )"
    [[ -n "$rows" ]] || continue
    echo
    echo "## ${repo##*/}"
    echo "$rows"
  done < <(queue_repos)
  for d in "$QDIR"/*/; do
    d="${d%/}"
    st="$(jstate "$d" status)" g="$(jstate "$d" gate)"
    [[ "$g" =~ ^[1-9] ]] || g=""
    case "$st" in blocked | failed | timeout | skipped) ;; *) [[ -n "$g" ]] || continue ;; esac
    [[ -f "$d/job" && ! -f "$d/held" ]] || continue
    wt="$(jstate "$d" worktree)"
    echo
    echo "## ${d##*/} — $st${g:+ · gate exit $g}"
    echo
    echo "- Repo: $(jget "$d/job" repo) · branch \`$(jget "$d/job" branch)\`"
    if [[ -n "$g" ]]; then
      printf -- '- Gate: %s\n\n```\n' "$d/gate.log"
      tail -n 20 "$d/gate.log"
      printf '```\n'
    fi
    [[ -z "$wt" ]] || echo "- Worktree: $wt"
    [[ ! -f "$d/report.md" ]] || echo "- Report: $d/report.md"
    if [[ -n "$wt" && -f "$wt/HANDOFF.md" ]]; then
      echo "- Next action:"
      md_section "$wt/HANDOFF.md" "Next action" "  "
      echo "- Blockers:"
      md_section "$wt/HANDOFF.md" Blockers "  "
    fi
    case "$st" in failed | timeout) echo "- Log: $d/log" ;; esac
  done
}

# vibe queue report — the report of the jobs to review, on stdout.
cmd_queue_report() {
  [[ $# -eq 0 ]] || die "usage: vibe queue report"
  queue_report_md
}

cmd_queue() {
  role_gate queue "$@"
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add | run | status | report | hold | archive | pause | resume | page | gpu | follow | conf | unlimit | set | retry | cancel | stop | steer | answer | fix | ready | new | roadmap) "cmd_queue_$sub" "$@" ;;
    merge-order) cmd_queue_merge_order "$@" ;;
    *) die "usage: vibe queue add|new|roadmap|run|status|report|hold|archive|pause|resume|page|conf|unlimit|set|retry|cancel|stop|steer|answer|fix|ready|merge-order — see vibe --help" ;;
  esac
}

# --- feature: branches in several repos that merge together (docs/vibe-queue.md) ---

FROOT="$QROOT/features"

# feature_members FILE — `repo<TAB>branch<TAB>pr` per `- <repo> <branch> [<pr>]` line under `## Members`.
feature_members() {
  awk '/^## / { m = ($0 == "## Members"); next }
    m && /^- / { sub(/\/$/, "", $2); print $2 "\t" $3 "\t" $4 }' "$1" 2>/dev/null || true
}

# feature_files — the registered feature files, one per line.
feature_files() {
  local f
  for f in "$FROOT"/*.md; do
    if [[ -f "$f" ]]; then echo "$f"; fi
  done
}

# feature_of REPO BRANCH — the file of the feature with REPO's BRANCH as a member; empty when none.
feature_of() {
  local f r b
  while IFS= read -r f; do
    while IFS=$'\t' read -r r b _; do
      if [[ "$r" == "${1%/}" && "$b" == "$2" ]]; then
        echo "$f"
        return 0
      fi
    done < <(feature_members "$f")
  done < <(feature_files)
}

# feature_keys — FKEYS: `<repo>#<branch>` of every member, one per line, framed by newlines.
feature_keys() {
  local f r b
  FKEYS=$'\n'
  while IFS= read -r f; do
    while IFS=$'\t' read -r r b _; do FKEYS+="$r#$b"$'\n'; done < <(feature_members "$f")
  done < <(feature_files)
}

# is_member JOB — true when JOB's repo and branch are a feature member (FKEYS of feature_keys).
is_member() {
  local r
  r="$(jget "$1/job" repo)"
  [[ "$FKEYS" == *$'\n'"${r%/}#$(jget "$1/job" branch)"$'\n'* ]]
}

# feature_row FILE — F_PILL, F_PROGRESS (done/members), F_ITEMS (a `<repo> · <branch>  <status>  <note>`
# line per member that needs you) and F_MEMBERS (`repo|branch|pr|state|note` per member).
# A member is done with a PR and no job queued, running or in need of you (a done job with a
# failed gate does, and so does a last `pr` note of pr_missed); without either PR or job, it needs you. Pill: needs you, running, queued, `your test`, `merge` (ready marker).
feature_row() {
  local f="$1" r b p j st jn ms note n=0 ok=0 you=0 run=0 wait=0 mrun mwait any c lastpr
  F_ITEMS="" F_MEMBERS=""
  while IFS=$'\t' read -r r b p; do
    n=$((n + 1)) ms="" note="" mrun=0 mwait=0 any=0 lastpr=""
    while IFS= read -r j; do
      [[ -n "$j" ]] || continue
      any=1 st="$(jstate "$j" status)" jn="$(jstate "$j" note)$(side_suffix "$j")"
      [[ ! -f "$j/held" ]] || st=held
      if [[ "$st" == "done" && "$(jstate "$j" gate)" =~ ^[1-9] ]]; then st=gate jn="gate exit $(jstate "$j" gate)"; fi
      case "$st" in
        running | gpu) mrun=1 ;;
        "" | queued) mwait=1 ;;
        held | blocked | failed | timeout | skipped | gate)
          if [[ -z "$ms" ]]; then ms="$st" note="$jn"; fi
          if [[ "$st" == held ]]; then ms=held note="$(jstate "$j" held)"; fi
          F_ITEMS+="${r##*/} · $b  $st  $jn"$'\n'
          ;;
      esac
      c="$(jstate "$j" pr)"
      if [[ -n "$c" ]]; then lastpr="$c"; fi
      if [[ -z "$p" && "$c" == http* ]]; then p="$c"; fi
    done < <(branch_jobs "$r" "$b")
    if [[ -z "$ms" ]]; then
      if ((mrun)); then
        ms=running
      elif ((mwait)); then
        ms=queued
      elif pr_missed "$lastpr"; then
        ms="$lastpr"
        F_ITEMS+="${r##*/} · $b  no PR  $lastpr"$'\n'
      elif [[ "$p" != http* ]]; then
        ms="no PR"
        F_ITEMS+="${r##*/} · $b  no PR  no job runs and no PR is open"$'\n'
      elif ((any)); then
        ms="done"
      else
        ms="no job"
      fi
    fi
    case "$ms" in
      running) run=1 ;;
      queued) wait=1 ;;
      "done" | "no job") ok=$((ok + 1)) ;;
      *) you=1 ;;
    esac
    F_MEMBERS+="$r|$b|$p|$ms|${note:-$p}"$'\n'
  done < <(feature_members "$f")
  F_PILL="your test"
  if ((you)); then
    F_PILL="needs you"
  elif ((run)); then
    F_PILL=running
  elif ((wait)); then
    F_PILL=queued
  elif [[ -f "${f%.md}.ready" ]]; then
    F_PILL=merge
  fi
  F_PROGRESS="$ok/$n"
}

# feature_set_pr FILE REPO BRANCH URL — the member line of REPO's BRANCH in FILE ends in URL.
# Two jobs of one feature end together: the read-and-write runs under a FILE.lock directory.
feature_set_pr() {
  local t rc=0 tries=0
  # shortcut: a lock over 1 min old is a killed job's; the waiter that gets FILE.reap removes it. A reaper killed
  # inside that step leaves FILE.reap and blocks the removal; a waiter fails after 3 min. flock is not on macOS.
  until mkdir "$1.lock" 2>/dev/null; do
    tries=$((tries + 1))
    if ((tries > 1800)); then
      echo "vibe: no lock on $1 after 3 min — remove $1.lock and $1.reap if no job runs, or check the directory is writable" >&2
      return 1
    fi
    if [[ -n "$(find "$1.lock" -prune -mmin +1 2>/dev/null)" ]] && mkdir "$1.reap" 2>/dev/null; then
      if [[ -n "$(find "$1.lock" -prune -mmin +1 2>/dev/null)" ]]; then rmdir "$1.lock" 2>/dev/null || true; fi
      rmdir "$1.reap" 2>/dev/null || true
    fi
    sleep 0.1
  done
  t="$(mktemp "$1.XXXXXX")" && awk -v r="${2%/}" -v b="$3" -v u="$4" '
    /^## / { m = ($0 == "## Members") }
    m && /^- / { x = $2; sub(/\/$/, "", x); if (x == r && $3 == b) $0 = "- " $2 " " $3 " " u }
    { print }' "$1" >"$t" && mv -f "$t" "$1" || rc=1
  rmdir "$1.lock" 2>/dev/null || true
  return "$rc"
}

# feature_prompt JOB — a member job's prompt.md ends with the feature block, once.
feature_prompt() {
  local d="$1" f
  f="$(feature_of "$(jget "$d/job" repo)" "$(jget "$d/job" branch)")"
  [[ -n "$f" ]] || return 0
  if grep -q '^## Feature$' "$d/prompt.md"; then return 0; fi
  {
    printf '\n## Feature\n\n'
    echo "This branch is one member of the feature \`$(basename "$f" .md)\`: $(md_line "$f" Context)"
    echo "Read the feature file first: $f. It holds the goal, the decisions and the contract."
    echo "- Never change a contract row, in the code or in the file. A change needs the user."
    echo "- The task needs a contract change: write the result \`blocked: contract <interface>: <the change you propose>\` and stop."
  } >>"$d/prompt.md"
}

# feature_body JOB FILE — JOB/pr-body.md gets the `**Feature:**` line below its TL;DR (siblings as
# repo#pr, else repo:branch) and the feature's decisions and contract in a <details> above its footer.
feature_body() {
  local d="$1" f="$2" b="$1/pr-body.md" r m p repo branch name sib="" det t
  repo="$(jget "$d/job" repo)" branch="$(jget "$d/job" branch)" name="$(basename "$f" .md)"
  while IFS=$'\t' read -r r m p; do
    if [[ "$r" == "${repo%/}" && "$m" == "$branch" ]]; then continue; fi
    if [[ "$p" == http* ]]; then sib+="${sib:+, }[${r##*/}#${p##*/}]($p)"; else sib+="${sib:+, }${r##*/}:$m"; fi
  done < <(feature_members "$f")
  det="$(
    printf '<details>\n<summary>Feature %s: decisions and contract</summary>\n\n' "$name"
    md_section "$f" Decisions
    echo
    md_section "$f" Contract
    printf '\n</details>\n'
  )"
  t="$(mktemp "$b.XXXXXX")" || return 1
  FLINE="**Feature:** $name — merges together with $sib" FDET="$det" awk '
    FNR == NR { if ($0 == "---") n = FNR; if (/^\*\*Decisions\/risks:\*\*/) r = 1; next }
    !r && !t && NF { print ENVIRON["FLINE"]; print ""; t = 1 }
    FNR == n { print ENVIRON["FDET"]; print "" }
    { print }
    r && !t && /^\*\*Decisions\/risks:\*\*/ { print ENVIRON["FLINE"]; t = 1 }
    END { if (!n) { print ""; print ENVIRON["FDET"] } }' "$b" "$b" >"$t" && mv -f "$t" "$b"
}

# vibe feature add FILE — check FILE, copy it to FROOT/<name>.md and fill in the open PRs.
cmd_feature_add() {
  local src="${1:-}" name dst r b p f t c n=0 seen=$'\n'
  [[ $# -eq 1 && -f "$src" ]] || die "usage: vibe feature add <file>"
  name="$(basename "$src" .md)"
  [[ -n "$name" && "$(slug "$name")" == "$name" ]] || die "'$name' is not a slug — name the file <slug>.md"
  dst="$FROOT/$name.md"
  [[ ! -e "$dst" ]] || die "feature '$name' exists: $dst"
  while IFS=$'\t' read -r r b _; do
    n=$((n + 1))
    [[ "$r" == /* ]] || die "$r is not an absolute path — jobs match a member by their absolute repo"
    [[ "$seen" != *$'\n'"$r#$b"$'\n'* ]] || die "$r $b is listed twice"
    seen+="$r#$b"$'\n'
    git -C "$r" rev-parse --git-dir >/dev/null 2>&1 || die "$r is not a git repo"
    c="$(cd "$r" && pwd)"
    [[ "$c" == "$r" ]] || die "$r is not the path jobs store as their repo — write $c"
    git -C "$r" rev-parse -q --verify "refs/heads/$b" >/dev/null ||
      git -C "$r" rev-parse -q --verify "refs/remotes/origin/$b" >/dev/null || die "no branch '$b' in $r"
    f="$(feature_of "$r" "$b")"
    [[ -z "$f" ]] || die "${r##*/} $b is a member of feature '$(basename "$f" .md)'"
  done < <(feature_members "$src")
  ((n >= 2)) || die "a feature needs 2 or more '- <repo> <branch>' lines under ## Members"
  mkdir -p "$FROOT"
  t="$(mktemp "$dst.XXXXXX")"
  cp "$src" "$t"
  while IFS=$'\t' read -r r b p; do
    if [[ -z "$p" ]]; then p="$(pr_of "$(open_prs "$r")" "$b")"; fi
    if [[ -n "$p" ]]; then feature_set_pr "$t" "$r" "$b" "$p"; fi
    echo "  ${r##*/} · $b${p:+ · $p}"
  done < <(feature_members "$src")
  mv "$t" "$dst"
  echo "feature $name: $n members → $dst"
}

# vibe feature ready SLUG — the human test passed: the card shows `merge`.
cmd_feature_ready() {
  [[ $# -eq 1 ]] || die "usage: vibe feature ready <slug>"
  [[ -f "$FROOT/$1.md" ]] || die "no feature '$1' in $FROOT"
  date '+%F %T' >"$FROOT/$1.ready"
  echo "ready $1: the batch waits for the merges"
}

# vibe feature archive SLUG... — move features to archive/<YYYY-MM>/features/; refuses an open member PR.
cmd_feature_archive() {
  local a f r b p st
  (($#)) || die "usage: vibe feature archive <slug>..."
  a="$QROOT/archive/$(date +%Y-%m)/features"
  for f in "$@"; do
    [[ -f "$FROOT/$f.md" ]] || die "no feature '$f' in $FROOT"
    feature_row "$FROOT/$f.md"
    while IFS='|' read -r r b p _; do
      [[ "$p" == http* ]] || continue
      st="$(gh pr view "$p" --json state -q .state)" || die "gh pr view $p failed"
      [[ "$st" != OPEN ]] || die "feature $f: $p is open — merge or close it first"
    done <<<"$F_MEMBERS"
    mkdir -p "$a"
    mv "$FROOT/$f.md" "$a/"
    if [[ -f "$FROOT/$f.ready" ]]; then mv "$FROOT/$f.ready" "$a/"; fi
    echo "archived feature $f"
  done
}

cmd_feature() {
  role_gate feature "$@"
  local sub="${1:-}"
  shift || true
  case "$sub" in
    add | ready | archive) "cmd_feature_$sub" "$@" ;;
    *) die "usage: vibe feature add|ready|archive — see vibe --help" ;;
  esac
}

# --- job: recurring jobs, added to the queue by the 01:00 timer (docs/vibe-jobs.md)

JOBS_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/vibe/jobs"
JOBS_ROOT="${VIBE_ROOT:-$(dirname "$SELF_ROOT")}"
JOBS_CATALOGUE="${VIBE_JOBS_CATALOGUE:-$SELF_ROOT/skills/recurring-jobs/references/jobs}"

# fm_get FILE KEY — `KEY: value` from FILE's frontmatter; empty when absent.
fm_get() {
  awk -v k="$2" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); print v; exit }' "$1" 2>/dev/null || true
}
# fm_has FILE KEY — true when FILE's frontmatter has KEY, even with no value.
fm_has() {
  awk -v k="$2" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 && index($0, k ":") == 1 { f = 1; exit }
    END { exit !f }' "$1" 2>/dev/null
}
# fm_body FILE — FILE after its frontmatter (the whole file without one).
fm_body() {
  awk 'NR == 1 && $0 != "---" { all = 1 } all { print; next } NR > 1 && !on && $0 == "---" { on = 1; next } on { print }' "$1" 2>/dev/null || true
}

# job_repos [REPO...] — absolute repo paths: the arguments, else every repo
# under the root with a .vibe-jobs/ opt-in.
job_repos() {
  local r
  if (($#)); then
    for r in "$@"; do job_repo_path "$r"; done
    return 0
  fi
  for r in "$JOBS_ROOT"/*/.vibe-jobs/; do
    r="${r%/.vibe-jobs/}"
    if [[ -n "$(job_names "$r")" ]]; then echo "$r"; fi
  done
}
job_repo_path() {
  case "$1" in */*) echo "$1" ;; *) echo "$JOBS_ROOT/$1" ;; esac
}

# job_names REPO — the jobs REPO opted into: one per <repo>/.vibe-jobs/<name>.md.
job_names() {
  local f
  for f in "$1"/.vibe-jobs/*.md; do
    [[ -f "$f" ]] || continue
    f="${f##*/}"
    case "$f" in _*) continue ;; esac
    echo "${f%.md}"
  done
}

# job_key REPO JOB KEY DEFAULT — the repo file's value, else the catalogue's, else DEFAULT.
job_key() {
  local v
  v="$(fm_get "$1/.vibe-jobs/$2.md" "$3")"
  [[ -n "$v" ]] || v="$(fm_get "$JOBS_CATALOGUE/$2.md" "$3")"
  echo "${v:-$4}"
}

# job_check REPO JOB — "ok", or why the job cannot run.
job_check() {
  local repo="$1" job="$2" sched
  [[ "$(slug "$job")" == "$job" ]] || {
    echo "bad name '$job'"
    return 0
  }
  sched="$(job_key "$repo" "$job" schedule "")"
  case "$sched" in
    daily | weekly | monthly) ;;
    "") echo "no schedule — not in the catalogue, and the repo file sets none" && return 0 ;;
    *) echo "bad schedule '$sched'" && return 0 ;;
  esac
  if [[ ! -f "$JOBS_CATALOGUE/$job.md" && -z "$(fm_body "$repo/.vibe-jobs/$job.md" | grep -v '^[[:space:]]*$' || true)" ]]; then
    echo "not in the catalogue, and the repo file has no instructions"
    return 0
  fi
  echo ok
}

# job_state REPO JOB FILE — a state file's first line (last-run epoch, fails).
job_state() { head -n 1 "$JOBS_STATE/$(basename "$1")/$2/$3" 2>/dev/null || true; }

# job_state_update JOB-DIR STATUS — done: stamp last-run, forget failures,
# keep a `done:` result as last-result; failed/timeout: one more failure.
# Two in a row stop the job (job_due). A job that queued a GPU run (`gpu-job`)
# is not done until its follow-up is: its own done changes nothing.
job_state_update() {
  local d="$1" st="$2" dir n
  dir="$JOBS_STATE/$(basename "$(jget "$d/job" repo)")/$(jget "$d/job" recurring)"
  mkdir -p "$dir"
  case "$st" in
    "done")
      if [[ -f "$d/gpu-job" ]]; then return 0; fi
      date +%s >"$dir/last-run"
      rm -f "$dir/fails"
      case "$(jstate "$d" result)" in "done:"*) jstate "$d" result >"$dir/last-result" ;; esac
      ;;
    failed | timeout)
      # A stop is your tap, not a failure: it must not count toward the two that disable the job.
      if [[ -e "$d/stop" ]]; then return 0; fi
      n="$(head -n 1 "$dir/fails" 2>/dev/null || echo 0)"
      echo $((n + 1)) >"$dir/fails"
      ;;
  esac
}

# job_live REPO JOB — true when the queue holds an unfinished copy of the recurring job.
job_live() {
  local d
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ "$(jget "$d/job" recurring)" == "$2" && "$(jget "$d/job" repo)" == "$1" ]] || continue
    if ! job_final "$d"; then return 0; fi
  done
  return 1
}

# job_due REPO JOB — "due", "stopped" (two failures), "queued" (a copy is in
# the queue), "not due", "invalid".
job_due() {
  local repo="$1" job="$2" sched day last fails now period today
  [[ "$(job_check "$repo" "$job")" == ok ]] || {
    echo invalid
    return 0
  }
  fails="$(job_state "$repo" "$job" fails)"
  if ((${fails:-0} >= 2)); then
    echo stopped
    return 0
  fi
  if job_live "$repo" "$job"; then
    echo queued
    return 0
  fi
  sched="$(job_key "$repo" "$job" schedule "")" day="$(job_key "$repo" "$job" day "")"
  case "$sched" in
    daily) period=72000 ;;
    weekly) period=518400 ;;
    monthly) period=2332800 ;;
  esac
  last="$(job_state "$repo" "$job" last-run)"
  now="$(date +%s)"
  today="$(LC_ALL=C date +%a | tr '[:upper:]' '[:lower:]')"
  if ((now - ${last:-0} < period)) || [[ -n "$day" && "$day" != "$today" ]]; then
    echo "not due"
  else
    echo due
  fi
}

# vibe job list [--all] [REPO...] — one row per repo × job; --all adds the
# catalogue jobs REPO has not opted into, as `available`.
# shellcheck disable=SC2120  # config_md calls it with no arguments
cmd_job_list() {
  local repo job last fails why all=0 repos=() f
  for f in "$@"; do
    case "$f" in
      --all) all=1 ;;
      -h | --help) usage ;;
      -*) die "usage: vibe job list [--all] [<repo>...]" ;;
      *) repos+=("$f") ;;
    esac
  done
  printf '%-21s %-20s %-8s %-4s %-11s %s\n' REPO JOB SCHEDULE DAY LAST-RUN STATE
  while IFS= read -r repo; do
    [[ -d "$repo" ]] || {
      printf '%-21s %s\n' "$(basename "$repo")" "no directory $repo"
      continue
    }
    while IFS= read -r job; do
      [[ -n "$job" ]] || continue
      last="$(job_state "$repo" "$job" last-run)" fails="$(job_state "$repo" "$job" fails)"
      [[ -z "$last" ]] || last="$(date -d "@$last" +%F 2>/dev/null || date -r "$last" +%F)"
      why="$(job_due "$repo" "$job")"
      case "$why" in
        invalid) why="invalid: $(job_check "$repo" "$job")" ;;
        stopped) why="stopped: $fails failures — vibe job reset $(basename "$repo") $job" ;;
      esac
      printf '%-21s %-20s %-8s %-4s %-11s %s\n' "$(basename "$repo")" "$job" \
        "$(job_key "$repo" "$job" schedule -)" "$(job_key "$repo" "$job" day -)" "${last:-never}" "$why"
    done < <(job_names "$repo")
    ((all)) || continue
    for f in "$JOBS_CATALOGUE"/*.md; do
      job="${f##*/}" && job="${job%.md}"
      [[ "$job" != _* && ! -f "$repo/.vibe-jobs/$job.md" ]] || continue
      printf '%-21s %-20s %-8s %-4s %-11s %s\n' "$(basename "$repo")" "$job" \
        "$(fm_get "$f" schedule)" "$(fm_get "$f" day)" - "available — vibe job add $(basename "$repo") $job"
    done
  done < <(job_repos "${repos[@]+"${repos[@]}"}")
  sweep_line
}

# sweep_line — the repos the fill-queue sweep covers (~/.config/vibe/repos).
sweep_line() {
  local conf="$QCONF/repos" line names=""
  if [[ ! -f "$conf" ]]; then
    printf '\nfill-queue sweep: no %s\n' "$conf"
    return 0
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(echo "$line" | tr -d '[:space:]')"
    [[ -z "$line" ]] || names+="${names:+, }${line##*/}"
  done <"$conf"
  # shellcheck disable=SC2088  # a literal ~ for display
  case "$conf" in "$HOME"/*) conf="~/${conf#"$HOME"/}" ;; esac
  printf '\nfill-queue sweep (%s): %s\n' "$conf" "${names:-none}"
}

# job_open_prs REPO — "branch" per open PR a runner opened; empty without gh.
job_open_prs() {
  command -v gh >/dev/null 2>&1 || return 0
  (cd "$1" && gh pr list --label agent --state open --json headRefName -q '.[].headRefName' 2>/dev/null) || true
}

# job_write DIR REPO JOB — the job dir: `job` and the rendered prompt.
# Output drops to `report` when the repo already has 2 open job PRs and this
# job's branch is not one of them.
job_write() {
  local d="$1" repo="$2" job="$3" branch output prs n tpl f last
  branch="jobs/$job" last="$(job_state "$repo" "$job" last-result)"
  output="$(job_key "$repo" "$job" output pr)"
  if [[ "$output" == pr ]]; then
    prs="$(job_open_prs "$repo")"
    n="$(printf '%s\n' "$prs" | grep -c '^jobs/' || true)"
    if ((n >= 2)) && ! printf '%s\n' "$prs" | grep -qx "$branch"; then output=report; fi
  fi
  printf 'repo=%s\nbranch=%s\nmodel=%s\ntimeout=%s\nrecurring=%s\noutput=%s\n' \
    "$repo" "$branch" "$(job_key "$repo" "$job" model sonnet)" "$(job_key "$repo" "$job" timeout 1h)" \
    "$job" "$output" >"$d/job"
  for f in "$repo/.vibe-jobs/$job.md" "$JOBS_CATALOGUE/$job.md"; do
    if fm_has "$f" after; then
      echo "after=$(fm_get "$f" after)" >>"$d/job"
      break
    fi
  done
  tpl="$SELF_ROOT/skills/recurring-jobs/references/job-prompt.md"
  render_template "$tpl" \
    '<job>' "$job" \
    '<repo>' "$repo" \
    '<branch>' "$branch" \
    '<output>' "$output" \
    '<kind>' "$(job_key "$repo" "$job" kind code)" \
    '<last-result>' "${last:-none}" \
    '<timeout>' "$(job_key "$repo" "$job" timeout 1h)" \
    '<catalogue-instructions>' "$(fm_body "$JOBS_CATALOGUE/$job.md")" \
    '<repo-instructions>' "$(fm_body "$repo/.vibe-jobs/$job.md")" \
    '<pr-template>' "$(cat "$SELF_ROOT/templates/job-pr.md")" \
    '<report-template>' "$(cat "$SELF_ROOT/templates/job-report.md")" >"$d/prompt.md"
}

# job_queue DRY "REPO JOB"... — add the jobs to the queue.
job_queue() {
  local dry="$1" item tmp d
  shift
  if (($# == 0)); then
    echo "nothing to queue"
    return 0
  fi
  for item in "$@"; do
    if ((dry)); then
      echo "would queue: $item"
      continue
    fi
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-job.XXXXXX")"
    job_write "$tmp" "${item% *}" "${item##* }"
    d="$(queue_add "$tmp")"
    echo "queued ${d##*/} ($(jget "$d/job" output))"
  done
}

# job_args ARGS... — parse --dry, --max N; the rest into REST.
job_args() {
  DRY=0 MAX=8 REST=()
  while (($#)); do
    case "$1" in
      --dry) DRY=1 ;;
      --max) MAX="${2:?--max needs a number}" && shift ;;
      -h | --help) usage ;;
      -*) die "unknown option '$1'" ;;
      *) REST+=("$1") ;;
    esac
    shift
  done
  [[ "$MAX" =~ ^[1-9][0-9]*$ ]] || die "--max wants a positive number, got '$MAX'"
}

# job_stopped REPO JOB — add a `skipped` entry for a stopped job, unless the
# queue already holds one, so the report shows it under "Needs you".
job_stopped() {
  local repo="$1" job="$2" d tmp
  for d in "$QDIR"/*/; do
    d="${d%/}"
    [[ "$(jget "$d/job" repo)" == "$repo" && "$(jget "$d/job" branch)" == "jobs/$job" &&
    "$(jstate "$d" status)" == skipped ]] && return 0
  done
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-job.XXXXXX")"
  printf 'repo=%s\nbranch=jobs/%s\nmodel=sonnet\n' "$repo" "$job" >"$tmp/job"
  job_end "$tmp" skipped "stopped after 2 failures — vibe job reset $(basename "$repo") $job"
  queue_add "$tmp" >/dev/null
}

# vibe job due [--dry] [--max N] [REPO...] — add every due job to the queue,
# oldest last-run first, at most N. A stopped job lands as `skipped`.
cmd_job_due() {
  local repo job why last lines="" picked=() stopped=()
  job_args "$@"
  while IFS= read -r repo; do
    [[ -d "$repo" ]] || continue
    while IFS= read -r job; do
      [[ -n "$job" ]] || continue
      why="$(job_due "$repo" "$job")"
      case "$why" in
        due)
          last="$(job_state "$repo" "$job" last-run)"
          lines+="${last:-0} $repo $job"$'\n'
          ;;
        stopped) stopped+=("$repo $job") ;;
      esac
    done < <(job_names "$repo")
  done < <(job_repos "${REST[@]+"${REST[@]}"}")
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    ((${#picked[@]} < MAX)) || break
    picked+=("${repo#* }")
  done < <(printf '%s' "$lines" | sort -n -k1,1)
  job_queue "$DRY" "${picked[@]+"${picked[@]}"}"
  for job in "${stopped[@]+"${stopped[@]}"}"; do
    if ((!DRY)); then job_stopped "${job% *}" "${job##* }"; fi
    echo "stopped: $job (2 failures)"
  done
}

# vibe job run REPO JOB — add one job to the queue now, due or not.
cmd_job_run() {
  local repo why
  job_args "$@"
  ((${#REST[@]} == 2)) || die "usage: vibe job run <repo> <job>"
  repo="$(job_repo_path "${REST[0]}")"
  [[ -d "$repo" ]] || die "no directory $repo"
  why="$(job_check "$repo" "${REST[1]}")"
  [[ "$why" == ok ]] || die "${REST[1]} in $(basename "$repo"): $why"
  job_queue "$DRY" "$repo ${REST[1]}"
}

# TRIAGE_JQ — one line per PR: number url head base mergeable red-checks new-comments.
# EVENT_JQ — one line per fix request, oldest first: number url since fresh id text. INLINE_JQ — ME's inline comments.
# Split by \037: a tab IFS collapses an empty field. New, fresh: after the last non-merge commit.
# `def me` goes in front at run time. `asked`: starts a fix job. `told`: job_publish's summary comment.
# shellcheck disable=SC2016  # jq variables, not shell ones
TRIAGE_DEFS='def since: [.commits[] | select(.messageHeadline | startswith("Merge ") | not) | .committedDate] | max // "";
def asked: .author.login == me and ((.body | test("^/fix(\\s|$)")) or .state == "CHANGES_REQUESTED");
def told: .body | startswith("**Fix job**");
'
# shellcheck disable=SC2016
TRIAGE_JQ='.[] | since as $t
| [.number, .url, .headRefName, .baseRefName, .mergeable,
   ([.statusCheckRollup[] | select((.conclusion // .state // "") | test("^(FAILURE|ERROR|TIMED_OUT|CANCELLED|ACTION_REQUIRED|STARTUP_FAILURE)$")) | (.name // .context)] | join(", ")),
   (.comments + .reviews | map(select((asked or told) | not) | .createdAt // .submittedAt | select(. > $t)) | length)] | map(tostring) | join("\u001f")'
# shellcheck disable=SC2016
EVENT_JQ='.[] | since as $t | .number as $n | .url as $u | (.comments + .reviews | sort_by(.createdAt // .submittedAt))[] | select(asked)
| [$n, $u, $t, ((.createdAt // .submittedAt) > $t), .id, (.body | sub("^/fix\\s*"; "") | gsub("\\s+"; " "))] | map(tostring) | join("\u001f")'
INLINE_JQ='.[] | select(.user.login == me and .created_at > since) | "\(.path):\(.line // .original_line // "?") \(.body | gsub("\\s+"; " "))"'

# triage_merge REPO HEAD BASE — merge origin/BASE into origin/HEAD in a scratch
# worktree and push; one line on what happened. Skips a branch a job runs on
# or one with unpushed local commits: the push would strand their work.
triage_merge() {
  local repo="$1" head="$2" base="$3" d tmp files
  for d in "$QDIR"/*/; do
    d="${d%/}"
    if [[ "$(jget "$d/job" repo)" == "$repo" && "$(jget "$d/job" branch)" == "$head" &&
    "$(jstate "$d" status)" == running ]]; then
      echo "conflicts with $base; not merged: a job runs on it"
      return 0
    fi
  done
  if [[ "$(git -C "$repo" rev-list --count "origin/$head..refs/heads/$head" 2>/dev/null || echo 0)" != 0 ]]; then
    echo "conflicts with $base; not merged: local commits not pushed"
    return 0
  fi
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/vibe-triage.XXXXXX")/wt"
  if ! agent_git -C "$repo" worktree add -q --detach "$tmp" "origin/$head" >/dev/null 2>&1; then
    echo "conflicts with $base; not merged: no origin/$head"
    return 0
  fi
  if agent_git -C "$tmp" merge -q --no-edit -m "Merge branch '$base' into $head" "origin/$base" >/dev/null 2>&1; then
    if agent_push "$tmp" -q origin "HEAD:refs/heads/$head" 2>/dev/null; then
      echo "merged $base and pushed"
    else
      echo "merged $base; push failed"
    fi
  else
    files="$(agent_git -C "$tmp" diff --name-only --diff-filter=U | tr '\n' ' ')"
    agent_git -C "$tmp" merge --abort 2>/dev/null || true
    echo "conflicts with $base in ${files% }: needs a hand merge"
  fi
  agent_git -C "$repo" worktree remove --force "$tmp" 2>/dev/null || true
  rm -rf "${tmp%/wt}"
}

# triage_fix REPO ME PR URL SINCE EVENT TEXT — a fix job for EVENT: TEXT and ME's inline comments
# since SINCE; the agent has no gh, so its prompt carries them. One line on what happened.
# A process of its own: a `die` in `queue fix` must not end the triage.
triage_fix() {
  local text="$7" inline msg
  inline="$( (cd "$1" && gh api --paginate "repos/{owner}/{repo}/pulls/$3/comments?per_page=100" \
    -q "def me: \"$2\"; def since: \"$5\"; $INLINE_JQ") 2>/dev/null || true)"
  if [[ -n "$inline" ]]; then text="$text"$'\n'"$inline"; fi
  if msg="$(VIBE_EVENT="$6" "$SELF_ROOT/bin/vibe" queue fix "$4" ${text:+"$text"} 2>&1)"; then
    echo "fix job $msg"
  else
    echo "no fix job: ${msg#vibe: }"
  fi
}

# vibe job triage [REPO...] — every open agent PR of every repo under the
# root: merge the base into a conflicted one and push; a `/fix` or "Request
# changes" of your login starts one fix job; red CI and unanswered review
# comments become lines in QROOT/triage.md, which the report and the page show.
cmd_job_triage() {
  local repo n url head base mergeable red comments out lines="" r me defs since fresh seen id text
  command -v gh >/dev/null 2>&1 || {
    echo "no gh — nothing to triage"
    return 0
  }
  local repos=("$@")
  if ((${#repos[@]} == 0)); then
    for r in "$JOBS_ROOT"/*/; do [[ ! -d "$r/.git" ]] || repos+=("${r%/}"); done
  fi
  me="$(qconf pr_login "")"
  if [[ -z "$me" ]]; then me="$(gh api user -q .login 2>/dev/null || true)"; fi
  defs="def me: \"$me\"; $TRIAGE_DEFS"
  for repo in "${repos[@]+"${repos[@]}"}"; do
    repo="$(job_repo_path "$repo")"
    out="$( (cd "$repo" && gh pr list --label agent --state open \
      --json number,url,headRefName,baseRefName,mergeable,statusCheckRollup,comments,reviews,commits \
      -q "$defs$TRIAGE_JQ") 2>/dev/null || true)"
    [[ -n "$out" ]] || continue
    git -C "$repo" fetch -q origin 2>/dev/null || warn "$(basename "$repo"): fetch failed"
    while IFS=$'\037' read -r n url head base mergeable red comments; do
      [[ -n "$n" ]] || continue
      r="- $(basename "$repo") [#$n]($url) \`$head\`:"
      if [[ "$mergeable" == CONFLICTING ]]; then lines+="$r $(triage_merge "$repo" "$head" "$base")"$'\n'; fi
      if [[ -n "$red" ]]; then lines+="$r CI red: $red"$'\n'; fi
      if ((comments > 0)); then lines+="$r unanswered review comments: $comments"$'\n'; fi
    done <<<"$out"
    # No login, no event: an empty `me` must not match an author.
    [[ -n "$me" ]] || continue
    out="$( (cd "$repo" && gh pr list --label agent --state open --json number,url,comments,reviews,commits \
      -q "$defs$EVENT_JQ") 2>/dev/null || true)"
    seen=""
    while IFS=$'\037' read -r n url since fresh id text; do
      [[ -n "$id" ]] || continue
      if grep -qsxF "event=$id" "$QDIR"/*/job "$QROOT"/archive/*/*/job; then
        seen="$url"
        continue
      fi
      # A later commit answers an event, but a fix job's commits answer only the events of that job.
      if [[ "$fresh" == false && "$seen" != "$url" ]]; then continue; fi
      lines+="- $(basename "$repo") [#$n]($url): $(triage_fix "$repo" "$me" "$n" "$url" "$since" "$id" "$text")"$'\n'
    done <<<"$out"
  done
  mkdir -p "$QROOT"
  if [[ -z "$lines" ]]; then
    rm -f "$QROOT/triage.md"
    echo "triage: nothing to report"
    return 0
  fi
  printf '## Triage — %s\n\n%s' "$(date '+%F %H:%M')" "$lines" >"$QROOT/triage.md"
  printf '%s' "$lines"
}

# vibe job add REPO JOB — render templates/VIBE_JOB.md to <repo>/.vibe-jobs/<job>.md.
cmd_job_add() {
  local repo="${1:?usage: vibe job add <repo> <job>}" job="${2:?usage: vibe job add <repo> <job>}" f
  repo="$(job_repo_path "$repo")"
  [[ -d "$repo" ]] || die "no directory $repo"
  [[ "$(slug "$job")" == "$job" ]] || die "bad job name '$job'"
  [[ -f "$JOBS_CATALOGUE/$job.md" ]] || info "'$job' is not in the catalogue — the file needs its own schedule and instructions"
  f="$repo/.vibe-jobs/$job.md"
  [[ ! -e "$f" ]] || die "$f exists — edit it"
  mkdir -p "$repo/.vibe-jobs"
  render_template "$SELF_ROOT/templates/VIBE_JOB.md" '<job>' "$job" '<repo>' "$(basename "$repo")" >"$f"
  echo "wrote $f — edit, then commit it"
}

# vibe job reset REPO JOB — forget JOB's failures: a stopped job is due again by its schedule.
cmd_job_reset() {
  local repo
  (($# == 2)) || die "usage: vibe job reset <repo> <job>"
  [[ "$(slug "$2")" == "$2" ]] || die "bad job name '$2'"
  repo="$(job_repo_path "$1")"
  rm -f "$JOBS_STATE/$(basename "$repo")/$2/fails"
  echo "reset $2 in $(basename "$repo")"
}

cmd_job() {
  role_gate job "$@"
  local sub="${1:-}"
  shift || true
  case "$sub" in
    list | due | run | add | triage | reset) "cmd_job_$sub" "$@" ;;
    *) die "usage: vibe job list|due|run|add|triage|reset — see vibe --help" ;;
  esac
}

# --- ws: outside research tools, one folder each under workspaces/ (docs/workspaces.md) ---

WS_ROOT="${VIBE_WORKSPACES:-$SELF_ROOT/workspaces}"
WS_STATES="$QROOT/workspaces"
WS_INST_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$' # docker's container-name rule

# ws_check DIR — "ok", or the first reason DIR/workspace.conf breaks the contract.
ws_check() {
  [[ -f "$1/workspace.conf" && -r "$1/workspace.conf" ]] || {
    echo "no readable workspace.conf"
    return 0
  }
  awk '
    function bad(m) { print m; done = 1; exit }
    function each(v, sep, re, what,  a, n, j) {
      n = split(v, a, sep)
      for (j = 1; j <= n; j++) if (a[j] !~ re) bad(what " " a[j])
    }
    /^[ \t]*(#|$)/ { next }
    {
      i = index($0, "=")
      if (i < 2) bad("not key=value: " $0)
      k = substr($0, 1, i - 1)
      v = substr($0, i + 1)
      if (k in seen) bad("twice: " k)
      seen[k] = v
      if (k == "kind") { if (v != "service" && v != "run") bad("kind=" v ": service or run") }
      else if (k == "runs") { if (v != "container" && v != "host") bad("runs=" v ": container or host") }
      else if (k == "gpu") { if (v != "yes" && v != "no") bad("gpu=" v ": yes or no") }
      else if (k == "places") each(v, ",", "^(turing|runpod|vast)$", "unknown place")
      else if (k == "hours") { if (v !~ /^[1-9][0-9]*$/) bad("hours=" v ": a whole number above 0") }
      else if (k == "commit") { if (length(v) != 40 || v ~ /[^0-9a-f]/) bad("commit=" v ": 40 hex") }
      else if (k == "secrets") each(v, " ", "^[A-Z_][A-Z0-9_]*$", "bad env name")
      else if (k == "ports") each(v, ",", "^[0-9]+$", "bad port")
      else if (k == "result") { if (v != "branch" && v != "folder") bad("result=" v ": branch or folder") }
      else if (k != "label" && k != "role" && k != "image") bad("unknown key " k)
    }
    END {
      if (done) exit
      if (seen["kind"] == "") bad("no kind")
      if (seen["places"] == "") bad("no places")
      if (seen["kind"] == "service" && "result" in seen) bad("result on a service")
      if (seen["kind"] == "run" && seen["result"] == "") bad("kind=run needs result")
      print "ok"
    }' "$1/workspace.conf"
}

# vibe ws list — one line per workspace (a directory not named _*): name, kind, gpu, places,
# label: role; a bad conf prints why, exit 1.
cmd_ws_list() {
  local d n c f l g bad=0
  (($# == 0)) || die "usage: vibe ws list"
  [[ -d "$WS_ROOT" ]] || die "no folder $WS_ROOT"
  for d in "$WS_ROOT"/*/; do
    n="${d%/}" n="${n##*/}"
    if [[ ! -d "$d" || "$n" == _* ]]; then continue; fi
    c="$(ws_check "$WS_ROOT/$n")"
    [[ "$(slug "$n")" == "$n" ]] || c="bad name: lower case, digits, . _ -"
    if [[ "$c" != ok ]]; then
      printf '%-16s bad conf: %s\n' "$n" "$c"
      bad=1
      continue
    fi
    f="$WS_ROOT/$n/workspace.conf"
    l="$(jget "$f" label)" g="$(jget "$f" gpu)"
    printf '%-16s %-7s gpu=%-3s %-18s %s\n' "$n" "$(jget "$f" kind)" "${g:-no}" "$(jget "$f" places)" "${l:+$l: }$(jget "$f" role)"
  done
  return "$bad"
}

# ws_holder INSTANCE-DIR — the pid of its live `gpu-queue lock` holder; fails when none.
# After a reboot the pid can name another process: its command must end in `ws hold <instance>`.
ws_holder() {
  local p
  p="$(jstate "$1" holder)"
  [[ "$p" =~ ^[1-9][0-9]*$ && "$(ps -o command= -p "$p" 2>/dev/null || true)" == *" ws hold ${1##*/}" ]] && echo "$p"
}

# ws_gpu INSTANCE-DIR — true when its place is turing and its tool has gpu=yes: it runs under the GPU lock.
ws_gpu() {
  local n
  n="$(ws_name "${1##*/}")" || return 1
  [[ "$(jstate "$1" place)" == turing && "$(jget "$WS_ROOT/$n/workspace.conf" gpu)" == yes ]]
}

# ws_stopper INSTANCE-DIR — the pid of its live page stop (`vibe ws down`); fails when none. Same pid check as ws_holder.
ws_stopper() {
  local p
  p="$(jstate "$1" stops)"
  [[ "$p" =~ ^[1-9][0-9]*$ && "$(ps -o command= -p "$p" 2>/dev/null || true)" == *" ws down ${1##*/}" ]] && echo "$p"
}

# ws_state INSTANCE-DIR — waits for the GPU, starts while its holder runs ws_up, stops while a page stop runs,
# down with no id file, past limit when limit has passed, else up.
ws_state() {
  local lim
  lim="$(jstate "$1" limit)"
  if [[ -e "$1/waits" ]] && ws_holder "$1" >/dev/null; then
    echo "waits for the GPU"
  elif [[ -e "$1/starts" ]] && ws_holder "$1" >/dev/null; then
    echo starts
  elif ws_stopper "$1" >/dev/null; then
    echo stops
  elif [[ ! -s "$1/id" ]]; then
    echo down
  elif [[ "$lim" =~ ^[0-9]+$ ]] && ((lim <= $(date +%s))); then
    echo "past limit"
  else
    echo up
  fi
}

# ws_inst INSTANCE — dies unless INSTANCE names a state dir; docker's container-name rule, a job id can hold upper case.
ws_inst() {
  [[ "$1" =~ $WS_INST_RE && -d "$WS_STATES/$1" ]] || die "no instance '$1' — vibe ws status"
}

# ws_line INSTANCE-DIR — instance, state, place, then limit and address, tab-separated; state files only.
ws_line() {
  local s lim more=""
  s="$(ws_state "$1")"
  if [[ "$s" != down ]]; then
    lim="$(jstate "$1" limit)"
    more="${lim:+until $(at_time "$lim") }$(jstate "$1" url)"
  elif [[ -s "$1/hold.log" ]] && ! ws_holder "$1" >/dev/null; then
    # A gpu=yes start that failed after `ws start` returned: its holder's last line is the reason.
    more="$(tail -n 1 "$1/hold.log")"
    if [[ "$more" == "vibe: holds the GPU" ]]; then more=""; fi
  fi
  printf '%s\t%s\t%s\t%s\n' "${1##*/}" "$s" "$(jstate "$1" place)" "$more"
}

# ws_lines — ws_line of each instance.
ws_lines() {
  local d
  for d in "$WS_STATES"/*/; do
    if [[ -d "$d" ]]; then ws_line "${d%/}"; fi
  done
}

# vibe ws status [INSTANCE] — one line per instance: state, place, limit, address; state files only.
cmd_ws_status() {
  (($# <= 1)) || die "usage: vibe ws status [<instance>]"
  if (($#)); then
    ws_inst "$1"
    ws_line "$WS_STATES/$1"
  else
    ws_lines
  fi | awk -F'\t' '{ l = sprintf("%-24s %-10s %-7s %s", $1, $2, $3, $4); sub(/ +$/, "", l); print l }'
}

# ws_dir NAME — the folder of workspace NAME; dies on no such workspace or a conf that breaks the contract.
ws_dir() {
  local c
  [[ -n "$1" && "$1" != [._]* && "$(slug "$1")" == "$1" && -d "$WS_ROOT/$1" ]] || die "no workspace '$1' — vibe ws list"
  c="$(ws_check "$WS_ROOT/$1")"
  [[ "$c" == ok ]] || die "$1: bad conf: $c"
  echo "$WS_ROOT/$1"
}

# ws_name INSTANCE — its workspace: INSTANCE is <name> or <name>-<job id>; the longest name wins.
ws_name() {
  local n="$1"
  until [[ "$n" != _* && -d "$WS_ROOT/$n" ]]; do
    [[ "$n" == *-* ]] || return 1
    n="${n%-*}"
  done
  echo "$n"
}

# ws_place INSTANCE VERB [ARG...] — the place script of INSTANCE with WS_* and WS_CONF_<KEY> set (docs/workspaces.md).
# The folder: the instance's dir file (a research run), else its workspace under WS_ROOT.
# A subshell with errexit off when tested: each lookup has its own `|| die`.
ws_place() {
  local inst="$1"
  shift
  (
    w="$(jstate "$WS_STATES/$inst" dir)"
    if [[ -z "$w" ]]; then
      n="$(ws_name "$inst")" || die "no workspace for instance $inst"
      w="$WS_ROOT/$n"
    fi
    p="$(jstate "$WS_STATES/$inst" place)"
    [[ -n "$p" && "$(slug "$p")" == "$p" && -f "$WS_ROOT/_places/$p" && -x "$WS_ROOT/_places/$p" ]] ||
      die "no place script '$p' for $inst"
    while IFS= read -r l; do export "WS_CONF_$l"; done < <(
      awk '/^[a-z]+=/ { i = index($0, "="); print toupper(substr($0, 1, i - 1)) substr($0, i) }' "$w/workspace.conf"
    )
    # A WS_HOURS the caller set (a tool job's hours=) wins over the conf's.
    export WS_INSTANCE="$inst" WS_STATE="$WS_STATES/$inst" WS_DIR="$w" WS_HOURS="${WS_HOURS:-${WS_CONF_HOURS:-}}"
    # WS_SECS set: timeout(1) ends the call after WS_SECS, exit 124; no timeout(1) means no bound.
    if [[ -n "${WS_SECS:-}" ]] && t="$(command -v timeout || command -v gtimeout)"; then
      exec "$t" -k 10 "$WS_SECS" "$WS_ROOT/_places/$p" "$@"
    fi
    exec "$WS_ROOT/_places/$p" "$@"
  )
}

# ws_secrets NAME CONF — dies unless ~/.config/vibe/workspaces/NAME.env is mode 600 and sets each of CONF's secrets.
ws_secrets() {
  local f="$HOME/.config/vibe/workspaces/$1.env" s k miss=""
  s="$(jget "$2" secrets)"
  [[ -n "$s" ]] || return 0
  [[ -f "$f" ]] || die "$1 needs $s: write KEY=VALUE lines to $f, mode 600"
  case "$(ls -lL "$f")" in
    -rw-------* | -r--------*) ;;
    *) die "$f: others can read it — chmod 600 $f" ;;
  esac
  for k in $s; do
    [[ -n "$(jget "$f" "$k")" ]] || miss+=" $k"
  done
  [[ -z "$miss" ]] || die "$f does not set:$miss"
}

# ws_up INSTANCE — place up, the start script (120 s at most, VIBE_WS_START_SECS), the url;
# a failed start brings the place down again.
ws_up() {
  local st="$WS_STATES/$1" url="" secs="${VIBE_WS_START_SECS:-120}" r=0
  ws_place "$1" up || die "up of $1 failed"
  # A page or GPU start: `starts` holds `script` from here on, and stop waits for up (ws_stop_cuts).
  if [[ -e "$st/starts" ]]; then echo script >"$st/starts"; fi
  WS_SECS="$secs" ws_place "$1" exec start || r=$?
  if ((r)); then
    ws_place "$1" down >&2 || true
    if ((r == 124)); then die "start of $1 ran past $secs s — it is down again"; fi
    die "start of $1 failed — it is down again"
  fi
  if [[ -n "$(jget "$WS_ROOT/$(ws_name "$1")/workspace.conf" ports)" ]]; then
    url="$(ws_place "$1" url)" || warn "no address for $1"
    if [[ -n "$url" ]]; then echo "$url" >"$st/url"; fi
  fi
  ws_up_line "$1"
}

ws_up_line() {
  local u
  u="$(jstate "$WS_STATES/$1" url)"
  echo "$1 up${u:+ — $u}"
}

# vibe ws build NAME — docker build NAME's image at its pinned commit, tagged with it.
cmd_ws_build() {
  local d f
  (($# == 1)) || die "usage: vibe ws build <name>"
  d="$(ws_dir "$1")"
  f="$d/workspace.conf"
  [[ "$(jget "$f" runs)" != host ]] || die "$1 runs on the host: no image to build"
  [[ -n "$(jget "$f" image)" && -n "$(jget "$f" commit)" ]] || die "$1: workspace.conf needs image and commit"
  docker build -t "$(jget "$f" image):$(jget "$f" commit)" --build-arg "COMMIT=$(jget "$f" commit)" "$d"
}

# vibe ws start NAME [--place P] [--hours N] — a kind=service tool up at P (the first of its places) for N hours
# (its hours=). gpu=yes on turing, or a start from the page (VIBE_WEB: a rented place takes minutes): a detached
# `vibe ws hold` starts it, under `gpu-queue lock` for the GPU, and keeps the lock until stop.
cmd_ws_start() {
  local d f st n="${1:-}" place="" hours="" pid i u="usage: vibe ws start <name> [--place P] [--hours N]"
  local -a lock=()
  (($#)) || die "$u"
  shift
  while (($#)); do
    case "$1" in --place=* | --hours=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;; esac
    (($# >= 2)) || die "$u"
    case "$1" in
      --place) place="$2" ;;
      --hours) hours="$2" ;;
      *) die "$u" ;;
    esac
    shift 2
  done
  d="$(ws_dir "$n")"
  f="$d/workspace.conf" st="$WS_STATES/$n"
  [[ "$(jget "$f" kind)" == service ]] || die "$n is kind=run: the queue runs it as a job"
  ws_secrets "$n" "$f"
  [[ "$(ws_state "$st")" == down ]] || die "$n is $(ws_state "$st") — vibe ws stop $n first"
  if [[ -z "$place" ]]; then place="$(jget "$f" places)" place="${place%%,*}"; fi
  [[ "$place" =~ ^[a-z]+$ && ",$(jget "$f" places)," == *",$place,"* ]] || die "$n has no place '$place' — places=$(jget "$f" places)"
  [[ -z "$hours" || "$hours" =~ ^[1-9][0-9]*$ ]] || die "--hours $hours: a whole number above 0"
  [[ -x "$WS_ROOT/_places/$place" ]] || die "no place script '$place' in $WS_ROOT/_places"
  mkdir -p "$st"
  echo "$place" >"$st/place"
  rm -f "$st/waits" "$st/starts" "$st/holder" "$st/url" "$st/hold.log"
  # WS_HOURS: ws_place hands it to the place's up, here or in the detached hold; empty: the conf's hours.
  if ws_gpu "$st"; then
    lock=("$SELF_ROOT/bin/gpu-queue" lock --)
    : >"$st/waits"
  elif [[ -z "${VIBE_WEB:-}" ]]; then
    WS_HOURS="$hours" ws_up "$n"
    return 0
  fi
  set -m
  WS_HOURS="$hours" nohup ${lock[@]+"${lock[@]}"} "$SELF_ROOT/bin/vibe" ws hold "$n" </dev/null >"$st/hold.log" 2>&1 &
  pid=$!
  set +m
  echo "$pid" >"$st/holder"
  for ((i = 0; ; i++)); do
    if grep -qxF "vibe: holds the GPU" "$st/hold.log"; then
      ws_up_line "$n"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      if wait "$pid"; then
        ws_up_line "$n"
        return 0
      fi
      cat "$st/hold.log" >&2
      die "start of $n failed — $st/hold.log"
    fi
    # The CLI waits for up, as a script uses the url next; the page and a wait for the lock return.
    if ((i >= 15)) && [[ -e "$st/waits" || -n "${VIBE_WEB:-}" ]]; then
      if [[ -e "$st/waits" ]]; then echo "$n waits for the GPU — vibe ws status $n"; else echo "$n starts — vibe ws status $n"; fi
      return 0
    fi
    sleep 0.2
  done
}

# vibe ws hold INSTANCE — start's detached command: the instance up; under the GPU lock, then wait until its id file goes.
cmd_ws_hold() {
  local st
  (($# == 1)) || die "usage: vibe ws hold <instance>"
  ws_inst "$1"
  st="$WS_STATES/$1"
  rm -f "$st/waits"
  : >"$st/starts"
  ws_up "$1"
  rm -f "$st/starts"
  if ws_gpu "$st"; then
    echo "vibe: holds the GPU"
    while [[ -s "$st/id" ]]; do sleep "${VIBE_WS_POLL:-10}"; done
  fi
}

# vibe ws run INSTANCE — a tool job's run (tool_run): up, the run script, down; exit: the run script's.
cmd_ws_run() {
  local r=0
  (($# == 1)) || die "usage: vibe ws run <instance>"
  ws_inst "$1"
  ws_place "$1" up || die "up of $1 failed"
  ws_place "$1" exec run || r=$?
  ws_place "$1" down || warn "down of $1 failed — vibe ws status $1"
  return "$r"
}

# ws_stop_cuts INSTANCE-DIR — true while a detached start runs the place's up: before ws_up marks `starts` with `script`.
ws_stop_cuts() { [[ -e "$1/starts" && "$(jstate "$1" starts)" != script ]]; }

# vibe ws stop INSTANCE — its stop script, then place down; a GPU holder ends then, and the lock is free.
# From the page (VIBE_WEB) a detached `vibe ws down` does it: vibe-web kills a command after 120 s.
cmd_ws_stop() {
  local st pid s i
  (($# == 1)) || die "usage: vibe ws stop <instance>"
  ws_inst "$1"
  st="$WS_STATES/$1"
  pid="$(ws_holder "$st")" || pid=""
  if [[ -e "$st/waits" && -n "$pid" ]]; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    rm -f "$st/waits" "$st/holder" "$st/hold.log"
    echo "$1 stopped — it waited for the GPU"
    return 0
  fi
  if [[ -n "$pid" ]] && ws_stop_cuts "$st"; then
    # Each place's up traps TERM and removes what it made; wait for that, 60 s at most.
    kill -TERM -- "-$pid" 2>/dev/null || true
    for ((i = 0; i < 300; i++)); do
      kill -0 -- "-$pid" 2>/dev/null || break
      sleep 0.2
    done
    rm -f "$st/starts" "$st/holder" "$st/hold.log"
    echo "$1 stopped — its place was not up yet"
    return 0
  fi
  s="$(ws_state "$st")"
  # A down beside a running start script races it: stop once it is up.
  [[ "$s" != starts ]] || die "$1 starts — stop it once it is up: vibe ws status $1"
  [[ "$s" != stops ]] || die "$1 stops already — vibe ws status $1"
  rm -f "$st/waits"
  [[ -s "$st/id" ]] || die "$1 is down"
  if [[ -n "${VIBE_WEB:-}" ]]; then
    set -m
    nohup "$SELF_ROOT/bin/vibe" ws down "$1" </dev/null >"$st/stop.log" 2>&1 &
    echo "$!" >"$st/stops"
    set +m
    echo "$1 stops — vibe ws status $1"
    return 0
  fi
  ws_down "$1" || die "down of $1 failed — vibe ws status $1"
  echo "$1 down"
}

# vibe ws down INSTANCE — a page stop's detached command: ws_down, then the stops file goes.
# shortcut: a failed one shows only in stop.log, and the page offers Stop again; show its reason when one fails.
cmd_ws_down() {
  local r=0
  (($# == 1)) || die "usage: vibe ws down <instance>"
  ws_inst "$1"
  ws_down "$1" || r=$?
  rm -f "$WS_STATES/$1/stops"
  ((r == 0)) || die "down of $1 failed — vibe ws status $1"
  rm -f "$WS_STATES/$1/stop.log"
  echo "$1 down"
}

# ws_down INSTANCE — its stop script (300 s at most, VIBE_WS_STOP_SECS), then place down;
# then a GPU holder ends and the lock is free. down has no bound: a cut pull loses data.
ws_down() {
  local st="$WS_STATES/$1" pid secs="${VIBE_WS_STOP_SECS:-300}" r=0 rc=0
  pid="$(ws_holder "$st")" || pid=""
  if [[ -z "$pid" ]]; then rm -f "$st/holder"; fi
  WS_SECS="$secs" ws_place "$1" exec stop || r=$?
  if ((r == 124)); then
    warn "the stop script of $1 ran past $secs s — down anyway"
  elif ((r != 0 && r != 3)); then
    warn "the stop script of $1 failed (exit $r) — down anyway"
  fi
  ws_place "$1" down || rc=1
  # The lock follows the id file: a container down failed to remove keeps it.
  if [[ -n "$pid" && ! -s "$st/id" ]]; then
    kill -TERM -- "-$pid" 2>/dev/null || true
    rm -f "$st/holder"
  fi
  rm -f "$st/hold.log"
  return "$rc"
}

# vibe ws tick — for each instance with an id: past its limit the stop script and down, else the place's tick,
# 600 s at most (VIBE_WS_TICK_SECS): one hung pull must not keep the next instance from its limit.
cmd_ws_tick() {
  local d i secs="${VIBE_WS_TICK_SECS:-600}"
  for d in "$WS_STATES"/*/; do
    d="${d%/}" i="${d##*/}"
    if [[ ! -s "$d/id" ]] || ws_stopper "$d" >/dev/null; then
      continue # down, or its page stop runs ws_down
    elif [[ "$(ws_state "$d")" == "past limit" ]]; then
      ws_down "$i" || warn "down of $i past its limit failed"
    else
      WS_SECS="$secs" ws_place "$i" tick || warn "tick of $i failed or ran past $secs s"
    fi
  done
}

# ws_tick_bg — the runner pass: `vibe ws tick` in the background, never two at once.
ws_tick_bg() {
  local p
  p="$(jstate "$WS_STATES" tick.pid)"
  # The command, not only a live pid: tick.pid outlives a reboot, and its pid then names another process.
  if [[ "$p" =~ ^[1-9][0-9]*$ && "$(ps -o command= -p "$p" 2>/dev/null || true)" == *" ws tick" ]]; then return 0; fi
  if ! compgen -G "$WS_STATES/*/id" >/dev/null; then return 0; fi
  "$SELF_ROOT/bin/vibe" ws tick </dev/null >>"$WS_STATES/tick.log" 2>&1 &
  echo "$!" >"$WS_STATES/tick.pid"
}

cmd_ws() {
  role_gate ws "$@"
  local sub="${1:-}"
  shift || true
  case "$sub" in
    list | status | build | start | stop | tick | hold | down | run) "cmd_ws_$sub" "$@" ;;
    *) die "usage: vibe ws list|status|build|start|stop|tick — see vibe --help" ;;
  esac
}

# One group ending in exit: bash never reads this file again after the command (an edit mid-run made vibe exit 2).
{
  case "${1:-}" in
    queue)
      shift
      cmd_queue "$@"
      ;;
    job)
      shift
      cmd_job "$@"
      ;;
    feature)
      shift
      cmd_feature "$@"
      ;;
    ws)
      shift
      cmd_ws "$@"
      ;;
    update-toolkit)
      shift
      cmd_update_toolkit "$@"
      ;;
    start | sync | status)
      cmd="$1"
      shift
      # sync fetches every repo anyway, so its check never uses the cache.
      if [[ "$cmd" == sync ]]; then VIBE_FETCH_INTERVAL=0 toolkit_check; else toolkit_check; fi
      "cmd_$cmd" "$@"
      ;;
    -h | --help | help) usage ;;
    *) die "unknown command '${1:-}' — vibe help" ;;
  esac
  exit
}
