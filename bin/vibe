#!/usr/bin/env bash
#
# vibe — one worktree per task, opened in VS Code; git carries it between machines.
#
#   vibe start [-C <repo>] <task>   make or adopt <repo>/.claude/worktrees/<task>, open it
#                                   (runs each <agent>/vibe-start.sh <worktree> <repo>-<task>)
#   vibe sync [--all] [--wip]       push, fast-forward, report every worktree
#   vibe status --<agent>           agent servers on this machine (<agent>/vibe-status.sh)
#   vibe update-toolkit             pull the toolkit checkout, install, doctor
#   vibe night start --<agent> <dir> [--jobs N] [--until HH:MM] [--timeout DUR]
#                                   run the night's jobs in tmux (<agent>/vibe-night.sh)
#   vibe night status [<dir>]       one line per job of a night (default: the latest)
#   vibe night report [--<agent>] [--new] [--day] [<dir>...]
#                                   the day's briefing over the active nights; open a session on it
#   vibe job list [<repo>...]       recurring jobs per repo: schedule, last run, due
#   vibe job due --<agent> [--dry] [--max N]
#                                   queue every due job on tonight's night (the 01:00 timer)
#   vibe job run --<agent> <repo> <job>   queue one job now
#   vibe job add <repo> <job>       opt <repo> in: write <repo>/.agent-jobs/<job>.md
#
# Docs: docs/remote-sessions.md, docs/night-shift.md, docs/recurring-jobs.md.
set -euo pipefail

script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

SELF_ROOT="$(dirname "$(script_dir)")"
# shellcheck disable=SC2034  # read by the lib's die/info message prefix
LIB_PROG=vibe
# shellcheck disable=SC1091  # path only exists at runtime, resolved above
. "$SELF_ROOT/skills/_lib/lib.sh"

usage() {
  sed -n '5,19s/^# \{0,1\}//p' "$SELF_ROOT/bin/vibe"
  exit "${1:-0}"
}
warn() { echo "vibe: warning: $*" >&2; }

# default_branch REPO — origin's HEAD branch; main when origin names none.
default_branch() {
  local ref
  ref="$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  ref="${ref:-origin/main}"
  echo "${ref#origin/}"
}

TOOLKIT="$(cd -P "${VIBE_TOOLKIT:-$SELF_ROOT}" 2>/dev/null && pwd || echo "${VIBE_TOOLKIT:-$SELF_ROOT}")"

# toolkit_check — one warning line when the installed toolkit differs from origin.
toolkit_check() {
  local t="$TOOLKIT" cache stamp now def b ahead behind
  git -C "$t" rev-parse --git-dir >/dev/null 2>&1 || return 0
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/vibe/last-fetch"
  now="$(date +%s)"
  stamp="$(stat -c %Y "$cache" 2>/dev/null || stat -f %m "$cache" 2>/dev/null || echo 0)"
  if ((now - stamp >= ${VIBE_FETCH_INTERVAL:-300})); then
    mkdir -p "$(dirname "$cache")" && touch "$cache"
    GIT_TERMINAL_PROMPT=0 git -C "$t" fetch -q origin 2>/dev/null || true
  fi
  def="$(default_branch "$t")"
  b="$(git -C "$t" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [[ "$b" == "$def" ]] || warn "toolkit checkout $t is on '$b', not $def"
  [[ -z "$(git -C "$t" status --porcelain --untracked-files=no)" ]] ||
    warn "toolkit checkout $t has uncommitted changes"
  git -C "$t" rev-parse -q --verify "origin/$def" >/dev/null || return 0
  read -r ahead behind < <(git -C "$t" rev-list --left-right --count "HEAD...origin/$def" 2>/dev/null || true)
  if ((${ahead:-0} > 0 && ${behind:-0} > 0)); then
    warn "toolkit checkout has diverged from origin/$def"
  elif ((${behind:-0} > 0)); then
    warn "toolkit is $behind commits behind origin/$def — run: vibe update-toolkit"
  fi
}

# ensure_exclude MAIN — keep .claude/worktrees/ out of git status in every checkout.
ensure_exclude() {
  local f
  f="$(git -C "$1" rev-parse --git-common-dir)/info/exclude"
  case "$f" in /*) ;; *) f="$1/$f" ;; esac
  mkdir -p "$(dirname "$f")"
  grep -qxF '.claude/worktrees/' "$f" 2>/dev/null || echo '.claude/worktrees/' >>"$f"
}

# worktree_of MAIN BRANCH — path of the worktree that has BRANCH checked out.
worktree_of() {
  git -C "$1" worktree list --porcelain | awk -v b="refs/heads/$2" '
    /^worktree / { p = substr($0, 10) }
    $0 == "branch " b { print p; exit }'
}

# open_prs DIR — "branch<TAB>url" for each open PR; empty without gh.
open_prs() {
  command -v gh >/dev/null 2>&1 || return 0
  (cd "$1" && gh pr list --state open --json headRefName,url \
    -q '.[] | "\(.headRefName)\t\(.url)"' 2>/dev/null) || true
}
pr_of() { printf '%s\n' "$1" | awk -F'\t' -v b="$2" '$1 == b { print $2; exit }'; }

# open_worktree MAIN BRANCH DEFAULT — make or adopt BRANCH's worktree, run the
# agent start hooks; sets WT. Call from inside the repo.
open_worktree() {
  local main="$1" branch="$2" def="$3" s
  ensure_exclude "$main"
  git -C "$main" fetch -q origin 2>/dev/null || warn "fetch failed — using the last fetched refs"
  WT="$(worktree_of "$main" "$branch")"
  if [[ -z "$WT" ]]; then
    WT="$(worktree_dir "$branch")"
    [[ ! -e "$WT" ]] || die "$WT exists but does not hold branch '$branch'"
    ensure_worktree "$main" "$branch" "$WT" "origin/$def"
  elif [[ -z "$(git -C "$WT" status --porcelain)" ]]; then
    git -C "$WT" merge -q --ff-only '@{u}' 2>/dev/null || true
  fi
  for s in "$SELF_ROOT"/*/vibe-start.sh; do
    if [[ -f "$s" ]] && ! bash "$s" "$WT" "$(basename "$main")-$branch"; then
      warn "$s failed"
    fi
  done
}

cmd_start() {
  local repo_dir="$PWD" task="" main branch dir def pr
  while (($#)); do
    case "$1" in
      -C) repo_dir="${2:?-C needs a repo path}" && shift 2 ;;
      -h | --help) usage ;;
      -*) die "unknown option '$1'" ;;
      *)
        [[ -z "$task" ]] || die "one task only"
        task="$1"
        shift
        ;;
    esac
  done
  [[ -n "$task" ]] || usage 1
  cd "$repo_dir" || die "no such directory: $repo_dir"
  main="$(main_repo_root)"
  branch="$(slug "$task")"
  def="$(default_branch "$main")"
  [[ -n "$branch" && "$branch" != "$def" ]] || die "'$task' is not a task name"
  open_worktree "$main" "$branch" "$def"
  dir="$WT"
  pr="$(pr_of "$(open_prs "$dir")" "$branch")"
  echo "worktree: $dir"
  [[ -z "$pr" ]] || echo "PR:       $pr"
  if command -v code >/dev/null 2>&1; then
    code "$dir"
  fi
}

# sync_repo MAIN — sync each worktree of MAIN; one output line per worktree.
sync_repo() {
  local main="$1" def prs failed=0 line dir="" branch="" locked=""
  def="$(default_branch "$main")"
  ensure_exclude "$main"
  git -C "$main" fetch -q --prune origin 2>/dev/null || warn "$(basename "$main"): fetch failed"
  prs="$(open_prs "$main")"
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) dir="${line#worktree }" branch="" locked="" ;;
      "branch "*) branch="${line#branch refs/heads/}" ;;
      locked*) locked=1 ;;
      "")
        if [[ -n "$dir" ]] && ! sync_wt "$main" "$dir" "$branch" "$locked" "$def" "$prs"; then failed=1; fi
        dir=""
        ;;
    esac
  done < <(git -C "$main" worktree list --porcelain && echo)
  return "$failed"
}

# sync_wt MAIN DIR BRANCH LOCKED DEFAULT PRS — the push / ff / report rules.
sync_wt() {
  local main="$1" dir="$2" br="$3" locked="$4" def="$5" prs="$6" res="ok" note="" dirty="" counts ahead behind rc=0 name
  name="$(basename "$main")"
  [[ "$dir" == "$main" ]] || name="$name/${dir##*/}"
  [[ ! -d "$dir" ]] && res="missing" && note="directory gone — /worktree-cleanup"
  if [[ -d "$dir" && -z "$br" ]]; then
    res="detached"
  elif [[ -d "$dir" ]]; then
    [[ -z "$(git -C "$dir" status --porcelain)" ]] || dirty=1
    if [[ -n "$dirty" && "$WIP" == 1 && "$br" != "$def" && -z "$locked" ]]; then
      git -C "$dir" add -A && git -C "$dir" commit -q -m "wip: $(hostname) $(date '+%Y-%m-%d %H:%M')" && dirty="" && note="wip committed"
    fi
    if ! counts="$(git -C "$dir" rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null)"; then
      if [[ "$dir" == "$main" ]]; then
        res="no-upstream"
      elif git -C "$dir" config "branch.$br.merge" >/dev/null; then
        res="merged" note="upstream gone — /worktree-cleanup"
      elif [[ "$br" == worktree-* ]]; then
        res="local" note="app session branch, not pushed"
      elif [[ "$(git -C "$dir" rev-list --count "origin/$def..HEAD" 2>/dev/null || echo 0)" == 0 ]]; then
        res="empty" note="no commits yet"
      elif git -C "$dir" push -q -u origin "$br" 2>/dev/null; then
        res="pushed"
      else
        res="error" note="push failed" rc=1
      fi
    else
      read -r ahead behind <<<"$counts"
      if ((ahead > 0 && behind > 0)); then
        res="diverged"
      elif ((ahead > 0)) && [[ "$dir" == "$main" ]]; then
        res="ahead" note="main checkout is never pushed"
      elif ((ahead > 0)); then
        if git -C "$dir" push -q origin "$br" 2>/dev/null; then res="pushed"; else res="error" note="push failed" rc=1; fi
      elif ((behind > 0)) && [[ -n "$dirty" || -n "$locked" ]]; then
        res="behind"
      elif ((behind > 0)) && [[ "$dir" == "$main" && "$(cd -P "$main" && pwd)" == "$TOOLKIT" ]]; then
        res="behind" note="run: vibe update-toolkit"
      elif ((behind > 0)); then
        if git -C "$dir" merge -q --ff-only '@{u}' 2>/dev/null; then res="pulled"; else res="error" note="fast-forward failed" rc=1; fi
      fi
    fi
    [[ -z "$dirty" ]] || note="${note:+$note, }dirty"
    [[ -z "$locked" ]] || note="${note:+$note, }locked"
    [[ "$dir" != "$main" || "$br" == "$def" ]] || note="${note:+$note, }off $def"
  fi
  printf '%-11s %-40s %-28s %s %s\n' "$res" "$name" "${br:--}" "$note" "$(pr_of "$prs" "$br")"
  return "$rc"
}

cmd_sync() {
  local all=0 failed=0 d
  WIP=0
  while (($#)); do
    case "$1" in
      --all) all=1 ;;
      --wip) WIP=1 ;;
      -h | --help) usage ;;
      *) die "unknown option '$1'" ;;
    esac
    shift
  done
  if ((all)); then
    for d in "${VIBE_ROOT:-$(dirname "$SELF_ROOT")}"/*/; do
      [[ -d "$d/.git" ]] || continue
      sync_repo "${d%/}" || failed=1
    done
  else
    sync_repo "$(main_repo_root)" || failed=1
  fi
  return "$failed"
}

cmd_status() {
  local agent="${1:-}" s
  [[ $# -eq 1 && "$agent" == --?* ]] || die "usage: vibe status --<agent>, e.g. --claude"
  agent="${agent#--}"
  s="$SELF_ROOT/$agent/vibe-status.sh"
  [[ "$agent" != */* && -f "$s" ]] || die "no status for '$agent' — $s is missing"
  exec bash "$s"
}

cmd_update_toolkit() {
  local t="$TOOLKIT" def unit before after
  [[ $# -eq 0 ]] || die "usage: vibe update-toolkit"
  git -C "$t" rev-parse --git-dir >/dev/null 2>&1 || die "$t is not a git checkout"
  def="$(default_branch "$t")"
  [[ "$(git -C "$t" rev-parse --abbrev-ref HEAD)" == "$def" ]] || die "$t is not on $def"
  [[ -z "$(git -C "$t" status --porcelain --untracked-files=no)" ]] || die "$t has uncommitted changes"
  unit="claude/systemd/claude-rc@.service"
  before="$(git -C "$t" rev-parse -q --verify "HEAD:$unit" || true)"
  git -C "$t" pull -q --ff-only origin "$def" || die "pull failed — $t has diverged from origin/$def"
  after="$(git -C "$t" rev-parse -q --verify "HEAD:$unit" || true)"
  echo "toolkit at $(git -C "$t" log -1 --format='%h %s')"
  "$t/install.sh" || die "install.sh failed"
  "$t/install.sh" doctor || die "doctor reports problems"
  if [[ "$before" != "$after" ]] && grep -qx server "$HOME/.config/vibe/role" 2>/dev/null; then
    systemctl --user daemon-reload
    echo "unit changed; restart stops running sessions: systemctl --user restart 'claude-rc@*'"
  fi
}

# --- night: unattended jobs, one worktree each (docs/night-shift.md) ---------

NIGHT_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/night-shift"

# jget FILE KEY — the value of KEY=value in FILE; empty when absent.
jget() { awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$1" 2>/dev/null || true; }
# jstate JOB NAME — first line of a job state file; empty when absent.
jstate() { head -n 1 "$1/$2" 2>/dev/null || true; }

# night_end JOB STATUS NOTE — final status of a job; a recurring job also
# updates its last-run / fails state (docs/recurring-jobs.md).
night_end() {
  echo "$2" >"$1/status"
  echo "$3" >"$1/note"
  date '+%F %T' >"$1/ended"
  rm -f "$1/pid"
  [[ -z "$(jget "$1/job" recurring)" ]] || job_state_update "$1" "$2"
}

# deadline_epoch HH:MM — epoch of the next HH:MM, today or tomorrow.
deadline_epoch() {
  local h m now nh nm ns diff
  [[ "$1" =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || die "--until wants HH:MM, got '$1'"
  h="${BASH_REMATCH[1]}" m="${BASH_REMATCH[2]}"
  read -r now nh nm ns < <(date '+%s %H %M %S')
  diff=$(((10#$h * 60 + 10#$m - 10#$nh * 60 - 10#$nm + 1440) % 1440))
  echo $((now - 10#$ns + diff * 60))
}

# night_args ARGS... — parse start/run options into AGENT DIR JOBS UNTIL TIMEOUT.
night_args() {
  AGENT="" DIR="" JOBS=4 UNTIL=06:30 TIMEOUT=3h
  while (($#)); do
    case "$1" in
      --jobs) JOBS="${2:?--jobs needs a number}" && shift 2 ;;
      --until) UNTIL="${2:?--until needs HH:MM}" && shift 2 ;;
      --timeout) TIMEOUT="${2:?--timeout needs a duration, e.g. 3h}" && shift 2 ;;
      -h | --help) usage ;;
      --?*)
        [[ -z "$AGENT" ]] || die "one agent only"
        AGENT="${1#--}"
        shift
        ;;
      *)
        [[ -z "$DIR" ]] || die "one night directory only"
        DIR="$1"
        shift
        ;;
    esac
  done
  [[ -n "$AGENT" && -n "$DIR" ]] || die "usage: vibe night start --<agent> <dir>, e.g. --claude"
  [[ "$AGENT" != */* && -f "$SELF_ROOT/$AGENT/vibe-night.sh" ]] ||
    die "no night jobs for '$AGENT' — $SELF_ROOT/$AGENT/vibe-night.sh is missing"
  [[ "$JOBS" =~ ^[1-9][0-9]*$ ]] || die "--jobs wants a positive number, got '$JOBS'"
  [[ -d "$DIR/jobs" ]] || die "$DIR/jobs is missing — the agent-shift skill writes it"
  DIR="$(cd -P "$DIR" && pwd)"
  deadline_epoch "$UNTIL" >/dev/null
}

# branch_ok BRANCH — a slug, or jobs/<slug> (a recurring job's branch).
branch_ok() {
  local b="${1#jobs/}"
  [[ "$1" != jobs/*/* && -n "$b" && "$(slug "$b")" == "$b" ]]
}

# night_prepare JOB — check the job, make or adopt its worktree. Writes
# JOB/worktree on success, a final status otherwise. Run it in a subshell.
night_prepare() {
  local d="$1" repo branch main def wt
  repo="$(jget "$d/job" repo)" branch="$(jget "$d/job" branch)"
  [[ -f "$d/prompt.md" ]] || {
    night_end "$d" failed "no prompt.md"
    return 0
  }
  cd "$repo" 2>/dev/null || {
    night_end "$d" failed "no directory '$repo'"
    return 0
  }
  main="$(main_repo_root 2>/dev/null)" || {
    night_end "$d" failed "$repo is not a git repo"
    return 0
  }
  def="$(default_branch "$main")"
  if [[ -z "$branch" || "$branch" == "$def" ]] || ! branch_ok "$branch"; then
    night_end "$d" failed "bad branch '$branch'"
    return 0
  fi
  wt="$(worktree_of "$main" "$branch")"
  # A GPU follow-up starts in the worktree the run just wrote its outputs to.
  if [[ -n "$wt" && "$(jget "$d/job" follow)" != 1 && -n "$(git -C "$wt" status --porcelain)" ]]; then
    night_end "$d" skipped "$wt has uncommitted changes"
    return 0
  fi
  if [[ -z "$wt" && -e "$(worktree_dir "$branch")" ]]; then
    night_end "$d" skipped "$(worktree_dir "$branch") exists but does not hold '$branch'"
    return 0
  fi
  open_worktree "$main" "$branch" "$def"
  if [[ "$(git -C "$WT" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "$branch" ]]; then
    night_end "$d" failed "no worktree for '$branch'"
    return 0
  fi
  echo "$def" >"$d/base"
  echo "$(basename "$main")-${branch//\//-}" >"$d/name"
  echo "$WT" >"$d/worktree"
}

# pr_title_fallback JOB — `agent-shift(<id>): <result>` when the job wrote no pr.md.
pr_title_fallback() {
  local r
  r="$(jstate "$1" result)"
  r="${r#*: }"
  echo "agent-shift(${1##*/}): ${r:-${1##*/}}" | cut -c 1-60
}

# night_publish JOB — push the job's commits; open a draft PR from JOB/pr.md,
# or replace the body of the PR already open on the branch. Label: agent.
# `gh pr edit` fails on gh 2.45 (it asks for the removed projectCards); gh api does not.
night_publish() {
  local d="$1" wt base branch ahead title url
  wt="$(jstate "$d" worktree)" base="$(jstate "$d" base)" branch="$(jget "$d/job" branch)"
  ahead="$(git -C "$wt" rev-list --count "origin/$base..HEAD" 2>/dev/null || echo 0)"
  ((ahead > 0)) || return 0
  if ! git -C "$wt" push -q -u origin "$branch"; then
    echo "push failed" >"$d/pr"
    return 0
  fi
  command -v gh >/dev/null 2>&1 || return 0
  if [[ -f "$d/pr.md" ]]; then tail -n +2 "$d/pr.md" >"$d/pr-body.md"; else : >"$d/pr-body.md"; fi
  printf '\n---\n_agent-shift job %s: %s_\n' "$(basename "$d")" "$(jstate "$d" result)" >>"$d/pr-body.md"
  url="$( (cd "$wt" && gh pr list --head "$branch" --state open --json url -q '.[0].url') 2>/dev/null || true)"
  if [[ -n "$url" ]]; then
    (cd "$wt" && gh api --method PATCH "repos/{owner}/{repo}/pulls/${url##*/}" -F "body=@$d/pr-body.md") >/dev/null 2>&1 || true
  else
    title="$(head -n 1 "$d/pr.md" 2>/dev/null || true)"
    [[ -n "$title" ]] || title="$(pr_title_fallback "$d")"
    url="$( (cd "$wt" && gh pr create --draft --base "$base" --head "$branch" \
      --title "$title" --body-file "$d/pr-body.md") | tail -n 1 || true)"
  fi
  if [[ -n "$url" ]]; then
    (cd "$wt" && gh label create agent --color 5319e7 --description "opened by a job runner") >/dev/null 2>&1 || true
    (cd "$wt" && gh api --method POST "repos/{owner}/{repo}/issues/${url##*/}/labels" -f 'labels[]=agent') >/dev/null 2>&1 || true
  fi
  echo "${url:-PR not created}" >"$d/pr"
}

# night_run_job JOB — the agent in the job's worktree, then publish. Runs in
# the background; the runner marks it failed if it dies without a status.
night_run_job() {
  local d="$1" rc=0 result st note=""
  date '+%F %T' >"$d/started"
  # A recurring job carries its own limit; it replaces the night's duration.
  local -a tcmd=("${TIMEOUT_CMD[@]+"${TIMEOUT_CMD[@]}"}")
  local t
  t="$(jget "$d/job" timeout)"
  if [[ -n "$t" && ${#tcmd[@]} -gt 0 ]]; then tcmd[${#tcmd[@]} - 1]="$t"; fi
  NIGHT_SHIFT_JOB_DIR="$d" "${tcmd[@]+"${tcmd[@]}"}" bash "$SELF_ROOT/$AGENT/vibe-night.sh" \
    "$(jstate "$d" worktree)" "$(jstate "$d" name)" "$(jget "$d/job" model)" "$d/prompt.md" >"$d/log" 2>&1 || rc=$?
  result="$(jstate "$d" result)"
  if ((rc == 124 || rc == 137)); then
    st=timeout note="stopped after ${t:-$TIMEOUT}"
  elif ((rc != 0)); then
    st=failed note="agent exit $rc: $(tail -n 1 "$d/log" 2>/dev/null | cut -c 1-160 || true)"
  else
    case "$result" in
      "done:"*) st="done" ;;
      "blocked:"*) st=blocked ;;
      "queued:"*) st=gpu ;;
      *) st=failed note="no result line" ;;
    esac
  fi
  night_publish "$d" || true
  night_end "$d" "$st" "${result:-$note}"
}

cmd_night_run() {
  local d st pid running waiting now deadline queued
  night_args "$@"
  deadline="$(deadline_epoch "$UNTIL")"
  TIMEOUT_CMD=()
  if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(timeout --kill-after=60 "$TIMEOUT")
  elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(gtimeout --kill-after=60 "$TIMEOUT")
  else
    warn "no timeout(1) — jobs run without the $TIMEOUT limit"
  fi
  info "night $DIR: $JOBS at a time, none started after $UNTIL"
  while :; do
    running=0 waiting=0 queued=()
    for d in "$DIR"/jobs/*/; do
      d="${d%/}"
      [[ -f "$d/job" ]] || continue
      st="$(jstate "$d" status)"
      case "$st" in
        running)
          pid="$(jstate "$d" pid)"
          if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            running=$((running + 1))
          else
            night_end "$d" failed "job process died"
          fi
          ;;
        gpu) waiting=$((waiting + 1)) ;;
        "" | queued) queued+=("$d") ;;
      esac
    done
    now="$(date +%s)"
    # A job waiting on its GPU run gets a follow-up job, unless the night is over.
    if ((${#queued[@]} == 0 && running == 0 && (waiting == 0 || now >= deadline))); then break; fi
    for d in "${queued[@]+"${queued[@]}"}"; do
      if ((now >= deadline)); then
        night_end "$d" skipped "not started before $UNTIL"
        continue
      fi
      ((running < JOBS)) || break
      echo running >"$d/status"
      (night_prepare "$d") >>"$d/runner.log" 2>&1 || true
      if [[ "$(jstate "$d" status)" != running || ! -s "$d/worktree" ]]; then
        [[ "$(jstate "$d" status)" != running ]] || night_end "$d" failed "prepare failed — see runner.log"
        continue
      fi
      night_run_job "$d" >>"$d/runner.log" 2>&1 &
      echo "$!" >"$d/pid"
      running=$((running + 1))
      info "started $(basename "$d")"
    done
    sleep "${VIBE_NIGHT_POLL:-30}"
  done
  info "night finished"
  cmd_night_status "$DIR"
}

cmd_night_start() {
  local cmd
  night_args "$@"
  command -v tmux >/dev/null 2>&1 || die "tmux is required"
  if tmux -L night-shift has-session -t '=night' 2>/dev/null; then
    die "a night already runs — tmux -L night-shift attach -t night"
  fi
  cmd="$(printf '%q ' "$SELF_ROOT/bin/vibe" night run "--$AGENT" "$DIR" \
    --jobs "$JOBS" --until "$UNTIL" --timeout "$TIMEOUT")"
  tmux -L night-shift new-session -d -s night -c "$DIR" "$cmd >>$(printf '%q' "$DIR/runner.log") 2>&1"
  if ! tmux -L night-shift has-session -t '=gpu' 2>/dev/null; then
    cmd="$(printf '%q ' "$SELF_ROOT/bin/gpu-queue" run --until "$UNTIL")"
    tmux -L night-shift new-session -d -s gpu -c "$DIR" "$cmd >>$(printf '%q' "$DIR/gpu-queue.log") 2>&1"
  fi
  echo "night started: $DIR"
  echo "follow:  tail -f $DIR/runner.log"
  echo "status:  vibe night status $DIR"
}

# vibe night gpu -- CMD... — from inside a night job: queue CMD on the GPU
# (cwd: the worktree); when it ends, a follow-up job continues the task.
cmd_night_gpu() {
  local d="${NIGHT_SHIFT_JOB_DIR:-}" id
  [[ -n "$d" && -f "$d/job" ]] || die "vibe night gpu runs inside a night job (NIGHT_SHIFT_JOB_DIR)"
  if [[ "${1:-}" == -- ]]; then shift; fi
  (($#)) || die "usage: vibe night gpu -- CMD..."
  id="$("$SELF_ROOT/bin/gpu-queue" submit --name "${d##*/}" --dir "$PWD" \
    --then "$(printf '%q ' "$SELF_ROOT/bin/vibe" night follow "$d")" -- "$@")" || die "gpu-queue submit failed"
  echo "$id" >"$d/gpu-job"
  echo "queued $id — now write result 'queued: <what runs>' and exit"
}

# vibe night follow JOB — gpu-queue's --then: a follow-up job on JOB's branch
# with the run's exit code and log (GPUQ_EXIT, GPUQ_LOG).
cmd_night_follow() {
  local p="${1:?usage: vibe night follow <job dir>}" f n=1
  p="${p%/}"
  [[ -f "$p/job" ]] || die "no job at $p"
  f="$p-gpu"
  while [[ -e "$f" ]]; do
    n=$((n + 1))
    f="$p-gpu$n"
  done
  mkdir -p "$f"
  {
    grep -v '^follow=' "$p/job" || true
    echo "follow=1"
  } >"$f/job"
  {
    cat "$p/prompt.md"
    printf '\n## GPU run finished\n\n- Exit: %s\n- Log: %s\n\n' "${GPUQ_EXIT:-?}" "${GPUQ_LOG:-?}"
    echo "An earlier session prepared and queued this run; its commits are on the branch."
    echo "Read the log and the outputs, check the done-when, finish the task."
  } >"$f/prompt.md"
  night_end "$p" "done" "GPU run exit ${GPUQ_EXIT:-?} → ${f##*/}"
}

# night_dir [DIR] — DIR, else the latest night under NIGHT_ROOT.
night_dir() {
  local dir="${1:-}" d
  if [[ -z "$dir" ]]; then
    for d in "$NIGHT_ROOT"/*/; do [[ -d "$d/jobs" ]] && dir="${d%/}"; done
    [[ -n "$dir" ]] || die "no night under $NIGHT_ROOT"
  fi
  [[ -d "$dir/jobs" ]] || die "$dir/jobs is missing"
  echo "$dir"
}

cmd_night_status() {
  local dir d id st
  dir="$(night_dir "${1:-}")"
  echo "night: $dir"
  for d in "$dir"/jobs/*/; do
    d="${d%/}"
    [[ -f "$d/job" ]] || continue
    id="${d##*/}" st="$(jstate "$d" status)"
    printf '%-32s %-8s %s %s\n' "$id" "${st:-queued}" "$(jstate "$d" pr)" "$(jstate "$d" note)"
  done
}

# in_list NEEDLE WORD... — true when NEEDLE is one of the words.
in_list() {
  local n="$1" w
  shift
  for w in "$@"; do [[ "$w" != "$n" ]] || return 0; done
  return 1
}

# report_tldr JOB — the `Changed:` line of the job's pr.md, else its result.
report_tldr() {
  local t=""
  if [[ -f "$1/pr.md" ]]; then
    t="$(grep -m 1 '^\*\*Changed:\*\*' "$1/pr.md" 2>/dev/null || true)"
    t="${t#\*\*Changed:\*\*}"
    t="${t# }"
  fi
  echo "${t:-$(jstate "$1" note)}"
}

# report_rows TITLE CLASS... — one table of the jobs in the classes: a status,
# or `pr` (done with a PR URL; `done` is then done without one). Reads NIGHTS.
report_rows() {
  local title="$1" dir d st cls pr tldr links rows=""
  shift
  for dir in "${NIGHTS[@]}"; do
    for d in "$dir"/jobs/*/; do
      d="${d%/}"
      [[ -f "$d/job" ]] || continue
      st="$(jstate "$d" status)" pr="$(jstate "$d" pr)"
      st="${st:-queued}" cls="${st:-queued}"
      case "$pr" in http*) [[ "$st" != "done" ]] || cls="pr" ;; esac
      in_list "$cls" "$@" || continue
      tldr="$(report_tldr "$d")" links=""
      case "$pr" in http*) links="[PR]($pr)" ;; esac
      [[ ! -f "$d/report.md" ]] || links="${links:+$links · }[report](file://$d/report.md)"
      rows+="| ${dir##*/}/${d##*/} | $st | ${tldr//|//} | $links |"$'\n'
    done
  done
  echo
  echo "## $title"
  echo
  if [[ -z "$rows" ]]; then
    echo "none"
  else
    echo "| Job | Status | TL;DR | Links |"
    echo "| --- | --- | --- | --- |"
    printf '%s' "$rows"
  fi
}

# night_report_md DIR... — the briefing over the nights: counts, then ranked
# tables (needs a human, PRs to read, the rest), then the next action of
# every job that did not finish.
night_report_md() {
  local dir d st wt counts="" s n names=""
  NIGHTS=("$@")
  for dir in "$@"; do names="${names:+$names, }${dir##*/}"; done
  echo "# Agent jobs — $(date +%F)"
  echo
  for s in "done" blocked failed timeout skipped running gpu queued; do
    n=0
    for dir in "$@"; do
      for d in "$dir"/jobs/*/; do
        [[ -f "$d/job" ]] || continue
        st="$(jstate "${d%/}" status)"
        [[ "${st:-queued}" != "$s" ]] || n=$((n + 1))
      done
    done
    ((n == 0)) || counts="${counts:+$counts · }$n $s"
  done
  echo "${counts:-no jobs} — nights: $names"
  report_rows "Needs you" blocked failed timeout skipped
  report_rows "PR ready" pr
  report_rows "Done, nothing to read" "done" running gpu queued
  for dir in "$@"; do
    for d in "$dir"/jobs/*/; do
      d="${d%/}"
      st="$(jstate "$d" status)"
      case "$st" in "done" | "") continue ;; esac
      [[ -f "$d/job" ]] || continue
      wt="$(jstate "$d" worktree)"
      echo
      echo "## ${dir##*/}/${d##*/} — $st"
      echo
      echo "- Repo: $(jget "$d/job" repo) · branch \`$(jget "$d/job" branch)\`"
      [[ -z "$wt" ]] || echo "- Worktree: $wt"
      [[ ! -f "$d/report.md" ]] || echo "- Report: $d/report.md"
      if [[ -n "$wt" && -f "$wt/HANDOFF.md" ]]; then
        echo "- Next action:"
        md_section "$wt/HANDOFF.md" "Next action" "  "
        echo "- Blockers:"
        md_section "$wt/HANDOFF.md" Blockers "  "
      fi
      case "$st" in failed | timeout) echo "- Log: $d/log" ;; esac
    done
  done
}

# active_nights — every night with a job file written in the last 24 h.
active_nights() {
  local d
  for d in "$NIGHT_ROOT"/*/; do
    [[ -d "$d/jobs" ]] || continue
    [[ -z "$(find "$d/jobs" -type f -mmin -1440 -print -quit 2>/dev/null)" ]] || echo "${d%/}"
  done
}

# vibe night report [--<agent>] [--new] [--day] [DIR...] — the day's briefing over
# DIRs (default: the nights active in the last 24 h) to
# NIGHT_ROOT/briefings/<date>.md, copied as briefing-<date>.md with note
# frontmatter to the directory named in ~/.config/night-shift/briefing-dir
# when that file exists. With an agent,
# open a session on it (<agent>/vibe-night-report.sh). --new: only when the
# day has no briefing yet (the morning timer). --day: today's day shift
# (NIGHT_ROOT/<date>-day) to <date>-day.md; none is no error (the 13:00 timer).
cmd_night_report() {
  local agent="" new=0 day=0 dirs=() d file copy dest name
  while (($#)); do
    case "$1" in
      --new) new=1 ;;
      --day) day=1 ;;
      -h | --help) usage ;;
      --?*) agent="${1#--}" ;;
      *) dirs+=("$(night_dir "$1")") ;;
    esac
    shift
  done
  if [[ -n "$agent" ]]; then
    [[ "$agent" != */* && -f "$SELF_ROOT/$agent/vibe-night-report.sh" ]] ||
      die "no night report for '$agent' — $SELF_ROOT/$agent/vibe-night-report.sh is missing"
  fi
  name="$(date +%F)"
  if ((day)); then
    name="$name-day"
    if [[ ! -d "$NIGHT_ROOT/$name/jobs" ]]; then
      echo "no day shift today: $NIGHT_ROOT/$name"
      return 0
    fi
    dirs=("$NIGHT_ROOT/$name")
  fi
  if ((${#dirs[@]} == 0)); then
    while IFS= read -r d; do [[ -z "$d" ]] || dirs+=("$d"); done < <(active_nights)
    ((${#dirs[@]})) || dirs=("$(night_dir "")")
  fi
  file="$NIGHT_ROOT/briefings/$name.md"
  if ((new)) && [[ -f "$file" ]]; then
    echo "briefing $file exists"
    return 0
  fi
  mkdir -p "${file%/*}"
  night_report_md "${dirs[@]}" >"$file"
  echo "briefing: $file"
  copy="$(head -n 1 "${XDG_CONFIG_HOME:-$HOME/.config}/night-shift/briefing-dir" 2>/dev/null || true)"
  copy="${copy/#\~/$HOME}"
  if [[ -n "$copy" ]]; then
    dest="$copy/briefing-${file##*/}"
    mkdir -p "$copy"
    {
      printf -- '---\ncreated: %s\ntouched_by_ai: true\n---\n\n' "$(date +%F)"
      cat "$file"
    } >"$dest"
    echo "copied: $dest"
  fi
  if [[ -n "$agent" ]]; then
    bash "$SELF_ROOT/$agent/vibe-night-report.sh" "$file" "$NIGHT_ROOT"
  fi
}

cmd_night() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    start | run | status | report | gpu | follow) "cmd_night_$sub" "$@" ;;
    *) die "usage: vibe night start|status|report — see vibe --help" ;;
  esac
}

# --- job: recurring jobs, queued on a night by the 01:00 timer (docs/recurring-jobs.md)

JOBS_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/agent-jobs"
JOBS_CATALOGUE="${AGENT_JOBS_CATALOGUE:-$SELF_ROOT/skills/recurring-jobs/references/jobs}"
JOBS_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/night-shift/repos"

# fm_get FILE KEY — `KEY: value` from FILE's frontmatter; empty when absent.
fm_get() {
  awk -v k="$2" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); print v; exit }' "$1" 2>/dev/null || true
}
# fm_body FILE — FILE after its frontmatter (the whole file without one).
fm_body() {
  awk 'NR == 1 && $0 != "---" { all = 1 } all { print; next } NR > 1 && !on && $0 == "---" { on = 1; next } on { print }' "$1" 2>/dev/null || true
}

# job_repos [REPO...] — absolute repo paths: the arguments, else the config.
job_repos() {
  local line
  if (($#)); then
    for line in "$@"; do job_repo_path "$line"; done
    return 0
  fi
  [[ -f "$JOBS_CONF" ]] || die "no repos — list them in $JOBS_CONF (one per line), or pass them"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(echo "$line" | tr -d '[:space:]')"
    [[ -z "$line" ]] || job_repo_path "$line"
  done <"$JOBS_CONF"
}
job_repo_path() {
  case "$1" in */*) echo "$1" ;; *) echo "${NIGHT_SHIFT_ROOT:-$(dirname "$SELF_ROOT")}/$1" ;; esac
}

# job_names REPO — the jobs REPO opted into: one per <repo>/.agent-jobs/<name>.md.
job_names() {
  local f
  for f in "$1"/.agent-jobs/*.md; do
    [[ -f "$f" ]] || continue
    f="${f##*/}"
    case "$f" in _*) continue ;; esac
    echo "${f%.md}"
  done
}

# job_key REPO JOB KEY DEFAULT — the repo file's value, else the catalogue's, else DEFAULT.
job_key() {
  local v
  v="$(fm_get "$1/.agent-jobs/$2.md" "$3")"
  [[ -n "$v" ]] || v="$(fm_get "$JOBS_CATALOGUE/$2.md" "$3")"
  echo "${v:-$4}"
}

# job_check REPO JOB — "ok", or why the job cannot run.
job_check() {
  local repo="$1" job="$2" sched
  [[ "$(slug "$job")" == "$job" ]] || {
    echo "bad name '$job'"
    return 0
  }
  sched="$(job_key "$repo" "$job" schedule "")"
  case "$sched" in
    daily | weekly | monthly) ;;
    "") echo "no schedule — not in the catalogue, and the repo file sets none" && return 0 ;;
    *) echo "bad schedule '$sched'" && return 0 ;;
  esac
  if [[ ! -f "$JOBS_CATALOGUE/$job.md" && -z "$(fm_body "$repo/.agent-jobs/$job.md" | grep -v '^[[:space:]]*$' || true)" ]]; then
    echo "not in the catalogue, and the repo file has no instructions"
    return 0
  fi
  echo ok
}

# job_state REPO JOB FILE — a state file's first line (last-run epoch, fails).
job_state() { head -n 1 "$JOBS_STATE/$(basename "$1")/$2/$3" 2>/dev/null || true; }

# job_state_update JOB-DIR STATUS — done: stamp last-run, forget failures;
# failed/timeout: one more failure. Two in a row stop the job (job_due).
job_state_update() {
  local d="$1" st="$2" dir n
  dir="$JOBS_STATE/$(basename "$(jget "$d/job" repo)")/$(jget "$d/job" recurring)"
  mkdir -p "$dir"
  case "$st" in
    "done")
      date +%s >"$dir/last-run"
      rm -f "$dir/fails"
      ;;
    failed | timeout)
      n="$(head -n 1 "$dir/fails" 2>/dev/null || echo 0)"
      echo $((n + 1)) >"$dir/fails"
      ;;
  esac
}

# job_due REPO JOB — "due", "stopped" (two failures), "not due", "invalid".
job_due() {
  local repo="$1" job="$2" sched day last fails now period today
  [[ "$(job_check "$repo" "$job")" == ok ]] || {
    echo invalid
    return 0
  }
  fails="$(job_state "$repo" "$job" fails)"
  if ((${fails:-0} >= 2)); then
    echo stopped
    return 0
  fi
  sched="$(job_key "$repo" "$job" schedule "")" day="$(job_key "$repo" "$job" day "")"
  case "$sched" in
    daily) period=72000 ;;
    weekly) period=518400 ;;
    monthly) period=2332800 ;;
  esac
  last="$(job_state "$repo" "$job" last-run)"
  now="$(date +%s)"
  today="$(LC_ALL=C date +%a | tr '[:upper:]' '[:lower:]')"
  if ((now - ${last:-0} < period)) || [[ -n "$day" && "$day" != "$today" ]]; then
    echo "not due"
  else
    echo due
  fi
}

# vibe job list [REPO...] — one row per repo × job.
cmd_job_list() {
  local repo job last fails why
  printf '%-18s %-20s %-8s %-4s %-11s %s\n' REPO JOB SCHEDULE DAY LAST-RUN STATE
  while IFS= read -r repo; do
    [[ -d "$repo" ]] || {
      printf '%-18s %s\n' "$(basename "$repo")" "no directory $repo"
      continue
    }
    while IFS= read -r job; do
      [[ -n "$job" ]] || continue
      last="$(job_state "$repo" "$job" last-run)" fails="$(job_state "$repo" "$job" fails)"
      [[ -z "$last" ]] || last="$(date -d "@$last" +%F 2>/dev/null || date -r "$last" +%F)"
      why="$(job_due "$repo" "$job")"
      case "$why" in
        invalid) why="invalid: $(job_check "$repo" "$job")" ;;
        stopped) why="stopped: $fails failures — rm $JOBS_STATE/$(basename "$repo")/$job/fails" ;;
      esac
      printf '%-18s %-20s %-8s %-4s %-11s %s\n' "$(basename "$repo")" "$job" \
        "$(job_key "$repo" "$job" schedule -)" "$(job_key "$repo" "$job" day -)" "${last:-never}" "$why"
    done < <(job_names "$repo")
  done < <(job_repos "$@")
}

# job_open_prs REPO — "branch" per open PR a runner opened; empty without gh.
job_open_prs() {
  command -v gh >/dev/null 2>&1 || return 0
  (cd "$1" && gh pr list --label agent --state open --json headRefName -q '.[].headRefName' 2>/dev/null) || true
}

# job_write NIGHT-DIR ID REPO JOB — the job dir: `job` and the rendered prompt.
# Output drops to `report` when the repo already has 2 open job PRs and this
# job's branch is not one of them.
job_write() {
  local dir="$1" id="$2" repo="$3" job="$4" d branch output prs n tpl
  d="$dir/jobs/$id"
  branch="jobs/$job"
  output="$(job_key "$repo" "$job" output pr)"
  if [[ "$output" == pr ]]; then
    prs="$(job_open_prs "$repo")"
    n="$(printf '%s\n' "$prs" | grep -c '^jobs/' || true)"
    if ((n >= 2)) && ! printf '%s\n' "$prs" | grep -qx "$branch"; then output=report; fi
  fi
  mkdir -p "$d"
  printf 'repo=%s\nbranch=%s\nmodel=%s\ntimeout=%s\nrecurring=%s\noutput=%s\n' \
    "$repo" "$branch" "$(job_key "$repo" "$job" model sonnet)" "$(job_key "$repo" "$job" timeout 1h)" \
    "$job" "$output" >"$d/job"
  tpl="$SELF_ROOT/skills/recurring-jobs/references/job-prompt.md"
  render_template "$tpl" \
    '<job>' "$job" \
    '<repo>' "$repo" \
    '<branch>' "$branch" \
    '<output>' "$output" \
    '<timeout>' "$(job_key "$repo" "$job" timeout 1h)" \
    '<job-dir>' "$d" \
    '<catalogue-instructions>' "$(fm_body "$JOBS_CATALOGUE/$job.md")" \
    '<repo-instructions>' "$(fm_body "$repo/.agent-jobs/$job.md")" \
    '<pr-template>' "$(cat "$SELF_ROOT/templates/job-pr.md")" \
    '<report-template>' "$(cat "$SELF_ROOT/templates/job-report.md")" >"$d/prompt.md"
  echo "queued $id → $d ($output)"
}

# job_queue AGENT DRY "REPO JOB"... — write the jobs into tonight's night: the
# running one when there is one, else a new <date>-jobs night, started. Sets
# QUEUED_DIR to the night used.
job_queue() {
  local agent="$1" dry="$2" dir="" item repo job n=0 id
  shift 2
  QUEUED_DIR=""
  (($#)) || {
    echo "nothing to queue"
    return 0
  }
  if ((dry)); then
    for item in "$@"; do echo "would queue: $item"; done
    return 0
  fi
  if tmux -L night-shift has-session -t '=night' 2>/dev/null; then
    dir="$(night_dir "")"
    info "a night runs — adding to $dir"
  else
    dir="$NIGHT_ROOT/$(date +%F)-jobs"
    mkdir -p "$dir/jobs"
  fi
  QUEUED_DIR="$dir"
  for item in "$@"; do
    repo="${item% *}" job="${item##* }"
    n=$((n + 1))
    id="$((89 + n))-$(basename "$repo")-$job"
    while [[ -e "$dir/jobs/$id" ]]; do id="$id-2"; done
    job_write "$dir" "$id" "$repo" "$job"
  done
  if ! tmux -L night-shift has-session -t '=night' 2>/dev/null; then
    cmd_night_start "--$agent" "$dir"
  fi
}

# job_agent_args ARGS... — parse --<agent>, --dry, --max N; the rest into REST.
job_agent_args() {
  AGENT="" DRY=0 MAX=4 REST=()
  while (($#)); do
    case "$1" in
      --dry) DRY=1 ;;
      --max) MAX="${2:?--max needs a number}" && shift ;;
      -h | --help) usage ;;
      --?*)
        [[ -z "$AGENT" ]] || die "one agent only"
        AGENT="${1#--}"
        ;;
      *) REST+=("$1") ;;
    esac
    shift
  done
  [[ -n "$AGENT" ]] || die "usage: vibe job due|run --<agent> …, e.g. --claude"
  [[ "$AGENT" != */* && -f "$SELF_ROOT/$AGENT/vibe-night.sh" ]] ||
    die "no night jobs for '$AGENT' — $SELF_ROOT/$AGENT/vibe-night.sh is missing"
  [[ "$MAX" =~ ^[1-9][0-9]*$ ]] || die "--max wants a positive number, got '$MAX'"
}

# vibe job due --<agent> [--dry] [--max N] [REPO...] — queue every due job,
# oldest last-run first, at most N. A stopped job lands on the night as
# `skipped` so the morning report shows it under "Needs you".
cmd_job_due() {
  local repo job why last lines="" picked=() stopped=() d
  job_agent_args "$@"
  while IFS= read -r repo; do
    [[ -d "$repo" ]] || continue
    while IFS= read -r job; do
      [[ -n "$job" ]] || continue
      why="$(job_due "$repo" "$job")"
      case "$why" in
        due)
          last="$(job_state "$repo" "$job" last-run)"
          lines+="${last:-0} $repo $job"$'\n'
          ;;
        stopped) stopped+=("$repo $job") ;;
      esac
    done < <(job_names "$repo")
  done < <(job_repos "${REST[@]+"${REST[@]}"}")
  while IFS= read -r repo; do
    [[ -n "$repo" ]] || continue
    ((${#picked[@]} < MAX)) || break
    picked+=("${repo#* }")
  done < <(printf '%s' "$lines" | sort -n -k1,1)
  job_queue "$AGENT" "$DRY" "${picked[@]+"${picked[@]}"}"
  [[ -z "${QUEUED_DIR:-}" ]] || for job in "${stopped[@]+"${stopped[@]}"}"; do
    d="$QUEUED_DIR/jobs/99-$(basename "${job% *}")-${job##* }"
    [[ ! -e "$d" ]] || continue
    mkdir -p "$d"
    printf 'repo=%s\nbranch=jobs/%s\nmodel=sonnet\n' "${job% *}" "${job##* }" >"$d/job"
    night_end "$d" skipped "stopped after 2 failures — rm $JOBS_STATE/$(basename "${job% *}")/${job##* }/fails"
  done
  for job in "${stopped[@]+"${stopped[@]}"}"; do echo "stopped: $job (2 failures)"; done
}

# vibe job run --<agent> REPO JOB — queue one job now, due or not.
cmd_job_run() {
  local repo why
  job_agent_args "$@"
  ((${#REST[@]} == 2)) || die "usage: vibe job run --<agent> <repo> <job>"
  repo="$(job_repo_path "${REST[0]}")"
  [[ -d "$repo" ]] || die "no directory $repo"
  why="$(job_check "$repo" "${REST[1]}")"
  [[ "$why" == ok ]] || die "${REST[1]} in $(basename "$repo"): $why"
  job_queue "$AGENT" "$DRY" "$repo ${REST[1]}"
}

# vibe job add REPO JOB — render templates/AGENT_JOB.md to <repo>/.agent-jobs/<job>.md.
cmd_job_add() {
  local repo="${1:?usage: vibe job add <repo> <job>}" job="${2:?usage: vibe job add <repo> <job>}" f
  repo="$(job_repo_path "$repo")"
  [[ -d "$repo" ]] || die "no directory $repo"
  [[ "$(slug "$job")" == "$job" ]] || die "bad job name '$job'"
  [[ -f "$JOBS_CATALOGUE/$job.md" ]] || info "'$job' is not in the catalogue — the file needs its own schedule and instructions"
  f="$repo/.agent-jobs/$job.md"
  [[ ! -e "$f" ]] || die "$f exists — edit it"
  mkdir -p "$repo/.agent-jobs"
  render_template "$SELF_ROOT/templates/AGENT_JOB.md" '<job>' "$job" '<repo>' "$(basename "$repo")" >"$f"
  echo "wrote $f — edit, then commit it"
}

cmd_job() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    list | due | run | add) "cmd_job_$sub" "$@" ;;
    *) die "usage: vibe job list|due|run|add — see vibe --help" ;;
  esac
}

case "${1:-}" in
  night)
    shift
    cmd_night "$@"
    ;;
  job)
    shift
    cmd_job "$@"
    ;;
  update-toolkit)
    shift
    cmd_update_toolkit "$@"
    ;;
  start | sync | status)
    cmd="$1"
    shift
    # sync fetches every repo anyway, so its check never uses the cache.
    if [[ "$cmd" == sync ]]; then VIBE_FETCH_INTERVAL=0 toolkit_check; else toolkit_check; fi
    "cmd_$cmd" "$@"
    ;;
  -h | --help | help) usage ;;
  *) usage 1 ;;
esac
